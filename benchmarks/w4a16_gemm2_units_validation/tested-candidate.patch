+    def _select_m_tiles_per_unit(self) -> int:
+        """Choose how many consecutive M tiles one work unit covers.
+
+        With few K stages per output tile, the per-tile activation load,
+        scheduler entry and accumulator handoff bound how far weight
+        streaming runs ahead of the epilogue. A unit of M tiles from the same
+        routed-row tile loads that activation tile once and hands all its
+        accumulators to the epilogue together. Each M tile keeps its own
+        accumulator, K order and epilogue arithmetic.
+
+        Use the largest divisor of the cluster's M tiles whose unit spans at
+        most _MAX_UNIT_WEIGHT_STAGES weight stages (M tiles x K stages) and
+        still fits two accumulator and two decoded-weight stages in TMEM.
+        """
+        if (
+            self.problem_mk is None
+            or self.gather_input
+            or self.activation_type is not None
+            or self.use_fused_finalize
+            or self.use_2cta_instrs
+            or not self.m_cluster_aligned
+            or self.transform_a_source != tcgen05.OperandSource.TMEM
+        ):
+            return 1
+        m, k = self.problem_mk
+        k_tiles = (k + self.mma_tiler[2] - 1) // self.mma_tiler[2]
+        # Units tile each cluster's M extent exactly.
+        cluster_m_tiles = m // (self.cta_tile_shape_mnk[0] * self.cluster_shape_mn[0])
+        # An M128 FP32 accumulator spans the routed-row tile's N columns, and a
+        # decoded BF16 weight stage spans K/2 columns.
+        acc_tmem_cols = self.cta_tile_shape_mnk[1]
+        a_tmem_cols = cute.round_up(self.cta_tile_shape_mnk[2] // 2, 4)
+        tmem_cols = cute.arch.get_max_tmem_alloc_cols("sm_100")
+        m_tiles_per_unit = 1
+        for tiles in range(2, _MAX_UNIT_WEIGHT_STAGES // k_tiles + 1):
+            # Two accumulator stages and at least two decoded-weight stages.
+            if (
+                cluster_m_tiles % tiles == 0
+                and 2 * tiles * acc_tmem_cols + 2 * a_tmem_cols <= tmem_cols
+            ):
+                m_tiles_per_unit = tiles
+        return m_tiles_per_unit
+
