{
  "name": "prims_ts_batch_decode_tuple_multi_q_sq4_h32_kv4_d128_ps32_s2048",
  "description": "Standalone PrimTS GQA decode over FlashInfer native CSR page metadata using the tuple HND cache form and caller-owned workspace. Fixed multi-Q uses [B,SQ,Hq,D]; packed Q uses [total_q,Hq,D] with cumulative qo_indptr offsets.",
  "op_type": "gqa_paged",
  "tags": [
    "fi_api:flashinfer.attention.prims_ts.decode.prims_ts_batch_decode_with_kv_cache",
    "stage:decode",
    "backend:prims-ts",
    "status:experimental"
  ],
  "axes": {
    "batch_size": {
      "type": "var",
      "description": "Number of decode requests."
    },
    "seq_len_q": {
      "type": "const",
      "value": 4,
      "description": "Fixed query length per request."
    },
    "num_qo_heads": {
      "type": "const",
      "value": 32
    },
    "num_kv_heads": {
      "type": "const",
      "value": 4
    },
    "head_dim": {
      "type": "const",
      "value": 128
    },
    "num_pages": {
      "type": "var",
      "description": "Physical KV-cache page capacity."
    },
    "page_size": {
      "type": "const",
      "value": 32
    },
    "workspace_size": {
      "type": "var",
      "description": "Caller workspace size in bytes."
    },
    "len_indptr": {
      "type": "var",
      "description": "Length of the native CSR indptr."
    },
    "num_kv_indices": {
      "type": "var",
      "description": "Number of referenced page IDs."
    },
    "len_qo_indptr": {
      "type": "var",
      "description": "Length of cumulative Q offsets."
    },
    "max_seq_len": {
      "type": "const",
      "value": 2048,
      "description": "Exact compiled maximum KV sequence length."
    }
  },
  "constraints": [
    "head_dim in (64, 128, 256)",
    "page_size in (16, 32, 64, 128)",
    "len_indptr == batch_size + 1",
    "num_qo_heads % num_kv_heads == 0",
    "1 <= num_qo_heads // num_kv_heads <= 32",
    "kv_layout == 'HND'",
    "window_left == -1 or mask_type == 'causal'",
    "seq_len_q >= 2"
  ],
  "inputs": {
    "query": {
      "shape": [
        "batch_size",
        "seq_len_q",
        "num_qo_heads",
        "head_dim"
      ],
      "dtype": "bfloat16"
    },
    "k_cache": {
      "shape": [
        "num_pages",
        "num_kv_heads",
        "page_size",
        "head_dim"
      ],
      "dtype": "bfloat16"
    },
    "v_cache": {
      "shape": [
        "num_pages",
        "num_kv_heads",
        "page_size",
        "head_dim"
      ],
      "dtype": "bfloat16"
    },
    "workspace_buffer": {
      "shape": [
        "workspace_size"
      ],
      "dtype": "int8",
      "description": "Exclusive caller-owned int8/uint8 scratch buffer."
    },
    "paged_kv_indptr": {
      "shape": [
        "len_indptr"
      ],
      "dtype": "int32"
    },
    "paged_kv_indices": {
      "shape": [
        "num_kv_indices"
      ],
      "dtype": "int32"
    },
    "seq_lens": {
      "shape": [
        "batch_size"
      ],
      "dtype": "int32"
    },
    "max_seq_len": {
      "shape": null,
      "dtype": "int32"
    },
    "seq_len_q": {
      "shape": null,
      "dtype": "int32",
      "optional": true
    },
    "qo_indptr": {
      "shape": [
        "len_qo_indptr"
      ],
      "dtype": "int32",
      "optional": true
    },
    "max_seq_len_q": {
      "shape": null,
      "dtype": "int32",
      "optional": true
    },
    "bmm1_scale": {
      "shape": null,
      "dtype": "float32",
      "optional": true
    },
    "bmm2_scale": {
      "shape": null,
      "dtype": "float32",
      "optional": true
    },
    "out_dtype": {
      "shape": null,
      "dtype": "dtype",
      "optional": true
    },
    "mask_type": {
      "shape": null,
      "dtype": "string",
      "optional": true
    },
    "window_left": {
      "shape": null,
      "dtype": "int32",
      "optional": true
    },
    "kv_layout": {
      "shape": null,
      "dtype": "string",
      "optional": true
    }
  },
  "outputs": {
    "output": {
      "shape": [
        "batch_size",
        "seq_len_q",
        "num_qo_heads",
        "head_dim"
      ],
      "dtype": "bfloat16",
      "param": "out"
    }
  },
  "check": "def standard_check(\n    reference_outputs: Any,\n    actual_outputs: Any,\n    *,\n    rtol: Optional[float] = None,\n    atol: Optional[float] = None,\n    max_mismatch_pct: float = 0.0,\n    min_cos_sim: Optional[float] = 1.0 - 1e-3,\n) -> bool:\n    \"\"\"Default trace correctness check used when a template does not override it.\"\"\"\n    from flashinfer.trace import default_check\n\n    return default_check(\n        reference_outputs,\n        actual_outputs,\n        rtol=rtol,\n        atol=atol,\n        max_mismatch_pct=max_mismatch_pct,\n        min_cos_sim=min_cos_sim,\n    )\n"
}
