{
  "name": "glm5_low_latency_moe_topk8_h6144_i256",
  "description": "GLM5 low-latency MoE for Blackwell: sigmoid top-8 routing, block-FP8 up/down projections, one shared expert, and local TP reduction.",
  "op_type": "moe",
  "tags": [
    "fi_api:flashinfer.fused_moe.glm5.glm5_low_latency_moe",
    "status:verified",
    "quantization:float8_e4m3fn",
    "arch:sm100-family"
  ],
  "axes": {
    "seq_len": {
      "type": "var",
      "description": "Decode token count (1..4)."
    },
    "num_experts": {
      "type": "const",
      "value": 256,
      "description": "Number of routed experts (256)."
    },
    "num_experts_with_shared": {
      "type": "const",
      "value": 257,
      "description": "Packed routed plus shared experts (257)."
    },
    "top_k": {
      "type": "const",
      "value": 8,
      "description": "Experts selected per token."
    },
    "hidden_size": {
      "type": "const",
      "value": 6144,
      "description": "Model hidden size (6144)."
    },
    "local_intermediate_size": {
      "type": "const",
      "value": 256,
      "description": "TP-local MoE intermediate size (256 or 512)."
    },
    "packed_up_sub_rows": {
      "type": "const",
      "value": 4,
      "description": "Packed 64-row up-projection groups."
    },
    "packed_up_k_iters": {
      "type": "const",
      "value": 8,
      "description": "Packed up-projection K iterations (8)."
    },
    "packed_up_tile_bytes": {
      "type": "const",
      "value": 98304,
      "description": "Bytes in one packed gate/up tile (98304)."
    },
    "up_scale_rows": {
      "type": "const",
      "value": 4,
      "description": "Gate/up block-scale rows."
    },
    "hidden_blocks": {
      "type": "const",
      "value": 48,
      "description": "128-column blocks along hidden_size (48)."
    },
    "intermediate_blocks": {
      "type": "const",
      "value": 2,
      "description": "128-column TP-local intermediate blocks."
    }
  },
  "constraints": [
    "seq_len <= 4",
    "num_experts == 256",
    "hidden_size == 6144",
    "local_intermediate_size in {256, 512}"
  ],
  "inputs": {
    "hidden_states": {
      "shape": [
        "seq_len",
        "hidden_size"
      ],
      "dtype": "bfloat16",
      "description": "Input activations."
    },
    "router_logits": {
      "shape": [
        "seq_len",
        "num_experts"
      ],
      "dtype": "float32",
      "description": "Pre-sigmoid routed-expert scores."
    },
    "routing_bias": {
      "shape": [
        "num_experts"
      ],
      "dtype": "bfloat16",
      "description": "Bias used only for expert selection."
    },
    "expert_gate_up_weight": {
      "shape": [
        "num_experts_with_shared",
        "packed_up_sub_rows",
        "packed_up_k_iters",
        "packed_up_tile_bytes"
      ],
      "dtype": "float8_e4m3fn",
      "description": "Kernel-packed shared and routed gate/up weights."
    },
    "expert_gate_up_scale": {
      "shape": [
        "num_experts_with_shared",
        "up_scale_rows",
        "hidden_blocks"
      ],
      "dtype": "float32",
      "description": "128x128 block scales for packed gate/up weights."
    },
    "routed_down_weight": {
      "shape": [
        "num_experts",
        "hidden_size",
        "local_intermediate_size"
      ],
      "dtype": "float8_e4m3fn",
      "description": "Raw row-major routed down-projection weights."
    },
    "routed_down_scale": {
      "shape": [
        "num_experts",
        "hidden_blocks",
        "intermediate_blocks"
      ],
      "dtype": "float32",
      "description": "128x128 routed down-projection block scales."
    },
    "shared_down_weight": {
      "shape": [
        "hidden_size",
        "local_intermediate_size"
      ],
      "dtype": "float8_e4m3fn",
      "description": "Raw row-major shared down-projection weight."
    },
    "shared_down_scale": {
      "shape": [
        "hidden_blocks",
        "intermediate_blocks"
      ],
      "dtype": "float32",
      "description": "128x128 shared down-projection block scales."
    },
    "routed_scaling_factor": {
      "shape": null,
      "dtype": "float32",
      "optional": true,
      "description": "Post-normalization routed-expert scale."
    },
    "packed_weight_stages": {
      "shape": null,
      "dtype": "int32",
      "optional": true,
      "description": "One or two packed-weight pipeline stages."
    },
    "use_tma": {
      "shape": null,
      "dtype": "bool",
      "optional": true,
      "description": "Use TMA instead of the cp.async fallback."
    }
  },
  "outputs": {
    "output": {
      "shape": [
        "seq_len",
        "hidden_size"
      ],
      "dtype": "bfloat16",
      "description": "TP-local routed-plus-shared MoE output."
    }
  },
  "check": "def standard_check(\n    reference_outputs: Any,\n    actual_outputs: Any,\n    *,\n    rtol: Optional[float] = None,\n    atol: Optional[float] = None,\n    max_mismatch_pct: float = 0.0,\n    min_cos_sim: Optional[float] = 1.0 - 1e-3,\n) -> bool:\n    \"\"\"Default trace correctness check used when a template does not override it.\"\"\"\n    from flashinfer.trace import default_check\n\n    return default_check(\n        reference_outputs,\n        actual_outputs,\n        rtol=rtol,\n        atol=atol,\n        max_mismatch_pct=max_mismatch_pct,\n        min_cos_sim=min_cos_sim,\n    )\n"
}
