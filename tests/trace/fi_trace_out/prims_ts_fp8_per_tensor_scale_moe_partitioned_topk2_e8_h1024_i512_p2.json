{
  "name": "prims_ts_fp8_per_tensor_scale_moe_partitioned_topk2_e8_h1024_i512_p2",
  "description": "Two-way partitioned Prims-TS FP8 per-tensor-scale MoE.",
  "op_type": "moe",
  "tags": [
    "fi_api:flashinfer.fused_moe.backends.prims_ts.fp8_op.prims_ts_fp8_per_tensor_scale_moe_partitioned",
    "status:experimental",
    "backend:prims-ts",
    "partitioning:two-way",
