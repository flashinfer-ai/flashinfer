      "type": "var",
      "description": "Number of input tokens."
    },
    "num_experts": {
      "type": "const",
      "value": 8,
      "description": "Total number of experts."
    },
    "top_k": {
      "type": "const",
      "value": 2,
      "description": "Experts selected per token."
    },
    "num_local_experts": {
      "type": "const",
      "value": 8,
      "description": "Experts resident on this rank."
    },
    "hidden_size": {
      "type": "const",
      "value": 1024,
      "description": "Logical activation width."
    },
    "intermediate_size": {
      "type": "const",
      "value": 512,
      "description": "Logical FFN width."
    },
    "partition_count": {
      "type": "const",
