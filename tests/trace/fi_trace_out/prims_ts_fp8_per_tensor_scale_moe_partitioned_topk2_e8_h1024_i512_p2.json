      "value": 1024,
      "description": "Physical prepared FC2 rows per partition."
    },
    "fc1_storage_k": {
      "type": "const",
      "value": 1024,
      "description": "Physical prepared FC1 K storage."
    },
    "fc2_storage_k": {
      "type": "const",
      "value": 256,
      "description": "Physical prepared FC2 K storage."
    }
  },
  "constraints": [
