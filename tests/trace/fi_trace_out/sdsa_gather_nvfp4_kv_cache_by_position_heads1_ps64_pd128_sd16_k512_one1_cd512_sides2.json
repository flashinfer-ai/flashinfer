{
  "name": "sdsa_gather_nvfp4_kv_cache_by_position_heads1_ps64_pd128_sd16_k512_one1_cd512_sides2",
  "description": "Selected HND NVFP4 MQA tokens, from key positions, converted to normalized FP8 K/V with their K/V index lists.",
  "op_type": "sdsa_gather_nvfp4_kv_cache_by_position",
  "tags": [
    "fi_api:flashinfer.sdsa.token_sparse.gather_nvfp4_kv_cache_by_position",
    "arch:sm100",
    "arch:sm103"
  ],
  "axes": {
    "pages": {
      "type": "var",
      "description": "KV cache pages."
    },
    "heads": {
      "type": "const",
      "value": 1,
      "description": "KV heads; the cache is MQA."
    },
    "page_size": {
      "type": "const",
      "value": 64,
      "description": "Tokens per page."
    },
    "packed_dim": {
      "type": "const",
      "value": 128,
      "description": "Packed NVFP4 bytes per token."
    },
    "scale_dim": {
      "type": "const",
      "value": 16,
      "description": "E4M3 block scales per token."
    },
    "rows": {
      "type": "var",
      "description": "Query rows, each with top_k key positions."
    },
    "top_k": {
      "type": "const",
      "value": 512,
      "description": "Key positions per row."
    },
    "requests": {
      "type": "var",
      "description": "Block-table rows."
    },
    "blocks": {
      "type": "var",
      "description": "Pages per request in the block table."
    },
    "out_rows": {
      "type": "var",
      "description": "FP8 workspace rows: rows * top_k or more."
    },
    "one": {
      "type": "const",
      "value": 1,
      "description": "Unit axis of the attention workspace."
    },
    "content_dim": {
      "type": "const",
      "value": 512,
      "description": "FP8 K then V values per token."
    },
    "attention_rows": {
      "type": "var",
      "description": "Attention requests: rows * requests_per_row or more."
    },
    "sides": {
      "type": "const",
      "value": 2,
      "description": "K and V lists."
    }
  },
  "constraints": [
    "content_dim == packed_dim * 4",
    "scale_dim * 8 == packed_dim"
  ],
  "inputs": {
    "k": {
      "shape": [
        "pages",
        "heads",
        "page_size",
        "packed_dim"
      ],
      "dtype": "uint8"
    },
    "v": {
      "shape": [
        "pages",
        "heads",
        "page_size",
        "packed_dim"
      ],
      "dtype": "uint8"
    },
    "k_sf": {
      "shape": [
        "pages",
        "heads",
        "page_size",
        "scale_dim"
      ],
      "dtype": "float8_e4m3fn"
    },
    "v_sf": {
      "shape": [
        "pages",
        "heads",
        "page_size",
        "scale_dim"
      ],
      "dtype": "float8_e4m3fn"
    },
    "positions": {
      "shape": [
        "rows",
        "top_k"
      ],
      "dtype": "int32"
    },
    "requests": {
      "shape": [
        "rows"
      ],
      "dtype": "int32"
    },
    "block_table": {
      "shape": [
        "requests",
        "blocks"
      ],
      "dtype": "int32"
    },
    "out": {
      "shape": [
        "out_rows",
        "one",
        "one",
        "content_dim"
      ],
      "dtype": "float8_e4m3fn"
    },
    "block_tables": {
      "shape": [
        "attention_rows",
        "sides",
        "top_k"
      ],
      "dtype": "int32"
    },
    "seq_lens": {
      "shape": [
        "attention_rows"
      ],
      "dtype": "int32"
    },
    "lengths": {
      "shape": [
        "rows"
      ],
      "dtype": "unknown",
      "optional": true
    },
    "requests_per_row": {
      "shape": null,
      "dtype": "int32"
    },
    "v_sf_swizzled": {
      "shape": null,
      "dtype": "bool"
    }
  },
  "outputs": {
    "out": {
      "shape": [
        "out_rows",
        "one",
        "one",
        "content_dim"
      ],
      "dtype": "float8_e4m3fn",
      "param": "out"
    },
    "block_tables": {
      "shape": [
        "attention_rows",
        "sides",
        "top_k"
      ],
      "dtype": "int32",
      "param": "block_tables"
    },
    "seq_lens": {
      "shape": [
        "attention_rows"
      ],
      "dtype": "int32",
      "param": "seq_lens"
    }
  },
  "check": "def standard_check(\n    reference_outputs: Any,\n    actual_outputs: Any,\n    *,\n    rtol: Optional[float] = None,\n    atol: Optional[float] = None,\n    max_mismatch_pct: float = 0.0,\n    min_cos_sim: Optional[float] = 1.0 - 1e-3,\n) -> bool:\n    \"\"\"Default trace correctness check used when a template does not override it.\"\"\"\n    from flashinfer.trace import default_check\n\n    return default_check(\n        reference_outputs,\n        actual_outputs,\n        rtol=rtol,\n        atol=atol,\n        max_mismatch_pct=max_mismatch_pct,\n        min_cos_sim=min_cos_sim,\n    )\n"
}
