{
  "name": "qsa_attention_h4_d128_w35",
  "description": "QSAAttention.run(): map a logical token route through the block table, attend over those KV entries of a paged cache (dense, FP8 or NVFP4), and apply the output gate.",
  "op_type": "qsa_attention",
  "tags": [
    "fi_api:flashinfer.qsa_ops.attention.QSAAttention.run",
    "status:verified",
    "sparse"
  ],
  "axes": {
    "num_rows": {
      "type": "var"
    },
    "num_qo_heads": {
      "type": "const",
      "value": 4
    },
    "head_dim": {
      "type": "const",
      "value": 128
    },
    "num_pages": {
      "type": "var"
    },
    "cache_axis_1": {
      "type": "const",
      "value": 16,
      "description": "page_size (NHD) or heads (HND)."
    },
    "cache_axis_2": {
      "type": "const",
      "value": 1,
      "description": "heads (NHD) or page_size (HND)."
    },
    "entry": {
      "type": "const",
      "value": 128,
      "description": "head_dim, or head_dim // 2 (NVFP4)."
    },
    "scale_entry": {
      "type": "var",
      "description": "head_dim // 16, for NVFP4 only."
    },
    "route_width": {
      "type": "const",
      "value": 35
    },
    "num_requests": {
      "type": "var"
    },
    "table_width": {
      "type": "var"
    }
  },
  "inputs": {
    "q": {
      "shape": [
        "num_rows",
        "num_qo_heads",
        "head_dim"
      ],
      "dtype": "bfloat16"
    },
    "k_data": {
      "shape": [
        "num_pages",
        "cache_axis_1",
        "cache_axis_2",
        "entry"
      ],
      "dtype": "bfloat16"
    },
    "v_data": {
      "shape": [
        "num_pages",
        "cache_axis_1",
        "cache_axis_2",
        "entry"
      ],
      "dtype": "bfloat16"
    },
    "route": {
      "shape": [
        "num_rows",
        "route_width"
      ],
      "dtype": "int32",
      "description": "Logical tokens, -1 where none."
    },
    "block_table": {
      "shape": [
        "num_requests",
        "table_width"
      ],
      "dtype": "int32",
      "description": "Logical to physical page per request; negative is unmapped."
    },
    "token_to_request": {
      "shape": [
        "num_rows"
      ],
      "dtype": "int32",
      "description": "Request of each row; a negative entry empties the row."
    },
    "output_gate": {
      "shape": [
        "num_rows",
        "num_qo_heads",
        "head_dim"
      ],
      "dtype": "bfloat16",
      "description": "Or [num_rows, num_qo_heads * head_dim]."
    },
    "k_sf": {
      "shape": [
        "num_pages",
        "cache_axis_1",
        "cache_axis_2",
        "scale_entry"
      ],
      "dtype": "unknown",
      "optional": true,
      "description": "NVFP4 block scales."
    },
    "v_sf": {
      "shape": [
        "num_pages",
        "cache_axis_1",
        "cache_axis_2",
        "scale_entry"
      ],
      "dtype": "unknown",
      "optional": true,
      "description": "NVFP4 block scales."
    },
    "k_scale": {
      "shape": null,
      "dtype": "float32",
      "optional": true
    },
    "v_scale": {
      "shape": null,
      "dtype": "float32",
      "optional": true
    },
    "out": {
      "shape": [
        "num_rows",
        "num_qo_heads",
        "head_dim"
      ],
      "dtype": "unknown",
      "optional": true
    }
  },
  "outputs": {
    "out": {
      "shape": [
        "num_rows",
        "num_qo_heads",
        "head_dim"
      ],
      "dtype": "bfloat16"
    }
  },
  "check": "def standard_check(\n    reference_outputs: Any,\n    actual_outputs: Any,\n    *,\n    rtol: Optional[float] = None,\n    atol: Optional[float] = None,\n    max_mismatch_pct: float = 0.0,\n    min_cos_sim: Optional[float] = 1.0 - 1e-3,\n) -> bool:\n    \"\"\"Default trace correctness check used when a template does not override it.\"\"\"\n    from flashinfer.trace import default_check\n\n    return default_check(\n        reference_outputs,\n        actual_outputs,\n        rtol=rtol,\n        atol=atol,\n        max_mismatch_pct=max_mismatch_pct,\n        min_cos_sim=min_cos_sim,\n    )\n"
}
