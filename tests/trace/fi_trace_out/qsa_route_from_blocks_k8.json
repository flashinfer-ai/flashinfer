{
  "name": "qsa_route_from_blocks_k8",
  "description": "QSA route expansion fused with the block-table lookup: the logical route, its physical KV slots, and their packed validity mask.",
  "op_type": "qsa_route",
  "tags": [
    "fi_api:flashinfer.qsa_ops.route.qsa_route_from_blocks",
    "status:verified",
    "sparse"
  ],
  "axes": {
    "num_rows": {
      "type": "var"
    },
    "block_topk": {
      "type": "const",
      "value": 8
    },
    "num_requests": {
      "type": "var"
    },
    "table_width": {
      "type": "var"
    },
    "route_width": {
      "type": "var",
      "description": "block_topk * ratio + ratio - 1."
    },
    "mask_bytes": {
      "type": "var",
      "description": "num_rows * ceil(route_width / 8)."
    }
  },
  "inputs": {
    "indexer_block_ids": {
      "shape": [
        "num_rows",
        "block_topk"
      ],
      "dtype": "int32"
    },
    "token_to_request": {
      "shape": [
        "num_rows"
      ],
      "dtype": "int32",
      "description": "Request of each row; a negative entry empties the row."
    },
    "query_positions": {
      "shape": [
        "num_rows"
      ],
      "dtype": "int32",
      "description": "Position of each query."
    },
    "seq_lens": {
      "shape": [
        "num_requests"
      ],
      "dtype": "int32",
      "description": "KV length of each request."
    },
    "block_table": {
      "shape": [
        "num_requests",
        "table_width"
      ],
      "dtype": "int32",
      "description": "Logical to physical page per request; negative is unmapped."
    },
    "out_logical": {
      "shape": [
        "num_rows",
        "route_width"
      ],
      "dtype": "int32"
    },
    "out_route": {
      "shape": [
        "num_rows",
        "route_width"
      ],
      "dtype": "int32"
    },
    "out_mask": {
      "shape": [
        "mask_bytes"
      ],
      "dtype": "uint8"
    },
    "compress_ratio": {
      "shape": null,
      "dtype": "int32"
    },
    "page_size": {
      "shape": null,
      "dtype": "int32",
      "description": "KV entries per physical page."
    },
    "num_slots": {
      "shape": null,
      "dtype": "int32",
      "description": "KV entries the cache holds."
    }
  },
  "outputs": {
    "out_logical": {
      "shape": [
        "num_rows",
        "route_width"
      ],
      "dtype": "int32",
      "param": "out_logical"
    },
    "out_route": {
      "shape": [
        "num_rows",
        "route_width"
      ],
      "dtype": "int32",
      "param": "out_route"
    },
    "out_mask": {
      "shape": [
        "mask_bytes"
      ],
      "dtype": "uint8",
      "param": "out_mask"
    }
  },
  "check": "def standard_check(\n    reference_outputs: Any,\n    actual_outputs: Any,\n    *,\n    rtol: Optional[float] = None,\n    atol: Optional[float] = None,\n    max_mismatch_pct: float = 0.0,\n    min_cos_sim: Optional[float] = 1.0 - 1e-3,\n) -> bool:\n    \"\"\"Default trace correctness check used when a template does not override it.\"\"\"\n    from flashinfer.trace import default_check\n\n    return default_check(\n        reference_outputs,\n        actual_outputs,\n        rtol=rtol,\n        atol=atol,\n        max_mismatch_pct=max_mismatch_pct,\n        min_cos_sim=min_cos_sim,\n    )\n"
}
