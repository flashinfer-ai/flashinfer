{
  "name": "ulysses_scatter_qkv_sage2_sm89_sm120_h8_d64_p8_u513",
  "description": "Distributed SageAttention2 QKV preparation: local statistics, one FP32 NCCL AllGather, rank-ordered statistics finalization, quantize/pack, one uint8 NCCL AllToAll, and unpack. Requires an existing communicator and prepare_qkv workspace on every rank, in the same collective order. This schema describes a distributed operation; it has no single-GPU reference or automatic process-group/workspace initializer. Returned UlyssesQKV fields are listed in tuple order; when out is supplied, its six tensors are filled and the same result record is returned. Input rows outside the global used_sequence prefix must already be zero.",
  "op_type": "comm",
  "tags": [
    "fi_api:flashinfer.comm.ulysses.UlyssesCommunicator.scatter_qkv",
    "stage:comm",
    "distributed:multi-rank",
    "transport:nccl",
    "quantization:sage2",
    "layout:sage2_sm89_sm120"
  ],
  "axes": {
    "batch": {
      "type": "var"
    },
    "local_sequence": {
      "type": "var"
    },
    "logical_sequence": {
      "type": "var"
    },
    "padded_sequence": {
      "type": "var"
    },
    "local_heads": {
      "type": "var"
    },
    "q_scale_width": {
      "type": "var"
    },
    "k_scale_width": {
      "type": "var"
    },
    "num_heads": {
      "type": "const",
      "value": 8
    },
    "head_dim": {
      "type": "const",
      "value": 64
    },
    "world_size": {
      "type": "const",
      "value": 8
    },
    "used_sequence": {
      "type": "const",
      "value": 513
    }
  },
  "constraints": [
    "batch > 0",
    "local_sequence > 0",
    "num_heads > 0",
    "head_dim in [64, 128]",
    "world_size in [2, 4, 8]",
    "num_heads % world_size == 0",
    "local_heads == num_heads // world_size",
    "logical_sequence == world_size * local_sequence",
    "0 < used_sequence <= logical_sequence",
    "padded_sequence == (logical_sequence + 63) // 64 * 64",
    "q_scale_width == (used_sequence + 127) // 128 * 4",
    "k_scale_width == (used_sequence + 63) // 64"
  ],
