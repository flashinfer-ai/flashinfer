def _sha256(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def _normalize_generated_body(source: str) -> str:
    source = source.replace("\r\n", "\n").replace("\r", "\n")
    volatile_ids = {}

    def replace_volatile_temp(match):
        kind, identity = match.groups()
        ordinal = volatile_ids.setdefault(identity, f"{len(volatile_ids) + 1:04d}")
        return f"_{kind}_volatile{ordinal}"

    source = _VOLATILE_TEMP.sub(replace_volatile_temp, source)
    source = "\n".join(line.rstrip() for line in source.splitlines())
    return source.rstrip() + "\n"


def _read_verified(path: Path, variant: Variant, arch: str) -> bytes:
    data = path.read_bytes()
    actual_sha256 = _sha256(data)
    if len(data) != variant.raw_bytes or actual_sha256 != variant.raw_sha256:
        raise ValueError(
            f"{arch} split{variant.split} export identity mismatch: "
            f"bytes={len(data)} sha256={actual_sha256}; expected "
            f"bytes={variant.raw_bytes} sha256={variant.raw_sha256}"
        )
    return data


def _verify_profile(path: Path, profile: dict[str, str], variant: Variant) -> None:
    data = path.read_bytes()
    if _sha256(data) != profile["profile_sha256"]:
        raise ValueError(f"{profile['profile']} profile identity mismatch")
    payload = json.loads(data)
    expected_fields = {
        "profile": profile["profile"],
        "arch": profile["arch"],
        "module_ident": variant.module_ident,
        "expected_source_sha256": variant.raw_sha256,
    }
    for field, expected in expected_fields.items():
        if payload.get(field) != expected:
            raise ValueError(
                f"{profile['profile']} {field} mismatch: "
                f"{payload.get(field)!r} != {expected!r}"
            )


def _freeze(raw: bytes, variant: Variant) -> bytes:
    text = raw.decode("utf-8")
    if not text.endswith("\n"):
        raise ValueError("raw source must end with a newline")
    if text.count("kernel_flashinfer_recurrent_kda_t1_unbounded_softplus(") != 1:
        raise ValueError("raw source has an unexpected kernel signature")
    for required in (
        "float* __restrict__ A_log",
        "float* __restrict__ dt_bias",
        "float biased_gate",
        "log1pf(",
        "__expf((-gate_a) * softplus)",
        "int g_stride_token",
        "int state_stride_slot",
    ):
        if required not in text:
            raise ValueError(f"raw source is missing {required!r}")
    normalized = _normalize_generated_body(text)
    if _sha256(normalized.encode("utf-8")) != variant.normalized_sha256:
        raise ValueError("normalized generated source identity mismatch")
    metadata = (
        "// Generated from a recurrent-KDA Loom schedule.\n"
        f"// Raw generated body SHA256: {variant.raw_sha256}\n"
        f"// Normalized generated SHA256: {variant.normalized_sha256}\n"
        "// BEGIN FROZEN GENERATED BODY\n"
    )
    return (
        LICENSE_HEADER
        + "\n// clang-format off\n"
        + metadata
        + text
        + "// END FROZEN GENERATED BODY\n"
        + "// clang-format on\n"
    ).encode("utf-8")


def _manifest(frozen: dict[str, bytes]) -> bytes:
    payload = {
        "schema_version": 1,
        "architecture_artifacts_are_separate": True,
        "generated_source_text_equal_across_architectures": True,
        "profiles": PROFILES,
        "variants": {
            key: {
                "frozen_path": f"csrc/kda/{variant.frozen_filename}",
                "frozen_sha256": _sha256(frozen[key]),
                "module_ident": variant.module_ident,
                "normalized_sha256": variant.normalized_sha256,
                "raw_bytes": variant.raw_bytes,
                "raw_sha256": variant.raw_sha256,
                "value_split": variant.split,
            }
            for key, variant in VARIANTS.items()
        },
    }
    return (json.dumps(payload, indent=2, sort_keys=True) + "\n").encode("utf-8")


def _write_or_check(path: Path, expected: bytes, check: bool) -> bool:
    if check:
        if not path.is_file() or path.read_bytes() != expected:
            print(f"out of date: {path}", file=sys.stderr)
            return False
        print(f"verified: {path}")
        return True
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_bytes(expected)
    print(f"wrote: {path}")
    return True


def _parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    for arch in ("sm100", "sm103"):
        for split in (8, 16):
            parser.add_argument(
                f"--{arch}-split{split}-source", type=Path, required=True
            )
            parser.add_argument(
                f"--{arch}-split{split}-profile", type=Path, required=True
            )
    parser.add_argument(
        "--output-dir",
        type=Path,
        default=Path(__file__).resolve().parents[1] / "csrc" / "kda",
    )
    parser.add_argument("--check", action="store_true")
    return parser.parse_args()


def main() -> int:
    args = _parse_args()
    raw = {}
    for profile_key, profile in PROFILES.items():
        arch_key = "sm100" if profile["arch"] == "sm_100a" else "sm103"
        variant = VARIANTS[profile["variant"]]
        source_path = getattr(args, f"{arch_key}_split{variant.split}_source")
        profile_path = getattr(args, f"{arch_key}_split{variant.split}_profile")
        _verify_profile(profile_path, profile, variant)
        raw[profile_key] = _read_verified(source_path, variant, profile["arch"])
    for split in (8, 16):
        if raw[f"sm100_split{split}"] != raw[f"sm103_split{split}"]:
            raise ValueError(f"split{split} SM100 and SM103 source text differs")
    frozen = {
        f"split{split}": _freeze(raw[f"sm100_split{split}"], VARIANTS[f"split{split}"])
        for split in (8, 16)
    }
    outputs = {
        args.output_dir / variant.frozen_filename: frozen[key]
        for key, variant in VARIANTS.items()
    }
    outputs[
        args.output_dir / "cake_kda_decode_unbounded_softplus_import_manifest.json"
    ] = _manifest(frozen)
    matched = True
    for path, data in outputs.items():
        matched = _write_or_check(path, data, args.check) and matched
    return 0 if matched else 1


if __name__ == "__main__":
    raise SystemExit(main())
