"""Import sealed Cake KDA affine device receipts into public CUDA sources.

The producer supplies exactly one generated device body for each target/role
pair. It does not supply public bindings. This importer verifies every receipt
field and source byte, deterministically publicizes the device bodies,
generates target/role selector bindings over checked-in shared C++ headers, and
writes the complete public manifest consumed by JIT and AOT.

No producer checkout identity is copied into public output.
The immutable exported/raw source digests are retained as byte provenance.
"""

from __future__ import annotations

import argparse
from dataclasses import dataclass
import hashlib
import json
from pathlib import Path, PurePosixPath
import re
import sys
from typing import Any


