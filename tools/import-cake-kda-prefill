def _sha256(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def _publicize_generated_names(source: str) -> str:
    replacements = (
        (r"\b[A-Z][A-Za-z0-9]*TensorMapPack\b", "CakeKDATensorMapPack"),
        (r"\b[A-Z][A-Za-z0-9]*TensorMap\b", "CakeKDATensorMap"),
    )
    for pattern, replacement in replacements:
        source, count = re.subn(pattern, replacement, source)
        if count == 0:
            raise ValueError(f"generated source is missing {pattern!r}")
    inf_match = re.search(r"#define ([A-Z][A-Z0-9_]*_INF) CUDART_INF_F", source)
    if inf_match is None:
        raise ValueError("generated source is missing its infinity macro")
    return source.replace(inf_match.group(1), "CAKE_KDA_INF")


def _read_verified(path: Path, variant: Variant, arch: str) -> bytes:
    data = path.read_bytes()
    actual_sha256 = _sha256(data)
    if len(data) != variant.raw_bytes or actual_sha256 != variant.raw_sha256:
        raise ValueError(
            f"{arch} {variant.key} export identity mismatch: "
            f"bytes={len(data)} sha256={actual_sha256}; expected "
            f"bytes={variant.raw_bytes} sha256={variant.raw_sha256}"
        )
    return data


def _verify_profile(path: Path, profile: dict[str, str], variant: Variant) -> None:
    data = path.read_bytes()
    actual_sha256 = _sha256(data)
    if actual_sha256 != profile["profile_sha256"]:
        raise ValueError(
            f"{profile['profile']} identity mismatch: sha256={actual_sha256}; "
            f"expected {profile['profile_sha256']}"
        )
    payload = json.loads(data)
    expected_fields = {
        "profile": profile["profile"],
        "arch": profile["arch"],
        "module_ident": variant.source_module_ident,
        "expected_source_sha256": variant.raw_sha256,
    }
    for field, expected in expected_fields.items():
        if payload.get(field) != expected:
            raise ValueError(
                f"{profile['profile']} {field} mismatch: "
                f"{payload.get(field)!r} != {expected!r}"
            )


def _freeze(raw: bytes, variant: Variant) -> bytes:
    text = raw.decode("utf-8")
    if not text.endswith("\n"):
        raise ValueError(f"{variant.key} raw source must end with a newline")
    if text.count("kernel_flashkda_bf16_fused_m128(") != 1:
        raise ValueError(
            f"{variant.key} raw source must contain exactly one kernel signature"
        )
    if text.count("__nv_bfloat16* __restrict__ initial_state") != 1:
        raise ValueError(
            f"{variant.key} raw source has an unexpected initial_state signature"
        )
    if text.count("__nv_bfloat16* __restrict__ final_state") != 1:
        raise ValueError(
            f"{variant.key} raw source has an unexpected final_state signature"
        )
    if text.count("fence.proxy.tensormap::generic.acquire.sys") != 6:
        raise ValueError(
            f"{variant.key} raw source must contain six generated tensor-map acquires"
        )
    if text.count("    __syncthreads();") < 1:
        raise ValueError(
            f"{variant.key} raw source is missing its generated CTA barrier"
        )
    if f"#define SMEM_TOTAL {variant.smem_bytes}" not in text:
        raise ValueError(f"{variant.key} raw source has an unexpected SMEM_TOTAL")

    signature_start = text.index("kernel_flashkda_bf16_fused_m128(")
    signature_end = text.index("\n{", signature_start) + 1
    signature = text[signature_start:signature_end]
    alias_signature = signature.replace(
        "__nv_bfloat16* __restrict__ initial_state",
        "__nv_bfloat16* initial_state",
    ).replace(
        "__nv_bfloat16* __restrict__ final_state",
        "__nv_bfloat16* final_state",
    )
    if alias_signature == signature:
        raise ValueError(f"{variant.key} alias integration made no change")
    integrated = (
        text[:signature_start]
        + ALIAS_BEGIN
        + alias_signature
        + ALIAS_END
        + text[signature_end:]
    )
    if integrated.count("kernel_flashkda_bf16_fused_m128") != 1:
        raise ValueError(f"{variant.key} raw source has an unexpected kernel name")
    integrated = integrated.replace(
        "kernel_flashkda_bf16_fused_m128",
        "kernel_cake_kda_bf16_fused_m128",
    )
    integrated = _publicize_generated_names(integrated)

    provenance = (
        "// Frozen generated Cake export; do not edit by hand.\n"
        "// Provenance: generated by Cake from its recurrent-KDA schedule; raw SHA-256:\n"
        f"// {variant.raw_sha256}.\n"
    )
    return (
        LICENSE_HEADER
        + "\n"
        + provenance
        + "// clang-format off\n"
        + integrated
        + "// clang-format on\n"
    ).encode("utf-8")


def _manifest(frozen: dict[str, bytes]) -> bytes:
    variants = {}
    for key, variant in VARIANTS.items():
        variants[key] = {
            "binding_path": f"csrc/kda/{variant.binding_filename}",
            "frozen_path": f"csrc/kda/{variant.frozen_filename}",
            "frozen_sha256": _sha256(frozen[key]),
            "module_ident": variant.module_ident,
            "source_module_ident": variant.source_module_ident,
            "raw_bytes": variant.raw_bytes,
            "raw_sha256": variant.raw_sha256,
            "smem_bytes": variant.smem_bytes,
        }
    payload = {
        "schema_version": 2,
        "architecture_artifacts_are_separate": True,
        "generated_source_text_equal_across_architectures": True,
        "generated_invariants": [
            "six fence.proxy.tensormap::generic.acquire.sys operations",
            "CTA barrier after tensor-map acquisition",
        ],
        "integration_patches": [
            {
                "id": "allow_exact_state_alias",
                "reason": "the public recurrent API permits initial_state and final_state to alias exactly",
                "scope": [
                    "initial_state restrict qualifier",
                    "final_state restrict qualifier",
                ],
            },
            {
                "id": "use_cake_kda_export_name",
                "reason": "identify the generated implementation as Cake KDA without changing the sealed source identity",
                "scope": ["frozen CUDA filename", "exported CUDA kernel symbol"],
            },
        ],
        "profiles": PROFILES,
        "variants": variants,
    }
    return (json.dumps(payload, indent=2, sort_keys=True) + "\n").encode("utf-8")


def _write_or_check(path: Path, expected: bytes, check: bool) -> bool:
    if check:
        if not path.is_file() or path.read_bytes() != expected:
            print(f"out of date: {path}", file=sys.stderr)
            return False
        print(f"verified: {path}")
        return True
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_bytes(expected)
    print(f"wrote: {path}")
    return True


def _parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--sm100-unbounded-softplus-source", type=Path, required=True)
    parser.add_argument("--sm103-unbounded-softplus-source", type=Path, required=True)
    parser.add_argument("--sm100-unbounded-softplus-profile", type=Path, required=True)
    parser.add_argument("--sm103-unbounded-softplus-profile", type=Path, required=True)
    parser.add_argument(
        "--sm100-bt64-unbounded-softplus-source", type=Path, required=True
    )
    parser.add_argument(
        "--sm103-bt64-unbounded-softplus-source", type=Path, required=True
    )
    parser.add_argument(
        "--sm100-bt64-unbounded-softplus-profile", type=Path, required=True
    )
    parser.add_argument(
        "--sm103-bt64-unbounded-softplus-profile", type=Path, required=True
    )
    parser.add_argument(
        "--output-dir",
        type=Path,
        default=Path(__file__).resolve().parents[1] / "csrc" / "kda",
    )
    parser.add_argument("--check", action="store_true")
    return parser.parse_args()


def main() -> int:
    args = _parse_args()
    paths = {
        "sm100_unbounded_softplus": args.sm100_unbounded_softplus_source,
        "sm103_unbounded_softplus": args.sm103_unbounded_softplus_source,
        "sm100_bt64_unbounded_softplus": (
            args.sm100_bt64_unbounded_softplus_source
        ),
        "sm103_bt64_unbounded_softplus": (
            args.sm103_bt64_unbounded_softplus_source
        ),
    }
    profile_paths = {
        "sm100_unbounded_softplus": args.sm100_unbounded_softplus_profile,
        "sm103_unbounded_softplus": args.sm103_unbounded_softplus_profile,
        "sm100_bt64_unbounded_softplus": (
            args.sm100_bt64_unbounded_softplus_profile
        ),
        "sm103_bt64_unbounded_softplus": (
            args.sm103_bt64_unbounded_softplus_profile
        ),
    }
    raw: dict[str, bytes] = {}
    for profile_key, path in paths.items():
        profile = PROFILES[profile_key]
        variant = VARIANTS[profile["variant"]]
        _verify_profile(profile_paths[profile_key], profile, variant)
        raw[profile_key] = _read_verified(path, variant, profile["arch"])
    if raw["sm100_unbounded_softplus"] != raw["sm103_unbounded_softplus"]:
        raise ValueError(
            "unbounded-softplus SM100 and SM103 generated source text differs"
        )
    if (
        raw["sm100_bt64_unbounded_softplus"]
        != raw["sm103_bt64_unbounded_softplus"]
    ):
        raise ValueError(
            "BT64 unbounded-softplus SM100 and SM103 generated source text differs"
        )

    frozen = {
        "unbounded_softplus": _freeze(
            raw["sm100_unbounded_softplus"], VARIANTS["unbounded_softplus"]
        ),
        "bt64_unbounded_softplus": _freeze(
            raw["sm100_bt64_unbounded_softplus"],
            VARIANTS["bt64_unbounded_softplus"],
        ),
    }
    outputs = {
        args.output_dir / variant.frozen_filename: frozen[key]
        for key, variant in VARIANTS.items()
    }
    outputs[
        args.output_dir
        / "cake_kda_bf16_fused_m128_unbounded_softplus_import_manifest.json"
    ] = _manifest(frozen)
    matched = True
    for path, data in outputs.items():
        matched = _write_or_check(path, data, args.check) and matched
    return 0 if matched else 1


if __name__ == "__main__":
    raise SystemExit(main())
