def _sha256(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def _read_verified(path: Path, variant: Variant, arch: str) -> bytes:
    data = path.read_bytes()
    actual_sha256 = _sha256(data)
    if len(data) != variant.raw_bytes or actual_sha256 != variant.raw_sha256:
        raise ValueError(
            f"{arch} {variant.key} export identity mismatch: "
            f"bytes={len(data)} sha256={actual_sha256}; expected "
            f"bytes={variant.raw_bytes} sha256={variant.raw_sha256}"
        )
    return data


def _verify_profile(path: Path, profile: dict[str, str], variant: Variant) -> None:
    data = path.read_bytes()
    actual_sha256 = _sha256(data)
    if actual_sha256 != profile["profile_sha256"]:
        raise ValueError(
            f"{profile['profile']} identity mismatch: sha256={actual_sha256}; "
            f"expected {profile['profile_sha256']}"
        )
    payload = json.loads(data)
    expected_fields = {
        "profile": profile["profile"],
        "arch": profile["arch"],
        "module_ident": variant.module_ident,
        "expected_source_sha256": variant.raw_sha256,
        "baseline_revision": SEMANTIC_BASELINE,
    }
    for field, expected in expected_fields.items():
        if payload.get(field) != expected:
            raise ValueError(
                f"{profile['profile']} {field} mismatch: "
                f"{payload.get(field)!r} != {expected!r}"
            )


def _freeze(raw: bytes, variant: Variant) -> bytes:
    text = raw.decode("utf-8")
    if not text.endswith("\n"):
        raise ValueError(f"{variant.key} raw source must end with a newline")
    if text.count("kernel_flashkda_bf16_fused_m128(") != 1:
        raise ValueError(
            f"{variant.key} raw source must contain exactly one kernel signature"
        )
    if text.count("__nv_bfloat16* __restrict__ initial_state") != 1:
        raise ValueError(
            f"{variant.key} raw source has an unexpected initial_state signature"
        )
    if text.count("__nv_bfloat16* __restrict__ final_state") != 1:
        raise ValueError(
            f"{variant.key} raw source has an unexpected final_state signature"
        )
    if text.count("fence.proxy.tensormap::generic.acquire.sys") != 6:
        raise ValueError(
            f"{variant.key} raw source must contain six generated tensor-map acquires"
        )
    if text.count("    __syncthreads();") < 1:
        raise ValueError(
            f"{variant.key} raw source is missing its generated CTA barrier"
        )
    if f"#define SMEM_TOTAL {variant.smem_bytes}" not in text:
        raise ValueError(f"{variant.key} raw source has an unexpected SMEM_TOTAL")

    signature_start = text.index("kernel_flashkda_bf16_fused_m128(")
    signature_end = text.index("\n{", signature_start) + 1
    signature = text[signature_start:signature_end]
    alias_signature = signature.replace(
        "__nv_bfloat16* __restrict__ initial_state",
        "__nv_bfloat16* initial_state",
    ).replace(
        "__nv_bfloat16* __restrict__ final_state",
        "__nv_bfloat16* final_state",
    )
    if alias_signature == signature:
        raise ValueError(f"{variant.key} alias integration made no change")
    integrated = (
        text[:signature_start]
        + ALIAS_BEGIN
        + alias_signature
        + ALIAS_END
        + text[signature_end:]
    )

    provenance = (
        "// Frozen Cake export; do not edit by hand.\n"
        "// Provenance: generated Loom schedule 'flashkda_bf16_fused_m128'; "
        f"module {variant.module_ident}.\n"
        f"// Cake revision: {variant.cake_revision}; raw SHA-256: {variant.raw_sha256}.\n"
    )
    return (
        LICENSE_HEADER
        + "\n"
        + provenance
        + "// clang-format off\n"
        + integrated
        + "// clang-format on\n"
    ).encode("utf-8")


def _manifest(frozen: dict[str, bytes]) -> bytes:
    variants = {}
    for key, variant in VARIANTS.items():
        variants[key] = {
            "binding_path": f"csrc/kda/{variant.binding_filename}",
            "cake_revision": variant.cake_revision,
            "cake_tree": variant.cake_tree,
            "frozen_path": f"csrc/kda/{variant.frozen_filename}",
            "frozen_sha256": _sha256(frozen[key]),
            "module_ident": variant.module_ident,
            "raw_bytes": variant.raw_bytes,
            "raw_sha256": variant.raw_sha256,
            "smem_bytes": variant.smem_bytes,
        }
    payload = {
        "schema_version": 1,
        "cake_revision": CAKE_REVISION,
        "cake_tree": CAKE_TREE,
        "semantic_baseline_revision": SEMANTIC_BASELINE,
        "architecture_artifacts_are_separate": True,
        "generated_source_text_equal_across_architectures": True,
        "generated_invariants": [
            "six fence.proxy.tensormap::generic.acquire.sys operations",
            "CTA barrier after tensor-map acquisition",
        ],
        "integration_patches": [
            {
                "id": "allow_exact_state_alias",
                "reason": "the public recurrent API permits initial_state and final_state to alias exactly",
                "scope": [
                    "initial_state restrict qualifier",
                    "final_state restrict qualifier",
                ],
            }
        ],
        "profiles": PROFILES,
        "variants": variants,
    }
    return (json.dumps(payload, indent=2, sort_keys=True) + "\n").encode("utf-8")


def _write_or_check(path: Path, expected: bytes, check: bool) -> bool:
    if check:
        if not path.is_file() or path.read_bytes() != expected:
            print(f"out of date: {path}", file=sys.stderr)
            return False
        print(f"verified: {path}")
        return True
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_bytes(expected)
    print(f"wrote: {path}")
    return True


def _parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--sm100-n16-source", type=Path, required=True)
    parser.add_argument("--sm103-n16-source", type=Path, required=True)
    parser.add_argument("--sm100-n32-source", type=Path, required=True)
    parser.add_argument("--sm103-n32-source", type=Path, required=True)
    parser.add_argument("--sm100-n16-profile", type=Path, required=True)
    parser.add_argument("--sm103-n16-profile", type=Path, required=True)
    parser.add_argument("--sm100-n32-profile", type=Path, required=True)
    parser.add_argument("--sm103-n32-profile", type=Path, required=True)
    parser.add_argument(
        "--output-dir",
        type=Path,
        default=Path(__file__).resolve().parents[1] / "csrc" / "kda",
    )
    parser.add_argument("--check", action="store_true")
    return parser.parse_args()


def main() -> int:
    args = _parse_args()
    paths = {
        "sm100_n16": args.sm100_n16_source,
        "sm103_n16": args.sm103_n16_source,
        "sm100_n32": args.sm100_n32_source,
        "sm103_n32": args.sm103_n32_source,
    }
    profile_paths = {
        "sm100_n16": args.sm100_n16_profile,
        "sm103_n16": args.sm103_n16_profile,
        "sm100_n32": args.sm100_n32_profile,
        "sm103_n32": args.sm103_n32_profile,
    }
    raw: dict[str, bytes] = {}
    for profile_key, path in paths.items():
        profile = PROFILES[profile_key]
        variant = VARIANTS[profile["variant"]]
        _verify_profile(profile_paths[profile_key], profile, variant)
        raw[profile_key] = _read_verified(path, variant, profile["arch"])
    if raw["sm100_n16"] != raw["sm103_n16"]:
        raise ValueError("N16 SM100 and SM103 generated source text differs")
    if raw["sm100_n32"] != raw["sm103_n32"]:
        raise ValueError("N32 SM100 and SM103 generated source text differs")

    frozen = {
        "n16": _freeze(raw["sm100_n16"], VARIANTS["n16"]),
        "n32": _freeze(raw["sm100_n32"], VARIANTS["n32"]),
    }
    outputs = {
        args.output_dir / VARIANTS["n16"].frozen_filename: frozen["n16"],
        args.output_dir / VARIANTS["n32"].frozen_filename: frozen["n32"],
        args.output_dir / "flashkda_bf16_fused_m128_import_manifest.json": _manifest(
            frozen
        ),
    }
    matched = True
    for path, data in outputs.items():
        matched = _write_or_check(path, data, args.check) and matched
    return 0 if matched else 1


if __name__ == "__main__":
    raise SystemExit(main())
