"""Import or rehash a deterministic generated-program promotion."""

from __future__ import annotations

import argparse
import importlib.util
from pathlib import Path
import sys


REPOSITORY_ROOT = Path(__file__).resolve().parents[1]
MODULE_PATH = REPOSITORY_ROOT / "flashinfer" / "jit" / "generated_program_promotion.py"
SPEC = importlib.util.spec_from_file_location(
    "_flashinfer_program_promotion", MODULE_PATH
)
if SPEC is None or SPEC.loader is None:
    raise RuntimeError(f"could not load promotion importer from {MODULE_PATH}")
PROMOTION = importlib.util.module_from_spec(SPEC)
sys.modules[SPEC.name] = PROMOTION
SPEC.loader.exec_module(PROMOTION)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--manifest", type=Path, required=True)
    parser.add_argument("--payload-root", type=Path, required=True)
    parser.add_argument("--output-root", type=Path, required=True)
    parser.add_argument("--mode", choices=PROMOTION.MODES, required=True)
    parser.add_argument(
        "--check",
        action="store_true",
        help="rehash declared source and destination files without writing",
    )
    parser.add_argument(
        "--replace",
        action="store_true",
        help="atomically replace existing destination files",
    )
    args = parser.parse_args()
    if args.check and args.replace:
        parser.error("--check and --replace are mutually exclusive")
    try:
        manifest = PROMOTION.load_manifest(args.manifest)
        if args.check:
            PROMOTION.verify_promotion(
                manifest,
                payload_root=args.payload_root,
                output_root=args.output_root,
                mode=args.mode,
            )
            action = "verified"
        else:
            PROMOTION.import_promotion(
                manifest,
                payload_root=args.payload_root,
                output_root=args.output_root,
                mode=args.mode,
                replace=args.replace,
            )
            action = "imported"
    except PROMOTION.PromotionIntegrityError as exc:
        parser.exit(2, f"promotion integrity error: {exc}\n")
    print(
        f"{action} {len(manifest.artifacts)} {manifest.mode} artifacts "
        f"for {manifest.name}"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
