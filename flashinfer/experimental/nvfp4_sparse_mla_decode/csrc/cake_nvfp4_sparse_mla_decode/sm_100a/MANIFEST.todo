# Expected generated sources of the NVFP4 sparse MLA decode program for sm_100a.
# The generated-program export renders them; when they land, delete this file
# and fill the matching records of ../../../cake_jit.py (module, sources,
# closure_sha256).  Nothing in this directory is hand-written.
#
# One module per cluster size C in {1, 2, 3, 4, 5, 6, 8}.  <hash20> is the
# export's 20-hex-digit kernel digest.  Each binding declares the kernel
#   extern "C" __global__ void kernel_cake_nvfp4_sparse_mla_decode_<hash20>(...)
# and exports the tvm-ffi entry `run` with the argument order of
# cake_jit.ARG_PLAN:
#   run(q, kv, indices, out, topk, keys_per_cta, qk_scale, out_scale, grid_x, grid_y, grid_z)
#   q       int32 view of the E4M3 [T, 16, 576] query
#   kv      uint8 flat row pool (352 bytes per row)
#   indices int32 [T, topk], -1 = empty slot
#   out     bf16 [T, 16, 512]
#   topk, keys_per_cta  int64; qk_scale (= bmm1_scale * log2 e), out_scale (= bmm2_scale)  double
# launched with block (448, 1, 1), cluster (1, C, 1), dynamic shared memory
# 192064 bytes (C = 1) or 226624 bytes (C > 1), non-cooperative, grid (T, C, 1).
#
# registry key                                 C  expected files
cake_nvfp4_sparse_mla_decode_c1_sm_100a   1  cake_nvfp4_sparse_mla_decode_<hash20>_kernel.cu  cake_nvfp4_sparse_mla_decode_<hash20>_binding.cu
cake_nvfp4_sparse_mla_decode_c2_sm_100a   2  cake_nvfp4_sparse_mla_decode_<hash20>_kernel.cu  cake_nvfp4_sparse_mla_decode_<hash20>_binding.cu
cake_nvfp4_sparse_mla_decode_c3_sm_100a   3  cake_nvfp4_sparse_mla_decode_<hash20>_kernel.cu  cake_nvfp4_sparse_mla_decode_<hash20>_binding.cu
cake_nvfp4_sparse_mla_decode_c4_sm_100a   4  cake_nvfp4_sparse_mla_decode_<hash20>_kernel.cu  cake_nvfp4_sparse_mla_decode_<hash20>_binding.cu
cake_nvfp4_sparse_mla_decode_c5_sm_100a   5  cake_nvfp4_sparse_mla_decode_<hash20>_kernel.cu  cake_nvfp4_sparse_mla_decode_<hash20>_binding.cu
cake_nvfp4_sparse_mla_decode_c6_sm_100a   6  cake_nvfp4_sparse_mla_decode_<hash20>_kernel.cu  cake_nvfp4_sparse_mla_decode_<hash20>_binding.cu
cake_nvfp4_sparse_mla_decode_c8_sm_100a   8  cake_nvfp4_sparse_mla_decode_<hash20>_kernel.cu  cake_nvfp4_sparse_mla_decode_<hash20>_binding.cu
