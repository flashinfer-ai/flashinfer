import BIKernels.GEMM
import BIKernels.GEMMConfig
import BIKernels.Export
/-!
# MoE FFN on the bf16 GEMM class: the numerical specification and the batch-invariance guarantees

Mirrors `flashinfer/fused_moe/batch_invariant/spec.py` (the classes `moe.bf16.swiglu`, `moe.bf16.relu2` and the other
activation chains as class parameters). The MoE class is everything around two members of the GEMM class: per token
`t`, the router turns the logits into `k` slots `(expert, weight)`; the expert's GEMM1 accumulators `(g, u)` (opaque:
`gemm.bf16.kfold[K=H]`) feed the gated chain `a = cvt(glu_pre(g, u))` (`spec.glu_pre`: `mul(act(g), u)` for the
unparameterised activations, the clamped / scaled mixes of the two branches for FlashInfer's parameterised ones), or
the ungated chain `cvt(act(acc))` on one accumulator; the expert's GEMM2 output `y` (opaque: `gemm.bf16.kfold[K=I]`,
rounded to bf16) is folded over the slots in slot order, `acc_{r+1} = add(acc_r, mul(y_r, w_r))` from `+0`.

* `MTerm` is the term language of the class (the `mterm.TermAlgebra` primitives the MoE chains use: the exact `neg`,
  `fmin`, `fmax`, `fmaxc` (the zero rule's commutative clamp), `fabs`, `exp2i`, `frexpm` / `frexpe`, the rounded `div`
  and `sqrt`, the n-ary exact `rowmax`, the named coordinate leaves); `MTerm.sexpr` prints it textually as
  `mterm.sexpr` does (commutative operands sorted), so `MoECases.lean` (generated by
  `flashinfer/fused_moe/batch_invariant/lean_cases.py`) couples every definition below to the Python spec node for node
  (kernel `decide` on the chains, the `moeconformance` executable on the routing weights and the largest chains).
* `expT` is the **declared** exponential: a fixed sequence of correctly rounded `.rn` ops (clamp, nearest-integer shift,
  Cody-Waite reduction, Horner, exact power-of-two scale); every backend (device, exact CPU, vectorised CPU) computes
  this term and nothing else. `erfPosT` (Abramowitz-Stegun 7.1.26 on the declared exp) and `logT` (Cephes logf on the
  exact `frexpm` / `frexpe`) are the declared erf and log the GELU and PowLU chains stand on; `tanhT` is
  `2 sigmoid(2 z) - 1`.
* `GAct` / `UAct` are the activations as class parameters (`spec.ACTS` / `spec.UNGATED_ACTS`) with their binary32
  scalars as the printer's strings: a parameter is a constant of the term, so every value is its own class.
* `routingWeights` takes the selection as a parameter: the selection is the strict total order `(score desc, index asc)`
  on exact binary32 values, a data-dependent choice outside the term language (its determinism is the CPU-vs-device
  test); the *weights* of the chosen slots are terms.
* The launch model: a token's output is a function of its own row, its own slots and the weights (`tokenOut`); `launch`
  applies it to every token of a batch. Determinism, batch, permutation and sub-batch invariance are theorems by
  construction, as for the GEMM. The grouped GEMM model (`groupedRow`) erases the grouping: which rows share an expert's
  segment, how many (the expert load) and where a row sits inside it never enter the per-row fold, which is the dense
  class `kfold`. What stays empirical is that the kernels compute these terms: the device suite
  (`tests/moe/test_unified_moe_batch_invariant.py`) checks the routing, the activation chains and the combine bit for
  bit against the exact CPU evaluation of these terms, and the grouped kernel against the dense one.
-/
namespace BIK.MoE

/-- Dataflow terms of the MoE class. `leaf name coords` is an input or an opaque GEMM output (`(l e)` logit,
`(g r j)` / `(u r j)` GEMM1 accumulators, `(y r h)` GEMM2 output, `(w r)` a routing weight when it is kept symbolic);
`rowmax E` is the exact maximum of logits `0 .. E-1`. `fmin` / `fmax` are the order-preserving clamps (the operand
order decides the signed zero), `fmaxc` the commutative one with the device's zero rule; `frexpm` / `frexpe` are the
exact mantissa in `[1/2, 1)` and exponent of a magnitude, `sqrt` the correctly rounded square root. -/
inductive MTerm where
  | const (c : String)
  | sym (s : String)
  | leaf (name : String) (coords : List Nat)
  | add (a b : MTerm)
  | mul (a b : MTerm)
  | div (a b : MTerm)
  | neg (a : MTerm)
  | fmin (a b : MTerm)
  | fmax (a b : MTerm)
  | fmaxc (a b : MTerm)
  | fabs (a : MTerm)
  | sqrt (a : MTerm)
  | frexpm (a : MTerm)
  | frexpe (a : MTerm)
  | exp2i (a : MTerm)
  | rowmax (E : Nat)
  | cvt (fmt : String) (a : MTerm)
  deriving Repr, DecidableEq, Inhabited

/-! ## The printer (textually `mterm.sexpr`; `sortPair` is the GEMM export's) -/

def coordsStr : List Nat → String
  | [] => ""
  | c :: cs => s!" {c}{coordsStr cs}"

def logitsStr : Nat → Nat → String
  | _, 0 => ""
  | i, n+1 => s!" (l {i})" ++ logitsStr (i + 1) n

def MTerm.sexpr : MTerm → String
  | .const c => s!"(const {c})"
  | .sym s => s!"(sym {s})"
  | .leaf n cs => s!"({n}{coordsStr cs})"
  | .add a b => let (p, q) := sortPair a.sexpr b.sexpr; s!"(add {p} {q})"
  | .mul a b => let (p, q) := sortPair a.sexpr b.sexpr; s!"(mul {p} {q})"
  | .div a b => s!"(div {a.sexpr} {b.sexpr})"
  | .neg a => s!"(neg {a.sexpr})"
  | .fmin a b => s!"(fmin {a.sexpr} {b.sexpr})"
  | .fmax a b => s!"(fmax {a.sexpr} {b.sexpr})"
  | .fmaxc a b => let (p, q) := sortPair a.sexpr b.sexpr; s!"(fmaxc {p} {q})"
  | .fabs a => s!"(fabs {a.sexpr})"
  | .sqrt a => s!"(sqrt {a.sexpr})"
  | .frexpm a => s!"(frexpm {a.sexpr})"
  | .frexpe a => s!"(frexpe {a.sexpr})"
  | .exp2i a => s!"(exp2i {a.sexpr})"
  | .rowmax E => "(rowmax" ++ logitsStr 0 E ++ ")"
  | .cvt f a => s!"(cvt {f} {a.sexpr})"

/-! ## The declared exp, sigmoid, silu, tanh, erf, log and the GEMM1 chains (`spec.exp_term`, `sigmoid_term`,
`silu_term`, `swiglu_elem`, `gelu_tanh_term`, `tanh_term`, `erf_pos_term`, `gelu_term`, `log_term`, `glu_pre` /
`glu_elem`, `ungated_term` / `act_elem`)

Every constant is a `String`: Python's `repr` of the binary32 value (`fp32.to_f32`), exactly as `mterm.sexpr` prints
it; the generated cases check every spelling. -/

def c (s : String) : MTerm := .const s

/-- `spec.EXP_COEFFS` as Python prints the binary32 values (`repr(float(c))`), highest degree first; the chain is
`p = c0; p = add(mul(p, r), c_i)`. -/
def expCoeffsTail : List String :=
  ["0.001398199936375022", "0.008333452045917511", "0.04166579619050026", "0.1666666567325592", "0.5", "1.0", "1.0"]

/-- `spec._horner`: `p = add(mul(p, r), c_i)` over the coefficients after the leading one. -/
def horner (r : MTerm) : List String → MTerm → MTerm
  | [], p => p
  | s :: rest, p => horner r rest (.add (.mul p r) (c s))

/-- `exp(x)`: clamp to `[-87, 88]`, `kf = round_nearest(x log2e)` through the `1.5 * 2^23` shift,
`r = x - kf ln2_hi - kf ln2_lo`, the Horner polynomial, times the exact `2^kf`. -/
def expT (x : MTerm) : MTerm :=
  let xc := MTerm.fmax (.fmin x (c "88.0")) (c "-87.0")
  let t := MTerm.add (.mul xc (c "1.4426950216293335")) (c "12582912.0")
  let kf := MTerm.add t (c "-12582912.0")
  let r1 := MTerm.add xc (.mul kf (c "-0.693359375"))
  let r := MTerm.add r1 (.mul kf (c "0.00021219444170128554"))
  .mul (horner r expCoeffsTail (c "0.00019875691214110702")) (.exp2i kf)

def sigmoidT (x : MTerm) : MTerm := .div (c "1.0") (.add (c "1.0") (expT (.neg x)))

def siluT (g : MTerm) : MTerm := .div g (.add (c "1.0") (expT (.neg g)))

/-- The GEMM1 epilogue chain of the SwiGLU class: `cvt_bf16(mul(silu(g), u))` from the two fp32 accumulators. -/
def swigluT (g u : MTerm) : MTerm := .cvt "bf16" (.mul (siluT g) u)

/-- `gelu_tanh(x) = x * sigmoid(2 y)`, `y = C1 (x + C2 x^3)` (the `0.5 (1 + tanh y) = sigmoid(2y)` identity; the
binary32 constants as Python prints them). -/
def geluTanhT (x : MTerm) : MTerm :=
  let x3 := MTerm.mul x (.mul x x)
  let y := MTerm.mul (c "0.7978845834732056") (.add x (.mul (c "0.044714998453855515") x3))
  .mul x (sigmoidT (.mul (c "2.0") y))

/-- `tanh(z) = 2 sigmoid(2 z) - 1` with the declared sigmoid (`spec.tanh_term`): saturates exactly at `±1` through the
exp clamp. -/
def tanhT (z : MTerm) : MTerm := .add (.mul (c "2.0") (sigmoidT (.mul (c "2.0") z))) (c "-1.0")

/-- `spec.ERF_COEFFS` after the leading `a5` (Horner order `a5 .. a1`), as Python prints the binary32 values. -/
def erfCoeffsTail : List String :=
  ["-1.453152060508728", "1.421413779258728", "-0.2844967246055603", "0.2548295855522156"]

/-- The declared erf of `a >= 0` (`spec.erf_pos_term`: Abramowitz-Stegun 7.1.26 with the declared exp):
`1 - t p(t) exp(-a^2)`, `t = 1 / (1 + P a)`. -/
def erfPosT (a : MTerm) : MTerm :=
  let t := MTerm.div (c "1.0") (.add (c "1.0") (.mul (c "0.32759109139442444") a))
  let e := expT (.neg (.mul a a))
  .add (c "1.0") (.neg (.mul (.mul t (horner t erfCoeffsTail (c "1.0614054203033447"))) e))

/-- `gelu(x) = 0.5 (x + |x| erf(|x| / sqrt 2))` (`spec.gelu_term`: the exact GELU's form written on `|x|`, the
declared erf; `1 / sqrt 2` as Python prints the binary32 value). -/
def geluT (x : MTerm) : MTerm :=
  let ax := MTerm.fabs x
  let y := erfPosT (.mul ax (c "0.7071067690849304"))
  .mul (c "0.5") (.add x (.mul ax y))

/-- `spec.LOG_COEFFS` after the leading coefficient (Cephes logf, highest degree first). -/
def logCoeffsTail : List String :=
  ["-0.11514610052108765", "0.11676998436450958", "-0.12420140951871872", "0.14249323308467865",
   "-0.16668057441711426", "0.2000071406364441", "-0.24999994039535522", "0.3333333134651184"]

/-- `spec.HUGE` (`2^100`) as Python prints it: the exact scale of a sign or a positive part into a clamp's saturation
range. -/
def hugeC : String := "1.2676506002282294e+30"

/-- The declared natural log of a positive `x` (`spec.log_term`, Cephes logf): a positive subnormal `x` is first scaled
into the normal range by the exact select `sub = clamp((2^-126 - x) 2^100 2^100, 0, 1)` (`x' = mul(x, add(1, mul(sub,
2^24 - 1)))`, the exponent takes `mul(sub, -24)` back), then `x' = m 2^e` through the exact `frexpm` / `frexpe`, the
exact select `lt = clamp((sqrt(1/2) - m) 2^100, 0, 1)` recentres `m` into `z = m + lt m - 1` and `e' = e - lt`;
`z + (z^3 P(z) + e' ln2_lo - z^2 / 2) + e' ln2_hi`. -/
def logT (x : MTerm) : MTerm :=
  let sub := MTerm.fmax (.fmin (.mul (.mul (.add (c "1.1754943508222875e-38") (.neg x)) (c hugeC)) (c hugeC)) (c "1.0")) (c "0.0")
  let xn := MTerm.mul x (.add (c "1.0") (.mul sub (c "16777215.0")))
  let m := MTerm.frexpm xn
  let ex := MTerm.add (.frexpe xn) (.mul sub (c "-24.0"))
  let lt := MTerm.fmax (.fmin (.mul (.add (c "0.7071067690849304") (.neg m)) (c hugeC)) (c "1.0")) (c "0.0")
  let z := MTerm.add (.add m (.mul lt m)) (c "-1.0")
  let ex := MTerm.add ex (.neg lt)
  let z2 := MTerm.mul z z
  let y := MTerm.mul (.mul z2 z) (horner z logCoeffsTail (c "0.07037683576345444"))
  let y := MTerm.add y (.mul ex (c "-0.00021219444170128554"))
  let y := MTerm.add y (.mul z2 (c "-0.5"))
  .add (.add z y) (.mul ex (c "0.693359375"))

/-- `spec._clamp_sym`: `fmin(fmax(u, -limit), limit)`. `limit` is the printer's string of the positive binary32 limit;
Python prints its negation as `-` followed by the same digits. -/
def clampSymT (u : MTerm) (limit : String) : MTerm := .fmin (.fmax u (c ("-" ++ limit))) (c limit)

/-- The gated activations (`spec.ACTS`) with their scalars (`spec.ACT_PARAMS`) as the printer's binary32 strings:
FlashInfer's `SwiGLU` with other than the default scalars (`alpha`, `beta`, `limit`), `SwiGLUStep` (`limit`), `SiTU`
(`gate_scale`, the optional `linear_scale` and `clamp_limit`), `PowLU` (`m`, the optional `limit`). `none` is the scalar
the config leaves out (no clamp, no scale, no limit): the term lacks it. -/
inductive GAct where
  | silu
  | geluTanh
  | gelu
  | swigluOai (alpha beta limit : String)
  | swigluStep (limit : String)
  | situ (gateScale : String) (linearScale clampLimit : Option String)
  | powlu (m : String) (limit : Option String)
  deriving Repr, DecidableEq

/-- The gated activation before any rounding, in fp32, on the (gate, up) accumulator pair (`spec.glu_pre`):

* `silu` / `geluTanh` / `gelu`: `mul(act(g), u)` (`spec.act_term`: the activation of the gate alone);
* `swigluOai alpha beta limit`: `g' = fmin(g, limit)`, `u' = clamp(u, ±limit)`,
  `mul(mul(g', sigmoid(mul(alpha, g'))), add(u', beta))`;
* `swigluStep limit`: `mul(fmin(silu(g), limit), clamp(u, ±limit))`;
* `situ gs ls cl`: the optional clamps first (`fmin(g, cl)`, `clamp(u, ±cl)`), then
  `mul(mul(mul(gs, tanh(div(g, gs))), sigmoid(g)), mul(ls, tanh(div(u, ls))))` (`u` as is without a linear scale);
* `powlu m limit`: `gp = fmaxc(g, 0)`, `e = div(m, add(sqrt(gp), 1))`, `pos = fmin(exp(mul(e, log(gp))), mul(gp, 2^100))`
  (zero exactly at `gp = 0`), `a = mul(add(pos, fmin(g, 0)), sigmoid(g))`, then `mul(a, u)`, or `fmin(a, limit)` times
  `clamp(u, ±limit)` when a limit is given. -/
def gluPreT : GAct → MTerm → MTerm → MTerm
  | .silu, g, u => .mul (siluT g) u
  | .geluTanh, g, u => .mul (geluTanhT g) u
  | .gelu, g, u => .mul (geluT g) u
  | .swigluOai alpha beta limit, g, u =>
    let gl := MTerm.fmin g (c limit)
    .mul (.mul gl (sigmoidT (.mul (c alpha) gl))) (.add (clampSymT u limit) (c beta))
  | .swigluStep limit, g, u => .mul (.fmin (siluT g) (c limit)) (clampSymT u limit)
  | .situ gs ls cl, g, u =>
    let g := match cl with | some cl => MTerm.fmin g (c cl) | none => g
    let u := match cl with | some cl => clampSymT u cl | none => u
    let gt := MTerm.mul (.mul (c gs) (tanhT (.div g (c gs)))) (sigmoidT g)
    let ut := match ls with | some ls => MTerm.mul (c ls) (tanhT (.div u (c ls))) | none => u
    .mul gt ut
  | .powlu m limit, g, u =>
    let gp := MTerm.fmaxc g (c "0.0")
    let e := MTerm.div (c m) (.add (.sqrt gp) (c "1.0"))
    let pos := MTerm.fmin (expT (.mul e (logT gp))) (.mul gp (c hugeC))
    let a := MTerm.mul (.add pos (.fmin g (c "0.0"))) (sigmoidT g)
    match limit with
    | none => .mul a u
    | some limit => .mul (.fmin a (c limit)) (clampSymT u limit)

/-- The gated GEMM1 chain (`spec.glu_elem(..., "bf16")`): `cvt_bf16(glu_pre(g, u))`; `swigluT` at `.silu`. -/
def gluT (a : GAct) (g u : MTerm) : MTerm := .cvt "bf16" (gluPreT a g u)

theorem gluT_silu_is_swiglu (g u : MTerm) : gluT .silu g u = swigluT g u := rfl

/-- The unparameterised gated chains activate the gate alone and multiply by `u` (`spec.act_term`). -/
theorem gluPreT_gelu_tanh (g u : MTerm) : gluPreT .geluTanh g u = .mul (geluTanhT g) u := rfl
theorem gluPreT_gelu (g u : MTerm) : gluPreT .gelu g u = .mul (geluT g) u := rfl

/-- `SwiGLUStep` is the SiLU chain with the activation capped and the linear branch clamped at the same limit. -/
theorem gluPreT_swiglu_step (l : String) (g u : MTerm) :
    gluPreT (.swigluStep l) g u = .mul (.fmin (siluT g) (c l)) (clampSymT u l) := rfl

/-- The ungated activations on one accumulator (`spec.UNGATED_ACTS`; none takes parameters). -/
inductive UAct where
  | relu2
  | identity
  | relu
  | silu
  | gelu
  deriving Repr, DecidableEq

/-- `spec.ungated_term`: ReLU^2 (`mul(r, r)`, `r = fmax(x, 0)`), the identity, ReLU as `fmaxc(x, 0)` (the device's zero
rule: a `-0` accumulator gives `+0`), SiLU, GELU. -/
def ungatedT : UAct → MTerm → MTerm
  | .relu2, x => .mul (.fmax x (c "0.0")) (.fmax x (c "0.0"))
  | .identity, x => x
  | .relu, x => .fmaxc x (c "0.0")
  | .silu, x => siluT x
  | .gelu, x => geluT x

/-- The ungated GEMM1 chain (`spec.act_elem(..., "bf16")`): `cvt_bf16(act(acc))`, one accumulator. -/
def actElemT (a : UAct) (x : MTerm) : MTerm := .cvt "bf16" (ungatedT a x)

/-- The ReLU^2 class's chain (`spec.act_elem`, act `relu2`): `cvt_bf16(mul(r, r))` with `r = fmax(acc, 0)`. -/
def relu2T (x : MTerm) : MTerm := .cvt "bf16" (.mul (.fmax x (c "0.0")) (.fmax x (c "0.0")))

theorem actElemT_relu2_is_relu2T (x : MTerm) : actElemT .relu2 x = relu2T x := rfl

/-- The ungated chain is the square of the clamp: no second accumulator, no exp. -/
theorem relu2T_is_square_of_clamp (x : MTerm) :
    relu2T x = .cvt "bf16" (.mul (.fmax x (c "0.0")) (.fmax x (c "0.0"))) := rfl

/-- The identity chain is the bare conversion of the accumulator. -/
theorem actElemT_identity (x : MTerm) : actElemT .identity x = .cvt "bf16" x := rfl

/-! ## Routing (`spec.softmax_reduction`, `per_expert_scores`, `slot_weights`) -/

/-- `canon._pairwise` with absent leaves dropped. -/
def oaddM : Option MTerm → Option MTerm → Option MTerm
  | none, b => b
  | some a, none => some a
  | some a, some b => some (.add a b)

/-- The canonical pairwise tree over `2^n` consecutive leaves from `base` (adjacent pairs first). -/
def mtree : Nat → (Nat → Option MTerm) → Nat → Option MTerm
  | 0, f, base => f base
  | n+1, f, base => oaddM (mtree n f base) (mtree n f (base + 2 ^ n))

/-- `log2(pow2ceil E)`: the bits of the `expert` digit. -/
def bitsFor (E : Nat) : Nat := Nat.log2 (2 * E - 1)

/-- `z_e = exp(add(l_e, neg(rowmax)))`. -/
def softmaxZ (E e : Nat) : MTerm := expT (.add (.leaf "l" [e]) (.neg (.rowmax E)))

/-- `S`: the `expert` digit's pairwise tree over `pow2ceil(E)` leaves, experts `>= E` absent. -/
def softmaxSum (E : Nat) : MTerm :=
  (mtree (bitsFor E) (fun e => if e < E then some (softmaxZ E e) else none) 0).getD (c "0.0")

def softmaxP (E e : Nat) : MTerm := .div (softmaxZ E e) (softmaxSum E)

/-- `spec.RoutingMethod`: `softmax` (weights = probabilities), sigmoid (weights = the unbiased sigmoid; a selection
bias never enters a weight term) or `raw` (weights = the logits themselves: the `TopK` method; `topk_sigmoid` has the
sigmoid weights with a selection on the logits); renormalisation; scaling. The selection-only features (what the k slots
are chosen on; the group-limited stage) are not fields: they change `selected`, never a weight term
(`routingWeights_selection_only`). -/
structure Method where
  softmax : Bool := true
  renorm : Bool := true
  scaled : Bool := false
  raw : Bool := false
  deriving Repr, DecidableEq

def weightOf (m : Method) (E e : Nat) : MTerm :=
  if m.raw then .leaf "l" [e] else if m.softmax then softmaxP E e else sigmoidT (.leaf "l" [e])

/-- `spec.biased_score_term`: the sigmoid methods' selection score with a bias, `add(sigmoid(l_e), b_e)`. -/
def biasedScoreT (e : Nat) : MTerm := .add (sigmoidT (.leaf "l" [e])) (.leaf "b" [e])

/-- `spec.group_score_term`: the group-limited stage's score of a group whose two largest biased scores are
experts `a` and `b` -- one `add` (commutative in the printer: the order of the two is immaterial). -/
def groupScoreT (a b : Nat) : MTerm := .add (biasedScoreT a) (biasedScoreT b)

/-- `spec.slot_weights`: `S_k = fold_r add(acc, w_r)` from `+0` in slot order, `w_r / S_k`; then `w_r * scale`. -/
def slotWeights (m : Method) (ws : List MTerm) : List MTerm :=
  let ws := if m.renorm then
      let acc := ws.foldl (fun a w => MTerm.add a w) (c "0.0")
      ws.map (fun w => MTerm.div w acc)
    else ws
  if m.scaled then ws.map (fun w => MTerm.mul w (.sym "scale")) else ws

/-- The k routing weights of the selected experts (in slot order). -/
def routingWeights (m : Method) (E : Nat) (selected : List Nat) : List MTerm :=
  slotWeights m (selected.map (weightOf m E))

/-- The weight terms depend on the selected experts and the method's weight features only: a method that
selects differently (on the logits instead of their sigmoid, or through the group-limited stage) with the
same weight features has the same weight terms for the same `selected`. -/
theorem routingWeights_selection_only (m : Method) (E : Nat) (selected : List Nat) :
    routingWeights m E selected = slotWeights m (selected.map (weightOf m E)) := rfl

/-! ## The combine (`spec.combine_reduction` / `combine_elem`) -/

/-- `cvt( fold_{r in slot order} add(acc, mul(y_r, w_r)) )` from `+0`. -/
def combineT (ys ws : List MTerm) : MTerm :=
  .cvt "bf16" ((ys.zip ws).foldl (fun acc yw => MTerm.add acc (.mul yw.1 yw.2)) (c "0.0"))

/-- The slot fold without the final conversion. -/
def slotFold (ys ws : List MTerm) : MTerm :=
  (ys.zip ws).foldl (fun acc yw => MTerm.add acc (.mul yw.1 yw.2)) (c "0.0")

theorem combineT_eq_cvt_slotFold (ys ws : List MTerm) : combineT ys ws = .cvt "bf16" (slotFold ys ws) := rfl

/-- **The fold is in slot order** (the spec's decision): swapping two slots is a different dataflow. -/
theorem combine_slot_order_matters :
    combineT [.leaf "y" [0], .leaf "y" [1]] [.leaf "w" [0], .leaf "w" [1]]
      ≠ combineT [.leaf "y" [1], .leaf "y" [0]] [.leaf "w" [1], .leaf "w" [0]] := by
  simp [combineT, c, List.zip, List.zipWith, List.foldl]

/-! ## The launch model: determinism and batch invariance by construction -/

/-- A token's own inputs: its row, its `k` slots (expert, routing weight term). -/
structure Token where
  row : GEMM.RowData
  slots : List (Nat × MTerm)
  deriving DecidableEq

/-- The expert weights, opaque. -/
structure Weights where
  id : Nat
  deriving DecidableEq

/-- One token's output element `h`: the slot fold over the opaque expert outputs `y(e, h)` of the token's row,
weighted by the token's routing weights. It takes the token and the weights and nothing else: no batch, no expert
load, no position inside a group. -/
def tokenOut (W : Weights) (tok : Token) (h : Nat) : MTerm :=
  combineT (tok.slots.map (fun s => MTerm.leaf "y" [W.id, tok.row.id, s.1, h])) (tok.slots.map (·.2))

def launch (M : Nat) (toks : Fin M → Token) (W : Weights) (h : Nat) (i : Fin M) : MTerm :=
  tokenOut W (toks i) h

/-- **Determinism** at the model level: evaluation is a function. -/
theorem determinism (W : Weights) (tok : Token) (h : Nat) : tokenOut W tok h = tokenOut W tok h := rfl

/-- **Batch invariance**: equal tokens give equal outputs whatever the batch size, position or the other tokens
(hence whatever the expert loads the other tokens create). -/
theorem batch_invariance (W : Weights) (h : Nat) {M₁ M₂ : Nat} (t₁ : Fin M₁ → Token) (t₂ : Fin M₂ → Token)
    (i₁ : Fin M₁) (i₂ : Fin M₂) (heq : t₁ i₁ = t₂ i₂) : launch M₁ t₁ W h i₁ = launch M₂ t₂ W h i₂ := by
  simp only [launch, heq]

/-- **Permutation invariance**: permuting the tokens permutes the outputs. -/
theorem permutation_invariance (W : Weights) (h : Nat) {M : Nat} (toks : Fin M → Token) (σ : Fin M → Fin M) (i : Fin M) :
    launch M (toks ∘ σ) W h i = launch M toks W h (σ i) := rfl

/-- **Sub-batch invariance**: any selection of tokens reproduces exactly those tokens' outputs. -/
theorem subbatch_invariance (W : Weights) (h : Nat) {M n : Nat} (toks : Fin M → Token) (sel : Fin n → Fin M) (i : Fin n) :
    launch n (toks ∘ sel) W h i = launch M toks W h (sel i) := rfl

/-! ## The grouped GEMM: a placement of the dense class -/

/-- The grouped kernel's result for expanded row `p` of expert `e`: the dense K-fold of the row's data and the expert's
column. `grouping` (which expert segment a row belongs to and its offset), `load` (tokens per expert) and `pos` (the
row's position inside the segment) are the placement the scheduler and the permutation choose; they are erased, which
is the claim: no fold step reads them. -/
def groupedRow (_grouping : Nat → Nat × Nat) (_load : Nat → Nat) (_pos : Nat → Nat)
    (a : GEMM.RowData) (b : GEMM.ColData) (steps : Nat) : GEMM.GTerm :=
  GEMM.kfold a b steps

/-- **Grouped == standalone.** Every row of the grouped GEMM is the dense class `kfold`. -/
theorem grouped_eq_dense (grouping : Nat → Nat × Nat) (load pos : Nat → Nat) (a : GEMM.RowData) (b : GEMM.ColData) (steps : Nat) :
    groupedRow grouping load pos a b steps = GEMM.kfold a b steps := rfl

/-- **Expert-load, grouping and position independence**: two launches that differ in how tokens are distributed over
experts, how many share an expert and in what order give the same row. -/
theorem grouped_placement_irrelevant (g₁ g₂ : Nat → Nat × Nat) (l₁ l₂ p₁ p₂ : Nat → Nat)
    (a : GEMM.RowData) (b : GEMM.ColData) (steps : Nat) :
    groupedRow g₁ l₁ p₁ a b steps = groupedRow g₂ l₂ p₂ a b steps := rfl

/-- The grouped kernel restarts the accumulator per tile, so a persistent CTA's previous tile leaves no trace: the same
statement as the dense `tileResult_reset`, through the dense model. -/
theorem grouped_tile_reset (cfg : GEMM.Config) (S : Nat) (prev₁ prev₂ : GEMM.GTerm) (a : GEMM.RowData) (b : GEMM.ColData) (kb nblk : Nat) :
    GEMM.tileResult cfg S prev₁ a b kb nblk = GEMM.tileResult cfg S prev₂ a b kb nblk :=
  GEMM.tileResult_reset cfg S prev₁ prev₂ a b kb nblk

/-! ## The swapped records: a second placement space of the grouped GEMM

The swapped body (`fused_moe/batch_invariant/blocks/swap_bf16.py`) computes `Cᵀ` per expert: the expert's weight rows on the
MMA's M side (128 rows per CTA, or 64) and the group's tokens on its N side as a narrow tile of 8 / 16 / 32 rows. The tcgen05 step
folds the same K sequence per output element whichever operand carries the token, so every output element is the dense
class's `kfold` of the row's data and the expert's column: the swapped records are placements (`groupedRow` erases the
orientation with the grouping), and the dispatcher ranks them with the grouped records. The predicate mirrors
`blocks/swap_bf16.is_swapped_record`; the space is the three token tiles of the 128-row weight tile and the two wider ones of
the 64-row tile. -/

/-- A swapped record of the bf16 classes: the swapped 1-CTA record at 128 weight rows and a narrow token tile (8 / 16 / 32) or
at 64 weight rows and a token tile of 16 / 32, no cluster, swizzle 1, no in-cluster split, no in-CTA chunk fold. -/
def swappedOK (cfg : GEMM.Config) : Bool :=
  cfg.swapAb && ((cfg.tm == 128 && (cfg.tn == 8 || cfg.tn == 16 || cfg.tn == 32)) || (cfg.tm == 64 && (cfg.tn == 16 || cfg.tn == 32))) &&
  cfg.clusterM == 1 && cfg.clusterN == 1 && !cfg.twoCta && cfg.swizzle == 1 && cfg.clusterK == 1 && !cfg.ctaChunks

/-- The swapped record space (`schedule.swapped_knobs`): one record per (weight tile, token tile), raster along the token tiles. -/
def swappedSpace : List GEMM.Config :=
  [⟨128, 8, 1, 1, false, true, 1, false, 1, true⟩, ⟨128, 16, 1, 1, false, true, 1, false, 1, true⟩, ⟨128, 32, 1, 1, false, true, 1, false, 1, true⟩,
   ⟨64, 16, 1, 1, false, true, 1, false, 1, true⟩, ⟨64, 32, 1, 1, false, true, 1, false, 1, true⟩]

theorem swapped_space_size : swappedSpace.length = 5 := by decide
theorem swapped_space_ok : swappedSpace.all swappedOK = true := by decide

/-- The swapped records are disjoint from the dense records (the swapped flag): no record is in both spaces. -/
theorem swapped_not_dense (cfg : GEMM.Config) (h : swappedOK cfg = true) : GEMM.ConfigOK cfg = false := by
  cases hs : cfg.swapAb with
  | false => simp [swappedOK, hs] at h
  | true => simp [GEMM.ConfigOK, hs]

/-- **Every record of either space computes the same tile**: a swapped record's tile result is any dense record's (the
dense class's configuration erasure, `GEMM.config_invariance`), so the two spaces together are one guarantee space. -/
theorem swapped_eq_dense (c₁ c₂ : GEMM.Config) (S₁ S₂ : Nat) (p q : GEMM.GTerm) (a : GEMM.RowData) (b : GEMM.ColData) (kb nblk : Nat) :
    GEMM.tileResult c₁ S₁ p a b kb nblk = GEMM.tileResult c₂ S₂ q a b kb nblk :=
  GEMM.config_invariance c₁ c₂ S₁ S₂ p q a b kb nblk

theorem swapped_space_invariant : ∀ c₁ ∈ swappedSpace, ∀ c₂ ∈ swappedSpace, ∀ (S₁ S₂ : Nat) (p q : GEMM.GTerm) (a : GEMM.RowData) (b : GEMM.ColData) (kb nblk : Nat),
    GEMM.tileResult c₁ S₁ p a b kb nblk = GEMM.tileResult c₂ S₂ q a b kb nblk :=
  GEMM.space_invariant swappedSpace

/-! ## The gate/up interleave is a row permutation of the weight -/

/-- Column `c` of the interleaved GEMM1 output (`api.interleave_fc1`: `u_0..u_7, g_0..g_7, ...`): the up value of
intermediate column `j` is at `16 (j / 8) + j % 8`, its gate at `+ 8`. A permutation of B's rows moves no arithmetic:
the accumulator of column `c` is the dense fold of the row with B's row `c`. -/
def upCol (j : Nat) : Nat := 16 * (j / 8) + j % 8
def gateCol (j : Nat) : Nat := upCol j + 8

theorem interleave_pairs_adjacent_blocks (j : Nat) : gateCol j = upCol j + 8 := rfl

end BIK.MoE
