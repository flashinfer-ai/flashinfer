import BIKernels.Attention
import BIKernels.Canon
import BIKernels.Support

/-!
# Sparse latent (MLA) attention: the classes `mla.sparse.<bf16|e4m3>.d512[r64]`

Mirrors `flashinfer/mla/batch_invariant/spec.py` and `config.py`. A row is one (request, query token, head) with a compacted list of `n` selected cache rows; the row's identity is the leaf index of its query slices and the list position the leaf index of its cache slices, so the model is per row and every theorem quantifies over every row. Per row and output column `d`:

* the score of list position `j`: the GEMM's `kfold` of `D / 16` opaque `mma16` steps from `+0` (`ATerm.score`);
* tile `t` holds positions `[128 t, 128 t + 128)`, position `k = 8 b + 2 c + e` inside it. Its state `(m, l, O[d])` is built from nothing but the tile (`tileState`): `m` and `l` are pairwise trees over the three digits `e` (1 bit, innermost), `b` (4 bits), `c` (2 bits) with absent positions dropped (`reduceKeys`, the attention class's `ptree` over the leaves in combine order), `p_k = ex2(fma(s_k, c, mul(m, nc)))`, and `O` is the attention class's PV fold from `+0`;
* the row is the fold of its tiles in ascending order from the init state with the attention class's `merge` (`rowState`);
* the epilogue `cvt_bf16(add(mul(mul(O, div(1, l)), s2), +0))`; a row with `n = 0` is `cvt_bf16(+0)`.

The e4m3 members are the same dataflow with every operand leaf (the query slice and the cache slice of a score step, the V slice of a PV step) read through the exact opaque `cvt_e4m3_bf16`: the model is one definition for both formats, and the format only selects the leaf printer (`sexprF`; `skeleton_format_irrelevant`).

What is proved: the key reductions under the kernel's placement and under every factorisation of the three digits are the canonical tree (the Canon engine, instantiated; `reduceKeys_canonical` identifies the model's tree with the engine's and `key_plan_prints` carries the engine statement to the printed term), the fixup fold over an index-addressed workspace and the in-kernel fold are the row term for every partition of the tiles into units and every unit order, the launch model (R1, R2, R4) and configuration invariance (R3) on the record of `config.py`. What is not modelled, and is covered by the hardware tests: the plumbing (gather, TMA, barriers), the instruction semantics (`mma16`, `ex2`, `cvt_e4m3_bf16`) and the kernel's identity steps on absent positions.

`SparseMLACases.lean` (generated by `python -m flashinfer.mla.batch_invariant.lean_cases`) checks the Python spec's terms node for node and the configuration space record by record.
-/
namespace BIK.SparseMLA
open BIK.GEMM BIK.Attn

/-! ## The operand format and the printers -/

inductive Fmt where
  | bf16
  | e4m3
  deriving DecidableEq, Repr

/-- The e4m3 score: `ATerm.score` with both operand slices of every step under `cvt_e4m3_bf16`. -/
def scoreE (row k : Nat) : Nat → String
  | 0 => "(const 0.0)"
  | t+1 => s!"(mma16 {scoreE row k t} (ab (op:cvt_e4m3_bf16 (a {row} {t})) (op:cvt_e4m3_bf16 (b {t} {k}))))"

/-- `ATerm.sexpr` with the three operand leaves (query slice, cache slice, V slice) under `cvt_e4m3_bf16`. -/
def sexprE : ATerm → String
  | .const c => s!"(const {c})"
  | .sym s => s!"(sym {s})"
  | .score row k steps => scoreE row k steps
  | .add a b => let (p, q) := sortPair (sexprE a) (sexprE b); s!"(add {p} {q})"
  | .mul a b => let (p, q) := sortPair (sexprE a) (sexprE b); s!"(mul {p} {q})"
  | .fma a b c => let (p, q) := sortPair (sexprE a) (sexprE b); s!"(fma {p} {q} {sexprE c})"
  | .div a b => s!"(div {sexprE a} {sexprE b})"
  | .fmax a b => let (p, q) := sortPair (sexprE a) (sexprE b); s!"(fmax {p} {q})"
  | .ex2 a => s!"(ex2 {sexprE a})"
  | .cvt f a => s!"(cvt {f} {sexprE a})"
  | .mma acc ps vt d => s!"(mma16 {sexprE acc} (op:pv_kslice (op:p_slice{ps}) (op:cvt_e4m3_bf16 (op:v_slice {vt} {d}))))"

/-- The printer of a member: the attention class's for bf16, the wrapped-leaf one for e4m3. -/
def sexprF : Fmt → ATerm → String
  | .bf16 => ATerm.sexpr
  | .e4m3 => sexprE

theorem sexprF_bf16 (t : ATerm) : sexprF .bf16 t = t.sexpr := rfl

/-! ## The key digits: `k = 8 b + 2 c + e`, combined `e`, then `b`, then `c` -/

/-- Bits per digit in combine order (`spec.KEY_DIGITS`: radices 2, 16, 4). -/
def keyDigits : List Nat := [1, 4, 2]

/-- The position of the leaf with combine-order bits `e ++ b ++ c` (`spec.key_of`). -/
def keyOfBits (bs : List Bool) : Nat :=
  8 * bitsToNat (takeN 4 (dropN 1 bs)) + 2 * bitsToNat (dropN 5 bs) + bitsToNat (takeN 1 bs)

/-- The `2^n` leaves of a bit-indexed function, in little-endian index order. -/
def leavesL {α : Type} : Nat → (List Bool → α) → List α
  | 0, g => [g []]
  | n+1, g => leavesL n (fun bs => g (bs ++ [false])) ++ leavesL n (fun bs => g (bs ++ [true]))

def combA : Comb → ATerm → ATerm → ATerm
  | .add => ATerm.add
  | .fmaxc => ATerm.fmax

/-- `Reduction.canonical` of a key reduction: the attention class's pairwise tree over the leaves in combine order. -/
def reduceKeys (cb : Comb) (leaf : Nat → Option ATerm) : Option ATerm :=
  ptree (combA cb) 7 (leavesL 7 (fun bs => leaf (keyOfBits bs)))

/-! ## The row and its tiles -/

/-- One row's fixed data: `steps = D_qk / 16`, the list length `n`, the row id of the query leaves, the column `d`. -/
structure Params where
  steps : Nat
  n : Nat
  row : Nat
  d : Nat

/-- `spec.n_tiles`: a function of the row's own list length only. -/
def nTiles (n : Nat) : Nat := (n + 127) / 128

/-- The score of position `k` of tile `t`, absent past the list. -/
def scoreOf (P : Params) (t k : Nat) : Option ATerm :=
  if t * 128 + k < P.n then some (.score P.row (t * 128 + k) P.steps) else none

/-- `p_k = ex2(fma(s_k, c, mul(m, nc)))`. -/
def probOf (m : ATerm) (s : Option ATerm) : Option ATerm := s.map (fun s => .ex2 (.fma s c (.mul m nc)))

/-- `Attn.pvFold` with the member's leaf printer for the P slices. -/
def pvFoldF (pr : ATerm → String) (o0 : ATerm) (pbf : List ATerm) (vt0 d : Nat) : ATerm :=
  let n := pbf.length / 16
  (List.range n).foldl (fun acc j =>
    let slice := (pbf.drop (16 * j)).take 16
    .mma acc (String.join (slice.map (fun q => " " ++ pr q))) (vt0 + j) d) o0

theorem pvFoldF_bf16 : pvFoldF (sexprF .bf16) = Attn.pvFold := rfl

/-- `spec.tile_state` of a present tile: nothing but the tile enters. -/
def tileState (f : Fmt) (P : Params) (t : Nat) : State :=
  let m := (reduceKeys .fmaxc (scoreOf P t)).getD (.const "-inf")
  let l := (reduceKeys .add (fun k => probOf m (scoreOf P t k))).getD (.const "0.0")
  let pbf := (List.range 128).map (fun k => ATerm.cvt "bf16" ((probOf m (scoreOf P t k)).getD (.const "0.0")))
  ⟨m, l, pvFoldF (sexprF f) (.const "0.0") pbf (t * 8) P.d⟩

/-- The `tile` fold digit: tiles `0 .. N-1` merged in ascending order from the init state. -/
def foldTiles (tile : Nat → State) (N : Nat) : State :=
  (List.range N).foldl (fun acc t => merge acc (tile t)) initState

/-- `row_reduction(...).canonical`: `none` for a row without a tile. -/
def rowState (f : Fmt) (P : Params) : Option State :=
  if nTiles P.n = 0 then none else some (foldTiles (tileState f P) (nTiles P.n))

def s2 : ATerm := .sym "s2"

/-- `spec.output_elem`. -/
def epilogue : Option State → ATerm
  | none => .cvt "bf16" (.const "0.0")
  | some st => .cvt "bf16" (.add (.mul (.mul st.o (.div (.const "1.0") st.l)) s2) (.const "0.0"))

def output (f : Fmt) (P : Params) : ATerm := epilogue (rowState f P)

/-- The printed term of one output element of the member `f`. -/
def outputSexpr (f : Fmt) (P : Params) : String := sexprF f (output f P)

/-! ## The key reductions on the engine (`spec.verify_key_plans`, unbounded) -/

/-- `spec.key_placement(1)`: a thread holds `e` and `b` in registers, `c` is the lane. -/
def keyPlacement : List (List Factor) := [[⟨1, .reg⟩], [⟨4, .reg⟩], [⟨2, .lane⟩]]

/-- `spec.key_placement(4)`: a thread holds `e` and 4 values of `b`; the 4 warps of the head group exchange the rest of `b` before the lane steps. -/
def keyPlacementSplit : List (List Factor) := [[⟨1, .reg⟩], [⟨2, .reg⟩, ⟨2, .xchg⟩], [⟨2, .lane⟩]]

/-- `spec.key_placement(split)` for `split` in `KEY_SPLITS = (1, 4)`. -/
def keyPlacementOf (split : Nat) : List (List Factor) := if split = 4 then keyPlacementSplit else keyPlacement

theorem keyPlacement_ok : PlacementOK keyDigits keyPlacement := ⟨rfl, rfl, rfl, trivial⟩

theorem keyPlacementSplit_ok : PlacementOK keyDigits keyPlacementSplit := ⟨rfl, rfl, rfl, trivial⟩

theorem keyPlacementOf_ok (split : Nat) : PlacementOK keyDigits (keyPlacementOf split) := by
  unfold keyPlacementOf
  split
  · exact keyPlacementSplit_ok
  · exact keyPlacement_ok

/-- The spec: a key reduction as `Reduction.canonical` over abstract leaves. -/
def specKeys (cb : Comb) (leaf : Nat → Option Term) : Option Term :=
  canonicalDigitsC cb keyDigits (fun bs => leaf (keyOfBits bs))

/-- What a unit with coordinates `cs` holds after the plan of placement `ps`. -/
def kernelKeys (cb : Comb) (leaf : Nat → Option Term) (ps : List (List Factor)) (cs : List (List Bool)) : Option Term :=
  execC cb (flatten ps) (fun bs => leaf (keyOfBits bs)) cs

/-- **Every factorisation of the three digits computes the canonical tree**, in every unit. -/
theorem key_invariance (cb : Comb) (leaf : Nat → Option Term) (ps : List (List Factor)) (cs : List (List Bool))
    (hp : PlacementOK keyDigits ps) (hc : CoordsOK (flatten ps) cs) :
    OEquiv (kernelKeys cb leaf ps cs) (specKeys cb leaf) :=
  config_invarianceC cb keyDigits ps _ cs hp hc

/-- **The kernel's placement computes the canonical tree in every lane.** -/
theorem key_kernel_placement (cb : Comb) (leaf : Nat → Option Term) (lane : List Bool) (h : lane.length = 2) :
    OEquiv (kernelKeys cb leaf keyPlacement [[], [], lane]) (specKeys cb leaf) := by
  apply key_invariance cb leaf keyPlacement _ keyPlacement_ok
  refine ⟨?_, ?_, ?_, trivial⟩
  · intro hk; cases hk
  · intro hk; cases hk
  · intro _; exact h

/-- **The split placement computes the canonical tree in every lane of every warp.** -/
theorem key_kernel_placement_split (cb : Comb) (leaf : Nat → Option Term) (warp lane : List Bool) (h : lane.length = 2) :
    OEquiv (kernelKeys cb leaf keyPlacementSplit [[], [], warp, lane]) (specKeys cb leaf) := by
  apply key_invariance cb leaf keyPlacementSplit _ keyPlacementSplit_ok
  refine ⟨?_, ?_, ?_, ?_, trivial⟩
  · intro hk; cases hk
  · intro hk; cases hk
  · intro hk; cases hk
  · intro _; exact h

/-- Two valid placements agree, whichever units are asked. -/
theorem key_dispatch_irrelevant (cb : Comb) (leaf : Nat → Option Term) (ps₁ ps₂ : List (List Factor)) (cs₁ cs₂ : List (List Bool))
    (hp₁ : PlacementOK keyDigits ps₁) (hp₂ : PlacementOK keyDigits ps₂)
    (hc₁ : CoordsOK (flatten ps₁) cs₁) (hc₂ : CoordsOK (flatten ps₂) cs₂) :
    OEquiv (kernelKeys cb leaf ps₁ cs₁) (kernelKeys cb leaf ps₂ cs₂) :=
  dispatch_irrelevantC cb keyDigits ps₁ ps₂ _ cs₁ cs₂ hp₁ hp₂ hc₁ hc₂

/-! ### The model's tree is the engine's canonical tree -/

/-- The engine's tree (`treeC`) over `ATerm` leaves. -/
def treeA (f : ATerm → ATerm → ATerm) : Nat → (List Bool → Option ATerm) → Option ATerm
  | 0, g => g []
  | n+1, g => oComb f (treeA f n (fun bs => g (bs ++ [false]))) (treeA f n (fun bs => g (bs ++ [true])))

theorem pairUp_append (f : ATerm → ATerm → ATerm) : ∀ (A B : List (Option ATerm)), A.length % 2 = 0 →
    pairUp f (A ++ B) = pairUp f A ++ pairUp f B
  | [], B, _ => rfl
  | [_], _, h => by simp at h
  | a :: b :: A, B, h => by
      have hA : A.length % 2 = 0 := by simp only [List.length_cons] at h; omega
      show oComb f a b :: pairUp f (A ++ B) = oComb f a b :: (pairUp f A ++ pairUp f B)
      rw [pairUp_append f A B hA]

theorem length_pairUp (f : ATerm → ATerm → ATerm) : ∀ (A : List (Option ATerm)) (k : Nat), A.length = 2 * k →
    (pairUp f A).length = k
  | [], k, h => by simp only [List.length_nil] at h; show 0 = k; omega
  | [_], k, h => by simp only [List.length_cons, List.length_nil] at h; omega
  | a :: b :: A, k, h => by
      have hA : A.length = 2 * (k - 1) := by simp only [List.length_cons] at h; omega
      show (pairUp f A).length + 1 = k
      rw [length_pairUp f A (k - 1) hA]
      simp only [List.length_cons] at h; omega

theorem length_leavesL {α : Type} : ∀ (n : Nat) (g : List Bool → α), (leavesL n g).length = 2 ^ n
  | 0, _ => rfl
  | n+1, g => by
      show (leavesL n _ ++ leavesL n _).length = 2 ^ (n + 1)
      rw [List.length_append, length_leavesL n, length_leavesL n, Nat.pow_succ]; omega

theorem ptree_append (f : ATerm → ATerm → ATerm) : ∀ (n : Nat) (A B : List (Option ATerm)),
    A.length = 2 ^ n → B.length = 2 ^ n → ptree f (n + 1) (A ++ B) = oComb f (ptree f n A) (ptree f n B)
  | 0, A, B, hA, hB => by
      match A, B, hA, hB with
      | [a], [b], _, _ => rfl
  | n+1, A, B, hA, hB => by
      have eA : A.length = 2 * 2 ^ n := by rw [hA, Nat.pow_succ]; omega
      have eB : B.length = 2 * 2 ^ n := by rw [hB, Nat.pow_succ]; omega
      show ptree f (n + 1) (pairUp f (A ++ B)) = oComb f (ptree f n (pairUp f A)) (ptree f n (pairUp f B))
      rw [pairUp_append f A B (by omega)]
      exact ptree_append f n _ _ (length_pairUp f A _ eA) (length_pairUp f B _ eB)

/-- The attention class's adjacent-pairs tree over the leaves in index order is the engine's tree. -/
theorem ptree_leavesL (f : ATerm → ATerm → ATerm) : ∀ (n : Nat) (g : List Bool → Option ATerm),
    ptree f n (leavesL n g) = treeA f n g
  | 0, _ => rfl
  | n+1, g => by
      show ptree f (n + 1) (leavesL n _ ++ leavesL n _) = oComb f (treeA f n _) (treeA f n _)
      rw [ptree_append f n _ _ (length_leavesL n _) (length_leavesL n _), ptree_leavesL f n, ptree_leavesL f n]

/-- An engine term over the leaves `x k`, with the leaf terms substituted. -/
def substA (σ : Nat → ATerm) : Term → ATerm
  | .x i => σ i
  | .add a b => .add (substA σ a) (substA σ b)
  | .fmaxc a b => .fmax (substA σ a) (substA σ b)
  | _ => .const "?"

theorem map_ocomb (cb : Comb) (σ : Nat → ATerm) : ∀ a b : Option Term,
    (ocomb cb a b).map (substA σ) = oComb (combA cb) (a.map (substA σ)) (b.map (substA σ))
  | none, none => rfl
  | none, some _ => rfl
  | some _, none => rfl
  | some _, some _ => by cases cb <;> rfl

theorem map_treeC (cb : Comb) (σ : Nat → ATerm) : ∀ (n : Nat) (g : List Bool → Option Term),
    (treeC cb n g).map (substA σ) = treeA (combA cb) n (fun bs => (g bs).map (substA σ))
  | 0, _ => rfl
  | n+1, g => by
      show (ocomb cb (treeC cb n _) (treeC cb n _)).map (substA σ) = oComb (combA cb) (treeA (combA cb) n _) (treeA (combA cb) n _)
      rw [map_ocomb, map_treeC cb σ n, map_treeC cb σ n]

/-- **The model's key reduction is the engine's canonical reduction** over the three digits, leaf for leaf. -/
theorem reduceKeys_canonical (cb : Comb) (leaf : Nat → Option Term) (σ : Nat → ATerm) :
    reduceKeys cb (fun k => (leaf k).map (substA σ)) = (specKeys cb leaf).map (substA σ) := by
  unfold reduceKeys specKeys
  rw [ptree_leavesL, canonicalDigitsC_eq_treeC, map_treeC]
  rfl

/-- The abstract leaves of a tile of the row: `x k` for a present position. -/
def xLeaf (P : Params) (t k : Nat) : Option Term := if t * 128 + k < P.n then some (.x k) else none

/-- **The tile maximum of the class is the canonical `fmaxc` reduction** with the scores as leaves. -/
theorem tileMax_canonical (P : Params) (t : Nat) :
    reduceKeys .fmaxc (scoreOf P t)
      = (specKeys .fmaxc (xLeaf P t)).map (substA (fun k => .score P.row (t * 128 + k) P.steps)) := by
  rw [← reduceKeys_canonical]
  congr 1
  funext k
  unfold scoreOf xLeaf
  split <;> rfl

/-- **The tile sum of the class is the canonical `add` reduction** with the probabilities as leaves. -/
theorem tileSum_canonical (P : Params) (t : Nat) (m : ATerm) :
    reduceKeys .add (fun k => probOf m (scoreOf P t k))
      = (specKeys .add (xLeaf P t)).map
          (substA (fun k => .ex2 (.fma (.score P.row (t * 128 + k) P.steps) c (.mul m nc)))) := by
  rw [← reduceKeys_canonical]
  congr 1
  funext k
  unfold scoreOf xLeaf probOf
  split <;> rfl

/-! ### The executed plan prints the model's term

`Equiv` is equality up to the operand order of `add` / `fmaxc`; the printers sort those operands, so `Equiv` engine terms print one S-expression once their leaves are substituted. -/

theorem charLt_antisymm {x y : Char} (h1 : ¬ x < y) (h2 : ¬ y < x) : x = y :=
  Char.eq_of_val_eq (UInt32.le_antisymm (Char.not_lt.mp h2) (Char.not_lt.mp h1))

theorem strLt_trans {a b c : String} (h1 : a < b) (h2 : b < c) : a < c :=
  String.lt_iff.mpr (List.lt_trans Char.lt_trans
    (fun h1 h2 => Char.not_lt.mpr (Char.le_trans (Char.not_lt.mp h2) (Char.not_lt.mp h1)))
    (String.lt_iff.mp h1) (String.lt_iff.mp h2))

theorem strLt_antisymm {a b : String} (h1 : ¬ a < b) (h2 : ¬ b < a) : a = b :=
  String.ext (List.lt_antisymm charLt_antisymm (fun h => h1 (String.lt_iff.mpr h)) (fun h => h2 (String.lt_iff.mpr h)))

/-- The printers' operand sort does not see the operand order. -/
theorem sortPair_comm (a b : String) : sortPair a b = sortPair b a := by
  unfold sortPair
  by_cases hab : a = b
  · subst hab; rfl
  · have hba : ¬ b = a := fun h => hab h.symm
    simp only [compare, compareOfLessAndEq]
    by_cases h1 : a < b
    · have h2 : ¬ b < a := fun h => String.lt_irrefl a (strLt_trans h1 h)
      simp only [h1, h2, hab, hba, if_true, if_false]
      rfl
    · have h2 : b < a := Classical.byContradiction (fun h => hab (strLt_antisymm h1 h))
      simp only [h1, h2, hab, hba, if_true, if_false]
      rfl

theorem print_comb_comm (f : Fmt) (cb : Comb) (a b : ATerm) : sexprF f (combA cb a b) = sexprF f (combA cb b a) := by
  cases f <;> cases cb <;> simp only [sexprF, combA, ATerm.sexpr, sexprE] <;> rw [sortPair_comm]

theorem print_comb_congr (f : Fmt) (cb : Comb) {a a' b b' : ATerm} (h1 : sexprF f a = sexprF f a') (h2 : sexprF f b = sexprF f b') :
    sexprF f (combA cb a b) = sexprF f (combA cb a' b') := by
  cases f <;> cases cb <;> simp only [sexprF, combA, ATerm.sexpr, sexprE] at h1 h2 ⊢ <;> rw [h1, h2]

theorem print_equiv (f : Fmt) (σ : Nat → ATerm) {a b : Term} (h : Equiv a b) :
    sexprF f (substA σ a) = sexprF f (substA σ b) := by
  induction h with
  | refl => rfl
  | symm _ ih => exact ih.symm
  | trans _ _ ih1 ih2 => exact ih1.trans ih2
  | add_comm a b => exact print_comb_comm f .add _ _
  | fmaxc_comm a b => exact print_comb_comm f .fmaxc _ _
  | add_congr _ _ ih1 ih2 => exact print_comb_congr f .add ih1 ih2
  | fmaxc_congr _ _ ih1 ih2 => exact print_comb_congr f .fmaxc ih1 ih2
  | _ => rfl

/-- **Every allowed plan prints the class's reduction**: for every factorisation of the three digits, every unit and both members, the executed plan over the substituted leaves is the S-expression of the model's tree. -/
theorem key_plan_prints (f : Fmt) (cb : Comb) (leaf : Nat → Option Term) (σ : Nat → ATerm) (ps : List (List Factor))
    (cs : List (List Bool)) (hp : PlacementOK keyDigits ps) (hc : CoordsOK (flatten ps) cs) :
    (kernelKeys cb leaf ps cs).map (fun t => sexprF f (substA σ t))
      = (reduceKeys cb (fun k => (leaf k).map (substA σ))).map (sexprF f) := by
  have aux : ∀ {o p : Option Term}, OEquiv o p →
      o.map (fun t => sexprF f (substA σ t)) = p.map (fun t => sexprF f (substA σ t)) := by
    intro o p h
    cases h with
    | absent => rfl
    | present e => exact congrArg some (print_equiv f σ e)
  rw [reduceKeys_canonical, Option.map_map]
  exact aux (key_invariance cb leaf ps cs hp hc)

/-- The printed tree a unit holds for the leaves `score 0 k 1`, `k < n` (the generated key cases). -/
def keysSexpr (cb : Comb) (n : Nat) (ps : List (List Factor)) (cs : List (List Bool)) : Option String :=
  (kernelKeys cb (fun k => if k < n then some (.x k) else none) ps cs).map (fun t => (substA (fun k => .score 0 k 1) t).sexpr)

/-- The printed canonical reduction over the same leaves. -/
def keysSpecSexpr (cb : Comb) (n : Nat) : Option String :=
  (reduceKeys cb (fun k => if k < n then some (.score 0 k 1) else none)).map ATerm.sexpr

/-! ## The row fold: the fixup kernel, the in-kernel walk, any partition into units -/

/-- The in-kernel fold: one CTA walks the tiles `t, t+1, ..` in order, merging as it goes. -/
def walk (tile : Nat → State) : Nat → Nat → State → State
  | 0, _, acc => acc
  | k+1, t, acc => walk tile k (t + 1) (merge acc (tile t))

theorem walk_eq (tile : Nat → State) : ∀ (k t : Nat) (acc : State),
    walk tile k t acc = (List.range' t k).foldl (fun acc t => merge acc (tile t)) acc
  | 0, _, _ => rfl
  | k+1, t, acc => by
      show walk tile k (t + 1) (merge acc (tile t)) = (List.range' (t + 1) k).foldl _ (merge acc (tile t))
      exact walk_eq tile k (t + 1) _

def inkernel (tile : Nat → State) (N : Nat) : Option State :=
  if N = 0 then none else some (walk tile N 0 initState)

/-- The workspace of partial rows: slot `t` holds a tile state. -/
def store (ws : Nat → State) (t : Nat) (s : State) : Nat → State := fun i => if i = t then s else ws i

/-- Unit `u` computes the states of its tiles (`own t = u`) and stores each at its tile index. -/
def runUnit (tile : Nat → State) (own : Nat → Nat) (N : Nat) (ws : Nat → State) (u : Nat) : Nat → State :=
  ((List.range N).filter (fun t => own t == u)).foldl (fun ws t => store ws t (tile t)) ws

/-- The units run in the order `order` over a workspace with arbitrary initial content `ws0`. -/
def runUnits (tile : Nat → State) (own : Nat → Nat) (N : Nat) (order : List Nat) (ws0 : Nat → State) : Nat → State :=
  order.foldl (runUnit tile own N) ws0

/-- The fixup kernel: the stored partials of tiles `0 .. N-1` folded in ascending order from the init state. -/
def fixup (ws : Nat → State) (N : Nat) : Option State :=
  if N = 0 then none else some (foldTiles ws N)

theorem writes_keep (tile : Nat → State) (i : Nat) : ∀ (ts : List Nat) (ws : Nat → State), ws i = tile i →
    (ts.foldl (fun ws t => store ws t (tile t)) ws) i = tile i
  | [], _, h => h
  | t :: ts, ws, h => by
      apply writes_keep tile i ts
      show (if i = t then tile t else ws i) = tile i
      split
      · next e => rw [e]
      · exact h

theorem writes_mem (tile : Nat → State) (i : Nat) : ∀ (ts : List Nat) (ws : Nat → State), i ∈ ts →
    (ts.foldl (fun ws t => store ws t (tile t)) ws) i = tile i
  | [], _, h => by cases h
  | t :: ts, ws, h => by
      cases List.mem_cons.mp h with
      | inl e =>
          apply writes_keep tile i ts
          show (if i = t then tile t else ws i) = tile i
          rw [if_pos e, e]
      | inr hm => exact writes_mem tile i ts _ hm

theorem runUnits_keep (tile : Nat → State) (own : Nat → Nat) (N i : Nat) : ∀ (order : List Nat) (ws : Nat → State),
    ws i = tile i → runUnits tile own N order ws i = tile i
  | [], _, h => h
  | _ :: us, ws, h => runUnits_keep tile own N i us _ (writes_keep tile i _ ws h)

/-- Once the unit owning tile `i` has run, slot `i` holds tile `i`'s state, whatever ran before or after. -/
theorem runUnits_mem (tile : Nat → State) (own : Nat → Nat) (N i : Nat) (hi : i < N) : ∀ (order : List Nat) (ws : Nat → State),
    own i ∈ order → runUnits tile own N order ws i = tile i
  | [], _, h => by cases h
  | u :: us, ws, h => by
      cases List.mem_cons.mp h with
      | inl e =>
          apply runUnits_keep tile own N i us
          apply writes_mem tile i
          exact List.mem_filter.mpr ⟨List.mem_range.mpr hi, by simp [e]⟩
      | inr hm => exact runUnits_mem tile own N i hi us _ hm

theorem foldl_merge_congr (a b : Nat → State) : ∀ (l : List Nat) (acc : State), (∀ t, t ∈ l → a t = b t) →
    l.foldl (fun acc t => merge acc (a t)) acc = l.foldl (fun acc t => merge acc (b t)) acc
  | [], _, _ => rfl
  | t :: ts, acc, h => by
      show ts.foldl _ (merge acc (a t)) = ts.foldl _ (merge acc (b t))
      rw [h t (List.mem_cons_self t ts)]
      exact foldl_merge_congr a b ts _ (fun s hs => h s (List.mem_cons_of_mem t hs))

/-- **The fixup fold is the canonical row fold** for every assignment `own` of tiles to units (any partition, contiguous or not), every unit order that runs each owning unit at least once, and any initial workspace content. -/
theorem fixup_eq_canonical (tile : Nat → State) (own : Nat → Nat) (N : Nat) (order : List Nat) (ws0 : Nat → State)
    (hcov : ∀ t, t < N → own t ∈ order) :
    fixup (runUnits tile own N order ws0) N = if N = 0 then none else some (foldTiles tile N) := by
  unfold fixup foldTiles
  split
  · rfl
  · congr 1
    apply foldl_merge_congr
    intro t ht
    exact runUnits_mem tile own N t (List.mem_range.mp ht) order ws0 (hcov t (List.mem_range.mp ht))

/-- **The in-kernel walk is the canonical row fold.** -/
theorem inkernel_eq_canonical (tile : Nat → State) (N : Nat) :
    inkernel tile N = if N = 0 then none else some (foldTiles tile N) := by
  unfold inkernel foldTiles
  rw [walk_eq, List.range_eq_range']

theorem fixup_eq_inkernel (tile : Nat → State) (own : Nat → Nat) (N : Nat) (order : List Nat) (ws0 : Nat → State)
    (hcov : ∀ t, t < N → own t ∈ order) : fixup (runUnits tile own N order ws0) N = inkernel tile N := by
  rw [fixup_eq_canonical tile own N order ws0 hcov, inkernel_eq_canonical]

/-- The `tiles_per_unit` knob: unit `u` owns the contiguous run `[u tpu, (u + 1) tpu)`. `0` is modelled as one unit with every tile; `ConfigOK` admits it with the in-kernel fold only, so no member of the space runs the fixup kernel with it. -/
def unitOf (tpu t : Nat) : Nat := if tpu = 0 then 0 else t / tpu

/-- The units of a row with `N` tiles under unit size `tpu`. -/
def unitsOf (tpu N : Nat) : List Nat := List.range (if tpu = 0 then 1 else (N + tpu - 1) / tpu)

/-- A unit order runs every unit of the row (any order, repeats allowed). -/
def Covers (tpu N : Nat) (order : List Nat) : Prop := ∀ t, t < N → unitOf tpu t ∈ order

theorem unitsOf_covers (tpu N : Nat) : Covers tpu N (unitsOf tpu N) := by
  intro t ht
  unfold unitOf unitsOf
  split
  · exact List.mem_range.mpr (Nat.lt_succ_self 0)
  · next h =>
      apply List.mem_range.mpr
      have hp : 0 < tpu := Nat.pos_of_ne_zero h
      have e : N + tpu - 1 = (N - 1) + tpu := by omega
      have hd := Nat.div_add_mod (N - 1) tpu
      have hm := Nat.mod_lt (N - 1) hp
      rw [e, Nat.add_div_right _ hp]
      apply (Nat.div_lt_iff_lt_mul hp).mpr
      rw [Nat.add_mul, Nat.one_mul, Nat.mul_comm ((N - 1) / tpu) tpu]
      omega

/-- The merge is a dataflow step, not an associative operation: a unit stores one partial per tile, never a merged run. -/
theorem merge_not_assoc :
    let a : State := ⟨.sym "ma", .sym "la", .sym "oa"⟩
    let b : State := ⟨.sym "mb", .sym "lb", .sym "ob"⟩
    let d : State := ⟨.sym "md", .sym "ld", .sym "od"⟩
    merge (merge a b) d ≠ merge a (merge b d) := by decide

/-! ## The configuration space (`config.SparseMlaConfig`) -/

/-- `SparseMlaConfig.lean()`: head rows per CTA, gather warps, the fold (`0` fixup, `1` in-kernel), tiles per unit (`0` exactly with the in-kernel fold), output columns per PV pass, the warps one head group's tile is spread over. -/
structure Config where
  headBlock : Nat
  gatherWarps : Nat
  fold : Nat
  tilesPerUnit : Nat
  pvPass : Nat
  mmaSplit : Nat
  deriving DecidableEq, Repr

/-- `SparseMlaConfig.well_formed`. -/
def ConfigOK (b : Config) : Bool :=
  (b.headBlock == 16 || b.headBlock == 32 || b.headBlock == 64)
    && (b.gatherWarps == 4 || b.gatherWarps == 8)
    && decide (b.headBlock ≤ b.gatherWarps * 16)
    && decide (b.fold ≤ 1)
    && (b.tilesPerUnit == 0 || b.tilesPerUnit == 1 || b.tilesPerUnit == 2 || b.tilesPerUnit == 4 || b.tilesPerUnit == 8)
    && ((b.fold == 1) == (b.tilesPerUnit == 0))
    && (b.pvPass == 64 || b.pvPass == 128)
    && (b.mmaSplit == 1 || b.mmaSplit == 4)
    && (b.mmaSplit == 1 || b.headBlock == 16)

/-- `config.default_config` (the dispatcher): the in-kernel fold at the widest head block when the partial rows would pass `FIXUP_WORKSPACE_FLOATS = 2^28` floats (`WS_ROW_FLOATS = 516` per head and tile); else the fixup fold at the narrowest head block (16, then 32) whose units number at most the SMs, else the widest, with four tiles per unit once `BUSY_UNITS_PER_SM = 16` units per SM are queued, else one. -/
def defaultConfig (rows heads width sm : Nat) : Config :=
  let hb := if heads ≤ 16 then 16 else if heads ≤ 32 then 32 else 64
  let tiles := (width + 127) / 128
  if 268435456 < rows * heads * tiles * 516 then ⟨hb, 8, 1, 0, 128, if hb = 16 then 4 else 1⟩
  else
    let nb := if 16 < hb ∧ rows * ((heads + 15) / 16) * tiles ≤ sm then 16
      else if 32 < hb ∧ rows * ((heads + 31) / 32) * tiles ≤ sm then 32 else hb
    let per := if 16 * sm ≤ rows * ((heads + nb - 1) / nb) * tiles then 4 else 1
    ⟨nb, 8, 0, per, 128, if nb = 16 then 4 else 1⟩

/-- The nine records the dispatcher can return. -/
def dispatchRange : List Config :=
  [⟨16, 8, 0, 1, 128, 4⟩, ⟨32, 8, 0, 1, 128, 1⟩, ⟨64, 8, 0, 1, 128, 1⟩, ⟨16, 8, 0, 4, 128, 4⟩, ⟨32, 8, 0, 4, 128, 1⟩, ⟨64, 8, 0, 4, 128, 1⟩,
   ⟨16, 8, 1, 0, 128, 4⟩, ⟨32, 8, 1, 0, 128, 1⟩, ⟨64, 8, 1, 0, 128, 1⟩]

theorem defaultConfig_in_range (rows heads width sm : Nat) : defaultConfig rows heads width sm ∈ dispatchRange := by
  unfold defaultConfig dispatchRange
  by_cases h1 : heads ≤ 16 <;> by_cases h2 : heads ≤ 32 <;> simp only [h1, h2, if_true, if_false] <;>
    repeat' split
  all_goals first | omega | simp

theorem dispatchRange_ok : dispatchRange.all ConfigOK = true := by decide

/-- **Every dispatcher pick satisfies the constraints**, for every call. -/
theorem defaultConfig_ok (rows heads width sm : Nat) : ConfigOK (defaultConfig rows heads width sm) = true :=
  List.all_eq_true.mp dispatchRange_ok _ (defaultConfig_in_range rows heads width sm)

/-- The key placement a configuration selects (`spec.key_placement(mma_split)`). -/
def Config.keyPlacement (b : Config) : List (List Factor) := keyPlacementOf b.mmaSplit

/-- **Every configuration's key reductions are the canonical tree**, in every unit of its plan. -/
theorem config_keys_canonical (b : Config) (cb : Comb) (leaf : Nat → Option Term) (cs : List (List Bool))
    (hc : CoordsOK (flatten b.keyPlacement) cs) : OEquiv (kernelKeys cb leaf b.keyPlacement cs) (specKeys cb leaf) :=
  key_invariance cb leaf _ cs (keyPlacementOf_ok b.mmaSplit) hc

/-- A row's output under a configuration: the fixup kernel over the units of `tilesPerUnit` run in `order` on a workspace with content `ws0`, or the in-kernel walk. `headBlock`, `gatherWarps` and `pvPass` are absent: they decide which thread or CTA computes an element and never reach a value; `mmaSplit` selects the plan of the key reductions, which is the canonical tree for both values (`config_keys_canonical`). -/
def kernel (f : Fmt) (b : Config) (order : List Nat) (ws0 : Nat → State) (P : Params) : ATerm :=
  if b.fold = 0 then
    epilogue (fixup (runUnits (tileState f P) (unitOf b.tilesPerUnit) (nTiles P.n) order ws0) (nTiles P.n))
  else epilogue (inkernel (tileState f P) (nTiles P.n))

theorem kernel_eq_output (f : Fmt) (b : Config) (order : List Nat) (ws0 : Nat → State) (P : Params)
    (hcov : Covers b.tilesPerUnit (nTiles P.n) order) : kernel f b order ws0 P = output f P := by
  unfold kernel output rowState
  split
  · rw [fixup_eq_canonical _ _ _ order ws0 hcov]
  · rw [inkernel_eq_canonical]

/-- **Configuration invariance (R3)**: every configuration, every unit order and every workspace content compute the class term. -/
theorem config_invariance (f : Fmt) (b₁ b₂ : Config) (o₁ o₂ : List Nat) (w₁ w₂ : Nat → State) (P : Params)
    (h₁ : Covers b₁.tilesPerUnit (nTiles P.n) o₁) (h₂ : Covers b₂.tilesPerUnit (nTiles P.n) o₂) :
    kernel f b₁ o₁ w₁ P = kernel f b₂ o₂ w₂ P := by
  rw [kernel_eq_output f b₁ o₁ w₁ P h₁, kernel_eq_output f b₂ o₂ w₂ P h₂]

theorem space_invariant (f : Fmt) (space : List Config) :
    ∀ b₁ ∈ space, ∀ b₂ ∈ space, ∀ (o₁ o₂ : List Nat) (w₁ w₂ : Nat → State) (P : Params),
      Covers b₁.tilesPerUnit (nTiles P.n) o₁ → Covers b₂.tilesPerUnit (nTiles P.n) o₂ →
      kernel f b₁ o₁ w₁ P = kernel f b₂ o₂ w₂ P :=
  fun b₁ _ b₂ _ o₁ o₂ w₁ w₂ P h₁ h₂ => config_invariance f b₁ b₂ o₁ o₂ w₁ w₂ P h₁ h₂

/-- Every configuration with its own units in ascending order computes the class term. -/
theorem kernel_units_eq_output (f : Fmt) (b : Config) (ws0 : Nat → State) (P : Params) :
    kernel f b (unitsOf b.tilesPerUnit (nTiles P.n)) ws0 P = output f P :=
  kernel_eq_output f b _ ws0 P (unitsOf_covers _ _)

/-! ## The launch model: R1, R2 and R4 -/

/-- A row of a launch: its own list length and the id of its query token and head. -/
structure Row where
  n : Nat
  row : Nat
  deriving DecidableEq, Repr

def rowOutput (f : Fmt) (steps d : Nat) (r : Row) : ATerm := output f ⟨steps, r.n, r.row, d⟩

/-- The launch applies the per-row term to every row; there is no batch parameter inside. -/
def launch (f : Fmt) (M : Nat) (rows : Fin M → Row) (steps d : Nat) (r : Fin M) : ATerm := rowOutput f steps d (rows r)

/-- **Determinism (R1)**. -/
theorem determinism (f : Fmt) (M : Nat) (rows : Fin M → Row) (steps d : Nat) (r : Fin M) :
    launch f M rows steps d r = launch f M rows steps d r := rfl

/-- **Batch invariance (R2)**: equal rows give equal outputs whatever the batch size, the row's position or its neighbours. -/
theorem batch_invariance (f : Fmt) (steps d : Nat) {M₁ M₂ : Nat} (rows₁ : Fin M₁ → Row) (rows₂ : Fin M₂ → Row)
    (r₁ : Fin M₁) (r₂ : Fin M₂) (h : rows₁ r₁ = rows₂ r₂) :
    launch f M₁ rows₁ steps d r₁ = launch f M₂ rows₂ steps d r₂ := by
  simp only [launch, h]

theorem permutation_invariance (f : Fmt) (steps d : Nat) {M : Nat} (rows : Fin M → Row) (σ : Fin M → Fin M) (r : Fin M) :
    launch f M (rows ∘ σ) steps d r = launch f M rows steps d (σ r) := rfl

theorem subbatch_invariance (f : Fmt) (steps d : Nat) {M k : Nat} (rows : Fin M → Row) (sel : Fin k → Fin M) (i : Fin k) :
    launch f k (rows ∘ sel) steps d i = launch f M rows steps d (sel i) := rfl

/-- A padding row (`n = 0`) is `cvt_bf16(+0)`, whatever its id and the head dim. -/
theorem padding_row (f : Fmt) (steps d row : Nat) : rowOutput f steps d ⟨0, row⟩ = .cvt "bf16" (.const "0.0") := by
  have h : nTiles 0 = 0 := by decide
  simp [rowOutput, output, rowState, h, epilogue]

/-- **Padding rows do not enter**: a launch extended by any rows (padding rows among them) leaves every original row's output unchanged. -/
theorem padding_irrelevant (f : Fmt) (steps d : Nat) {M K : Nat} (rows : Fin M → Row) (ext : Fin (M + K) → Row)
    (hext : ∀ i : Fin M, ext (Fin.castAdd K i) = rows i) (r : Fin M) :
    launch f (M + K) ext steps d (Fin.castAdd K r) = launch f M rows steps d r :=
  batch_invariance f steps d ext rows _ r (hext r)

/-- A request's rows by token: `lists i` is token `i`'s own list and id. A prefill call launches all of them, a chunk of a prefill the tokens `[a, a + len)`, a decode call one token. -/
def prefillRow (lists : Nat → Row) (i : Nat) : Row := lists i
def chunkRow (lists : Nat → Row) (a i : Nat) : Row := lists (a + i)
def decodeRow (lists : Nat → Row) (i : Nat) : Row := lists i

/-- **Prefill == chunked prefill == decode (R4)**: the term reads the row's own list and query only, so token `a + i` is the same term from the three calls. -/
theorem prefill_chunk_decode_agree (f : Fmt) (steps d : Nat) (lists : Nat → Row) (a i : Nat) :
    rowOutput f steps d (chunkRow lists a i) = rowOutput f steps d (prefillRow lists (a + i))
      ∧ rowOutput f steps d (decodeRow lists (a + i)) = rowOutput f steps d (prefillRow lists (a + i)) :=
  ⟨rfl, rfl⟩

/-- Tile boundaries are cut by list position: the tiles of a row depend on its own `n` only. -/
theorem tiles_absolute (P Q : Params) (h : P.n = Q.n) : nTiles P.n = nTiles Q.n := by rw [h]

/-! ## The e4m3 members: the bf16 dataflow with every operand leaf wrapped -/

/-- A term with the printed P slices of its PV steps erased. -/
def skel : ATerm → ATerm
  | .add a b => .add (skel a) (skel b)
  | .mul a b => .mul (skel a) (skel b)
  | .fma a b c => .fma (skel a) (skel b) (skel c)
  | .div a b => .div (skel a) (skel b)
  | .fmax a b => .fmax (skel a) (skel b)
  | .ex2 a => .ex2 (skel a)
  | .cvt f a => .cvt f (skel a)
  | .mma acc _ vt d => .mma (skel acc) "" vt d
  | t => t

def skelS (s : State) : State := ⟨skel s.m, skel s.l, skel s.o⟩

theorem skel_merge (a b : State) : skelS (merge a b) = merge (skelS a) (skelS b) := rfl

theorem skel_pvFoldF (pr₁ pr₂ : ATerm → String) (pbf : List ATerm) (vt0 d : Nat) : ∀ (js : List Nat) (o₁ o₂ : ATerm),
    skel o₁ = skel o₂ →
    skel (js.foldl (fun acc j => ATerm.mma acc (String.join (((pbf.drop (16 * j)).take 16).map (fun q => " " ++ pr₁ q))) (vt0 + j) d) o₁)
      = skel (js.foldl (fun acc j => ATerm.mma acc (String.join (((pbf.drop (16 * j)).take 16).map (fun q => " " ++ pr₂ q))) (vt0 + j) d) o₂)
  | [], _, _, h => h
  | j :: js, o₁, o₂, h => by
      apply skel_pvFoldF pr₁ pr₂ pbf vt0 d js
      show ATerm.mma (skel o₁) "" (vt0 + j) d = ATerm.mma (skel o₂) "" (vt0 + j) d
      rw [h]

theorem skel_tileState (P : Params) (t : Nat) : skelS (tileState .e4m3 P t) = skelS (tileState .bf16 P t) := by
  unfold tileState skelS
  simp only []
  congr 1
  exact skel_pvFoldF _ _ _ _ _ _ _ _ rfl

theorem skel_foldl (a b : Nat → State) (h : ∀ t, skelS (a t) = skelS (b t)) : ∀ (l : List Nat) (x y : State),
    skelS x = skelS y → skelS (l.foldl (fun acc t => merge acc (a t)) x) = skelS (l.foldl (fun acc t => merge acc (b t)) y)
  | [], _, _, hxy => hxy
  | t :: ts, x, y, hxy => by
      apply skel_foldl a b h ts
      rw [skel_merge, skel_merge, hxy, h t]

/-- **The e4m3 member is the bf16 term node for node**: the two members' terms differ only inside the printed operand slices, where `sexprE` wraps the query, cache and V leaves in `cvt_e4m3_bf16`. -/
theorem skeleton_format_irrelevant (P : Params) : skel (output .e4m3 P) = skel (output .bf16 P) := by
  unfold output rowState
  split
  · rfl
  · have h := skel_foldl (tileState .e4m3 P) (tileState .bf16 P) (skel_tileState P) (List.range (nTiles P.n)) initState initState rfl
    have ho := congrArg State.o h
    have hl := congrArg State.l h
    show ATerm.cvt "bf16" (.add (.mul (.mul (skel _) (.div (.const "1.0") (skel _))) s2) (.const "0.0")) = ATerm.cvt "bf16" (.add (.mul (.mul (skel _) (.div (.const "1.0") (skel _))) s2) (.const "0.0"))
    simp only [skelS, foldTiles] at ho hl ⊢
    rw [ho, hl]

/-- The wrapped leaves are visible in the printed term: the two members are different classes. -/
theorem formats_differ : outputSexpr .e4m3 ⟨1, 1, 0, 0⟩ ≠ outputSexpr .bf16 ⟨1, 1, 0, 0⟩ := by decide +kernel

/-- One class per layout: `D_qk = 512` (32 steps) and `576` (36 steps) are different terms. -/
theorem output_depends_on_D : output .bf16 ⟨32, 1, 0, 0⟩ ≠ output .bf16 ⟨36, 1, 0, 0⟩ := by decide +kernel

end BIK.SparseMLA
