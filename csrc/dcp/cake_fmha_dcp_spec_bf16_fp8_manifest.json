{
  "activity_policy": "one CUDA kernel launch per invocation after JIT/prewarm",
  "architectures": [
    "sm_100a",
    "sm_103a"
  ],
  "caller_owned_outputs": {
    "LSE": "float32_base2",
    "O": "bfloat16"
  },
  "empty_row_policy": {
    "LSE": "negative_infinity",
    "O": "exact_zero"
  },
  "fixed": {
    "causal": true,
    "head_dim": 128,
    "k_scale": "per_tensor_folded_into_bmm1",
    "kv_dtype": "float8_e4m3fn",
    "kv_layout": "HND",
    "lse": "float32_base2",
    "o_dtype": "bfloat16",
    "page_size": 64,
    "q_dtype": "bfloat16",
    "v_scale": "per_tensor_folded_into_output"
  },
  "format_version": 1,
  "minimum_arch": "sm_100a",
  "name": "cake_fmha_dcp_spec_bf16_fp8",
  "route": {
    "binding": "cake_fmha_dcp_spec_bf16_fp8_binding.cu",
    "body": "cake_fmha_dcp_spec_bf16_fp8.cu",
    "macros": [
      "BATCH_SIZE",
      "NUM_Q_HEADS",
      "NUM_KV_HEADS",
      "Q_LEN",
      "CP_WORLD"
    ]
  },
  "specialization_domain": {
    "batch_size": "positive integer",
    "cp_rank": "0 <= cp_rank < cp_world",
    "cp_world": [
      1,
      2,
      4,
      8
    ],
    "head_group_ratio": "integer in [1, 8]",
    "q_len": [
      1,
      2,
      3,
      4,
      5,
      6,
      8
    ]
  }
}
