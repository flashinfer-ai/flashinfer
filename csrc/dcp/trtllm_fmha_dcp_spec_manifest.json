{
  "activity_policy": "one CUDA kernel launch per invocation after JIT/prewarm",
  "architectures": [
    "sm_100a",
    "sm_103a"
  ],
  "fixed": {
    "causal": true,
    "dtype": "bfloat16",
    "head_dim": 128,
    "kv_layout": "HND",
    "lse": "float32_base2",
    "page_size": 16
  },
  "format_version": 1,
  "minimum_arch": "sm_100a",
  "name": "trtllm_fmha_dcp_spec_bf16",
  "routes": {
    "v1": {
      "binding": "trtllm_fmha_dcp_spec_bf16_v1_binding.cu",
      "body": "trtllm_fmha_dcp_spec_bf16_v1.cu",
      "macros": [
        "BATCH_SIZE",
        "NUM_Q_HEADS",
        "NUM_KV_HEADS",
        "Q_LEN",
        "CP_WORLD",
        "RETAIN_KV_L2"
      ]
    },
    "v4": {
      "binding": "trtllm_fmha_dcp_spec_bf16_v4_binding.cu",
      "body": "trtllm_fmha_dcp_spec_bf16_v4.cu",
      "macros": [
        "BATCH_SIZE",
        "NUM_Q_HEADS",
        "NUM_KV_HEADS",
        "Q_LEN",
        "CP_WORLD",
        "NUM_SPLIT"
      ]
    }
  },
  "specialization_domain": {
    "batch_size": "positive integer",
    "cp_rank": "0 <= cp_rank < cp_world",
    "cp_world": [
      1,
      2,
      4,
      8
    ],
    "head_group_ratio": "integer in [1, 8]",
    "q_len": [
      1,
      2,
      4,
      5,
      6,
      8
    ],
    "v1_retain_kv_l2": [
      0,
      1
    ],
    "v4_num_split": "integer in [2, 16]"
  }
}
