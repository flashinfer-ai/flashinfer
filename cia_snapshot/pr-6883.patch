+CakeFastDivmod MakeFastDivmod(int32_t divisor) {
+  if (divisor == 1) return CakeFastDivmod{1, 0u, 0u};
+  uint32_t log2_ceil = 0;
+  for (uint32_t value = static_cast<uint32_t>(divisor) - 1u; value != 0u; value >>= 1) ++log2_ceil;
+  const uint64_t power = uint64_t{1} << (31u + log2_ceil);
+  const uint32_t multiplier = static_cast<uint32_t>((power + static_cast<uint64_t>(divisor) - 1u) /
+                                                    static_cast<uint64_t>(divisor));
+  return CakeFastDivmod{divisor, multiplier, log2_ceil - 1u};
