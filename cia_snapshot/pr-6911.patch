+    alpha_dtype: str,
+    sf_vec_size: int,
+    mma_k: int,
+    tile_k: int,
+    mma_tile_m: int,
+    mma_tile_n: int,
+    cluster_shape_m: int,
+    cluster_shape_n: int,
+    sm_count: int,
+    single_work_tile_per_cta: bool,
+    direct_one_m_tile_scheduler: bool,
+    use_m1_non_tma: bool,
+    split_k_slices: int,
+    split_k_atomic_bf16: bool,
