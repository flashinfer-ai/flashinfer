diff --git a/tests/experimental/b12x/sequence/test_mamba_ssd.py b/tests/experimental/b12x/sequence/test_mamba_ssd.py
new file mode 100644
index 0000000000000000000000000000000000000000..0823645bf6f404e7e4c7e7cdbd587e721ad33296
--- /dev/null
+++ b/tests/experimental/b12x/sequence/test_mamba_ssd.py
@@ -0,0 +1,223 @@
+"""Mamba recurrence, packed state ownership, and frozen graph replay."""
+
+from contextlib import contextmanager
+
+import pytest
+import torch
+
+from b12x.preparation import PreparationSession, PreparedCall
+from b12x.sequence import mamba_ssd
+
+pytestmark = pytest.mark.skipif(not torch.cuda.is_available(), reason="requires CUDA")
+
+
+def inputs(
+    lengths,
+    *,
+    heads=8,
+    groups=2,
+    dim=64,
+    dstate=128,
+    state_dtype=torch.bfloat16,
+    parameter_dtype=torch.float32,
+    padding=0,
+):
+    torch.manual_seed(13)
+    tokens, seqs = sum(lengths), len(lengths)
+
+    def rand(*shape, dtype=torch.bfloat16):
+        return torch.randn(*shape, device="cuda", dtype=dtype)
+
+    def packed(width, stride):
+        return rand(tokens, stride)[:, :width]
+
+    x = packed(heads * dim, heads * dim + padding).view(tokens, heads, dim)
+    B = packed(groups * dstate, groups * dstate + padding).view(tokens, groups, dstate)
+    C = packed(groups * dstate, groups * dstate + padding).view(tokens, groups, dstate)
+    dt = rand(tokens, heads, dtype=parameter_dtype)
+    A = -torch.rand(heads, device="cuda") - 1
+    D, bias = (
+        rand(heads, dtype=parameter_dtype),
+        (rand(heads, dtype=parameter_dtype) - 4),
+    )
+    state = rand(2 * seqs + 1, heads * dim * dstate + padding, dtype=state_dtype)
+    state = state[:, : heads * dim * dstate].view(2 * seqs + 1, heads, dim, dstate)
+    cu = torch.tensor(
+        [0, *torch.tensor(lengths).cumsum(0).tolist()], device="cuda", dtype=torch.int32
+    )
+    src = torch.arange(1, 1 + seqs, device="cuda", dtype=torch.int64)
+    dst = src + seqs
+    fresh = torch.zeros(seqs, device="cuda", dtype=torch.bool)
+    ns = torch.tensor([seqs], device="cuda", dtype=torch.int32)
+    nt = torch.tensor([tokens], device="cuda", dtype=torch.int32)
+    return (
+        x,
+        dt,
+        A,
+        B,
+        C,
+        D,
+        bias,
+        state,
+        cu,
+        src,
+        dst,
+        fresh,
+        ns,
+        nt,
+    ), torch.full_like(x, -31)
+
+
+def reference(args, out):
+    x, dt, A, B, C, D, bias, state, cu, src, dst, fresh, ns, nt = args
+    result, states = out.clone(), state.clone()
+    groups = torch.arange(x.shape[1], device=x.device) // (x.shape[1] // B.shape[1])
+    for request in range(int(ns)):
+        lo, hi = int(cu[request]), int(cu[request + 1])
+        if int(src[request]) < 0 or int(dst[request]) < 0 or hi == lo:
+            continue
+        acc = (
+            torch.zeros_like(state[0], dtype=torch.float32)
+            if fresh[request]
+            else state[src[request]].float()
+        )
+        for t in range(lo, hi):
+            step = torch.nn.functional.softplus(dt[t].float() + bias.float())
+            decay = torch.exp(A * step)
+            acc = (
+                acc * decay[:, None, None]
+                + x[t].float()[:, :, None]
+                * (step[:, None] * B[t, groups].float())[:, None, :]
+            )
+            result[t] = (acc * C[t, groups].float()[:, None, :]).sum(-1) + D.float()[
+                :, None
+            ] * x[t].float()
+        states[dst[request]] = acc
+    return result, states
+
+
+@contextmanager
+def prepared(args, out, override=None):
+    plan = mamba_ssd.plan(
+        mamba_ssd.query_from_call(*args, out=out), device=out.device, override=override
+    )
+    workspace = torch.empty(
+        plan.memory_requirements().scratch_nbytes, dtype=torch.uint8, device=out.device
+    )
+    with PreparationSession(
+        device=out.device, autotune=False, compile_workers=1
+    ) as session:
+        session.prepare(
+            (
+                plan.request(
+                    name="mamba",
+                    prepare_call=lambda state: PreparedCall(
+                        run=lambda: state.run(*args, out=out, workspace=workspace)
+                    ),
+                ),
+            )
+        )
+        session.freeze()
+        yield plan, workspace
+
+
+def assert_numerics(actual, expected):
+    assert torch.isfinite(actual).all()
+    error = (
+        actual.float() - expected.float()
+    ).norm() / expected.float().norm().clamp_min(1e-8)
+    assert error < 0.008, error.item()
+    torch.testing.assert_close(actual.float(), expected.float(), rtol=0.025, atol=0.06)
+
+
+@pytest.mark.parametrize(
+    "lengths", [(1,), (15,), (16,), (17,), (128,), (129,), (0, 7, 33), (1, 127, 0, 257)]
+)
+@pytest.mark.parametrize("state_dtype", [torch.bfloat16, torch.float32])
+def test_recurrence_and_distinct_state_slots(lengths, state_dtype):
+    args, out = inputs(lengths, state_dtype=state_dtype, padding=16)
+    expected, states = reference(args, out)
+    initial = args[7].clone()
+    with prepared(args, out) as (plan, workspace):
+        mamba_ssd.run(*args, out=out, plan=plan, workspace=workspace)
+        torch.cuda.synchronize()
+        assert_numerics(out, expected)
+        assert_numerics(args[7], states)
+        torch.testing.assert_close(
+            args[7][: len(lengths) + 1], initial[: len(lengths) + 1], rtol=0, atol=0
+        )
+
+
+@pytest.mark.parametrize("dim,dstate", [(64, 64), (128, 128)])
+@pytest.mark.parametrize("tokens", [35, 257])
+def test_geometry_and_bf16_parameters(dim, dstate, tokens):
+    args, out = inputs(
+        (tokens,), dim=dim, dstate=dstate, parameter_dtype=torch.bfloat16
+    )
+    expected, states = reference(args, out)
+    with prepared(args, out) as (plan, workspace):
+        mamba_ssd.run(*args, out=out, plan=plan, workspace=workspace)
+        assert_numerics(out, expected)
+        assert_numerics(args[7], states)
+
+
+@pytest.mark.parametrize(
+    "warps,elements,rows,d,n",
+    [
+        (4, 4, 64, 64, 128),
+        (8, 16, 64, 64, 128),
+        (16, 8, 64, 64, 128),
+        (16, 16, 128, 64, 64),
+        (8, 8, 128, 64, 128),
+        (16, 8, 128, 128, 128),
+    ],
+)
+def test_launch_configurations(warps, elements, rows, d, n):
+    args, out = inputs((7, 129, 0, 257), dim=d, dstate=n)
+    expected, states = reference(args, out)
+    with prepared(args, out, mamba_ssd.MambaConfig(warps, elements, rows)) as (
+        plan,
+        workspace,
+    ):
+        mamba_ssd.run(*args, out=out, plan=plan, workspace=workspace)
+        assert_numerics(out, expected)
+        assert_numerics(args[7], states)
+
+
+@pytest.mark.parametrize("capacity", [33, 4096])
+def test_graph_live_counts_fresh_slots_and_poisoned_padding(capacity):
+    args, out = inputs((17, capacity - 17, 0))
+    state, cu, src, dst, fresh, ns, nt = args[7:]
+    initial = state.clone()
+    with prepared(args, out) as (plan, workspace):
+        graph = torch.cuda.CUDAGraph()
+        with torch.cuda.graph(graph):
+            mamba_ssd.run(*args, out=out, plan=plan, workspace=workspace)
+        address = out.data_ptr()
+        for lengths in ((17, capacity - 17), (1,), (), (7, 3, 0)):
+            n, t = len(lengths), sum(lengths)
+            state.copy_(initial)
+            fresh.fill_(True)
+            state[src] = float("nan")
+            cu.fill_(-123)
+            cu[: n + 1].copy_(
+                torch.tensor(
+                    [0, *torch.tensor(lengths, dtype=torch.int32).cumsum(0).tolist()],
+                    device="cuda",
+                    dtype=torch.int32,
+                )
+            )
+            ns.fill_(n)
+            nt.fill_(t)
+            out.fill_(-31)
+            expected, states = reference(args, out)
+            before = torch.cuda.memory_allocated()
+            graph.replay()
+            torch.cuda.synchronize()
+            assert torch.cuda.memory_allocated() == before and out.data_ptr() == address
+            assert_numerics(out, expected)
+            torch.testing.assert_close(out[t:], expected[t:], rtol=0, atol=0)
+            for r in range(n):
+                if lengths[r]:
+                    assert_numerics(state[dst[r]], states[dst[r]])
+        graph.reset()
diff --git a/tests/experimental/b12x/sequence/test_short_conv.py b/tests/experimental/b12x/sequence/test_short_conv.py
new file mode 100644
index 0000000000000000000000000000000000000000..d0492f1a70a646f0d50faab85e65403f472742ca
--- /dev/null
+++ b/tests/experimental/b12x/sequence/test_short_conv.py
@@ -0,0 +1,547 @@
+"""Raw GDN convolution parity, accepted history, and fixed-address replay."""
+
+from contextlib import contextmanager
+
+import pytest
+import torch
+import torch.nn.functional as F
+from b12x.preparation import PreparationSession, PreparedCall
+from b12x.sequence import short_conv
+from b12x.sequence.short_conv._tuning import ShortConvQuery
+
+from ..conftest import require_b12x
+
+
+def test_gdn_raw_projection_geometry_is_metadata_only():
+    plan = short_conv.plan(
+        short_conv.Caps(
+            device="cuda:0",
+            mode="mixed",
+            channels=10240,
+            kernel_size=4,
+            max_tokens=16,
+            max_seqs=4,
+            max_state_slots=8,
+            max_speculative_tokens=3,
+        )
+    )
+    assert plan.query.state_length == 3
+    assert plan.query.state_capacity == 6
+    assert plan.query.state_strides == (61440, 6, 1)
+
+
+@pytest.mark.parametrize(
+    "override",
+    [
+        {"channels": True},
+        {"mode": "eager"},
+        {"kernel_size": 1},
+        {"max_speculative_tokens": -1},
+        {"dilation": 0},
+        {"max_seqs": 2**31},
+        {"state_strides": (32, 6, 1)},
+        {"state_strides": (65536, 1, 10240)},
+        {"input_alignments": (16,)},
+        {"input_row_stride": 10239},
+        {"input_row_stride": True},
+        {"input_row_stride": 2**63},
+    ],
+)
+def test_invalid_convolution_contract_is_rejected_without_cuda(override):
+    values = dict(
+        mode="mixed",
+        channels=10240,
+        kernel_size=4,
+        dilation=1,
+        max_tokens=16,
+        max_seqs=4,
+        max_state_slots=8,
+        max_speculative_tokens=3,
+    )
+    with pytest.raises(ValueError):
+        ShortConvQuery(**(values | override))
+
+
+class _Case:
+    def __init__(
+        self,
+        mode,
+        *,
+        channels=10240,
+        dilation=1,
+        input_padding=0,
+        speculative_tokens=3,
+        kernel_size=4,
+        max_tokens=12,
+        weight_dtype=torch.bfloat16,
+        bias_dtype=None,
+        round_before_silu=True,
+    ):
+        device = require_b12x()
+        self.caps = short_conv.Caps(
+            device=device,
+            mode=mode,
+            channels=channels,
+            kernel_size=kernel_size,
+            dilation=dilation,
+            max_tokens=max_tokens,
+            max_seqs=4,
+            max_state_slots=6,
+            max_speculative_tokens=speculative_tokens,
+            round_before_silu=round_before_silu,
+        )
+        self.length = dilation * (kernel_size - 1)
+        capacity = self.length + speculative_tokens
+        stride = channels * capacity + 32
+        self.storage = torch.full(
+            (6 * stride,), 17, dtype=torch.bfloat16, device=device
+        )
+        self.state = self.storage.as_strided(
+            (6, channels, capacity), (stride, capacity, 1)
+        )
+        self.input_storage = torch.randn(
+            (max_tokens, channels + input_padding), device=device
+        ).to(torch.bfloat16)
+        self.x = self.input_storage[:, :channels]
+        self.weight = (torch.randn((channels, kernel_size), device=device) * 0.2).to(
+            weight_dtype
+        )
+        self.args = dict(
+            x=self.x,
+            conv_weight=self.weight,
+            conv_state=self.state,
+            out=torch.full_like(self.x, float("nan")),
+            query_start_loc=torch.zeros(5, dtype=torch.int32, device=device),
+            state_slot_ids=torch.full((4,), -1, dtype=torch.int64, device=device),
+            state_is_fresh=torch.zeros(4, dtype=torch.bool, device=device),
+            num_accepted_tokens=torch.ones(4, dtype=torch.int32, device=device),
+            num_seqs=torch.zeros(1, dtype=torch.int32, device=device),
+            num_tokens=torch.zeros(1, dtype=torch.int32, device=device),
+        )
+        if mode == "mixed":
+            self.args["request_is_prefill"] = torch.zeros(
+                4, dtype=torch.bool, device=device
+            )
+        if bias_dtype is not None:
+            self.args["conv_bias"] = torch.randn(
+                channels, device=device, dtype=bias_dtype
+            )
+
+    def batch(self, lengths, slots, fresh, accepted, prefill=None):
+        n = len(lengths)
+        starts = [0]
+        for length in lengths:
+            starts.append(starts[-1] + length)
+        for name, values, pad in (
+            ("query_start_loc", starts, -12345),
+            ("state_slot_ids", slots, 2**40),
+            ("state_is_fresh", fresh, False),
+            ("num_accepted_tokens", accepted, -12345),
+        ):
+            dest = self.args[name]
+            dest.copy_(
+                torch.tensor(
+                    values + [pad] * (dest.numel() - len(values)),
+                    dtype=dest.dtype,
+                    device=dest.device,
+                )
+            )
+        self.args["num_seqs"].fill_(n)
+        self.args["num_tokens"].fill_(sum(lengths))
+        if prefill is not None:
+            self.args["request_is_prefill"].copy_(
+                torch.tensor(
+                    prefill + [False] * (4 - n),
+                    dtype=torch.bool,
+                    device=self.x.device,
+                )
+            )
+
+    def oracle(self):
+        expected = torch.zeros_like(self.x)
+        state = self.state.clone()
+        count = int(self.args["num_seqs"].item())
+        for request in range(count):
+            slot = int(self.args["state_slot_ids"][request].item())
+            start, end = self.args["query_start_loc"][request : request + 2].tolist()
+            if slot < 0 or start == end:
+                continue
+            prefill = self.caps.mode == "prefill" or (
+                self.caps.mode == "mixed"
+                and bool(self.args["request_is_prefill"][request])
+            )
+            accepted = int(self.args["num_accepted_tokens"][request].item())
+            offset = 0 if prefill else accepted - 1
+            history = state[slot, :, offset : offset + self.length].clone()
+            if bool(self.args["state_is_fresh"][request]):
+                history.zero_()
+            sequence = torch.cat((history, self.x[start:end].T), dim=1)
+            dtype = self.weight.dtype if self.caps.round_before_silu else torch.float32
+            conv = F.conv1d(
+                sequence.unsqueeze(0).to(dtype),
+                self.weight.unsqueeze(1).to(dtype),
+                bias=None
+                if "conv_bias" not in self.args
+                else self.args["conv_bias"].to(dtype),
+                groups=self.caps.channels,
+                dilation=self.caps.dilation,
+            )
+            if self.caps.round_before_silu:
+                conv = conv.to(self.x.dtype)
+            expected[start:end] = F.silu(conv).squeeze(0).T.to(self.x.dtype)
+            committed = end - start if prefill else 1
+            state[slot, :, : self.length] = sequence[
+                :, committed : committed + self.length
+            ]
+            state[slot, :, self.length :] = 0
+            if not prefill and end - start > 1:
+                state[slot, :, self.length : self.length + end - start - 1] = self.x[
+                    start + 1 : end
+                ].T
+        return expected, state
+
+
+@contextmanager
+def _prepared(case):
+    plan = short_conv.plan(
+        case.caps, invocation=short_conv.invocation_from_tensors(**case.args)
+    )
+    box = []
+
+    def prepare_call(state):
+        scratch = {
+            s.name: torch.empty(s.shape, dtype=s.dtype, device=s.device)
+            for s in plan.scratch_specs()
+        }
+        binding = state.bind(plan=plan, scratch=scratch, **case.args)
+        box.append(binding)
+        return PreparedCall(run=lambda: state.run(binding), output=binding.out)
+
+    with PreparationSession(
+        device=case.x.device, autotune=False, compile_workers=1
+    ) as session:
+        session.prepare((plan.request(name="short_conv", prepare_call=prepare_call),))
+        session.freeze()
+        yield box[0]
+
+
+@pytest.mark.parametrize("max_tokens", [12, 300])
+@pytest.mark.parametrize("mode", ["decode", "prefill", "mixed"])
+@pytest.mark.parametrize("input_padding", [0, 6144])
+def test_gdn_width_raw_history_and_device_metadata_replay(
+    mode, input_padding, max_tokens
+):
+    case = _Case(mode, input_padding=input_padding, max_tokens=max_tokens)
+    with _prepared(case) as binding:
+        graph = torch.cuda.CUDAGraph()
+        with torch.cuda.graph(graph):
+            result = short_conv.run(binding)
+        batches = (
+            (
+                [4, 2, 0],
+                [4, 1, -1],
+                [False, True, False],
+                [3, 1, 0],
+                [False, True, False],
+            ),
+            ([1, 3], [-1, 4], [False, True], [0, 1], [False, False]),
+            ([], [], [], [], []),
+            ([0, 0, 0], [5, 0, 2], [True, True, True], [1, 1, 1], [True, False, True]),
+        )
+        for lengths, slots, fresh, accepted, prefill in batches:
+            case.x.normal_()
+            case.batch(
+                lengths, slots, fresh, accepted, prefill if mode == "mixed" else None
+            )
+            expected, state = case.oracle()
+            untouched_padding = case.storage.reshape(6, -1)[:, -32:].clone()
+            untouched_input = case.input_storage.clone()
+            torch.cuda.synchronize()
+            allocated = torch.cuda.memory_allocated()
+            graph.replay()
+            torch.cuda.synchronize()
+            assert torch.cuda.memory_allocated() == allocated
+            assert result.data_ptr() == case.args["out"].data_ptr()
+            torch.testing.assert_close(result, expected, rtol=0.008, atol=0.002)
+            torch.testing.assert_close(case.state, state, rtol=0, atol=0)
+            torch.testing.assert_close(
+                case.input_storage, untouched_input, rtol=0, atol=0
+            )
+            torch.testing.assert_close(
+                case.storage.reshape(6, -1)[:, -32:], untouched_padding, rtol=0, atol=0
+            )
+        graph.reset()
+
+
+@pytest.mark.parametrize("accepted", [1, 2, 4])
+def test_decode_selects_accepted_history_and_retains_raw_candidates(accepted):
+    case = _Case("decode", channels=65)
+    prior = torch.randn_like(case.state)
+    with _prepared(case) as binding:
+        case.state.copy_(prior)
+        case.batch([4], [2], [False], [accepted])
+        expected, state = case.oracle()
+        short_conv.run(binding)
+        torch.testing.assert_close(binding.out, expected, rtol=0.008, atol=0.002)
+        torch.testing.assert_close(case.state, state, rtol=0, atol=0)
+        torch.testing.assert_close(case.state[2, :, -3:], case.x[1:4].T, rtol=0, atol=0)
