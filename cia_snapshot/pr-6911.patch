+class _DenseGemmFusedQuantALaunch(_DenseGemmLaunch):
+    """Small-M MXFP8 launch that quantizes BF16 A into each CTA's stages."""
+
+    def __init__(
+        self,
+        *args,
+        fused_quant_a_inner_span: int = 0,
+        fused_quant_a_wide: bool = False,
+        **kwargs,
