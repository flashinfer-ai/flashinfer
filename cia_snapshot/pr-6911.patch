+        m == 16
+        and is_mxfp8
+        and sf_vec_size == 32
+        and tile_k == 128
+        and mma_tiler_mn == (32, 64)
+        and load_path == "tma"
+        and not swap_ab
+        and b_tile_major
+        and sfb_k_reuse
+        and alpha_is_one
+        and (n, k, l) in ((1024, 4096, 4), (4096, 4096, 1))
+    )
