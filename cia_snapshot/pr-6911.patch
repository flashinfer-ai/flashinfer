+                "dense_gemm launch is unsupported with "
+                f"{ab_dtype}, {sf_dtype}, {sf_vec_size}, {c_dtype}, "
+                f"{mma_tiler_mn}, {cluster_shape_mn}, {n}, {k}, {l}, "
+                f"{a_major}, {b_major}, {c_major}, "
