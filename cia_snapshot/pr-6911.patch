+        kernel_c_l,
+        ab_dtype,
+        sf_dtype,
+        kernel_c_dtype,
+        alpha_dtype,
+        sf_vec_size,
+        mma_k,
+        tile_k,
+        mma_tile_m,
+        mma_tile_n,
+        cluster_shape_m,
+        cluster_shape_n,
+        sm_count,
+        single_work_tile_per_cta,
+        direct_one_m_tile_scheduler,
