+@dataclass(frozen=True)
+class _DenseGemmPolicy:
+    single_work_tile_per_cta: bool
+    direct_one_m_tile_scheduler: bool
+    use_m1_non_tma: bool
+    split_k_slices: int
+    split_k_atomic_bf16: bool
