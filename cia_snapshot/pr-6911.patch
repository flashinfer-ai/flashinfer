+            if (n, k, l) == (1024, 4096, 4):
+                self._b_tile_n = 64
+            elif (n, k, l) == (4096, 4096, 1):
+                self._b_tile_n = 128
+            else:
+                raise ValueError(
+                    "tile-major B is restricted to production WO-A/WO-B shapes, "
+                    f"got {(n, k, l)}"
+                )
+        else:
+            self._b_tile_n = 0
