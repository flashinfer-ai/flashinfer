-int64_t MTiles(int64_t rows) {
-  // Row tiles are consumed in CTA pairs: round the tile count up to an even number.
-  int64_t tiles = (rows + kBlockM - 1) / kBlockM;
-  return tiles + tiles % kCtaGroup;
-}
