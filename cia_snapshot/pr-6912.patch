+    """GLM-5.3 TP6: FC1 N = 704 and FC2 K = 352 share a 128-thread geometry."""
+    common = dict(
+        moe_block_size=block,
+        sms=188,
+        max_shared_mem=101_376,
+        scale_format="e4m3_k16",
+        weight_layout="packed",
