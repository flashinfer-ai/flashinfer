+        kernel,
+        a_fake,
+        a_fake,
+        b_fake,
+        c_fake,
+        scales_fake,
+        global_scale_fake,
+        packed_routes_fake,
+        block_experts_fake,
+        route_count_fake,
+        topk_fake,
+        c_tmp_fake,
+        locks_fake,
+        trellis_lut_fake,
+        Int32(compile_size_m),
+        Int32(1),
+        current_cuda_stream(),
+        compile_spec=KernelCompileSpec.from_key(
+            "moe.w4a16.gemm",
+            4,
+            cache_key,
