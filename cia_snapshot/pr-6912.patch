+                    ]
+                    + r1
+                )
+                acc[(flat_j * 4 + 2) // _SCALAR_ACC_FRAGMENT_WIDTH][
+                    (flat_j * 4 + 2) % _SCALAR_ACC_FRAGMENT_WIDTH
+                ] = (
