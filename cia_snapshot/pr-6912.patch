-        csf = self.csf
-        codes = ld_shared_u16_zx(
-            stage
-            + Int32(csf.codes)
-            + slab * Int32(64 * csf.groups)
-            + group * Int32(64)
-            + lane * Int32(2)
-        )
-        codes = (codes | (codes << Uint32(12))) & Uint32(0x0F0F0F0F)
