+    @cute.jit
+    def _fold_cta_partials_large_m_block(
+        self,
+        acc,
+        smem_base: Int32,
+        red_off: cutlass.Constexpr[int],
+        red_idx: Int32,
+        red_sh_stride: Int32,
+        red_sh_delta: Int32,
+        red_sh_rd: Int32,
+    ):
+        if cutlass.const_expr(red_off == 2):
