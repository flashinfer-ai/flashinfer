+    c_fake = make_ptr(cutlass_dtype, 16, cute.AddressSpace.gmem, assumed_align=16)
+    scales_fake = cute.runtime.make_fake_compact_tensor(
+        cutlass.Int32,
+        (
+            _scale_fake_int32_elements(
