+            if cutlass.const_expr(self.direct_topk_routes):
+                route = route_pos
+                expert = packed_route_indices[route_pos].to(Int32)
+                if cutlass.const_expr(self.use_expert_map):
+                    global_expert = expert
+                    expert = Int32(-1)
