+        bits = _offset_bits(self.quantization)
+        page_blocks = _page_block_offsets(self.rows, self.columns)
+        pages = len(page_blocks) - 1
+        widths = np.minimum(2, self.columns - 2 * (order % ((self.columns + 1) // 2)))
