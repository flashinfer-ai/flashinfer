+    )
+    result = W4A16GemmCompileResult(
+        compiled=compiled,
+        tile_n=tile_n,
+        tile_k=tile_k,
+        moe_block_size=moe_block_size,
+        max_m_blocks=max_m_blocks,
+        blocks_per_sm=kernel.blocks_per_sm,
+        weight_layout=weight_layout,
+        scale_format=scale_format,
