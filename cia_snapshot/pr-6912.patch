-                ig2_1 = gh1 * svg1
-                ig2_2 = gh2 * svg2
-                ig2_3 = gh3 * svg3
-                iu2_0 = uh0 * svu0
-                iu2_1 = uh1 * svu1
-                iu2_2 = uh2 * svu2
-                iu2_3 = uh3 * svu3
