-                u1 = fc1_bf16_flat[u_base + Int32(1)].to(cutlass.Float32)
-                u2 = fc1_bf16_flat[u_base + Int32(2)].to(cutlass.Float32)
-                u3 = fc1_bf16_flat[u_base + Int32(3)].to(cutlass.Float32)
