+        cute.arch.sync_threads()
+
+        if red_idx == Int32(0):
+            for flat_j in cutlass.range_constexpr(8):
+                rd_addr = self._int4_addr(
+                    smem_base,
+                    Int32(self.sh_red_off) + red_sh_delta * Int32(flat_j) + red_sh_rd,
