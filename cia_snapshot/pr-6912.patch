-    @cute.jit
-    def _run_activation(
-        self,
-        fc1_bf16_flat: cute.Tensor,
-        activated_bf16_flat: cute.Tensor,
-        rot_scales_flat: cute.Tensor,
-        tid: Int32,
-        cta: Int32,
-        grid_x: Int32,
