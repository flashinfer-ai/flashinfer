-    @cute.jit
-    def _had4_normalized(
-        self,
-        v0: cutlass.Float32,
-        v1: cutlass.Float32,
-        v2: cutlass.Float32,
-        v3: cutlass.Float32,
-    ):
-        """Normalized natural-order H4 over four H128 subblocks."""
-        s0 = v0 + v1
-        d0 = v0 - v1
-        s1 = v2 + v3
-        d1 = v2 - v3
-        rs = cutlass.Float32(0.5)
-        return (
-            (s0 + s1) * rs,
-            (d0 + d1) * rs,
-            (s0 - s1) * rs,
-            (d0 - d1) * rs,
-        )
