+            )
+            return result[0] if isinstance(result, list) else result
+
+        return PreparedPrecision(
+            "fp8_block", shape, ids, routing_weights, packed, output, invoke
+        )
+
+    clamped, unclamped = prepare(0.5), prepare(1.0e9)
