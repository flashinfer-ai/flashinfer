+def _resident_ring(output_tile, token_tile, k_tile, stages, ctas_per_sm):
+    """Deepest legal ring that lets ``ctas_per_sm`` CTAs co-reside on one SM."""
+    fit = [
+        s
+        for s in stages
+        if ctas_per_sm
+        * (
+            _smem_bytes(WarpSplitKTactic(output_tile, token_tile, k_tile, s, 1))
+            + _CTA_RESERVED_SMEM
+        )
+        <= _SM_SMEM_BYTES
+    ]
