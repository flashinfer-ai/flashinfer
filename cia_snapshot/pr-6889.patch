+            mma_tile_mnk,
+            mma_tile_mnk_vp,
+            tiled_mma_kq,
+            tiled_mma_vp,
+            mma_dtype,
+            kq_dtype,
+            vp_dtype,
+            o_smem_dtype,
+            smem_layout_q,
+            tma_atom_q,
+            tma_tensor_q,
+            smem_layout_k,
+            tma_atom_k,
+            tma_tensor_k,
+            tiled_mma_kq_sfb,
+            smem_layout_sfk,
+            smem_layout_sfk_raw,
+            tma_atom_sfk,
+            tma_tensor_sfk,
+            smem_layout_sfq,
+            tma_atom_sfq,
+            tma_tensor_sfq,
+            smem_layout_v,
+            smem_layout_v_sf_d,
+            tma_atom_v,
+            tma_tensor_v,
+            tma_atom_v_sf_d,
+            tma_tensor_v_sf_d,
