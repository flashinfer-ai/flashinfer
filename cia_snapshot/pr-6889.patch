+        _ksf_bytes = self.page_size * (self.headdim // sf_vec_size)
+        mSFK = cute.make_tensor(
+            k_sf.iterator,
+            cute.make_layout(
+                (16, _ksf_bytes // 16, (k_sf.shape[1], k_sf.shape[0])),
+                stride=(
+                    1,
+                    16,
+                    (k_sf.stride[1], k_sf.stride[0]),
