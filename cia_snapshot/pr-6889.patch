+        if cutlass.const_expr(self.do_kernel_red):
+            self.launch_reduction(
+                self.headdim,
+                o_bshd,
+                o_partial_bshd,
+                l_partial_bsh,
+                m_partial_bsh,
+                scale_o,
+                o_block_scale,
+                o_global_scale,
