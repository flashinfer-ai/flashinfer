+        coord_hb = cute.idx2crd(coord_hb, tiles_hb)
+        coord_hp = cute.idx2crd(coord_hp, tiles_hp)
+        coord_hg, coord_p = coord_hp
+        coord_hk, coord_b = coord_hb
