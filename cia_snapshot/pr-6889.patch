+// SPDX-License-Identifier: Apache-2.0
+// Adapted from ResInfer 51b906836a69fa43915040314df57bc9f23030ad,
+// csrc/nvfp4/cuda/nvfp4_quant_kernels.cu (NVIDIA Apache-2.0 base).
