+            stride_order=(4, 3, 2, 1, 0),
+            assumed_align=16,
+        )
+        partial_shape = (
+            sym_splits,
+            sym_batch,
+            1,
+            num_qo_heads,
+        )
+        l_partial_fake = cute.runtime.make_fake_compact_tensor(
+            cutlass.Float32,
+            partial_shape,
+            stride_order=(3, 2, 1, 0),
+            assumed_align=16,
+        )
+        m_partial_fake = cute.runtime.make_fake_compact_tensor(
+            cutlass.Float32,
+            partial_shape,
+            stride_order=(3, 2, 1, 0),
+            assumed_align=16,
+        )
+        if reduction == "gmem_fused":
+            completion_fake = cute.runtime.make_fake_compact_tensor(
+                Int32,
+                (cute.sym_int(),),
+                stride_order=(0,),
+                assumed_align=16,
+            )
+    seq_lens_fake = cute.runtime.make_fake_compact_tensor(
+        Int32,
+        (sym_batch,),
+        assumed_align=4,
+    )
+    block_tables_fake = cute.runtime.make_fake_tensor(
+        Int32,
+        (sym_batch, cute.sym_int()),
+        stride=(cute.sym_int(), 1),
+        assumed_align=4,
+    )
+    stream_fake = cute.runtime.make_fake_stream(use_tvm_ffi_env_stream=True)
+    compile_options = "--enable-tvm-ffi --opt-level 3"
+    return cute.compile(
+        fmha,
+        Int32(1),
+        q_fake,
+        k_fake,
+        v_fake,
+        sf_flat(),
+        k_sf_fake,
+        v_sf_fake,
+        o_fake,
+        o_sf_fake,
+        o_global_scale_fake,
+        o_partial_fake,
+        l_partial_fake,
+        m_partial_fake,
+        completion_fake,
+        Float32(1.0),
+        Float32(1.0),
+        seq_lens_fake,
+        block_tables_fake,
+        stream_fake,
+        True,
+        options=compile_options,
+    )
