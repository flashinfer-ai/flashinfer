+++ b/csrc/resinfer_mext_quantize.cu
@@ -0,0 +1,52 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 Rong Shuo
+// SPDX-License-Identifier: Apache-2.0
+// FlashInfer TVM-FFI binding for ResInfer's MEXT quantizer.
+#include <tvm/ffi/extra/cuda/device_guard.h>
+
+#include <climits>
+#include <flashinfer/experimental/resinfer/quantize.cuh>
+
+#include "tvm_ffi_utils.h"
+
+void quantize(TensorView input, TensorView scales, TensorView output, TensorView output_scales) {
+  CHECK_INPUT(input);
+  CHECK_INPUT(scales);
+  CHECK_INPUT(output);
+  CHECK_INPUT(output_scales);
+  CHECK_DEVICE(input, scales);
+  CHECK_DEVICE(input, output);
+  CHECK_DEVICE(input, output_scales);
+  CHECK_DIM(2, input);
+  CHECK_DIM(2, output);
+  check_dtype(scales, dl_float32, "scales");
+  check_dtype(output, dl_uint8, "output");
+  check_dtype(output_scales, dl_uint8, "output_scales");
+  auto m = input.size(0), k = input.size(1);
+  TVM_FFI_ICHECK(m > 0 && m <= INT_MAX / 2 && k > 0 && k <= INT_MAX && k % 16 == 0);
+  TVM_FFI_ICHECK(scales.numel() == 1 || scales.numel() == 2);
+  TVM_FFI_ICHECK(output.size(0) == 2 * m && output.size(1) == k / 2);
+  TVM_FFI_ICHECK_EQ(output_scales.numel(), ((2 * m + 127) / 128) * ((k + 63) / 64) * 512);
+  TVM_FFI_ICHECK_EQ(reinterpret_cast<uintptr_t>(input.data_ptr()) % 32, 0);
+  TVM_FFI_ICHECK_EQ(reinterpret_cast<uintptr_t>(output.data_ptr()) % 8, 0);
+  ffi::CUDADeviceGuard guard(input.device().device_id);
+  int major, minor, sms;
+  cudaDeviceGetAttribute(&major, cudaDevAttrComputeCapabilityMajor, input.device().device_id);
+  cudaDeviceGetAttribute(&minor, cudaDevAttrComputeCapabilityMinor, input.device().device_id);
+  TVM_FFI_ICHECK(major == 10 && minor == 0) << "ResInfer MEXT currently supports SM100";
+  cudaDeviceGetAttribute(&sms, cudaDevAttrMultiProcessorCount, input.device().device_id);
+  int groups = k / 16;
+  int desired_y = std::min<int>((((m + 127) / 128) * 128 + m - 1) / m, groups);
+  int threads = std::min(512, std::max(32, ((groups + desired_y - 1) / desired_y + 31) / 32 * 32));
+  dim3 block(threads), grid(std::min<int64_t>(m, sms * 4), (groups + threads - 1) / threads);
+  auto stream = get_stream(input.device());
+  DISPATCH_DLPACK_DTYPE_TO_CTYPE_FP16(input.dtype(), T, [&] {
+    flashinfer::resinfer::QuantizeRowPairs<T><<<grid, block, 0, stream>>>(
+        m, k, static_cast<const T*>(input.data_ptr()), static_cast<const float*>(scales.data_ptr()),
+        scales.numel(), static_cast<uint32_t*>(output.data_ptr()),
+        static_cast<uint8_t*>(output_scales.data_ptr()));
+    return true;
+  });
+  auto status = cudaGetLastError();
+  TVM_FFI_ICHECK_EQ(status, cudaSuccess) << cudaGetErrorString(status);
+}
+TVM_FFI_DLL_EXPORT_TYPED_FUNC(quantize, quantize);
diff --git a/examples/resinfer/bench_mext.py b/examples/resinfer/bench_mext.py
new file mode 100644
index 00000000000..895aae511cc
--- /dev/null
+++ b/examples/resinfer/bench_mext.py
@@ -0,0 +1,86 @@
+# SPDX-FileCopyrightText: Copyright (c) 2026 Rong Shuo
+# SPDX-License-Identifier: Apache-2.0
+"""ResInfer MEXT vs upstream CuTe GEMM plus separate row-pair reduction.
+
+Run from the fork: python examples/resinfer/bench_mext.py --m 32 --n 4096 --k 4096
+Weight preparation is excluded. Activation quantization is included only in
+measurements named quantize_and_*. These are kernel pipelines, not model E2E.
+The upstream baseline rounds paired outputs to BF16 before folding; ResInfer
+folds FP32 accumulators before conversion, so they need not be bit-identical.
+"""
+
+import argparse
+import json
+import statistics
+
+import torch
+
+from flashinfer import mm_fp4
+from flashinfer.resinfer import mm_nvfp4_residue, nvfp4_quantize_residue
+from flashinfer.testing import bench_gpu_time
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    for name, default in [("m", 32), ("n", 4096), ("k", 4096)]:
+        parser.add_argument(f"--{name}", type=int, default=default)
+    args = parser.parse_args()
+    torch.manual_seed(42)
+    x = torch.randn(args.m, args.k, device="cuda", dtype=torch.bfloat16)
+    scale = torch.tensor([64.0], device="cuda")
+    alpha = scale.reciprocal()
+    w = torch.randint(0, 256, (args.n, args.k // 2), device="cuda", dtype=torch.uint8)
+    ws = (
+        torch.ones(((args.n + 127) // 128) * ((args.k + 63) // 64) * 512, device="cuda")
+        .to(torch.float8_e4m3fn)
+        .view(torch.uint8)
+    )
+    a, sf = nvfp4_quantize_residue(x, scale)
+
+    def folded(a, sf):
+        return mm_nvfp4_residue(a, w, sf, ws, alpha)
+
+    def separate(a, sf):
+        y = mm_fp4(a, w.T, sf, ws, alpha, backend="cute-dsl")
+        return y.reshape(args.m, 2, args.n).sum(dim=1)
+
+    paths = {
+        "fold": lambda: folded(a, sf),
+        "upstream_separate_fold": lambda: separate(a, sf),
+        "quantize_and_fold": lambda: folded(*nvfp4_quantize_residue(x, scale)),
+        "quantize_and_upstream_separate_fold": lambda: separate(
+            *nvfp4_quantize_residue(x, scale)
+        ),
+    }
+    # Warm all paths; fail loudly on compilation or shape errors before timing.
+    outputs = {name: fn() for name, fn in paths.items()}
+    for y in outputs.values():
+        assert torch.isfinite(y).all()
+    raw = {
+        name: bench_gpu_time(fn, dry_run_iters=10, repeat_iters=30)
+        for name, fn in paths.items()
+    }
+    print(
+        json.dumps(
+            {
+                "gpu": torch.cuda.get_device_name(),
+                "torch": torch.__version__,
+                "shape": vars(args),
+                "milliseconds": raw,
+                "median_ms": {name: statistics.median(v) for name, v in raw.items()},
+                "fold_vs_baseline_max_abs": float(
+                    (
+                        outputs["fold"].float()
+                        - outputs["upstream_separate_fold"].float()
+                    )
+                    .abs()
+                    .max()
+                ),
+            },
+            indent=2,
+        )
+    )
+
+
+if __name__ == "__main__":
+    main()
