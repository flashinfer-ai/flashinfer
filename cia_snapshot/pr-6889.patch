+        q_load_mbar = smem.allocate_array(Int64, 1)
+        sfq_mbar = smem.allocate_array(Int64, 1)
+        if warp_idx == init_warp:
+            expect_tx_bytes = cute.size_in_bytes(q_dtype, smem_layout_q)
+            with cute.arch.elect_one():
