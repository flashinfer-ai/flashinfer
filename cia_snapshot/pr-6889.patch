+        tma_atom_sfq, tma_tensor_sfq = cute.nvgpu.make_tiled_tma_atom_B(
+            sfb_op,
+            mSFQ,
+            cute.select(smem_layout_sfq, mma_modes),
+            (mma_tile_mnk[0], mma_tile_n_sfb, mma_tile_mnk[2]),
+            tiled_mma_kq_sfb,
+            internal_type=cutlass.Int16,
