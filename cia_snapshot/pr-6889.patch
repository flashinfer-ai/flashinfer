+        tma_atom_sfk: cute.CopyAtom,
+        mSFK: cute.Tensor,
+        smem_layout_sfq: cute.Layout,
+        tma_atom_sfq: cute.CopyAtom,
+        mSFQ: cute.Tensor,
+        smem_layout_v: cute.ComposedLayout,
+        smem_layout_v_sf_d: cute.Layout,
