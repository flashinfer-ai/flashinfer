+
+        if warp_idx == init_warp and not exit_early:
+            cute.arch.alloc_tmem(tmem_alloc_cols, tmem_ptr_smem_ptr)
+        init_warp += 1
+
+        softmax_threads = warpgroup_threads
+        correction_threads = warpgroup_threads
