+        num_rows=int(values["num_rows"]),
+        num_requests=int(values["num_requests"]),
+        page_size=int(values["page_size"]),
+    )
+    grid_values = {"grid_x": grid[0], "grid_y": grid[1], "grid_z": grid[2]}
