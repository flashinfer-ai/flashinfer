+            dsa_sparse_attention_nope_varlen(
+                inp.q,
+                inp.kv,
+                inp.idx_local,
+                i32(0, 300, 256, inp.total_q),
+                i32(0, 512, 512, inp.total_k),
+                check_cu_seqlens=True,
+            )
+        with pytest.raises(ValueError, match="int32"):
+            dsa_sparse_attention_nope_varlen(
+                inp.q, inp.kv, inp.idx_local, cu_q.long(), cu_k
