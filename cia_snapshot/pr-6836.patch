+    short = cu_k.clone()
+    short[-1] = inp.total_k - 64
+    with _quiet_experimental():
+        with pytest.raises(ValueError, match=r"cu_seqlens_k\[-1\]"):
+            dsa_sparse_attention_nope_varlen(
