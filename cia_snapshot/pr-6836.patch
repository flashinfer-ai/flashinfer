+def _nope_inputs(seq_q, seq_k, *, seed, topk, index="iid", **kw):
+    return nope_ref.make_nope_inputs(
+        seq_q if isinstance(seq_q, list) else [seq_q],
+        seq_k if isinstance(seq_k, list) else [seq_k],
+        seed=seed,
+        topk=topk,
+        index=index,
+        **kw,
+    )
