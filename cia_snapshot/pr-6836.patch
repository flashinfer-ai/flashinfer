+def _index_prep_example():
+    """The four-document example of the causal glue test: tail segments, an empty query segment, a fully masked
+    row, a repeated key."""
+    cu_q = _i32(0, 3, 5, 5, 9)
+    cu_k = _i32(0, 5, 11, 14, 18)
+    local = torch.tensor(
+        [
+            [0, 1, 2, -1, 4],
+            [1, 0, 3, 4, -1],
+            [2, 1, 0, 4, 5],
+            [4, 5, 3, -1, 6],
+            [5, 4, 0, 6, -1],
+            [0, 1, 2, 3, -1],
+            [3, 2, 1, 0, 4],
+            [-1, -1, -1, -1, -1],
+            [3, 0, 1, 2, 3],
+        ],
+        dtype=torch.int32,
+    )
+    return local, cu_q, cu_k
