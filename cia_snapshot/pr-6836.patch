+def forward_binding_key_nope(
+    q_latent: torch.Tensor,
+    kv_latent: torch.Tensor,
+    indices: torch.Tensor,
+    topk_length: Optional[torch.Tensor],
+    softmax_scale: float,
+    derive_topk_length: bool = False,
