+            "state_checkpoint_needed": "u32",
+            "tape_qd": "bf16",
+            "tape_kd": "bf16",
+            "tape_kr": "bf16",
+            "tape_j": "bf16",
+            "tape_restore_factor": "f32",
+            "tape_e": "bf16",
+            "tape_x": "bf16",
+            "tape_r": "bf16",
+            "norm_inv_out": "f32",
