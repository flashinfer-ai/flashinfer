+"""Host bindings of the generated KDA prefill modules, rendered from one template.
+
+Each ``cake_kda_{bf16,tf32}_<digest>`` module pairs an exported kernel body with
+a tvm-ffi launcher: argument checks, TMA descriptor encoding into the
+caller-owned workspace and the launch of the module's kernel symbol. The
+launcher text is a fixed function of the module's argument plan
+(``cake_kda_tf32.ARG_PLANS``) and of the per-module facts recorded below, so
+``cake_kda_tf32.spec`` renders it into the generated-source directory at
+JIT-spec creation instead of reading a checked-in copy. Every module keeps its
+own kernel symbol and host-shim namespace, which lets all modules load into one
+process. The preparing entries encode and upload the TMA descriptors and opt
+the kernel into its dynamic shared memory; the launch-only entry reuses both.
+"""
+
+from string import Template
+from textwrap import indent
+
+# Tensor dtype code -> (tvm_ffi_utils.h DLDataType constant, device pointer
+# element type).
+_TENSOR_TYPES = {
+    "bf16": ("dl_bfloat16", "__nv_bfloat16"),
+    "f32": ("dl_float32", "float"),
+    "i32": ("dl_int32", "int"),
+    "i64": ("dl_int64", "long long"),
+    "u32": ("dl_uint32", "unsigned int"),
+}
+
+# Scalar code -> (host value type, kernel parameter type, FFI parameter type,
+# range check as (label, min, max) or None when the FFI type already fits).
+_SCALAR_TYPES = {
+    "i32": ("int32_t", "int", "int64_t", ("i32", -2147483648, 2147483647)),
+    "i64": ("int64_t", "long long", "int64_t", None),
+    "u64": (
+        "uint64_t",
+        "unsigned long long",
+        "int64_t",
+        ("u64", 0, 9223372036854775807),
+    ),
+    "f32": ("float", "float", "double", None),
+}
+
+# Launch kind -> template of the launch statement.
+_LAUNCH_TEMPLATES = {
+    "kernel": "launch_kernel",
+    "exc": "launch_exc",
+    "exc_pdl": "launch_exc_pdl",
+    "exc_pdl_bare": "launch_exc_pdl_bare",
+}
+
+# Kernels above this dynamic shared memory size (48 KiB) need the opt-in attribute.
+_DEFAULT_SMEM_LIMIT = 49152
+
+# Text fragments of a binding (string.Template syntax: ``$name``).
+_TEMPLATES = {
+    "preamble": """/*
+ * Copyright (c) 2026, NVIDIA CORPORATION. All rights reserved.
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *   http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+// Generated by the Cake source exporter — do not edit.
+// tvm-ffi direct-source launcher for Cake kernel '$symbol'.
+#include "cake_kda_prefill_host_shim.cuh"
+
+${tensor_map}extern "C" __global__ void $symbol($kernel_params);
+
+namespace $namespace {
+
+using namespace cake_kda_prefill_shim;
+using tvm::ffi::Optional;
+using tvm::ffi::TensorView;
+
+void $entry($entry_params) {
+  DLDevice dev = arg_$first.device();
+  tvm::ffi::CUDADeviceGuard device_guard(dev.device_id);
+""",
+    "tensor": """  check_cuda_tensor(arg_$name, "$name");
+  check_dtype(arg_$name, $dtype, "$name");
+""",
+    "contiguous": """  check_contiguous(arg_$name, "$name");
+""",
+    "pitched": """  TVM_FFI_CHECK(arg_$name.stride(-1) == 1, ValueError)
+      << "$name must have unit innermost stride; the kernel reads its token pitch from ${name}_token_stride";
+""",
+    "strided": """  TVM_FFI_CHECK(arg_$name.ndim() >= 3, ValueError)
+      << "$name must have at least 3 dimensions";
+  TVM_FFI_CHECK(arg_$name.stride(-1) == 1, ValueError)
+      << "$name must have unit innermost stride unless the kernel consumes stride(-1)";
+""",
+    "range": """  TVM_FFI_CHECK(arg_$name >= ${min}LL && arg_$name <= ${max}LL, ValueError)
+      << "scalar '$name' value " << arg_$name
+      << " is outside $label range [$min, $max]";
+""",
+    "same_device": """  CheckSameCudaDevice(arg_$name, arg_$first, "$name", "$first");
+""",
+    "current_device": """  CheckCurrentCudaDevice(arg_$first, "$first");
+""",
+    "workspace": """  check_cuda_tensor(arg_tma_descriptor_workspace, "tma_descriptor_workspace");
+  CheckSameCudaDevice(arg_tma_descriptor_workspace, arg_$first, "tma_descriptor_workspace", "$first");
+  check_contiguous(arg_tma_descriptor_workspace, "tma_descriptor_workspace");
+  check_dtype(arg_tma_descriptor_workspace, dl_uint8, "tma_descriptor_workspace");
+  TVM_FFI_CHECK(arg_tma_descriptor_workspace.numel() >= $bytes, ValueError)
+      << "tma_descriptor_workspace requires at least $bytes bytes";
+  TVM_FFI_CHECK(
+      reinterpret_cast<uintptr_t>(arg_tma_descriptor_workspace.data_ptr()) % 128 == 0,
+      ValueError)
+      << "tma_descriptor_workspace must be 128-byte aligned";
+""",
+    "grid": """  TVM_FFI_CHECK(grid_x > 0 && grid_y > 0 && grid_z > 0, ValueError)
+      << "launch grid dimensions must be positive, got (" << grid_x << ", " << grid_y
+      << ", " << grid_z << ")";
+
+  cudaStream_t stream = (cudaStream_t)TVMFFIEnvGetStream(dev.device_type, dev.device_id);
+""",
+    "pointer": """  $ctype* p_$name = static_cast<$ctype*>(arg_$name.data_ptr());
+""",
+    "descriptor": """  CakeTensorMap const* p_$name = static_cast<CakeTensorMap const*>(CallerTmaWorkspaceSlot(arg_tma_descriptor_workspace, ${slot}u));
+""",
+    "encode": """        EncodeTma_${name}_$encoder(arg_$name),
+""",
+    "scalar": """  $ctype v_$name = ($ctype)arg_$name;
+""",
+    "stride": """  int64_t v_${name}_stride_m3 = arg_$name.stride(-3);
+""",
+    "kargs": """  void* kargs[] = {$kargs};
+
+""",
+    "shared_memory": """  static std::mutex smem_mu;
+  static auto* smem_status_by_device =
+      new std::unordered_map<int, cudaError_t>();
+  cudaError_t smem_status = EnsureMaxDynamicSharedMemory(
+      smem_mu, *smem_status_by_device, dev.device_id,
+      reinterpret_cast<const void*>($symbol), $smem);
+  TVM_FFI_CHECK(smem_status == cudaSuccess, RuntimeError)
+      << "cudaFuncSetAttribute for $symbol failed: "
+      << cudaGetErrorString(smem_status);
+""",
+    "dims": """  dim3 grid((uint32_t)grid_x, (uint32_t)grid_y, (uint32_t)grid_z);
+  dim3 block(${block}u, 1u, 1u);
+""",
+    "upload": """  // Only the preparing actions encode and upload the descriptors and opt
+  // the kernel into its dynamic shared memory; the launch-only action reuses
+  // both from the preparation that filled this workspace.
+  if (descriptor_action != 0) {
+    const CUtensorMap workspace_maps[] = {
+$maps    };
+$shared_memory    UploadCallerTmaWorkspace(arg_tma_descriptor_workspace.data_ptr(), workspace_maps, stream);
+  }
+  if (descriptor_action == 1) return;
+""",
+    "launch_kernel": """
+  cudaError_t launch_status = cudaLaunchKernel(
+      reinterpret_cast<const void*>($symbol), grid, block, kargs, ${smem}u, stream);
+  TVM_FFI_CHECK(launch_status == cudaSuccess, RuntimeError)
+      << "cudaLaunchKernel for $symbol failed: "
+      << cudaGetErrorString(launch_status);
+}
+""",
+    "launch_exc": """
+  cudaLaunchConfig_t config{};
+  config.gridDim = grid;
+  config.blockDim = block;
+  config.dynamicSmemBytes = ${smem}u;
+  config.stream = stream;
+  cudaError_t launch_status = cudaLaunchKernelExC(
+      &config, reinterpret_cast<const void*>($symbol), kargs);
+  TVM_FFI_CHECK(launch_status == cudaSuccess, RuntimeError)
+      << "cudaLaunchKernelExC for $symbol failed: "
+      << cudaGetErrorString(launch_status);
+}
+""",
+    "launch_exc_pdl": """
+  // Extended direct-source launch for a linked CUDA kernel symbol.
+  cudaLaunchAttribute attrs[1]{};
+  int n = 0;
+  attrs[n].id = cudaLaunchAttributeProgrammaticStreamSerialization;
+  attrs[n].val.programmaticStreamSerializationAllowed = 1;
+  ++n;
+  cudaLaunchConfig_t config{};
+  config.gridDim = grid;
+  config.blockDim = block;
+  config.dynamicSmemBytes = ${smem}u;
+  config.stream = stream;
+  config.attrs = attrs;
+  config.numAttrs = n;
+  cudaError_t launch_status = cudaLaunchKernelExC(
+      &config, reinterpret_cast<const void*>($symbol), kargs);
+  TVM_FFI_CHECK(launch_status == cudaSuccess, RuntimeError)
+      << "cudaLaunchKernelExC for $symbol failed: "
+      << cudaGetErrorString(launch_status);
+}
+""",
+    "launch_exc_pdl_bare": """
+  cudaLaunchAttribute attrs[1]{};
+  int n = 0;
+  attrs[n].id = cudaLaunchAttributeProgrammaticStreamSerialization;
+  attrs[n].val.programmaticStreamSerializationAllowed = 1;
+  ++n;
+  cudaLaunchConfig_t config{};
+  config.gridDim = grid;
+  config.blockDim = block;
+  config.dynamicSmemBytes = ${smem}u;
+  config.stream = stream;
+  config.attrs = attrs;
+  config.numAttrs = n;
+  cudaError_t launch_status = cudaLaunchKernelExC(
+      &config, reinterpret_cast<const void*>($symbol), kargs);
+  TVM_FFI_CHECK(launch_status == cudaSuccess, RuntimeError)
+      << "cudaLaunchKernelExC for $symbol failed: "
+      << cudaGetErrorString(launch_status);
+}
+""",
+    "wrapper": """
+void $name($entry_params) {
+  RunWithDescriptors($call_args, grid_x, grid_y, grid_z, $descriptor_action);
+}
+""",
+    "exports": """
+}  // namespace $namespace
+
+TVM_FFI_DLL_EXPORT_TYPED_FUNC(run, $namespace::Run);
+""",
+    "prepared_exports": """TVM_FFI_DLL_EXPORT_TYPED_FUNC(run_prepare_tma, $namespace::PrepareTma);
+TVM_FFI_DLL_EXPORT_TYPED_FUNC(run_prepared, $namespace::RunPrepared);
+""",
+}
+
+# Prepared wrappers: FFI name -> (function, descriptor_action). Action 2 encodes
+# and uploads the TMA descriptors and launches, 1 only encodes and uploads, 0
+# only launches. Actions 2 and 1 also opt the kernel into its dynamic shared
+# memory on the tensors' device.
+_WRAPPERS = (("Run", 2), ("PrepareTma", 1), ("RunPrepared", 0))
+
+# Argument signatures. ``tensors`` gives the dtype code of every tensor argument
+# of the plan, ``layouts`` lists the arguments that are not required to be
+# contiguous ("strided": at least three dimensions and a unit innermost stride,
+# the kernel reads the token stride; "pitched": a unit innermost stride, the
+# kernel addresses token rows through the plan's ``<name>_token_stride`` scalar;
+# "unchecked": a TMA operand view whose layout the descriptor encoder
+# validates), ``scalars`` gives the C type code of every scalar argument and
+# ``current_device_check`` adds the check that the current device is the
+# tensors' device. ``like`` starts from another signature and adds or overrides
+# entries.
+_SIGNATURES = {
