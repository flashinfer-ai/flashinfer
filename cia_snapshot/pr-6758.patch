+"""CPU checks of the rendered host bindings of the generated KDA prefill modules."""
+
+import hashlib
+import json
+import re
+from pathlib import Path
+
+import pytest
+
+from flashinfer.jit import cake_kda_tf32
+from flashinfer.jit import core as jit_core
+from flashinfer.jit import env as jit_env
+from flashinfer.jit.cake_kda_prefill_binding import BINDINGS, _DEFAULT_SMEM_LIMIT
+
+PREPARED_EXPORTS = ("run", "run_prepare_tma", "run_prepared")
+
+
+def test_every_module_has_one_binding_row_and_one_kernel_source():
+    assert sorted(BINDINGS) == sorted(cake_kda_tf32.MODULES)
+    for record in cake_kda_tf32.MODULES.values():
+        # The fold test pins which body a module compiles.
+        (source,) = record["sources"]
+        assert re.fullmatch(
+            r"csrc/kda/(bf16|tf32)/cake_kda_\1_[0-9a-f]{64}_kernel\.cu", source
+        ), source
+
+
+def test_bindings_render_to_the_pinned_text():
+    # The sidecar pins the sha256 of each rendered binding (keyed by module).
+    sidecar = Path(__file__).with_name("cake_kda_prefill_binding_sha256.json")
+    pinned = json.loads(sidecar.read_text(encoding="utf-8"))
+    assert sorted(pinned) == sorted(cake_kda_tf32.MODULES)
+    symbols = set()
+    namespaces = set()
+    for name, record in cake_kda_tf32.MODULES.items():
+        text = cake_kda_tf32.render_binding(name)
+        assert hashlib.sha256(text.encode("utf-8")).hexdigest() == pinned[name], name
+        symbol = f"kernel_{record['cache_name']}"
+        assert f'extern "C" __global__ void {symbol}(' in text
+        (namespace,) = re.findall(
+            r"^namespace (cake_host_shim_[0-9a-f]{64}) \{$", text, re.MULTILINE
+        )
+        exports = re.findall(
+            r"^TVM_FFI_DLL_EXPORT_TYPED_FUNC\((\w+), (\w+)::\w+\);$", text, re.MULTILINE
+        )
+        expected = PREPARED_EXPORTS if record["tma_workspace_bytes"] else ("run",)
+        assert exports == [(entry, namespace) for entry in expected], name
+        symbols.add(symbol)
+        namespaces.add(namespace)
+    # Every module keeps its own kernel symbol and host-shim namespace, so all
+    # modules can load into one process.
+    assert len(symbols) == len(cake_kda_tf32.MODULES)
+    assert len(namespaces) == len(cake_kda_tf32.MODULES)
+
+
+def test_prepared_launch_skips_descriptor_encoding():
+    # Only the preparing actions encode and upload the TMA descriptors and opt
+    # the kernel into its dynamic shared memory; the launch-only action reuses
+    # both. Modules without descriptors export run only and keep the opt-in.
+    for name, record in cake_kda_tf32.MODULES.items():
+        _signature, smem_bytes, _block, _launch, encoders, _strides = BINDINGS[name]
+        text = cake_kda_tf32.render_binding(name)
+        assert "ScopedCudaDevice" not in text
+        assert "CUtensorMap h_" not in text
+        opt_ins = text.count("EnsureMaxDynamicSharedMemory(")
+        assert opt_ins == int(smem_bytes > _DEFAULT_SMEM_LIMIT)
+        if not record["tma_workspace_bytes"]:
+            assert "EncodeTma_" not in text
+            assert "descriptor_action" not in text
+            continue
+        start = text.index("  if (descriptor_action != 0) {\n")
+        end = text.index("  if (descriptor_action == 1) return;\n", start)
+        preparing = text[start:end]
+        assert text.count("EncodeTma_") == len(encoders)
+        assert preparing.count("EncodeTma_") == len(encoders)
+        assert preparing.count("EnsureMaxDynamicSharedMemory(") == opt_ins
+
+
+@pytest.mark.parametrize("arch", cake_kda_tf32.ARCHES)
+def test_spec_lists_the_kernel_body_and_the_rendered_binding(
+    monkeypatch, tmp_path, arch
+):
+    minor = {"sm_100a": "0", "sm_103a": "3"}[arch]
+    monkeypatch.setattr(
+        jit_core.current_compilation_context, "TARGET_CUDA_ARCHS", {(10, f"{minor}a")}
+    )
+    monkeypatch.setattr(jit_env, "FLASHINFER_GEN_SRC_DIR", tmp_path)
+    name = next(
+        name
+        for name, record in cake_kda_tf32.MODULES.items()
+        if arch in record["arches"]
+    )
+    record = cake_kda_tf32.MODULES[name]
+    cake_kda_tf32.spec.cache_clear()
+    try:
+        spec = cake_kda_tf32.spec(name, arch)
+        assert spec.name == f"{record['cache_name']}_{arch}"
+        kernel, binding = spec.sources
+        assert kernel.name == Path(record["sources"][0]).name
+        assert kernel.is_file()
+        assert binding == tmp_path / spec.name / f"{record['cache_name']}_binding.cu"
+        assert binding.read_text(encoding="utf-8") == cake_kda_tf32.render_binding(name)
+        assert spec.extra_include_dirs[0] == kernel.parent
+        assert [
+            flag for flag in spec.extra_cuda_cflags if flag.startswith("-gencode=")
+        ] == [f"-gencode=arch=compute_10{minor}a,code=sm_10{minor}a"]
+    finally:
+        cake_kda_tf32.spec.cache_clear()
diff --git a/tests/kda/test_cake_kda_prefill_binding_strides.py b/tests/kda/test_cake_kda_prefill_binding_strides.py
new file mode 100644
index 00000000000..6d91bba7cbd
--- /dev/null
+++ b/tests/kda/test_cake_kda_prefill_binding_strides.py
@@ -0,0 +1,67 @@
+"""
+Copyright (c) 2026, NVIDIA CORPORATION. All rights reserved.
+Licensed under the Apache License, Version 2.0.
+https://www.apache.org/licenses/LICENSE-2.0
+"""
+
+"""The BF16 KDA prefill bindings take g and beta at their token pitch.
+
+A rendered binding drops the contiguity check on the raw ``g`` / ``beta``
+pointer exactly when the kernel body consumes the plan's token-stride scalar
+(``g_token_stride`` / ``beta_token_stride``) for that operand; the bodies that
+read beta at the head-count pitch keep the contiguous contract.  CPU-only: the
+proof reads the kernel sources and the rendered binding texts.
+"""
+
+import re
+from string import Template
+
+import pytest
+
+from flashinfer.jit import cake_kda_prefill_binding, cake_kda_tf32
+
+# (pitched, contiguous) module counts among the 46 BF16 bodies whose plan
+# passes both token strides: 44 fused M128 and 2 fused M64 bodies.
+_EXPECTED_COUNTS = {"g": (46, 0), "beta": (36, 10)}
+
+
+def _bf16_modules_with_token_strides():
+    for name, record in cake_kda_tf32.MODULES.items():
+        plan = record["arg_plan"]
+        if record["cache_name"].startswith("cake_kda_bf16_") and all(
+            ["parameter", f"{operand}_token_stride"] in plan
+            for operand in ("g", "beta")
+        ):
+            yield name, record
+
+
+def _check_fragment(layout, operand):
+    # The exact text the renderer emits for this layout kind and operand.
+    return Template(cake_kda_prefill_binding._TEMPLATES[layout]).substitute(
+        name=operand
+    )
+
+
+def _consumes_token_stride(kernel_text, operand):
+    # The kernel signature declares the scalar; any further occurrence reads it.
+    return len(re.findall(rf"\b{operand}_token_stride\b", kernel_text)) >= 2
+
+
+@pytest.mark.parametrize("operand", ["g", "beta"])
+def test_contiguity_checks_follow_the_kernel_token_stride_reads(operand):
+    contiguous_check = _check_fragment("contiguous", operand)
+    pitched_check = _check_fragment("pitched", operand)
+    assert contiguous_check != pitched_check
+    pitched = contiguous = 0
+    for name, record in _bf16_modules_with_token_strides():
+        kernel = cake_kda_tf32._source_path(record["sources"][0]).read_text(
+            encoding="utf-8"
+        )
+        binding = cake_kda_tf32.render_binding(name)
+        checks_contiguous = contiguous_check in binding
+        checks_pitch = pitched_check in binding
+        assert checks_contiguous != checks_pitch, name
+        assert checks_pitch == _consumes_token_stride(kernel, operand), name
+        pitched += checks_pitch
+        contiguous += checks_contiguous
+    assert (pitched, contiguous) == _EXPECTED_COUNTS[operand]
diff --git a/tests/kda/test_kda_prefill_plan_cache.py b/tests/kda/test_kda_prefill_plan_cache.py
index 1742bf485bb..0dfc09f9de3 100644
--- a/tests/kda/test_kda_prefill_plan_cache.py
+++ b/tests/kda/test_kda_prefill_plan_cache.py
@@ -611,6 +611,76 @@ def test_hit_rebinds_strided_qkv_views_in_place(heads, lengths):
     _assert_same(got, _snapshot(second))
 
 
+def _head_padded_g(d, heads, *, extra=8):
+    """Replace the dense g with a view into head-padded storage.
+
+    Serving allocators may pad the gate buffer in the head dimension (token
+    pitch above ``H * 128`` with a dense ``[H, 128]`` payload).  Every body
+    reads the gate rows at that pitch through ``g_token_stride``; nothing is
+    densified and the binding receives the view itself.
+    """
+    tokens = d["g"].shape[1]
+    storage = torch.full(
+        (1, tokens, heads + extra, HEAD_DIM),
+        float("nan"),
+        device="cuda",
+        dtype=torch.bfloat16,
+    )
+    view = storage[:, :, :heads]
+    view.copy_(d["g"])
+    assert not view.is_contiguous() and view.stride(1) == (heads + extra) * HEAD_DIM
+    d = dict(d, g=view)
+    d["_g_storage"] = storage  # keep the storage alive
+    return d
+
+
+@pytest.mark.parametrize(
+    "lengths,heads,checkpoints,lower_bound",
+    [
+        pytest.param([64] * 4, 12, True, None, id="h12_short_direct_n16"),
+        pytest.param([512], 12, False, -1.0, id="h12_bounded_dvsplit_m64"),
+        pytest.param([1024] * 4, 16, True, None, id="h16_direct_m128"),
+        pytest.param([2048, 3073], 16, True, -1.0, id="h16_bounded_long"),
+        pytest.param([16384], 12, True, None, id="h12_affine_split"),
+    ],
+)
+def test_head_padded_g_matches_dense_bitwise_on_every_body(
+    lengths, heads, checkpoints, lower_bound
+):
+    dense = _inputs(lengths, heads, seed=37)
+    pool = dense["pool"].clone()
+    dense_call = _run(dense, checkpoints=checkpoints, lower_bound=lower_bound)
+    dense_got = _snapshot(dense)
+
+    padded = _head_padded_g(dense, heads)
+    padded["out"] = torch.empty_like(dense["out"])
+    padded["state_checkpoints"] = torch.zeros_like(dense["state_checkpoints"])
+    dense["pool"].copy_(pool)
+    padded_call = _run(padded, checkpoints=checkpoints, lower_bound=lower_bound)
+    assert str(padded_call.schedule) == str(dense_call.schedule), (
+        dense_call.schedule,
+        padded_call.schedule,
+    )
+    _assert_same(_snapshot(padded), dense_got)
+
+
+@pytest.mark.parametrize("heads,lengths", [(12, [512]), (16, [1024])])
+def test_hit_rebinds_head_padded_g_in_place(heads, lengths):
+    """A plan-cache hit re-points the head-padded g view (the recorded argument
+    is the view, not a one-element carrier) and stays bitwise exact."""
+    cache = KDAPrefillPlanCache(8)
+    first = _head_padded_g(_inputs(lengths, heads, seed=43), heads)
+    second = _head_padded_g(_inputs(lengths, heads, seed=44), heads)
+    pool_second = second["pool"].clone()
+    miss = _run(first, cache, checkpoints=False, lower_bound=-1.0)
+    hit = _run(second, cache, checkpoints=False, lower_bound=-1.0)
+    assert hit is miss and (cache.misses, cache.hits) == (1, 1)
+    got = _snapshot(second)
+    second["pool"].copy_(pool_second)
+    _run(second, checkpoints=False, lower_bound=-1.0)
+    _assert_same(got, _snapshot(second))
+
+
 @pytest.mark.parametrize(
     "lengths", [[5461, 5461, 5462], [4096] * 4, [500] * 6 + [13384], [2048] * 8]
 )
