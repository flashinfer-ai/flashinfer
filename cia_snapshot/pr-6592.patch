+inline CUtensorMap EncodeTma_Q(const TensorView& t) {
+  TVM_FFI_CHECK(t.ndim() >= 3, ValueError)
+      << "TMA source 'Q' must have at least 3 dimensions, got ndim=" << t.ndim();
