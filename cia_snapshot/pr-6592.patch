+// Measured per-shape overrides (both seeds, both interleaved rounds, >= 1 % each); other T use the rule.
+constexpr int kMultiTokenBandCount = 3;
+constexpr MultiTokenBand kMultiTokenBands[kMultiTokenBandCount + 1] = {
