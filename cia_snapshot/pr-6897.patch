+  check_dtype(a_x, DLDataType{kDLBfloat, 16, 1}, "x");
+  check_cuda_tensor(a_stats, "stats");
+  check_dtype(a_stats, DLDataType{kDLFloat, 32, 1}, "stats");
+  check_cuda_tensor(a_db, "db");
+  check_dtype(a_db, DLDataType{kDLBfloat, 16, 1}, "db");
+  check_cuda_tensor(a_gstats, "gstats");
+  check_dtype(a_gstats, DLDataType{kDLFloat, 32, 1}, "gstats");
+  TVM_FFI_CHECK(a_T >= -2147483648LL && a_T <= 2147483647LL, ValueError)
+      << KERNEL_NAME << ": 'T' = " << a_T
+      << " is outside the i32 range [-2147483648, 2147483647]";
+  check_contiguous(a_dy, "dy");
+  check_contiguous(a_b, "b");
+  check_same_device(a_b, a_dy, "b", "dy");
+  check_contiguous(a_x, "x");
+  check_same_device(a_x, a_dy, "x", "dy");
+  check_contiguous(a_stats, "stats");
+  check_same_device(a_stats, a_dy, "stats", "dy");
+  check_contiguous(a_db, "db");
+  check_same_device(a_db, a_dy, "db", "dy");
+  check_contiguous(a_gstats, "gstats");
+  check_same_device(a_gstats, a_dy, "gstats", "dy");
+  TVM_FFI_CHECK((a_T >= 0), ValueError)
+      << KERNEL_NAME << ": requires (T >= 0)";
+  TVM_FFI_CHECK(grid_x > 0 && grid_y > 0 && grid_z > 0, ValueError)
+      << KERNEL_NAME << ": the grid (" << grid_x << ", " << grid_y << ", " << grid_z << ") must be positive";
+  TVM_FFI_CHECK(grid_x <= 2147483647 && grid_y <= 65535 && grid_z <= 65535, ValueError)
+      << KERNEL_NAME << ": the grid (" << grid_x << ", " << grid_y << ", " << grid_z << ") exceeds CUDA's limits";
+  cudaStream_t stream = static_cast<cudaStream_t>(TVMFFIEnvGetStream(dev.device_type, dev.device_id));
