+void Run(TensorView a_X, TensorView a_dY, TensorView a_dU, TensorView a_dzp, TensorView a_fnTp, TensorView a_dX, TensorView a_tokp, TensorView a_dfn_part, int64_t a_T, int64_t a_P, int64_t a_rpc, int64_t grid_x, int64_t grid_y, int64_t grid_z) {
+  DLDevice dev = a_X.device();
+  tvm::ffi::CUDADeviceGuard device_guard(dev.device_id);
+  check_cuda_tensor(a_X, "X");
+  check_dtype(a_X, DLDataType{kDLBfloat, 16, 1}, "X");
+  check_cuda_tensor(a_dY, "dY");
+  check_dtype(a_dY, DLDataType{kDLBfloat, 16, 1}, "dY");
+  check_cuda_tensor(a_dU, "dU");
+  check_dtype(a_dU, DLDataType{kDLBfloat, 16, 1}, "dU");
+  check_cuda_tensor(a_dzp, "dzp");
+  check_dtype(a_dzp, DLDataType{kDLBfloat, 16, 1}, "dzp");
+  check_cuda_tensor(a_fnTp, "fnTp");
+  check_dtype(a_fnTp, DLDataType{kDLBfloat, 16, 1}, "fnTp");
+  check_cuda_tensor(a_dX, "dX");
+  check_dtype(a_dX, DLDataType{kDLBfloat, 16, 1}, "dX");
+  check_cuda_tensor(a_tokp, "tokp");
+  check_dtype(a_tokp, DLDataType{kDLFloat, 32, 1}, "tokp");
+  check_cuda_tensor(a_dfn_part, "dfn_part");
+  check_dtype(a_dfn_part, DLDataType{kDLFloat, 32, 1}, "dfn_part");
+  TVM_FFI_CHECK(a_T >= -2147483648LL && a_T <= 2147483647LL, ValueError)
+      << KERNEL_NAME << ": 'T' = " << a_T
+      << " is outside the i32 range [-2147483648, 2147483647]";
+  TVM_FFI_CHECK(a_P >= -2147483648LL && a_P <= 2147483647LL, ValueError)
+      << KERNEL_NAME << ": 'P' = " << a_P
+      << " is outside the i32 range [-2147483648, 2147483647]";
+  TVM_FFI_CHECK(a_rpc >= -2147483648LL && a_rpc <= 2147483647LL, ValueError)
+      << KERNEL_NAME << ": 'rpc' = " << a_rpc
+      << " is outside the i32 range [-2147483648, 2147483647]";
+  check_same_device(a_dY, a_X, "dY", "X");
+  check_same_device(a_dU, a_X, "dU", "X");
+  check_same_device(a_dzp, a_X, "dzp", "X");
+  check_same_device(a_fnTp, a_X, "fnTp", "X");
+  check_same_device(a_dX, a_X, "dX", "X");
+  check_contiguous(a_tokp, "tokp");
+  check_same_device(a_tokp, a_X, "tokp", "X");
+  check_contiguous(a_dfn_part, "dfn_part");
+  check_same_device(a_dfn_part, a_X, "dfn_part", "X");
+  TVM_FFI_CHECK(grid_x > 0 && grid_y > 0 && grid_z > 0, ValueError)
+      << KERNEL_NAME << ": the grid (" << grid_x << ", " << grid_y << ", " << grid_z << ") must be positive";
+  TVM_FFI_CHECK(grid_x <= 2147483647 && grid_y <= 65535 && grid_z <= 65535, ValueError)
+      << KERNEL_NAME << ": the grid (" << grid_x << ", " << grid_y << ", " << grid_z << ") exceeds CUDA's limits";
+  cudaStream_t stream = static_cast<cudaStream_t>(TVMFFIEnvGetStream(dev.device_type, dev.device_id));
+  {
+    // Once per thread per device: the kernel's function attributes hold per device; the tensor-map encoders need this thread's context of the device bound.
+    static thread_local uint64_t prepared_devices = 0;
+    const uint64_t device_bit = dev.device_id < 64 ? uint64_t{1} << dev.device_id : uint64_t{0};
+    if (device_bit == 0 || (prepared_devices & device_bit) == 0) {
+      CheckCuda(cudaSetDevice(dev.device_id), "cudaSetDevice");
+      CheckCuda(cudaFuncSetAttribute(reinterpret_cast<const void*>(kernel_cake_mhc_train_bwd_slab), cudaFuncAttributeMaxDynamicSharedMemorySize, 222208), "cudaFuncSetAttribute");
+      prepared_devices |= device_bit;
+    }
+  }
+  CUtensorMap v_X = EncodeTma_X(a_X);
+  CUtensorMap v_dY = EncodeTma_dY(a_dY);
+  CUtensorMap v_dU = EncodeTma_dU(a_dU);
+  CUtensorMap v_dzp = EncodeTma_dzp(a_dzp);
+  CUtensorMap v_fnTp = EncodeTma_fnTp(a_fnTp);
+  CUtensorMap v_dX = EncodeTma_dX(a_dX);
+  void* v_tokp = DataPtr(a_tokp);
+  void* v_dfn_part = DataPtr(a_dfn_part);
+  int32_t v_T = static_cast<int32_t>(a_T);
+  int32_t v_P = static_cast<int32_t>(a_P);
+  int32_t v_rpc = static_cast<int32_t>(a_rpc);
+  void* kernel_args[] = {&v_X, &v_dY, &v_dU, &v_dzp, &v_fnTp, &v_dX, &v_tokp, &v_dfn_part, &v_T, &v_P, &v_rpc};
+  cudaLaunchConfig_t config{};
+  config.gridDim = dim3(static_cast<unsigned>(grid_x), static_cast<unsigned>(grid_y), static_cast<unsigned>(grid_z));
+  config.blockDim = dim3(384, 1, 1);
+  config.dynamicSmemBytes = 222208;
+  config.stream = stream;
+  cudaLaunchAttribute attrs[1] = {};
+  attrs[0].id = cudaLaunchAttributeProgrammaticStreamSerialization;
+  attrs[0].val.programmaticStreamSerializationAllowed = 1;
+  config.attrs = attrs;
+  config.numAttrs = 1;
+  CheckCuda(cudaLaunchKernelExC(&config, reinterpret_cast<const void*>(kernel_cake_mhc_train_bwd_slab), kernel_args),
+            "cudaLaunchKernelExC");
+}
