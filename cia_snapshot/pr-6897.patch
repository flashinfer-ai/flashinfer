+def test_pdl_only_where_the_kernel_waits_for_the_preceding_grid() -> None:
+    """``use_pdl`` is safe only for kernels that wait (``griddepcontrol.wait``) before reading a predecessor's
+    output: the coefficient pass, the row streams, the token-owner pass, the column-slab pass (every role waits
+    before its first read) and the final reduction do; the fn split and the mapping pass do not and must be
+    launched without it."""
+    pdl = {name: record["launch"]["use_pdl"] for name, record in loader.MODULES.items()}
+    assert pdl == {
+        "cake_mhc_train_fn_split": False,
+        "cake_mhc_train_fn_split__t": False,
+        "cake_mhc_train_fwd_map": False,
+        "cake_mhc_train_fwd_coef": True,
+        "cake_mhc_train_fwd_collapse": True,
+        "cake_mhc_train_fwd_finish": True,
+        "cake_mhc_train_bwd_prepare": True,
+        "cake_mhc_train_bwd_token": True,
+        "cake_mhc_train_bwd_slab": True,
+        "cake_mhc_train_bwd_reduce": True,
+    }
+
