+def route_key(hidden: int, kind: str) -> str:
+    """Name the route of one public call: ``<kind>_h<hidden>``."""
+
+    if kind not in KINDS:
+        raise ValueError(f"kind must be one of {KINDS}, got {kind!r}")
+    return f"{kind}_h{int(hidden)}"
