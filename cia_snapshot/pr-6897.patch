+@pytest.mark.parametrize("sm", SM_COUNTS)
+def test_launch_grids_follow_the_rules(
+    monkeypatch: pytest.MonkeyPatch, sm: int
+) -> None:
+    monkeypatch.setattr(loader, "sm_count", lambda device_index: sm)
+    modules = loader.MODULES
+    for row in _rows():
+        T = row["T"]
+        if T == 0 or row["sm_count"] != sm:
+            continue
+        grid = lambda name: loader.launch_grid(modules[name], T, device_index=0)  # noqa: E731
+        assert (
+            grid("cake_mhc_train_fn_split")
+            == grid("cake_mhc_train_fn_split__t")
+            == (256, 1, 1)
+        )
+        assert grid("cake_mhc_train_fwd_map") == (row["k1_grid"], 1, 1)
+        assert grid("cake_mhc_train_fwd_coef") == (row["k2_grid"], 1, 1)
+        # One trip per CTA (the production forms): two column halves per token for the collapse, four tokens
+        # times two halves per CTA for the residual mixing, two tokens per CTA for the backward prepare.
+        assert (
+            grid("cake_mhc_train_fwd_collapse")
+            == (row["k3_grid"], 1, 1)
+            == (2 * T, 1, 1)
+        )
+        assert (
+            grid("cake_mhc_train_fwd_finish")
+            == (row["k4_grid"], 1, 1)
+            == (-(-(2 * T) // 4), 1, 1)
+        )
+        assert (
+            grid("cake_mhc_train_bwd_prepare")
+            == (row["k5_grid"], 1, 1)
+            == (-(-T // 2), 1, 1)
+        )
+        assert grid("cake_mhc_train_bwd_token") == (row["G6"], 1, 1)
+        assert grid("cake_mhc_train_bwd_slab") == (row["k7_grid"], 1, 1)
+        assert grid("cake_mhc_train_bwd_reduce") == (385, 1, 1)
+    with pytest.raises(ValueError):
+        loader.launch_grid(modules["cake_mhc_train_fwd_coef"], 0, device_index=0)
+
