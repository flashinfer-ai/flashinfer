+    (8192, 8192),
+    (7168, 18432),
+    (8192, 28672),
+    (16384, 7168),
+)
+VALIDATED_OFF_MATRIX_FAMILY: tuple[int, int] = (4096, 3200)
+VALIDATED_OFF_MATRIX_ROWS: tuple[int, ...] = (16, 300)
