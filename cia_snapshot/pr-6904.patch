+def device_arch(device_index: int) -> str:
+    """Exported architecture of one CUDA device (``RuntimeError`` when it is not an
+    exported target)."""
+
+    import torch
+
+    capability = tuple(torch.cuda.get_device_capability(device_index))
+    arch = arch_for_capability(capability)
+    if arch is None:
+        raise RuntimeError(
+            f"device {device_index} (capability {capability}) is not an exported Cake "
+            "Kimi-K3 AttnRes target"
         )
+    return arch
+
+
+def sm_count(device_index: int) -> int:
+    """Streaming multiprocessors of one CUDA device."""
+
+    import torch
+
+    return int(torch.cuda.get_device_properties(device_index).multi_processor_count)
+
