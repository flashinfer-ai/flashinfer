+def test_top_n_preserves_splitk_and_full_search_order():
+    candidates = [((128, n), (1, 1), False, False, 1) for n in (64, 128, 192, 256)] + [
+        SPLITK
+    ]
+    assert (
+        _rank_mm_mxfp8_autotune_tactics(candidates, 8, 512, 4096, 148, 0) is candidates
