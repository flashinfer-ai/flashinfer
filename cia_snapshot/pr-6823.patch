+
+template <class T>
+struct PhysicalStorage<T, 3> {
+  using InputT = typename T::InputT;
+  using SmemLayoutQ = typename T::SmemLayoutQ;
+  using SmemLayoutKV = typename T::SmemLayoutKV;
+  using SmemLayoutKVSlice = typename T::SmemLayoutKVSlice;
