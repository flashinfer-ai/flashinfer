+)
+def test_along_n_grid_limit_applicability(num_tokens, expected_applicable):
+    candidate = Candidate(options={}, tile_n=32)
+    materialized = SimpleNamespace(
+        candidate=candidate,
+        kwargs={
+            "tile_n": 32,
+            "mma_n": 32,
