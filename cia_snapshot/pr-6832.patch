+@cute.jit
+def umma_atom_leader_rank() -> Int32:
+    """Return the even physical rank that owns the current atom's barriers."""
+    rank = cute.arch.make_warp_uniform(cute.arch.block_idx_in_cluster())
+    return rank & Int32(~1)
