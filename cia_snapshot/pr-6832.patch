new file mode 100644
index 0000000000000000000000000000000000000000..ad1f8e1c732c8c0def891a23b135ea70c20e8f23
--- /dev/null
+++ b/tests/prims_ts/test_batched_gemm_c_row_stride.py
@@ -0,0 +1,272 @@
