+    "default_global_num_tokens",
+    "launch_equivalence_key",
+    "merge_duplicate_shapes",
+    "model_moe_shape",
+    "modeled_shape_consistency_errors",
+    "normalize_activation",
+    "normalize_dtype",
+    "resolve_activation_params",
+]
