+                    writer,
+                    candidate,
+                    {
+                        "status": "validation_error",
+                        "error": f"{type(exc).__name__}: {exc}",
+                    },
+                    phase="search",
+                )
+                continue
+            signature = _resolved_signature(materialized.resolved_hashes)
+            owner = signature_owner.get(signature)
+            if owner is not None:
