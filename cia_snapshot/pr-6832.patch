+def _cmd_menu_retime(args) -> int:
+    target = load_menu_target(args.config)
+    os.environ.setdefault("FLASHINFER_CUDA_ARCH_LIST", _CUDA_ARCH_ENV[target.sm_arch])
+    calibration = _load_or_calibrate(args)
