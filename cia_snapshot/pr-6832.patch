+    under_limit_token_ctas = _kimi_fc2_token_ctas(num_tokens=1024, tile_n=16)
+    assert under_limit_token_ctas == 1864
+    validate_launch_grid(
+        tile_16,
+        problem_m=3584,
+        problem_n=1024 * 16,
+        early_exit_max_token_ctas=under_limit_token_ctas,
