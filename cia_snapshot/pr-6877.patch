+void Run(TensorView a_Q, TensorView a_K, TensorView a_Vt, TensorView a_O, TensorView a_plan, int64_t a_seqlen_q, int64_t a_seqlen_k, double a_scale_log2, int64_t grid_x, int64_t grid_y, int64_t grid_z) {
+  DLDevice dev = a_Q.device();
+  tvm::ffi::CUDADeviceGuard device_guard(dev.device_id);
+  check_cuda_tensor(a_Q, "Q");
+  check_dtype(a_Q, DLDataType{kDLBfloat, 16, 1}, "Q");
+  check_cuda_tensor(a_K, "K");
+  check_dtype(a_K, DLDataType{kDLBfloat, 16, 1}, "K");
+  check_cuda_tensor(a_Vt, "Vt");
+  check_dtype(a_Vt, DLDataType{kDLBfloat, 16, 1}, "Vt");
+  check_cuda_tensor(a_O, "O");
+  check_dtype(a_O, DLDataType{kDLBfloat, 16, 1}, "O");
+  CheckParamArray(a_plan, "plan", kDLInt, 16, 1750);
+  TVM_FFI_CHECK(a_seqlen_q >= -2147483648LL && a_seqlen_q <= 2147483647LL, ValueError)
