+}
+
+CUtensorMap EncodeTma_Vt(const TensorView& t) {
+  TVM_FFI_CHECK(t.ndim() >= 2, ValueError)
+      << KERNEL_NAME << ": descriptor 'Vt' takes a source of at least 2 dims, got " << t.ndim();
+  CheckUnitInnerStride(t, "Vt");
+  int64_t d1 = t.size(-1);
+  int64_t outer1 = NumelAbove(t, 1);
+  check_dense_leading_dims(t, 1, "Vt");
+  int64_t s2 = t.stride(-2) * 2;
+  TVM_FFI_CHECK((CMod(outer1, 8) == 0), ValueError)
+      << KERNEL_NAME << ": descriptor 'Vt' requires (CMod(outer1, 8) == 0)";
+  TVM_FFI_CHECK((CMod(d1, 64) == 0), ValueError)
+      << KERNEL_NAME << ": descriptor 'Vt' requires (CMod(d1, 64) == 0)";
+  cuuint64_t global_dim[4] = {Extent(64, "Vt"), Extent(8, "Vt"), Extent(CDiv(outer1, 8), "Vt"), Extent(CDiv(d1, 64), "Vt")};
+  cuuint64_t global_strides[3] = {Stride(s2, "Vt"), Stride((s2 * 8), "Vt"), Stride(128, "Vt")};
+  cuuint32_t box_dim[4] = {64u, 8u, 8u, 2u};
+  cuuint32_t elem_strides[4] = {1u, 1u, 1u, 1u};
+  TVM_FFI_CHECK(box_dim[0] <= global_dim[0] && box_dim[1] <= global_dim[1] && box_dim[2] <= global_dim[2] && box_dim[3] <= global_dim[3], ValueError)
+      << KERNEL_NAME << ": the box of descriptor 'Vt' exceeds its source extents";
+  TVM_FFI_CHECK(global_strides[0] % 16 == 0 && global_strides[1] % 16 == 0 && global_strides[2] % 16 == 0, ValueError)
+      << KERNEL_NAME << ": the strides of descriptor 'Vt' must be multiples of 16 bytes";
+  void* address = DataPtr(t);
+  TVM_FFI_CHECK(reinterpret_cast<uintptr_t>(address) % 16 == 0, ValueError)
+      << KERNEL_NAME << ": the address of descriptor 'Vt' must be 16-byte aligned";
+  CUtensorMap map{};
+  CheckCu(cuTensorMapEncodeTiled(&map, CU_TENSOR_MAP_DATA_TYPE_BFLOAT16, 4, address, global_dim, global_strides,
+                                 box_dim, elem_strides, CU_TENSOR_MAP_INTERLEAVE_NONE, CU_TENSOR_MAP_SWIZZLE_128B,
+                                 CU_TENSOR_MAP_L2_PROMOTION_NONE, CU_TENSOR_MAP_FLOAT_OOB_FILL_NONE),
+          "cuTensorMapEncodeTiled of Vt");
+  return map;
+}
