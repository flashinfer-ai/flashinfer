+void Run(TensorView a_Q, TensorView a_K, TensorView a_Vt, TensorView a_O, TensorView a_plan, int64_t a_seqlen_q, int64_t a_seqlen_k, double a_scale_log2, int64_t grid_x, int64_t grid_y, int64_t grid_z) {
+  DLDevice dev = a_Q.device();
+  tvm::ffi::CUDADeviceGuard device_guard(dev.device_id);
+  check_cuda_tensor(a_Q, "Q");
+  check_dtype(a_Q, DLDataType{kDLBfloat, 16, 1}, "Q");
+  check_cuda_tensor(a_K, "K");
+  check_dtype(a_K, DLDataType{kDLBfloat, 16, 1}, "K");
+  check_cuda_tensor(a_Vt, "Vt");
+  check_dtype(a_Vt, DLDataType{kDLBfloat, 16, 1}, "Vt");
+  check_cuda_tensor(a_O, "O");
+  check_dtype(a_O, DLDataType{kDLBfloat, 16, 1}, "O");
+  CheckParamArray(a_plan, "plan", kDLInt, 16, 1750);
+  TVM_FFI_CHECK(a_seqlen_q >= -2147483648LL && a_seqlen_q <= 2147483647LL, ValueError)
+      << KERNEL_NAME << ": 'seqlen_q' = " << a_seqlen_q
+      << " is outside the i32 range [-2147483648, 2147483647]";
+  TVM_FFI_CHECK(a_seqlen_k >= -2147483648LL && a_seqlen_k <= 2147483647LL, ValueError)
+      << KERNEL_NAME << ": 'seqlen_k' = " << a_seqlen_k
+      << " is outside the i32 range [-2147483648, 2147483647]";
+  check_same_device(a_K, a_Q, "K", "Q");
+  check_same_device(a_Vt, a_Q, "Vt", "Q");
+  check_contiguous(a_O, "O");
+  check_same_device(a_O, a_Q, "O", "Q");
+  TVM_FFI_CHECK(grid_x > 0 && grid_y > 0 && grid_z > 0, ValueError)
+      << KERNEL_NAME << ": the grid (" << grid_x << ", " << grid_y << ", " << grid_z << ") must be positive";
+  TVM_FFI_CHECK(grid_x <= 2147483647 && grid_y <= 65535 && grid_z <= 65535, ValueError)
+      << KERNEL_NAME << ": the grid (" << grid_x << ", " << grid_y << ", " << grid_z << ") exceeds CUDA's limits";
+  TVM_FFI_CHECK(grid_x % 4 == 0 && grid_y % 1 == 0 && grid_z % 1 == 0, ValueError)
+      << KERNEL_NAME << ": the grid (" << grid_x << ", " << grid_y << ", " << grid_z
+      << ") is not a multiple of the cluster shape (4, 1, 1)";
+  cudaStream_t stream = static_cast<cudaStream_t>(TVMFFIEnvGetStream(dev.device_type, dev.device_id));
+  {
+    // Once per thread per device: the kernel's function attributes hold per device; the tensor-map encoders need this thread's context of the device bound.
+    static thread_local uint64_t prepared_devices = 0;
+    const uint64_t device_bit = dev.device_id < 64 ? uint64_t{1} << dev.device_id : uint64_t{0};
+    if (device_bit == 0 || (prepared_devices & device_bit) == 0) {
+      CheckCuda(cudaSetDevice(dev.device_id), "cudaSetDevice");
+      CheckCuda(cudaFuncSetAttribute(reinterpret_cast<const void*>(kernel_cake_vsa_sm90_b9403a3f1b1266dda4c1), cudaFuncAttributeMaxDynamicSharedMemorySize, 111616), "cudaFuncSetAttribute");
+      prepared_devices |= device_bit;
+    }
+  }
+  CUtensorMap v_Q = EncodeTma_Q(a_Q);
+  CUtensorMap v_K = EncodeTma_K(a_K);
+  CUtensorMap v_Vt = EncodeTma_Vt(a_Vt);
+  void* v_O = DataPtr(a_O);
+  CakeParamArray<int16_t, 1750> v_plan;
+  std::memcpy(v_plan.v, DataPtr(a_plan), sizeof(v_plan.v));
+  int32_t v_seqlen_q = static_cast<int32_t>(a_seqlen_q);
+  int32_t v_seqlen_k = static_cast<int32_t>(a_seqlen_k);
+  float v_scale_log2 = static_cast<float>(a_scale_log2);
+  void* kernel_args[] = {&v_Q, &v_K, &v_Vt, &v_O, &v_plan, &v_seqlen_q, &v_seqlen_k, &v_scale_log2};
+  cudaLaunchConfig_t config{};
+  config.gridDim = dim3(static_cast<unsigned>(grid_x), static_cast<unsigned>(grid_y), static_cast<unsigned>(grid_z));
+  config.blockDim = dim3(256, 1, 1);
+  config.dynamicSmemBytes = 111616;
+  config.stream = stream;
+  cudaLaunchAttribute attrs[2] = {};
+  attrs[0].id = cudaLaunchAttributeClusterDimension;
+  attrs[0].val.clusterDim.x = 4;
+  attrs[0].val.clusterDim.y = 1;
+  attrs[0].val.clusterDim.z = 1;
+  attrs[1].id = cudaLaunchAttributeClusterSchedulingPolicyPreference;
+  attrs[1].val.clusterSchedulingPolicyPreference = cudaClusterSchedulingPolicySpread;
+  config.attrs = attrs;
+  config.numAttrs = 2;
+  CheckCuda(cudaLaunchKernelExC(&config, reinterpret_cast<const void*>(kernel_cake_vsa_sm90_b9403a3f1b1266dda4c1), kernel_args),
+            "cudaLaunchKernelExC");
+}
