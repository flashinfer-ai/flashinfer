+@requires_hopper
+def test_replan_and_independent_wrappers():
+    mask, rows, cols = _descriptors(2, 2, 3, device="cuda")
+    mask[:, :, 1:] = False
+    first = _wrapper(mask)
+    q, k, v = _inputs(2, 2, 3)
+    expected_first = first.run(q, k, v).clone()
+    mask[:, :, 0] = False
