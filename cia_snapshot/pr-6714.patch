-            nibble = Uint8(1)
-        elif mag >= t075 and mag <= t125:
-            nibble = Uint8(2)
-        elif mag > t125 and mag < t175:
-            nibble = Uint8(3)
-        elif mag >= t175 and mag <= t250:
