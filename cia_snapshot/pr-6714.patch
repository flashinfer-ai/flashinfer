+                        route_values[value_base + Int32(1)] = hs1
+                        route_values[value_base + Int32(2)] = hs2
+                        route_values[value_base + Int32(3)] = hs3
+                        if lane == Int32(0) and sub == Int32(0):
+                            weight = cutlass.Float32(0.0)
+                            if valid_route != Int32(0):
