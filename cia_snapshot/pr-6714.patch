-def _packed_decode_iq2_xs_to_bfloat2x4(
-    q_row0,
-    q_row1,
-    base_pair,
-    subscale_pair,
-    execution_lut_addr,
-    pair_byte_offset,
-    *,
-    shared_lut=False,
-    selector_lut=False,
-    loc=None,
-    ip=None,
