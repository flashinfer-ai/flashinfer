+        if split and not atomic:
+            if p.policy.split_k_slices != 2:
+                raise ValueError("non-atomic dense reduction requires two slices")
+            programs["reduce"] = _reduce_split_k2_bf16_kernel.warmup(
+                torch.float32,
+                torch.bfloat16,
+                p.m * p.n,
+                BLOCK=1024,
+                grid=(triton.cdiv(p.m * p.n, 1024),),
+            )
+        return programs
