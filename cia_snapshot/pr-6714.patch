@@ -0,0 +1,343 @@
+"""Correctness tests for RoCEnante's variable-length all-gather.
+
+Run with torchrun on two or more nodes that share a RoCE fabric, for example
+from every node of a DGX Spark cluster::
+
+    NCCL_IB_HCA=rocep1s0f0,roceP2p1s0f0 NCCL_IB_GID_INDEX=3 \\
+    torchrun --nnodes=2 --nproc-per-node=1 --node-rank=$RANK \\
+        --master-addr=$MASTER --master-port=29650 \\
+        -m pytest -x tests/experimental/b12x/comm/test_roce_varlen_gpu.py
+
+Without a torchrun environment the tests skip.
+"""
+
+from __future__ import annotations
+
+import os
+import time
+from datetime import timedelta
+
+import pytest
+import torch
+import torch.distributed as dist
+from b12x.preparation import PreparationSession, PreparedCall
+
+pytestmark = pytest.mark.skipif(
+    "WORLD_SIZE" not in os.environ or int(os.environ.get("WORLD_SIZE", "1")) < 2,
+    reason="requires a torchrun launch with WORLD_SIZE >= 2",
+)
+
+CAPACITY = 4 << 20
+# Small chunks so modest contributions span many chunk flags.
+CHUNK = 64 << 10
+SENTINEL = 0x5A
+
+
+class _Prepared:
+    """A runtime plus its published plan."""
+
+    def __init__(self, runtime, plan):
+        self.runtime, self.plan = runtime, plan
+
+    def gather(self, source, counts, **kwargs):
+        return self.runtime.all_gather_varlen(source, counts, plan=self.plan, **kwargs)
+
+    def all_reduce(self, inp, **kwargs):
+        return self.runtime.all_reduce(inp, plan=self.plan, **kwargs)
+
+
+def _prepare(spin_limit: int | None = None, **kwargs) -> _Prepared:
+    """A prepared runtime with a variable-length area over the torchrun world."""
+    from b12x.comm import roce
+    from b12x.comm.roce import _preparation
+
+    if not roce.is_supported():
+        pytest.skip("RoCE needs an integrated GPU with an active RDMA device")
+    if not dist.is_initialized():
+        dist.init_process_group("nccl", timeout=timedelta(seconds=60))
+    device = torch.device("cuda", 0)
+    torch.cuda.set_device(device)
+    previous = os.environ.get("B12X_ROCE_SPIN_LIMIT")
+    if spin_limit is not None:
+        os.environ["B12X_ROCE_SPIN_LIMIT"] = str(spin_limit)
+    try:
+        rt = roce.AllReduce(
+            exchange_group=dist.group.WORLD,
+            device=device,
+            max_size=1 << 20,
+            max_gather_bytes=1 << 20,
+            pipe_bytes=kwargs.pop("pipe_bytes", 8 << 20),
+            max_varlen_bytes=CAPACITY,
+            varlen_chunk_bytes=CHUNK,
+            **kwargs,
+        )
+    finally:
+        if spin_limit is not None:
+            if previous is None:
+                del os.environ["B12X_ROCE_SPIN_LIMIT"]
+            else:
+                os.environ["B12X_ROCE_SPIN_LIMIT"] = previous
+    query = roce.query_from_runtime(
+        rt,
+        surface="AllReduce.all_gather_varlen",
+        call={"dtypes": ("bfloat16",)},
+        topology="roce_rdma",
+        peer_hosts=tuple(f"rank-{r}" for r in range(rt.world_size)),
+    )
+    plan = roce.plan(query, runtime=rt)
+    source = torch.zeros(4096, dtype=torch.uint8, device=device)
+    counts = torch.full((rt.world_size,), 16, dtype=torch.int64, device=device)
+    seed = torch.zeros(8, dtype=torch.bfloat16, device=device)
+
+    def prepare(state):
+        calls = (
+            _preparation.prepared_varlen_call(state, source=source, counts=counts),
+            _preparation.prepared_call(state, inp=seed),
+        )
+        return PreparedCall(run=lambda: [call.run() for call in calls])
+
+    with PreparationSession(
+        device=device, autotune=False, compile_workers=2
+    ) as session:
+        session.prepare((plan.request(name="roce", prepare_call=prepare),))
+    return _Prepared(rt, plan)
+
+
+@pytest.fixture(scope="module")
+def runtime():
+    prepared = _prepare()
+    yield prepared
+    prepared.runtime.close()
+    dist.barrier()
+
+
+def _contribution(rank: int, nbytes: int, trial: int, device) -> torch.Tensor:
+    """Rank-specific bytes every rank can regenerate."""
+    gen = torch.Generator(device=device).manual_seed(1009 * trial + rank)
+    return torch.randint(
+        0, 256, (CAPACITY,), dtype=torch.uint8, device=device, generator=gen
+    )
+
+
+def _check(out: torch.Tensor, counts: list[int], trial: int) -> None:
+    device = out.device
+    rows = out.view(len(counts), -1)
+    for peer, count in enumerate(counts):
+        expected = _contribution(peer, count, trial, device)[:count]
+        assert torch.equal(rows[peer, :count], expected), f"row {peer} differs"
+        assert bool((rows[peer, count:] == SENTINEL).all()), (
+            f"row {peer} written past its count"
+        )
+
+
+def _counts_cases(world: int) -> list[list[int]]:
+    return [
+        [16 * 1000] * world,
+        [0] + [CHUNK * 3 + 16] * (world - 1),  # one rank sends nothing
+        [16 * (1 + 4097 * r) for r in range(world)],  # differ by rank
+        [CAPACITY] * world,
+        [CAPACITY if r == world - 1 else 0 for r in range(world)],
+        [0] * world,
+    ]
+
+
+def test_gathers_counts_that_differ_by_rank_and_call(runtime):
+    """Every row holds its rank's first count bytes; nothing past a count is written."""
+    world, rank = dist.get_world_size(), dist.get_rank()
+    device = runtime.runtime.device
+    for trial, counts in enumerate(_counts_cases(world)):
+        source = _contribution(rank, counts[rank], trial, device)
+        out = torch.full((world, CAPACITY), SENTINEL, dtype=torch.uint8, device=device)
+        counts_tensor = torch.tensor(counts, dtype=torch.int64, device=device)
+        runtime.gather(source, counts_tensor, out=out)
+        torch.cuda.synchronize()
+        _check(out, counts, trial)
+    runtime.runtime.check_health()
+
+
+def test_source_may_be_this_ranks_output_row(runtime):
+    """Packing straight into our row of the output skips the local copy and still gathers."""
+    world, rank = dist.get_world_size(), dist.get_rank()
+    device = runtime.runtime.device
+    counts = [16 * (3000 + 7 * r) for r in range(world)]
+    out = torch.full((world, CAPACITY), SENTINEL, dtype=torch.uint8, device=device)
+    out[rank, : counts[rank]] = _contribution(rank, counts[rank], 41, device)[
+        : counts[rank]
+    ]
+    runtime.gather(
+        out[rank], torch.tensor(counts, dtype=torch.int64, device=device), out=out
+    )
+    torch.cuda.synchronize()
+    _check(out, counts, 41)
+
+
+def test_graph_replays_with_counts_changing_between_replays(runtime):
+    """One captured graph mixes the gather with one-shot and two-shot reductions; counts change per replay."""
+    world, rank = dist.get_world_size(), dist.get_rank()
+    rt = runtime.runtime
+    device = rt.device
+    counts_tensor = torch.zeros(world, dtype=torch.int64, device=device)
+    source = torch.empty(CAPACITY, dtype=torch.uint8, device=device)
+    out = torch.empty((world, CAPACITY), dtype=torch.uint8, device=device)
+    small = torch.randn(4096, dtype=torch.bfloat16, device=device)
+    large = torch.randn(3 << 19, dtype=torch.bfloat16, device=device)
+    small_out, large_out = torch.empty_like(small), torch.empty_like(large)
+    expected_small, expected_large = small.clone(), large.clone()
+    dist.all_reduce(expected_small)
+    dist.all_reduce(expected_large)
+    stream = torch.cuda.Stream(device=device)
+    stream.wait_stream(torch.cuda.current_stream())
+    with torch.cuda.stream(stream):
+        runtime.gather(source, counts_tensor, out=out)
+        runtime.all_reduce(small, out=small_out)
+    torch.cuda.current_stream().wait_stream(stream)
+    torch.cuda.synchronize()
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph, stream=stream), rt.capture(stream=stream):
+        runtime.all_reduce(small, out=small_out)
+        runtime.gather(source, counts_tensor, out=out)
+        runtime.all_reduce(large, out=large_out)
+        runtime.gather(source, counts_tensor, out=out)
+    for trial, counts in enumerate(_counts_cases(world) * 2):
+        source.copy_(_contribution(rank, counts[rank], 100 + trial, device))
+        counts_tensor.copy_(torch.tensor(counts, dtype=torch.int64))
+        out.fill_(SENTINEL)
+        small_out.zero_()
+        large_out.zero_()
+        torch.cuda.synchronize()
+        dist.barrier()
+        graph.replay()
+        torch.cuda.synchronize()
+        rt.check_health()
+        _check(out, counts, 100 + trial)
+        torch.testing.assert_close(
+            small_out, expected_small, rtol=1e-2, atol=4e-2 * world
+        )
+        torch.testing.assert_close(
+            large_out, expected_large, rtol=1e-2, atol=4e-2 * world
+        )
+    dist.barrier()
+
+
+def test_proxy_catches_up_after_the_next_gather_overwrote_ready_words(runtime):
+    """A proxy that sleeps across two gathers posts both: the second's ready words release the first.
+
+    Rank 1's first gather completes on its peers' data alone, so its second
+    stages every chunk (overwriting the ready words) before the stopped proxy
+    posted any chunk of the first.
+    """
+    world, rank = dist.get_world_size(), dist.get_rank()
+    rt = runtime.runtime
+    device = rt.device
+    counts = [CHUNK * 5 + 16 * (r + 1) for r in range(world)]
+    counts_tensor = torch.tensor(counts, dtype=torch.int64, device=device)
+    sources = [_contribution(rank, counts[rank], 200 + i, device) for i in range(2)]
+    outs = [
+        torch.full((world, CAPACITY), SENTINEL, dtype=torch.uint8, device=device)
+        for _ in range(2)
+    ]
+    torch.cuda.synchronize()
+    dist.barrier()
+    if rank == 1:
+        rt._proxy.stop()
+    for source, out in zip(sources, outs, strict=True):
+        runtime.gather(source, counts_tensor, out=out)
+    if rank == 1:
+        posted = rt._proxy.stats()["last_seq"]
+        deadline = time.monotonic() + 20
+        while int(rt._ctrl_words[0].item()) != posted + 2:
+            assert time.monotonic() < deadline, "second gather never rang"
+            time.sleep(0.001)
+        rt._proxy.start()
+    torch.cuda.synchronize()
+    rt.check_health()
+    for i, out in enumerate(outs):
+        _check(out, counts, 200 + i)
+    dist.barrier()
+
+
+def test_unusable_count_stops_every_rank_before_sending():
+    """A count that is not a multiple of 16 poisons every rank alike, with no timeout and no epoch."""
+    world = dist.get_world_size()
+    prepared = _prepare(spin_limit=2_000_000)
+    rt = prepared.runtime
+    try:
+        epoch_before = rt.stats()["epoch"]
+        counts = torch.tensor(
+            [16] * (world - 1) + [8], dtype=torch.int64, device=rt.device
+        )
+        source = torch.zeros(4096, dtype=torch.uint8, device=rt.device)
+        # The kernel stops at once, so the launch's own health check may already report it.
+        with pytest.raises(RuntimeError, match="unusable byte count for rank"):
+            prepared.gather(source, counts)
+            torch.cuda.synchronize()
+            rt.check_health()
+        assert rt.poisoned and rt.stats()["epoch"] == epoch_before
+        assert rt.stats()["error_peer"] == world - 1
+    finally:
+        rt.close()
+        dist.barrier()
+
+
+def test_gather_fail_stop_when_a_peer_never_sends():
+    """Peers of a rank whose proxy stopped time out and poison; that rank fails on its next op."""
+    rank = dist.get_rank()
+    prepared = _prepare(spin_limit=2_000_000)
+    rt = prepared.runtime
+    try:
+        counts = torch.full(
+            (dist.get_world_size(),), CHUNK, dtype=torch.int64, device=rt.device
+        )
+        source = torch.ones(CHUNK, dtype=torch.uint8, device=rt.device)
+        dist.barrier()
+        if rank == 1:
+            rt._proxy.stop()
+        if rank != 1:
+            with pytest.raises(RuntimeError, match="poisoned|timed out"):
+                prepared.gather(source, counts)
+                torch.cuda.synchronize()
+                rt.check_health()
+        else:
+            # Rank 1 received everything; its poisoned peers never send again.
+            prepared.gather(source, counts)
+            torch.cuda.synchronize()
+            rt.check_health()
+            with pytest.raises(RuntimeError, match="poisoned|timed out"):
+                prepared.gather(source, counts)
+                torch.cuda.synchronize()
+                rt.check_health()
+        assert rt.poisoned
+    finally:
+        rt.close()
+        dist.barrier()
+
+
+def test_external_region_describes_the_variable_length_area():
+    """A caller-supplied region carries the variable-length area, and the description names it."""
+    world, rank = dist.get_world_size(), dist.get_rank()
+    supplied = []
+
+    def allocate(nbytes):
+        region = torch.full((nbytes,), 0xA5, dtype=torch.uint8, pin_memory=True)
+        supplied.append(region)
+        return region
+
+    prepared = _prepare(region_allocator=allocate)
+    rt = prepared.runtime
+    try:
+        description = rt.native_description()
+        assert description["varlen_bytes"] == CAPACITY
+        assert description["region"]["nbytes"] == rt._layout.total_bytes
+        counts = [16 * (500 + r) for r in range(world)]
+        source = _contribution(rank, counts[rank], 300, rt.device)
+        out = torch.full(
+            (world, CAPACITY), SENTINEL, dtype=torch.uint8, device=rt.device
+        )
+        prepared.gather(
+            source, torch.tensor(counts, dtype=torch.int64, device=rt.device), out=out
+        )
+        torch.cuda.synchronize()
+        _check(out, counts, 300)
+    finally:
+        rt.close()
+        dist.barrier()
diff --git a/tests/experimental/b12x/comm/validate_roce_ring_native.py b/tests/experimental/b12x/comm/validate_roce_ring_native.py
new file mode 100644
index 0000000000000000000000000000000000000000..cb72619241b8e78b84c6060821fab624a2925182
--- /dev/null
+++ b/tests/experimental/b12x/comm/validate_roce_ring_native.py
@@ -0,0 +1,328 @@
+"""Exercise the real RDMA ring proxy without a CUDA context.
+
+Run one process per host with --rank R and --world-size N and --rendezvous HOST:PORT. The
+CPU drives the same pinned-region doorbells and checks every received byte.
+This checks transport progress and staging reuse, independently of GPU kernels.
+"""
+
+import argparse
+import ctypes
+import importlib.util
+import json
+import mmap
+from pathlib import Path
+import socket
+import struct
+import sys
+import time
+
+
+def module(path, name):
+    spec = importlib.util.spec_from_file_location(name, path)
+    result = importlib.util.module_from_spec(spec)
+    sys.modules[name] = result
+    spec.loader.exec_module(result)
+    return result
+
+
+def send(sock, data):
+    sock.sendall(struct.pack("!I", len(data)) + data)
+
+
+def receive(sock):
+    def exact(n):
+        data = bytearray()
+        while len(data) < n:
+            part = sock.recv(n - len(data))
+            if not part:
+                raise RuntimeError("peer disconnected")
+            data += part
+        return bytes(data)
+
+    return exact(struct.unpack("!I", exact(4))[0])
+
+
+class Group:
+    def __init__(self, rank, address, world):
+        self.rank, self.world = rank, world
+        host, port = address.rsplit(":", 1)
+        if rank == 0:
+            with socket.socket() as listener:
+                listener.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
+                listener.bind(("0.0.0.0", int(port)))
+                listener.listen(world - 1)
+                listener.settimeout(30)
+                self.peers = {}
+                for _ in range(world - 1):
+                    peer, _ = listener.accept()
+                    peer.settimeout(30)
+                    self.peers[int(receive(peer))] = peer
+        else:
+            until = time.monotonic() + 30
+            while True:
+                try:
+                    self.peer = socket.create_connection((host, int(port)), 5)
+                    break
+                except OSError:
+                    if time.monotonic() > until:
+                        raise
+                    time.sleep(0.1)
+            self.peer.settimeout(30)
+            send(self.peer, str(rank).encode())
+
+    def exchange(self, value):
+        if self.rank:
+            send(self.peer, json.dumps(value).encode())
+            return json.loads(receive(self.peer))
+        values = [value] + [
+            json.loads(receive(self.peers[r])) for r in range(1, self.world)
+        ]
+        for peer in self.peers.values():
+            send(peer, json.dumps(values).encode())
+        return values
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--rank", type=int, required=True)
+    parser.add_argument("--world-size", type=int, default=4, choices=range(2, 17))
+    parser.add_argument("--rendezvous", required=True)
+    parser.add_argument("--iterations", type=int, default=120)
+    parser.add_argument(
+        "--mesh",
+        action="store_true",
+        help="check the ordinary direct transport instead",
+    )
+    parser.add_argument("--skew-rank", type=int)
+    parser.add_argument("--hca-names", default="roceP2p1s0f0,rocep1s0f0")
+    parser.add_argument("--gid-index", type=int, default=3)
+    parser.add_argument("--source", type=Path)
+    args = parser.parse_args()
+    if args.source is None:
+        args.source = (
+            Path(__file__).resolve().parents[4]
+            / "flashinfer/experimental/b12x/comm/roce"
+        )
+    world = args.world_size
+    if not 0 <= args.rank < world:
+        parser.error("--rank must be less than --world-size")
+    if args.iterations < 1:
+        parser.error("--iterations must be positive")
+    names = tuple(args.hca_names.split(","))
+    if not 2 <= len(names) <= 4 or not all(names):
+        parser.error("this validator requires 2..4 --hca-names for two rails")
+    proxy_api = module(args.source / "_proxy.py", "ring_proxy_check")
+    routes_api = module(args.source / "_routes.py", "ring_routes_check")
+    group = Group(args.rank, args.rendezvous, world)
+    layout = proxy_api.Layout(world, 1 << 20, 4 << 20, 1 << 20)
+    memory = mmap.mmap(-1, layout.total_bytes)
+    buffer = (ctypes.c_char * layout.total_bytes).from_buffer(memory)
+    address = ctypes.addressof(buffer)
+    proxy = proxy_api.Proxy(
+        world_size=world,
+        rank=args.rank,
+        hca_names=names,
+        gid_index=args.gid_index,
+        region_ptr=address,
+        region_bytes=layout.total_bytes,
+        slot_bytes=1 << 20,
+        pipe_bytes=4 << 20,
+        varlen_bytes=1 << 20,
+        ring=not args.mesh,
+    )
+    endpoints = routes_api.local_endpoints(names, args.gid_index)
+    local = {
+        "blob": proxy.local_blob().hex(),
+        "endpoints": [(e.name, str(e.ipv4)) for e in endpoints],
+    }
+    records = group.exchange(local)
+    import ipaddress
+
+    all_endpoints = [
+        [
+            routes_api.Endpoint(n, ipaddress.IPv4Interface(ip))
+            for n, ip in record["endpoints"]
+        ]
+        for record in records
+    ]
+    routes = routes_api.plan_routes(all_endpoints, args.rank, 2, ring=not args.mesh)
+    if not args.mesh:
+        assert all(
+            not links
+            for peer, links in enumerate(routes)
+            if peer not in {args.rank, (args.rank + 1) % world, (args.rank - 1) % world}
+        )
+    proxy.connect([bytes.fromhex(r["blob"]) for r in records], routes)
+    group.exchange("connected")
+    proxy.start()
+    ctrl = (ctypes.c_uint32 * 1024).from_address(address + layout.ctrl_off)
+    # libatomic provides system acquire/release accesses on ARM as well as x86.
+    atomics = ctypes.CDLL("libatomic.so.1")
+    atomics.__atomic_load_4.argtypes = [ctypes.c_void_p, ctypes.c_int]
+    atomics.__atomic_load_4.restype = ctypes.c_uint32
+    atomics.__atomic_store_4.argtypes = [ctypes.c_void_p, ctypes.c_uint32, ctypes.c_int]
+
+    def put(offset, value):
+        atomics.__atomic_store_4(address + offset, value, 3)
+
+    def wait(offset, value):
+        until = time.monotonic() + 20
+        while atomics.__atomic_load_4(address + offset, 2) != value:
+            if proxy.failed():
+                raise RuntimeError(proxy.error())
+            if time.monotonic() > until:
+                raise TimeoutError(
+                    f"rank {args.rank}: offset {offset} expected {value}, stats {proxy.stats()}"
+                )
+
+    try:
+        for seq in range(1, args.iterations + 1):
+            if args.rank == args.skew_rank:
+                time.sleep(0.001 * (seq % 4))
+            mode = (seq - 1) % 3
+            slot = seq & 1
+            pattern = (seq + 17 * args.rank) % 256
+            if mode == 0:
+                size = (32, 32768, 131072, 1 << 20)[((seq - 1) // 3) % 4]
+                start = layout.send_off + slot * (1 << 20)
+                memory[start : start + size] = bytes([pattern]) * size
+                ctrl[4 + slot], ctrl[8 + slot] = size, 0
+                put(layout.ctrl_off, seq)
+                for src in range(world):
+                    if src == args.rank:
+                        continue
+                    for rail in range(2):
+                        wait(
+                            layout.flag_off
+                            + ((src * 2 + slot) * 2 + rail) * layout.flag_stride,
+                            seq,
+                        )
+                    start = layout.recv_off + (src * 2 + slot) * (1 << 20)
+                    assert (
+                        memory[start : start + size]
+                        == bytes([(seq + 17 * src) % 256]) * size
+                    )
+            elif mode == 1:
+                size = (2 << 20, 4 << 20, (1 << 20) + 48)[((seq - 1) // 3) % 3]
+                total_packs = size // 16
+                chunk_bytes = 65536
+                chunks = (
+                    (total_packs + world - 1) // world * 16 + chunk_bytes - 1
+                ) // chunk_bytes
+                start = layout.pipe_send_off
+                memory[start : start + size] = bytes([pattern]) * size
+                ctrl[4 + slot], ctrl[8 + slot] = size, 1
+                ctrl[10 + slot], ctrl[12 + slot] = chunk_bytes // 16, chunks
+                for chunk in range(chunks):
+                    put(layout.ctrl_off + 4 * (64 + chunk), seq)
+                put(layout.ctrl_off, seq)
+                first = args.rank * total_packs // world * 16
+                end = (args.rank + 1) * total_packs // world * 16
+                reduced = (world * seq + 17 * world * (world - 1) // 2) % 256
+                for chunk in range(chunks):
+                    length = min(chunk_bytes, max(0, end - first - chunk * chunk_bytes))
+                    for src in range(world):
+                        if src == args.rank:
+                            continue
+                        for rail in range(2):
+                            wait(
+                                layout.pipe_flag_off
+                                + ((src * 64 + chunk) * 2 + rail) * layout.flag_stride,
+                                seq,
+                            )
+                        start = (
+                            layout.pipe_recv_off
+                            + src * 2 * layout.shard_cap
+                            + chunk * chunk_bytes
+                        )
+                        assert (
+                            memory[start : start + length]
+                            == bytes([(seq + 17 * src) % 256]) * length
+                        )
+                    start = layout.pipe_send_off + first + chunk * chunk_bytes
+                    memory[start : start + length] = bytes([reduced]) * length
+                    put(layout.ctrl_off + 4 * (128 + chunk), seq)
+                for src in range(world):
+                    if src == args.rank:
+                        continue
+                    length = (
+                        (src + 1) * total_packs // world - src * total_packs // world
+                    ) * 16
+                    for chunk in range(chunks):
+                        for rail in range(2):
+                            wait(
+                                layout.pipe_flag_off
+                                + (((world + src) * 64 + chunk) * 2 + rail)
+                                * layout.flag_stride,
+                                seq,
+                            )
+                    start = layout.pipe_recv_off + (src * 2 + 1) * layout.shard_cap
+                    assert memory[start : start + length] == bytes([reduced]) * length
+                wait(layout.ctrl_off + 4 * 48, seq)
+            else:
+                sizes = tuple((0, 16, 131088, 1 << 20)[r % 4] for r in range(world))
+                sizes = sizes[seq % world :] + sizes[: seq % world]
+                size = sizes[args.rank]
+                chunk_bytes = 65536
+                chunks = max(1, (size + chunk_bytes - 1) // chunk_bytes)
+                start = (
+                    layout.varlen_recv_off
+                    + (slot * world + args.rank) * layout.varlen_bytes
+                )
+                memory[start : start + size] = bytes([pattern]) * size
+                ctrl[4 + slot], ctrl[8 + slot] = size, 2
+                ctrl[10 + slot], ctrl[12 + slot] = chunk_bytes // 16, chunks
+                for chunk in range(chunks):
+                    put(layout.ctrl_off + 4 * (256 + chunk), seq)
+                put(layout.ctrl_off, seq)
+                for src, length in enumerate(sizes):
+                    if src == args.rank:
+                        continue
+                    for chunk in range(
+                        max(1, (length + chunk_bytes - 1) // chunk_bytes)
+                    ):
+                        for rail in range(2):
+                            wait(
+                                layout.varlen_flag_off
+                                + (
+                                    (((slot * world + src) * 512 + chunk) * 2 + rail)
+                                    * layout.flag_stride
+                                ),
+                                seq,
+                            )
+                    start = (
+                        layout.varlen_recv_off
+                        + (slot * world + src) * layout.varlen_bytes
+                    )
+                    assert (
+                        memory[start : start + length]
+                        == bytes([(seq + 17 * src) % 256]) * length
+                    )
+        group.exchange("drained")
+        proxy.stop()
+        stats = proxy.stats()
+        assert stats["connected_peers"] == (
+            world - 1 if args.mesh else min(2, world - 1)
+        )
+        if not args.mesh and world > 3:
+            assert stats["ring_forwarded"] > 0, stats
+        print(
+            json.dumps(
+                {
+                    "rank": args.rank,
+                    "world": world,
+                    "iterations": args.iterations,
+                    "routes": routes,
+                    "stats": stats,
+                }
+            ),
+            flush=True,
+        )
+    finally:
+        proxy.close()
+        del ctrl, buffer
+        memory.close()
+
+
+if __name__ == "__main__":
+    main()
