+                    )
+                    output.copy_(captured)
+                source.normal_()
+                workspace.fill_(255)
+                output.fill_(float("nan"))
+                graph.replay()
+                torch.cuda.synchronize()
+            torch.testing.assert_close(output, source @ dense.T, atol=0, rtol=0)
+        finally:
+            graph.reset()
+
