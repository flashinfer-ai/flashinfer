+    @cute.jit
+    def _lut_smem_copy(
+        self,
+        src_addr: Int64,
+        dst_off: Int32,
+        nbytes: cutlass.Constexpr[int],
+        tid: Int32,
+    ):
+        chunks = Int32(int(nbytes) // 16)
+        i = tid
+        while i < chunks:
+            v0, v1, v2, v3 = ld_global_nc_v4_u32(src_addr + Int64(i) * Int64(16))
+            st_shared_v4_u32(dst_off + i * Int32(16), v0, v1, v2, v3)
+            i += Int32(self.cta_threads)
