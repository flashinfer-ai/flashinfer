+
+        # Create pointer from address
+        y = make_ptr(cutlass.Float32, ptr_address)
+    """
+    # check if value is int or ctypes.POINTER
+    if isinstance(value, int):
+        address_value = value
+    elif isinstance(value, ctypes._Pointer):
