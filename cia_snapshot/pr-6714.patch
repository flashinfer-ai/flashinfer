+def _compile_w4a16_gemm_launch(
+    *,
+    size_m: int,
+    size_n: int,
+    size_k: int,
+    num_experts: int,
+    top_k: int,
+    mul_topk_weights: bool,
+    moe_block_size: int,
+    max_m_blocks: int,
+    element_dtype: str,
+    packed_route_indices: torch.Tensor | None,
+    sms: int,
