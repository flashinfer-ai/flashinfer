+        **{
+            name: operands[name]
+            for name in (
+                "query",
+                "request_ids",
+                "query_positions",
+                "main_k_cache",
+                "main_v_cache",
+                "k_descale",
+                "v_descale",
+                "main_block_table",
+                "scratch",
+                "output",
+            )
