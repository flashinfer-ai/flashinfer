new file mode 100644
index 0000000000000000000000000000000000000000..d4350fcf93cf916d847b3a4501f13dc6bde105fa
--- /dev/null
+++ b/flashinfer/experimental/b12x/sequence/short_conv/_tuning.py
@@ -0,0 +1,130 @@
+"""Fixed packed-request convolution geometry and launch layouts."""
+
+from dataclasses import dataclass
+
+from b12x.preparation import make_fixed_contract
+
+OPERANDS = (
+    "x",
+    "conv_weight",
+    "query_start_loc",
+    "state_slot_ids",
+    "state_is_fresh",
+    "num_accepted_tokens",
+    "request_is_prefill",
+    "num_seqs",
+    "num_tokens",
+    "conv_state",
+    "out",
+    "gathered_state",
+    "request_ids",
+    "conv_bias",
+)
+
+
+@dataclass(frozen=True, kw_only=True)
+class ShortConvQuery:
+    mode: str
+    channels: int
+    kernel_size: int
+    dilation: int
+    max_tokens: int
+    max_seqs: int
+    max_state_slots: int
+    max_speculative_tokens: int
+    round_before_silu: bool = True
+    bias_dtype: str | None = None
+    weight_dtype: str = "bfloat16"
+    state_strides: tuple[int, int, int] | None = None
+    input_row_stride: int | None = None
+    input_alignments: tuple[int, ...] = (16,) * len(OPERANDS)
+
+    def __post_init__(self):
+        if (
+            self.bias_dtype not in (None, "bfloat16", "float32")
+            or type(self.round_before_silu) is not bool
+        ):
+            raise ValueError(
+                "short convolution requires BF16/FP32 bias and a boolean rounding contract"
+            )
+        if self.weight_dtype not in ("bfloat16", "float32"):
+            raise ValueError("short convolution weights require BF16 or FP32")
+        if self.mode not in ("decode", "prefill", "mixed"):
+            raise ValueError("short convolution mode must be decode, prefill, or mixed")
+        if any(
+            type(value) is not int or not 0 < value < 2**31
+            for value in (
+                self.channels,
+                self.kernel_size,
+                self.dilation,
+                self.max_tokens,
+                self.max_seqs,
+                self.max_state_slots,
+            )
+        ):
+            raise ValueError(
+                "short convolution dimensions must be positive Int32 integers"
+            )
+        if self.kernel_size < 2:
+            raise ValueError("short convolution requires at least two taps")
+        if (
+            type(self.max_speculative_tokens) is not int
+            or self.max_speculative_tokens < 0
+        ):
+            raise ValueError(
+                "short convolution speculative capacity must be nonnegative"
+            )
+        input_stride = (
+            self.channels if self.input_row_stride is None else self.input_row_stride
+        )
+        if type(input_stride) is not int or input_stride < self.channels:
+            raise ValueError(
+                "short convolution input rows must have a nonoverlapping positive stride"
+            )
+        if input_stride * self.max_tokens >= 2**63:
+            raise ValueError(
+                "short convolution input exceeds the Int64 indexing domain"
+            )
+        object.__setattr__(self, "input_row_stride", input_stride)
+        capacity = self.state_capacity
+        if capacity >= 2**31:
+            raise ValueError(
+                "short convolution history exceeds the Int32 indexing domain"
+            )
+        strides = (
+            (self.channels * capacity, capacity, 1)
+            if self.state_strides is None
+            else tuple(self.state_strides)
+        )
+        if len(strides) != 3 or any(type(s) is not int or s <= 0 for s in strides):
+            raise ValueError(
+                "short convolution history requires three positive strides"
+            )
+        if strides[1:] != (capacity, 1) or strides[0] < self.channels * capacity:
+            raise ValueError(
+                "short convolution history must be dense within nonoverlapping slots"
+            )
+        if strides[0] * self.max_state_slots >= 2**63:
+            raise ValueError("short convolution pool exceeds the Int64 indexing domain")
+        alignments = tuple(self.input_alignments)
+        if len(alignments) != len(OPERANDS) or any(
+            type(a) is not int or a not in (1, 2, 4, 8, 16) for a in alignments
+        ):
+            raise ValueError("short convolution requires every operand's alignment")
+        object.__setattr__(self, "state_strides", strides)
+        object.__setattr__(self, "input_alignments", alignments)
+
+    @property
+    def state_length(self):
+        return self.dilation * (self.kernel_size - 1)
+
+    @property
+    def state_capacity(self):
+        return self.state_length + self.max_speculative_tokens
+
+
+TUNING = make_fixed_contract(
+    component_id="sequence.short_conv",
+    query_type=ShortConvQuery,
+    backend="triton",
+)
diff --git a/flashinfer/experimental/b12x/sequence/short_conv/api.py b/flashinfer/experimental/b12x/sequence/short_conv/api.py
new file mode 100644
index 0000000000000000000000000000000000000000..7e76d85a4ac9fed405d8aaa256aba1a0d818bc95
--- /dev/null
+++ b/flashinfer/experimental/b12x/sequence/short_conv/api.py
@@ -0,0 +1,199 @@
+"""Prepared raw-input short convolution public API."""
+
+from dataclasses import dataclass
+
+import torch
+
+from b12x._lib.gating import default_is_supported
+from b12x.preparation import Plan
+from b12x.preparation.types import plan_from_handle, require_prepared
+
+from ._tuning import OPERANDS
+
+
+@dataclass(frozen=True, kw_only=True)
+class Caps:
+    """Convolution geometry and fixed capacities for packed request buffers."""
+
+    device: torch.device | str
+    mode: str
+    channels: int
+    kernel_size: int
+    max_tokens: int
+    max_seqs: int
+    max_state_slots: int
+    dilation: int = 1
+    max_speculative_tokens: int = 0
+    round_before_silu: bool = True
+
+
+@dataclass(frozen=True)
+class Binding:
+    """Caller-owned inputs, persistent history, output, and scratch views."""
+
+    plan: Plan
+    scratch: torch.Tensor
+    x: torch.Tensor
+    conv_weight: torch.Tensor
+    query_start_loc: torch.Tensor
+    state_slot_ids: torch.Tensor
+    state_is_fresh: torch.Tensor
+    num_accepted_tokens: torch.Tensor
+    request_is_prefill: torch.Tensor
+    num_seqs: torch.Tensor
+    num_tokens: torch.Tensor
+    conv_state: torch.Tensor
+    out: torch.Tensor
+    gathered_state: torch.Tensor
+    request_ids: torch.Tensor
+    conv_bias: torch.Tensor | None = None
+
+
+def plan(caps: Caps, *, invocation=None, override=None) -> Plan:
+    from ._preparation import make_plan
+
+    return make_plan(caps, invocation=invocation, override=override)
+
+
+def invocation_from_tensors(*, conv_state, scratch=None, **tensors):
+    """Describe actual history strides and pointer alignments for preparation."""
+    from ._preparation import invocation_from_tensors as describe
+
+    return describe(conv_state=conv_state, scratch=scratch, **tensors)
+
+
+def bind(
+    plan: Plan,
+    *,
+    scratch,
+    x,
+    conv_weight,
+    query_start_loc,
+    state_slot_ids,
+    state_is_fresh,
+    num_accepted_tokens,
+    num_seqs,
+    num_tokens,
+    conv_state,
+    out,
+    request_is_prefill=None,
+    conv_bias=None,
+) -> Binding:
+    """Bind BF16 ``x/out [max_tokens, channels]`` and caller-owned history.
+
+    Weights are BF16 ``[channels, kernel_size]``. Request metadata consists of
+    int32 ``query_start_loc [max_seqs + 1]``, int64 ``state_slot_ids [max_seqs]``,
+    bool ``state_is_fresh [max_seqs]``, int32 ``num_accepted_tokens [max_seqs]``,
+    and int32 ``num_seqs/num_tokens [1]``. Mixed batches additionally require
+    bool ``request_is_prefill [max_seqs]``. History may have a padded slot
+    stride, and input rows may have a padded outer stride with unit column
+    stride; every other operand must be contiguous. Mutated buffers must not
+    overlap other operands. Binding does not allocate or read device values.
+    """
+    return require_prepared(plan, "sequence.short_conv", x.device).bind(
+        plan=plan,
+        scratch=scratch,
+        x=x,
+        conv_weight=conv_weight,
+        query_start_loc=query_start_loc,
+        state_slot_ids=state_slot_ids,
+        state_is_fresh=state_is_fresh,
+        num_accepted_tokens=num_accepted_tokens,
+        num_seqs=num_seqs,
+        num_tokens=num_tokens,
+        conv_state=conv_state,
+        out=out,
+        request_is_prefill=request_is_prefill,
+        conv_bias=conv_bias,
+    )
+
+
+@torch.library.custom_op(
+    "b12x::short_conv",
+    mutates_args=("conv_state", "out", "gathered_state", "request_ids"),
+)
+def _pipeline(
+    x: torch.Tensor,
+    conv_weight: torch.Tensor,
+    query_start_loc: torch.Tensor,
+    state_slot_ids: torch.Tensor,
+    state_is_fresh: torch.Tensor,
+    num_accepted_tokens: torch.Tensor,
+    request_is_prefill: torch.Tensor,
+    num_seqs: torch.Tensor,
+    num_tokens: torch.Tensor,
+    conv_state: torch.Tensor,
+    out: torch.Tensor,
+    gathered_state: torch.Tensor,
+    request_ids: torch.Tensor,
+    conv_bias: torch.Tensor | None,
+    plan_handle: int,
+) -> None:
+    require_prepared(
+        plan_from_handle(plan_handle), "sequence.short_conv", x.device
+    ).run_tensors(
+        x,
+        conv_weight,
+        query_start_loc,
+        state_slot_ids,
+        state_is_fresh,
+        num_accepted_tokens,
+        request_is_prefill,
+        num_seqs,
+        num_tokens,
+        conv_state,
+        out,
+        gathered_state,
+        request_ids,
+        conv_bias,
+    )
+
+
+@_pipeline.register_fake
+def _pipeline_fake(
+    x,
+    conv_weight,
+    query_start_loc,
+    state_slot_ids,
+    state_is_fresh,
+    num_accepted_tokens,
+    request_is_prefill,
+    num_seqs,
+    num_tokens,
+    conv_state,
+    out,
+    gathered_state,
+    request_ids,
+    conv_bias,
+    plan_handle,
+) -> None:
+    pass
+
+
+def run(binding: Binding) -> torch.Tensor:
+    """Execute retained launchers; write zero for padded rows and return ``out``."""
+    if not isinstance(binding, Binding):
+        raise TypeError("binding must be short_conv.Binding")
+    _pipeline(*(getattr(binding, name) for name in OPERANDS), binding.plan.handle)
+    return binding.out
+
+
+def is_supported(device=None):
+    return default_is_supported(device, requires=("triton",))
+
+
+def clear_caches():
+    """Compiled programs are owned by preparation sessions."""
+
+
+__all__ = [
+    "Caps",
+    "Binding",
+    "Plan",
+    "plan",
+    "invocation_from_tensors",
+    "bind",
+    "run",
+    "is_supported",
+    "clear_caches",
+]
