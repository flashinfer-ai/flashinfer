+                                fc2_flat[base + Int32(0)].to(cutlass.Float32) * weight
+                            )
+                            acc1 += (
+                                fc2_flat[base + Int32(1)].to(cutlass.Float32) * weight
+                            )
+                            acc2 += (
+                                fc2_flat[base + Int32(2)].to(cutlass.Float32) * weight
+                            )
+                            acc3 += (
+                                fc2_flat[base + Int32(3)].to(cutlass.Float32) * weight
+                            )
