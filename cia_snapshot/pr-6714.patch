+"""Block storage expands exact scale bytes into caller-owned native scratch."""
+
+import numpy as np
+import pytest
+import torch
+
+from b12x._lib.quant.csf_blocks import (
+    Nvfp4BlockPlane,
+    Nvfp4CompactBlockPlane,
