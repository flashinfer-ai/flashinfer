+def _caps(**changes):
+    values = dict(
+        device="cuda:0",
+        max_batch=4,
+        max_raw_state_slots=4,
+        max_q_rows=512,
+        max_seq_len=4096,
+        num_main_cache_pages=64,
+        num_compressed_cache_pages=64,
+        main_page_size=64,
+        compressed_page_size=16,
+    )
+    values.update(changes)
+    return qsa.Caps(**values)
