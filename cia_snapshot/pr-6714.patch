+                    a_bf16_flat,
+                    suh_gate_flat,
+                    packed_route_indices,
+                    block_expert_ids,
+                    packed_route_count,
+                    expert_map_flat,
+                    weight_num_experts,
+                    route_num_experts,
+                    tid,
+                    cta,
+                    grid_x,
+                    active_m,
+                )
+            else:
