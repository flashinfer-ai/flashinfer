+"""Session-prepared expansion of compact FP4 scale records.
+
+The tuner sweeps work per CTA, exception placement, and expert-presence
+construction. Scale payloads and native outputs remain caller-owned. Each
+prepared binding uses one fixed expert-presence scratch tensor.
+"""
+
+from dataclasses import asdict, dataclass, replace
+
+import torch
+
+from b12x._lib.compile_pool import CompileJob
+from b12x._lib.program_cache import program_cache
+from b12x._lib.scratch import ScratchBufferSpec, scratch_tensor
+from b12x.preparation import (
+    FrozenMapping,
+    Knob,
+    MemoryRequirements,
+    ParameterBinding,
+    ParameterSpace,
+    Plan,
+    TuningContract,
+)
+from b12x._lib.quant.csf_blocks import Nvfp4CompactBlockPlane
+from b12x._lib.quant.csf_routing import compile_csf_active_experts
+from b12x._lib.quant.nvfp4_csf import Nvfp4CsfDecoder, compile_nvfp4_csf_pair
+
+
+@dataclass(frozen=True)
+class CsfExpansionQuery:
+    first: tuple[int, ...]
+    second: tuple[int, ...]
+    routes: int
+    ids_dtype: str
+
+
+@dataclass(frozen=True)
+class CsfExpansionConfig:
+    groups_per_task: int = 8
+    shared_exceptions: bool = True
+    bitmap_routes: bool = False
+    direct_routes: bool = False
+
+    @classmethod
+    def from_config(cls, payload):
+        if set(payload) != set(cls.__dataclass_fields__):
+            raise ValueError(
+                "CSF expansion configuration fields differ from its contract"
+            )
+        return cls(**dict(payload))
+
+
+def _uses_presence(query):
+    return 64 <= query.routes < 16 * query.first[6]
+
+
+def _validate_query(query, device):
+    if not isinstance(query, CsfExpansionQuery):
+        raise TypeError("CSF expansion requires a CsfExpansionQuery")
+    if type(query.routes) is not int or query.routes <= 0:
+        raise ValueError("CSF expansion requires a positive route capacity")
+    if query.ids_dtype not in ("int32", "int64"):
+        raise ValueError("CSF expansion routes require int32 or int64")
+    for geometry in (query.first, query.second):
+        if (
+            len(geometry) != 9
+            or geometry[2] not in (1, 4)
+            or geometry[3] not in range(4, 10)
+        ):
+            raise ValueError(
+                "Native expansion requires compact one-bit or four-bit scales"
+            )
+    if query.first[6] != query.second[6]:
+        raise ValueError("CSF expansion expert counts must agree")
+
+
+def _validate_config(query, config, device):
+    if not isinstance(config, CsfExpansionConfig):
+        raise TypeError("CSF expansion requires a CsfExpansionConfig")
+    if type(config.groups_per_task) is not int or config.groups_per_task not in (
+        1,
+        2,
+        4,
+        8,
+        16,
+        32,
+        64,
+    ):
+        raise ValueError("CSF expansion tasks require 1, 2, 4, 8, 16, 32, or 64 groups")
+    if (
+        type(config.shared_exceptions) is not bool
+        or type(config.bitmap_routes) is not bool
+        or type(config.direct_routes) is not bool
+    ):
+        raise TypeError("CSF expansion switches must be boolean")
+    if config.direct_routes and not _uses_presence(query):
+        raise ValueError("Direct-route tuning requires a presence-routed capacity")
+    if config.direct_routes and config.bitmap_routes:
+        raise ValueError("Direct routes do not use an expert-presence bitmap")
+    if config.bitmap_routes and not _uses_presence(query):
+        raise ValueError("Expert-presence tuning requires a presence-routed capacity")
+
+
+def _parameters(query, device):
+    return ParameterSpace.create(
+        TUNING.knobs,
+        values={
+            "direct_routes": (False, True)
+            if _uses_presence(query) and query.routes <= query.first[6]
+            else (False,),
+            "bitmap_routes": (False, True) if _uses_presence(query) else (False,),
+        },
+    )
+
+
+TUNING = TuningContract(
+    component_id="quantization.csf_block_expansion",
+    query_schema_version=8,
+    config_schema_version=2,
+    query_fields=frozenset(CsfExpansionQuery.__dataclass_fields__),
+    config_fields=frozenset(CsfExpansionConfig.__dataclass_fields__),
+    encode_query=asdict,
+    encode_config=asdict,
+    decode_config=CsfExpansionConfig.from_config,
+    validate_query=_validate_query,
+    validate_config=_validate_config,
+    default_config=lambda query, device: CsfExpansionConfig(
+        bitmap_routes=_uses_presence(query)
+    ),
+    knobs=(
+        Knob(name="groups_per_task", values=(1, 2, 4, 8, 16, 32, 64)),
+        Knob(name="shared_exceptions", values=(False, True)),
+        Knob(
+            name="direct_routes",
+            values=(False, True),
+            binding=ParameterBinding.RUNTIME,
+        ),
+        Knob(
+            name="bitmap_routes",
+            values=(False, True),
+            when=FrozenMapping({"direct_routes": False}),
+            otherwise=False,
+        ),
+    ),
+    parameters=_parameters,
+)
+
+
+@program_cache(scope="preparation")
+def compile_expansion(query_payload, config_payload, ordinal):
+    query = CsfExpansionQuery(**dict(query_payload))
+    config = CsfExpansionConfig.from_config(config_payload)
+    geometries = tuple(
+        (
+            *geometry[:7],
+            config.groups_per_task,
+            int(config.shared_exceptions),
+            *geometry[7:],
+        )
+        for geometry in (query.first, query.second)
+    )
+    with torch.cuda.device(ordinal):
+        programs = tuple(
+            compile_nvfp4_csf_pair(*geometries, ids64) for ids64 in (False, True)
+        )
+        routing = tuple(
+            compile_csf_active_experts(
+                ids64, query.first[6] if config.bitmap_routes else 0
+            )
+            for ids64 in (False, True)
+        )
+    return programs, routing
+
+
+def _scratch(experts, device):
+    return (
+        ScratchBufferSpec(
+            name="csf_active_experts",
+            shape=(experts,),
+            dtype=torch.int32,
+            device=device,
+        ),
+    )
+
+
+@dataclass(frozen=True)
+class _Binding:
+    decoder: Nvfp4CsfDecoder
+    ids: torch.Tensor
+    out13: torch.Tensor
+    out2: torch.Tensor
+
+    def run(self):
+        self.decoder.decode(self.ids, self.out13, self.out2)
+
+
+@dataclass(frozen=True)
+class _ExpansionState:
+    query: CsfExpansionQuery
+    first: Nvfp4CompactBlockPlane
+    second: Nvfp4CompactBlockPlane
+    programs: tuple
+    routing: tuple
+    device: torch.device
+    bitmap_routes: bool
+    direct_routes: bool
+
+    def decoder(self, scratch):
+        active = scratch_tensor(
+            scratch,
+            _scratch(self.first.num_experts, self.device),
+            owner="CSF expansion",
+        )
+        return Nvfp4CsfDecoder(
+            self.first,
+            self.second,
+            self.programs,
+            self.routing,
+            active[: self.first.num_experts],
+            bitmap_routes=self.bitmap_routes,
+            direct_routes=self.direct_routes,
+        )
+
+    def bind(self, *, ids, out13, out2, scratch):
+        if (ids.numel(), str(ids.dtype).removeprefix("torch."), ids.device) != (
+            self.query.routes,
+            self.query.ids_dtype,
+            self.device,
+        ):
+            raise ValueError(
+                "CSF routes differ from the prepared capacity, dtype, or device"
+            )
+        return _Binding(self.decoder(scratch), ids, out13, out2)
+
+    def run(self, binding):
+        binding.run()
+
+
+def plan_csf_block_expansion(
+    first,
+    second,
+    *,
+    routes,
+    ids_dtype=torch.int32,
+    invocation=FrozenMapping(),
+    override=None,
+):
+    """Declare an expansion sweep without compiling or allocating GPU storage."""
+    for plane in (first, second):
+        if not isinstance(plane, Nvfp4CompactBlockPlane):
+            raise TypeError("CSF expansion planning requires compact FP4 block planes")
+        plane.validate()
+    if first.fixed.device != second.fixed.device:
+        raise ValueError("CSF expansion planes must be on one device")
+    query = CsfExpansionQuery(
+        first.geometry[:7] + first.geometry[9:],
+        second.geometry[:7] + second.geometry[9:],
+        routes,
+        str(ids_dtype).removeprefix("torch."),
+    )
+
+    def compile_jobs(config, device):
+        return (
+            CompileJob.create(
+                "b12x._lib.quant.csf_blocks_tuning:compile_expansion",
+                TUNING.encode_query(query),
+                TUNING.encode_config(config),
+                device.ordinal,
+            ),
+        )
+
+    def materialize(selection, device):
+        if first.fixed.device != torch.device("cuda", device.ordinal):
+            raise ValueError("CSF payload and preparation devices differ")
+        config = selection.config
+        planes = tuple(
+            replace(
+                p,
+                groups_per_task=config.groups_per_task,
+                shared_exceptions=config.shared_exceptions,
+            )
+            for p in (first, second)
+        )
+        programs, routing = compile_expansion(
+            TUNING.encode_query(query), TUNING.encode_config(config), device.ordinal
+        )
+        return _ExpansionState(
+            query,
+            *planes,
+            programs,
+            routing,
+            torch.device("cuda", device.ordinal),
+            config.bitmap_routes,
+            config.direct_routes,
+        )
+
+    return Plan(
+        contract=TUNING,
+        query=query,
+        invocation=invocation,
+        override=override,
+        _device=first.fixed.device,
+        _compile_jobs=compile_jobs,
+        _memory_requirements=lambda config, device: MemoryRequirements(
+            scratch=_scratch(first.num_experts, torch.device("cuda", device.ordinal))
+        ),
+        _materialize=materialize,
+    )
diff --git a/flashinfer/experimental/b12x/_lib/quant/csf_encode.py b/flashinfer/experimental/b12x/_lib/quant/csf_encode.py
new file mode 100644
index 0000000000000000000000000000000000000000..72f5ee157d8242b13bc16ce351d1851de0e7982d
--- /dev/null
+++ b/flashinfer/experimental/b12x/_lib/quant/csf_encode.py
@@ -0,0 +1,128 @@
+"""Load-time lossless GPU encoding of native FP4 block-scale bytes.
+
+Each row keeps the lowest base covering the most of its scale bytes in a
+sixteen-value (NVFP4) or two-value (MXFP4) window. Bytes outside that window
+are stored verbatim as exceptions. The output is the slab checkpoint encoding,
+so weight preparation consumes it exactly like compressed checkpoint scales.
+No floating-point conversion is performed. Sizing the exception stream takes
+one host synchronization; this is a load-time operation, not graph replay.
+"""
+
+from __future__ import annotations
+
+import torch
+import triton
+import triton.language as tl
+
+_BITS = {"nvfp4": 4, "mxfp4": 1}
+
+
+@triton.jit
+def _choose_bases(
+    S,
+    Bases,
+    Counts,
+    C: tl.constexpr,
+    W: tl.constexpr,
+    B: tl.constexpr,
+):
+    row = tl.program_id(0).to(tl.int64)
+    col = tl.arange(0, B)
+    values = tl.load(S + row * C + col, col < C, 0).to(tl.int32)
+    histogram = tl.histogram(values, 256, mask=col < C)
+    ends = tl.cumsum(histogram, 0)
+    base = tl.arange(0, 256)
+    right = tl.gather(ends, tl.minimum(base + W - 1, 255), 0)
+    left = tl.where(base > 0, tl.gather(ends, tl.maximum(base - 1, 0), 0), 0)
+    covered = tl.where(base <= 256 - W, right - left, -1)
+    best = tl.max(covered, 0)
+    chosen = tl.min(tl.where(covered == best, base, 256), 0)
+    tl.store(Bases + row, chosen.to(tl.uint8))
+    tl.store(Counts + row, (C - best).to(tl.int64))
+
+
+@triton.jit
+def _pack_rows(
+    S,
+    Bases,
+    Prefix,
+    Fixed,
+    Exceptions,
+    R: tl.constexpr,
+    C: tl.constexpr,
+    BITS: tl.constexpr,
+    B: tl.constexpr,
+):
+    # One program per row of the concatenated [expert, row] grid. A 16-row slab
+    # holds sixteen bases, then each row's codes in column order, low bits first.
+    row = tl.program_id(0).to(tl.int64)
+    col = tl.arange(0, B)
+    valid = col < C
+    values = tl.load(S + row * C + col, valid, 0).to(tl.int32)
+    base = tl.load(Bases + row).to(tl.int32)
+    delta = values - base
+    outside = valid & ((delta < 0) | (delta >= (1 << BITS)))
+    rank = tl.cumsum(outside.to(tl.int32), 0) - 1
+    start = tl.load(Prefix + row)
+    record = ((row % R) * C + col).to(tl.uint32) | (values.to(tl.uint32) << 24)
+    tl.store(Exceptions + start + rank, record, outside)
+    width: tl.constexpr = (C * BITS + 7) // 8
+    per: tl.constexpr = 8 // BITS
+    slab = row // 16 * (16 * (1 + width))
+    tl.store(Fixed + slab + row % 16, base.to(tl.uint8))
+    codes = tl.where(valid & ~outside, delta, 0)
+    shift = (tl.arange(0, per) * BITS)[None, :]
+    packed = tl.sum(tl.reshape(codes, (B // per, per)) << shift, 1)
+    byte = tl.arange(0, B // per)
+    tl.store(
+        Fixed + slab + 16 + row % 16 * width + byte, packed.to(tl.uint8), byte < width
+    )
+
+
+def encode_csf_source(scales: torch.Tensor, *, quantization: str):
+    """Encode logical ``[expert, row, column]`` scale bytes as a slab ``CsfSource``.
+
+    Each expert is one segment. Source bytes are never modified. Dense
+    exceptions remain exact but can make the result larger than its input.
+    """
+    from b12x.loader._csf_source import CsfSource
+
+    bits = _BITS.get(quantization)
+    if bits is None:
+        raise ValueError("CSF quantization must be nvfp4 or mxfp4")
+    if (
+        scales.dtype != torch.uint8
+        or scales.ndim != 3
+        or scales.device.type != "cuda"
+        or not scales.is_contiguous()
+    ):
+        raise ValueError("CSF encoding requires contiguous CUDA uint8 [E,R,C] scales")
+    e, r, c = scales.shape
+    if e <= 0 or r <= 0 or r % 32 or c <= 0 or r * c > 1 << 24:
+        raise ValueError("CSF encoding requires 32-row blocks and 24-bit positions")
+    if torch.cuda.is_current_stream_capturing():
+        raise RuntimeError("CSF encoding is a load-time operation, not graph replay")
+    rows = e * r
+    block = max(triton.next_power_of_2(c), 8 // bits)
+    with torch.cuda.device(scales.device):
+        bases = torch.empty(rows, dtype=torch.uint8, device=scales.device)
+        counts = torch.empty(rows, dtype=torch.int64, device=scales.device)
+        _choose_bases[(rows,)](scales, bases, counts, C=c, W=1 << bits, B=block)
+        prefix = torch.zeros(rows + 1, dtype=torch.int64, device=scales.device)
+        torch.cumsum(counts, 0, out=prefix[1:])
+        exceptions = torch.empty(
+            int(prefix[-1].item()), dtype=torch.uint32, device=scales.device
+        )
+        fixed = torch.empty(
+            (e, r // 16, 16 * (1 + (c * bits + 7) // 8)),
+            dtype=torch.uint8,
+            device=scales.device,
+        )
+        _pack_rows[(rows,)](
+            scales, bases, prefix, fixed, exceptions, R=r, C=c, BITS=bits, B=block
+        )
+    source = CsfSource(
+        (fixed, exceptions), prefix[::r].contiguous(), r, c, quantization, e, "csf"
+    )
+    source.validate()
+    return source
diff --git a/flashinfer/experimental/b12x/_lib/quant/csf_inline.py b/flashinfer/experimental/b12x/_lib/quant/csf_inline.py
new file mode 100644
index 0000000000000000000000000000000000000000..ee30e685e6a9b785b5e6590a97be7ef89f951eb7
--- /dev/null
+++ b/flashinfer/experimental/b12x/_lib/quant/csf_inline.py
@@ -0,0 +1,380 @@
+"""Pipeline-stage readers for the resident compact CSF scale payload."""
+
+import cutlass
+import cutlass.cute as cute
+from cutlass.cutlass_dsl import Int32, Int64, Uint32
+
+from b12x._lib.intrinsics.packed import byte_perm
+from b12x._lib.intrinsics.memory import (
+    cp_async4_shared_global,
+    cp_async_u32_shared_global,
+    st_shared_v4_u32,
+)
+from b12x._lib.intrinsics.atomics import ld_shared_u32, st_shared_u32
+from b12x._lib.quant.csf_blocks import CompactBlockStoragePlane
+
+
+class CsfInlineReader:
+    def __init__(self, geometry):
+        if len(geometry) != 11 or geometry[3] != 9:
+            raise ValueError(
+                "Inline CSF requires native codes and compact group records"
+            )
+        self.plane = CompactBlockStoragePlane(geometry)
+        self.plane.shared_exceptions = True
+        self.expert_bytes = self.plane.rows * self.plane.columns
+
+    @cute.jit
+    def stage_native(self, storage, offset, target, lane):
+        assert self.plane.destination == 2
+        if lane < Int32(32):
+            expert = (offset // Int64(self.expert_bytes)).to(Int32)
+            local = (offset % Int64(self.expert_bytes)).to(Int32)
+            tile, half = local // Int32(1024), local % Int32(1024) // Int32(512)
+            columns = Int32(self.plane.storage.column_groups)
+            row_group = tile // columns * Int32(2) + half
+            group = row_group * columns + tile % columns
+            self.stage_compressed(storage, expert, group, target, lane)
+
+    @cute.jit
+    def expand_slots(
+        self,
+        storage,
+        address,
+        tid,
+        threads: cutlass.Constexpr,
+        slots: cutlass.Constexpr,
+    ):
+        warp, lane = tid // Int32(32), tid % Int32(32)
+        for chunk in cutlass.range_constexpr(
+            (slots + threads // 32 - 1) // (threads // 32)
+        ):
+            slot = warp + Int32(chunk * (threads // 32))
+            if slot < Int32(slots):
+                target = cute.make_ptr(
+                    cutlass.Uint8,
+                    address + slot * Int32(512),
+                    cute.AddressSpace.smem,
+                    assumed_align=16,
+                )
+                group = ld_shared_u32(target.toint().to(Int32) + Int32(500)).to(Int32)
+                self.expand_compressed(storage, group, target, lane)
+                self.pad_rows(group, target, lane)
+
+    @cute.jit
+    def stage_compressed(self, storage, expert, group, target, lane, bounds=None):
+        """Stage codes, bases and the first 32 exceptions in a 512-byte slot.
+
+        Callers publish the asynchronous copies before reconstructing the slot.
+        Dense exception tails remain in the resident payload.
+        """
+        storage = cute.recast_ptr(storage, dtype=cutlass.Uint8)
+        source_expert = expert * Int32(self.plane.sections) + group // Int32(
+            self.plane.storage.groups
+        )
+        source_group = group % Int32(self.plane.storage.groups)
+        row_group = source_group // Int32(self.plane.storage.column_groups)
+        column_group = source_group % Int32(self.plane.storage.column_groups)
+        nr = cutlass.min(
+            Int32(128), Int32(self.plane.storage.rows) - row_group * Int32(128)
+        )
+        nc = cutlass.min(Int32(4), Int32(self.plane.columns) - column_group * Int32(4))
+        valid = group < Int32(self.plane.storage.groups * self.plane.sections)
+        first, end = Uint32(0), Uint32(0)
+        if valid:
+            if cutlass.const_expr(bounds is not None):
+                first, end = bounds
+            else:
+                first, end = self.plane.group_record_bounds(
+                    storage, source_expert, source_group
+                )
+        address = target.toint().to(Int32)
+        value_start = self.plane.group_value_offset(storage) + first.to(Int64)
+        if lane == Int32(0):
+            st_shared_u32(address + Int32(384), first)
+            st_shared_u32(address + Int32(388), end)
+            st_shared_u32(address + Int32(496), (value_start & Int64(3)).to(Uint32))
+            st_shared_u32(address + Int32(500), group.to(Uint32))
+        codes = (
+            Int64(self.plane.storage.codes)
+            + source_expert.to(Int64) * Int64(self.plane.storage.code_bytes)
+            + row_group.to(Int64)
+            * Int64(128 * self.plane.columns * self.plane.storage.bits // 8)
+            + (column_group * nr).to(Int64) * Int64(self.plane.storage.bits) // Int64(2)
+        )
+        bases = Int64(self.plane.storage.bases) + (
+            source_expert * Int32(self.plane.storage.rows) + row_group * Int32(128)
+        ).to(Int64)
+        if lane < Int32(16):
+            if valid and lane * Int32(16) < nr * nc * Int32(
+                self.plane.storage.bits
+            ) // Int32(8):
+                cp_async4_shared_global(
+                    address + lane * Int32(16),
+                    (storage + codes + lane.to(Int64) * Int64(16)).toint(),
+                )
+            else:
+                st_shared_v4_u32(
+                    address + lane * Int32(16),
+                    Uint32(0),
+                    Uint32(0),
+                    Uint32(0),
+                    Uint32(0),
+                )
+        if lane < Int32(8):
+            if valid and lane * Int32(16) < nr:
+                cp_async4_shared_global(
+                    address + Int32(256) + lane * Int32(16),
+                    (storage + bases + lane.to(Int64) * Int64(16)).toint(),
+                )
+            else:
+                st_shared_v4_u32(
+                    address + Int32(256) + lane * Int32(16),
+                    Uint32(0),
+                    Uint32(0),
+                    Uint32(0),
+                    Uint32(0),
+                )
+        count = cutlass.min(end - first, Uint32(32))
+        if lane < Int32(17) and lane.to(Uint32) * Uint32(2) < count + (
+            first & Uint32(1)
+        ):
+            cp_async_u32_shared_global(
+                address + Int32(392) + lane * Int32(4),
+                (
+                    storage
+                    + Int64(self.plane.storage.source_records)
+                    + (first & ~Uint32(1)).to(Int64) * Int64(2)
+                    + lane.to(Int64) * Int64(4)
+                ).toint(),
+            )
+        if lane < Int32(9) and lane.to(Uint32) * Uint32(4) < count + (
+            value_start & Int64(3)
+        ):
+            cp_async_u32_shared_global(
+                address + Int32(460) + lane * Int32(4),
+                (
+                    storage + (value_start & ~Int64(3)) + lane.to(Int64) * Int64(4)
+                ).toint(),
+            )
+
+    @cute.jit
+    def expand_compressed(self, storage, group, target, lane):
+        """Reconstruct a ready compact slot and synchronize the decoding warp."""
+        storage = cute.recast_ptr(storage, dtype=cutlass.Uint8)
+        address = target.toint().to(Int32)
+        first = ld_shared_u32(address + Int32(384))
+        end = ld_shared_u32(address + Int32(388))
+        position, replacement = Int32(0), Uint32(0)
+        if first + lane.to(Uint32) < end:
+            p = (first & Uint32(1)).to(Int32) + lane
+            position = (
+                (
+                    ld_shared_u32(address + Int32(392) + p // Int32(2) * Int32(4))
+                    >> ((p % Int32(2)) * Int32(16)).to(Uint32)
+                )
+                & Uint32(65535)
+            ).to(Int32)
+            v = ld_shared_u32(address + Int32(496)).to(Int32) + lane
+            replacement = (
+                ld_shared_u32(address + Int32(460) + v // Int32(4) * Int32(4))
+                >> ((v % Int32(4)) * Int32(8)).to(Uint32)
+            ) & Uint32(255)
+        source_group = group % Int32(self.plane.storage.groups)
+        nr = cutlass.min(
+            Int32(128),
+            Int32(self.plane.storage.rows)
+            - source_group // Int32(self.plane.storage.column_groups) * Int32(128),
+        )
+        nc = cutlass.min(
+            Int32(4),
+            Int32(self.plane.columns)
+            - source_group % Int32(self.plane.storage.column_groups) * Int32(4),
+        )
+        values = cute.make_rmem_tensor(cute.make_layout(4), cutlass.Uint32)
+        values.fill(Uint32(0))
+        for quarter in cutlass.range_constexpr(4):
+            index = lane * Int32(16) + Int32(quarter * 4)
+            code_index = index
+            if cutlass.const_expr(self.plane.destination == 0):
+                code_index = (lane * (nr // Int32(32)) + Int32(quarter)) * nc
+                valid = Int32(quarter) < nr // Int32(32)
+            else:
+                valid = index < nr * nc
+            if valid:
+                field = code_index * Int32(self.plane.storage.bits)
+                packed = ld_shared_u32(address + field // Int32(32) * Int32(4)) >> (
+                    field % Int32(32)
+                ).to(Uint32)
+                if cutlass.const_expr(self.plane.storage.bits == 4):
+                    offsets = byte_perm(
+                        packed, packed >> Uint32(4), Int32(0x5140)
+                    ) & Uint32(0x0F0F0F0F)
+                else:
+                    offsets = packed & Uint32(15)
+                    offsets = (offsets | (offsets << Uint32(14))) & Uint32(0x00030003)
+                    offsets = (offsets | (offsets << Uint32(7))) & Uint32(0x01010101)
+                base = Uint32(0)
+                if cutlass.const_expr(self.plane.destination == 1):
+                    base = ld_shared_u32(address + Int32(256) + index % nr)
+                else:
+                    row = code_index // nc
+                    base_word = ld_shared_u32(
+                        address + Int32(256) + row // Int32(4) * Int32(4)
+                    )
+                    if cutlass.const_expr(self.plane.destination == 0):
+                        base = byte_perm(
+                            base_word, base_word, (row % Int32(4)) * Int32(0x1111)
+                        )
+                        if nc == Int32(2):
+                            offsets &= Uint32(0x00000F0F)
+                    elif nc == Int32(4):
+                        base = byte_perm(
+                            base_word, base_word, (row % Int32(4)) * Int32(0x1111)
+                        )
+                    else:
+                        pair = base_word >> ((row % Int32(4)) * Int32(8)).to(Uint32)
+                        base = (
+                            (pair & Uint32(255))
+                            | ((pair & Uint32(0xFF00)) << Uint32(8))
+                        ) * Uint32(0x101)
+                values[quarter] = base + offsets
+        cute.arch.sync_warp()
+        st_shared_v4_u32(
+            address + lane * Int32(16), values[0], values[1], values[2], values[3]
+        )
+        cute.arch.sync_warp()
+        if first + lane.to(Uint32) < end:
+            self.plane.write_group_record(
+                source_group, target, position, replacement.to(cutlass.Uint8)
+            )
+        self.plane.patch_group_records(
+            storage,
+            source_group,
+            lane,
+            target,
+            cutlass.min(first + Uint32(32), end),
+            end,
+        )
+        cute.arch.sync_warp()
+
+    @cute.jit
