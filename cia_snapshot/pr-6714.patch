+                    tile_base = (
+                        kt_local * Int32(pair_span_u32)
+                        + Int32(high_base_u32)
+                        + record_n16 * Int32(8 * high_bits)
+                    )
+                    wa[jj], wb[jj] = self._load_trellis256_pair_tile_windows(
+                        b_region, tile_base, lane, high_bits
+                    )
