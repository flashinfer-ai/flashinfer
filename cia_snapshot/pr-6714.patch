+    intermediate_size,
+    num_experts,
+    top_k,
+    swiglu_limit,
+    after_silu,
+    monkeypatch,
+):
+    require_b12x()
+    _env(monkeypatch, True, terms)
+    case = _make_case(11, intermediate_size, hidden_size, num_experts, top_k)
+    from b12x.moe import fused_moe as moe
+
+    case["plan"] = moe.plan_weights(
+        source=case["plan"].source,
