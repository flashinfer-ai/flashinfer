+                        hs0 = h0 * svh_flat[sbase + Int32(0)].to(cutlass.Float32)
+                        hs1 = h1 * svh_flat[sbase + Int32(1)].to(cutlass.Float32)
+                        hs2 = h2 * svh_flat[sbase + Int32(2)].to(cutlass.Float32)
+                        hs3 = h3 * svh_flat[sbase + Int32(3)].to(cutlass.Float32)
