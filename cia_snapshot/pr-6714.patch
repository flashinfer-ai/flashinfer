+@pytest.fixture
+def checkpoint(tmp_path):
+    e, h, n = 4, 128, 256
+    text = dict(
+        model_type="step5",
+        hidden_size=h,
+        moe_intermediate_size=n,
+        moe_num_experts=e,
+        moe_top_k=2,
