+    assert options == {
+        "BLOCK_E": 128,
+        "TOP_K": 2,
+        "TOPK_BLOCK": 2,
+        "RENORMALIZE": False,
+        "SCORE_FUNC": "softmax",
+        "HAS_CORRECTION_BIAS": False,
+        "HAS_IMAGE_BIAS": False,
+        "HAS_VALID_TOKENS": False,
+        "num_warps": 4,
+    }
