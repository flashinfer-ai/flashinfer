+    ],
+}
+
+MUTATIONS = {
+    "w4a16_grid_barrier_fence": {**_W4A16_MUTATION, "delay": False},
+    "w4a16_grid_barrier_fence_delay": {**_W4A16_MUTATION, "delay": True},
