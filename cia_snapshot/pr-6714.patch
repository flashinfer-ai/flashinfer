+    @cute.jit
+    def _scaled_dequant_b_fragment(self, frag: cute.Tensor, q: Uint32, s: Uint32):
+        if cutlass.const_expr(self.native_nvfp4_scales and self.is_fp16):
+            b0_0, b0_1, b1_0, b1_1 = _dequant_native_fp4_word(q, self.is_fp16)
+        else:
