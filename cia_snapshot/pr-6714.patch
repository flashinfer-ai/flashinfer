-def dense_gemm_fused_quant_a_grouped(
-    source: torch.Tensor,
-    b: torch.Tensor,
-    sfb: torch.Tensor,
-    *,
-    groups: int,
-    out: Optional[torch.Tensor] = None,
-    positions: Optional[torch.Tensor] = None,
-    cos_sin_cache: Optional[torch.Tensor] = None,
-    head_dim: int = 0,
-    nope_dim: int = 0,
-    rope_dim: int = 0,
