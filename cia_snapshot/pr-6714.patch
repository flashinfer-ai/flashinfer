+@pytest.mark.parametrize("rows", [1, 4, 16, 64, 65, 128, 129, 512])
+@pytest.mark.parametrize("draft", [False, True])
+@pytest.mark.parametrize("kv_heads", [1, 2])
+def test_separate_and_draft_attention_use_identical_partition_contract(
