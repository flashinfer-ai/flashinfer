+            a_bf16_flat,
+            a_alt_bf16_flat,
+            b_i32_flat,
+            c_bf16_flat,
+            scales_i32_flat,
+            global_scale,
+            packed_route_indices,
+            block_expert_ids,
+            packed_route_count,
+            topk_weights_flat,
+            c_tmp_f32_flat,
+            locks_i32_flat,
+            trellis_lut_addr,
+            smem_base,
+            tid,
+            cta,
+            Int32(grid_x),
+            Int32(active_m),
+        )
