+    policy = _dense_gemm_policy_for(
+        m=m,
+        n=n,
+        k=k,
+        l=l,
+        ab_dtype=ab_cutlass_dtype,
+        c_dtype=c_cutlass_dtype,
+        mma_tiler_mn=mma_tiler_mn,
+        cluster_shape_mn=cluster_shape_mn,
