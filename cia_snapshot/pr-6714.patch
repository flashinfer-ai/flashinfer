+    @cute.jit
+    def _merge_splitk_slot(
+        self,
+        c_tmp_f32_flat: cute.Tensor,
+        c_cur_offset: Int32,
+        active_threads: Int32,
+        slot: Int32,
+        tid: Int32,
+        reduce_slice_idx: Int32,
+        reduce_slice_count: Int32,
+        c0: cutlass.Float32,
+        c1: cutlass.Float32,
+        c2: cutlass.Float32,
+        c3: cutlass.Float32,
+    ):
+        int4_off = c_cur_offset + active_threads * slot + tid
+        return self._merge_splitk_vec4(
+            c_tmp_f32_flat,
+            int4_off * Int32(4),
+            reduce_slice_idx,
+            reduce_slice_count,
+            c0,
+            c1,
+            c2,
+            c3,
+        )
