+        else:
+            self._load_b_registers_trellis256_pair_bits(
+                regs, smem_base, tid, pipe, kk, tile_idx, 3, 3
+            )
+        return (
+            regs[0, 0],
+            regs[0, 1],
+            regs[0, 2],
+            regs[0, 3],
+            regs[1, 0],
+            regs[1, 1],
+            regs[1, 2],
+            regs[1, 3],
