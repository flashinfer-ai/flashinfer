+                    acc2 *= svh_flat[col0 + Int32(2)].to(cutlass.Float32)
+                    acc3 *= svh_flat[col0 + Int32(3)].to(cutlass.Float32)
+                    acc0, acc1, acc2, acc3 = self._had128_quad(
+                        acc0, acc1, acc2, acc3, lane
+                    )
