+        h1 *= rotations_flat[sign_base + Int32(1)].to(cutlass.Float32)
+        h2 *= rotations_flat[sign_base + Int32(2)].to(cutlass.Float32)
+        h3 *= rotations_flat[sign_base + Int32(3)].to(cutlass.Float32)
