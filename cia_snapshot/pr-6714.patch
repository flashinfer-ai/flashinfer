+        ) * Int64(self.size_k // 128) + Int64(global_k16 // Int32(8))
+        return tile * Int64(32 * self.block_tile_bytes // 4) + (
+            Int64(global_k16 % Int32(8)) * Int64(4) + Int64(global_n16 % Int32(4))
+        ) * Int64(self.block_tile_bytes // 4)
