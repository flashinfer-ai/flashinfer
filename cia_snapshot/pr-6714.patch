+                    a_sh_rd,
+                    Int32(pipe),
+                    Int32(kk + 1),
+                    uses_m_block_8,
+                )
+        else:
+            next_tile = tile_idx + Int32(1)
+            if next_tile < k_tiles:
+                self._load_b_scale_register_bundle(
+                    b_scale_next,
+                    smem_base,
+                    tid,
+                    b_sh_rd,
+                    s_sh_rd,
+                    Int32((pipe + 1) % self.stages),
+                    Int32(0),
+                    reduce_k_tile + next_tile,
+                    dynamic_pair_override,
+                )
+                self._load_a_register_bundle(
+                    a_regs_next,
+                    smem_base,
+                    a_sh_rd,
+                    Int32((pipe + 1) % self.stages),
+                    Int32(0),
+                    uses_m_block_8,
+                )
