-def _determine_blocks_per_sm(
-    *,
-    problem_m: int,
-    problem_n: int,
-    top_k: int,
-    cta_threads: int,
-    cta_m_blocks: int,
-    tile_n: int,
-    tile_k: int,
-    uses_m_block_8: bool,
-    sms: int,
-    max_shared_mem: int,
-    scale_format: str = "e4m3_k16",
-    weight_layout: str = "packed",
-    weight_bits: int = 4,
-    pipeline_stages: int | None = None,
-    small_m_occupancy: int | None = None,
