+        draft_capacity=rows,
+    )
+    _assert_launch_slices(calls, {**operands, "selected_positions": selected}, caps)
+    assert all(
+        call["_prepared"] == {"path": "draft" if draft else "selected"}
+        for call in calls
+    )
