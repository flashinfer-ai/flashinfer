-            cvt.f32.f16 s1, dh1;
-            bfe.u32 n0, $7, 0, 4;
-            bfe.u32 n1, $7, 8, 4;
-            cvt.rn.f32.u32 fl0, n0;
-            cvt.rn.f32.u32 fl1, n1;
-            add.f32 fl0, fl0, 0f3f000000;
-            add.f32 fl1, fl1, 0f3f000000;
-            mul.f32 s0, s0, fl0;
-            mul.f32 s1, s1, fl1;
