+def capture_benchmark_call(call):
+    """Explicitly capture the timed operation, retaining live sample producers."""
+    import torch
+
+    graph = torch.cuda.CUDAGraph()
+    stream = torch.cuda.Stream()
+    stream.wait_stream(torch.cuda.current_stream())
+    try:
+        with torch.cuda.stream(stream):
+            for _ in range(2):
+                _prime(call)
+        stream.synchronize()
+        with call_scope(), torch.cuda.graph(graph, stream=stream):
+            call.invoke()
+    except BaseException:
+        try:
+            graph.reset()
+            with call_scope():
+                if call.restore is not None:
+                    call.restore()
+        finally:
+            if call.close is not None:
+                call.close()
+        raise
+
+    def close():
+        try:
+            graph.reset()
+        finally:
+            if call.close is not None:
+                call.close()
+
+    return replace(
+        call,
+        run=graph.replay,
+        owners=(call, graph, stream),
+        close=close,
+        capture_safe=True,
+    )
+
