-            shr.u32 cslo, $2, 3;
-            and.b32 cslo, cslo, 0x00001111;
-            shr.u32 cshi, $2, 19;
-            and.b32 cshi, cshi, 0x00001111;
-            prmt.b32 slo, tbl_s, zero, cslo;
-            prmt.b32 shi, tbl_s, zero, cshi;
-            or.b32 $0, mlo, slo;
-            or.b32 $1, mhi, shi;
