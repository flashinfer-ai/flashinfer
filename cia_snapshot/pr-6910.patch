+++ b/tests/experimental/b12x/_lib/test_compile_options.py
@@ -0,0 +1,117 @@
+"""Cache identities describe resolved codegen settings, not configuration sources."""
+
+import importlib
+
+import pytest
+
+from b12x._lib.compile_options import clear_options_cache, resolve_compile_options
+
+
+@pytest.fixture
+def dsl():
+    pytest.importorskip("cutlass")
+    from cutlass.cutlass_dsl import CuTeDSL
+
+    clear_options_cache()
+    yield CuTeDSL._get_dsl()
+    clear_options_cache()
+
+
+def test_environment_defaults_and_explicit_options_have_identical_keys(
+    dsl, monkeypatch
+):
+    import cutlass.cute as cute
+    from cutlass.base_dsl.compiler import OptLevel
+
+    monkeypatch.setattr(dsl.envar, "compiler_opt", "opt-level=2")
+    configured = resolve_compile_options(cute.compile)
+    monkeypatch.setattr(dsl.envar, "compiler_opt", "")
+    clear_options_cache()
+    explicit = resolve_compile_options(cute.compile, OptLevel(2))
+    textual = resolve_compile_options(cute.compile, None, "--opt-level 2")
+    assert (
+        configured._b12x_options_key
+        == explicit._b12x_options_key
+        == textual._b12x_options_key
+    )
+
+
+def test_explicit_default_overrides_configured_default(dsl, monkeypatch):
+    import cutlass.cute as cute
+    from cutlass.base_dsl.compiler import OptLevel
+
+    monkeypatch.setattr(dsl.envar, "compiler_opt", "opt-level=2")
+    for options in (
+        resolve_compile_options(cute.compile, OptLevel(3)),
+        resolve_compile_options(cute.compile, None, "--opt-level 3"),
+    ):
+        assert options._compile_options.options[OptLevel].value == 3
+        options._compile_options.apply_envar_settings(dsl.envar, "test_kernel")
+        assert options._compile_options.options[OptLevel].value == 3
+
+
+@pytest.mark.parametrize(
+    "name,value", [("lineinfo", True), ("enable_assertions", True), ("arch", "sm_121a")]
+)
+def test_effective_codegen_settings_change_identity(dsl, monkeypatch, name, value):
+    import cutlass.cute as cute
+
+    before = resolve_compile_options(cute.compile)._b12x_options_key
+    monkeypatch.setattr(dsl.envar, name, value)
+    clear_options_cache()
+    assert before != resolve_compile_options(cute.compile)._b12x_options_key
+
+
+def test_operational_settings_do_not_change_identity(dsl, monkeypatch, tmp_path):
+    import cutlass.cute as cute
+
+    before = resolve_compile_options(cute.compile)._b12x_options_key
+    monkeypatch.setattr(dsl.envar, "dump_dir", str(tmp_path))
+    monkeypatch.setattr(dsl.envar, "keep_ptx", True)
+    clear_options_cache()
+    assert before == resolve_compile_options(cute.compile)._b12x_options_key
+
+
+def test_compiler_diagnostics_do_not_change_identity(dsl, monkeypatch):
+    import cutlass.cute as cute
+
+    before = resolve_compile_options(cute.compile)._b12x_options_key
+    monkeypatch.setattr(dsl.envar, "compiler_opt", "warnings{nvvm,ptx}")
+    clear_options_cache()
+    assert before == resolve_compile_options(cute.compile)._b12x_options_key
+
+
+def test_launch_checks_are_preserved_and_keyed(dsl, monkeypatch):
+    import cutlass.cute as cute
+
+    default = resolve_compile_options(cute.compile)
+    monkeypatch.setattr(dsl.envar, "compiler_opt", "debug{launch-check}")
+    clear_options_cache()
+    checked = resolve_compile_options(cute.compile)
+    assert checked._compile_options._debug_selectors == {"launch-check"}
+    assert default._b12x_options_key != checked._b12x_options_key
+
+
+def test_raw_environment_does_not_participate_in_disk_key(dsl, monkeypatch):
+    import cutlass.cute as cute
+    from b12x.norm.hyperconnection._cute import _GroupedRmsNorm
+
+    compiler = importlib.import_module("b12x._lib.compiler")
+    compile_callable = resolve_compile_options(cute.compile)
+    target = _GroupedRmsNorm(4, 256)
+    spec = compiler.KernelCompileSpec.from_facts("test.rmsnorm", 1, 4, 256)
+    before = compiler._build_compile_disk_cache_key(
+        compile_callable, target, (), {}, spec
+    )
+    for name in (
+        "B12X_UNUSED_SETTING",
+        "CUTE_UNUSED_SETTING",
+        "CUTLASS_UNUSED_SETTING",
+        "NVCC_APPEND_FLAGS",
+        "CC",
+        "CUDA_HOME",
+    ):
+        monkeypatch.setenv(name, "different")
+    assert before == compiler._build_compile_disk_cache_key(
+        compile_callable, target, (), {}, spec
+    )
diff --git a/tests/experimental/b12x/_lib/test_source_dependencies.py b/tests/experimental/b12x/_lib/test_source_dependencies.py
new file mode 100644
index 00000000000..418b1fb9512
--- /dev/null
+++ b/tests/experimental/b12x/_lib/test_source_dependencies.py
@@ -0,0 +1,279 @@
+"""Source closure tests that require neither CUDA nor the b12x runtime."""
+
+import importlib.util
+from pathlib import Path
+import tempfile
+import unittest
+from unittest.mock import patch
+import sys
+import weakref
+
+
+SOURCE = (
+    Path(__file__).resolve().parents[4]
+    / "flashinfer/experimental/b12x/_lib/source_dependencies.py"
+)
+spec = importlib.util.spec_from_file_location("source_dependencies", SOURCE)
+dependencies = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(dependencies)
+
+
+class SourceDependencyTests(unittest.TestCase):
+    def setUp(self):
+        dependencies.source_dependencies.cache_clear()
+        self.addCleanup(dependencies.source_dependencies.cache_clear)
+        directory = tempfile.TemporaryDirectory()
+        self.addCleanup(directory.cleanup)
+        self.root = Path(directory.name)
+        self.write("__init__.py", "")
+
+    def write(self, path, text):
+        target = self.root / path
+        target.parent.mkdir(parents=True, exist_ok=True)
+        target.write_text(text)
+        return target
+
+    def key(self, module="b12x.kernel"):
+        resolver = dependencies.SourceDependencies(self.root)
+        return resolver.fingerprint(((module, resolver.module_path(module)),))
+
+    def test_transitive_edits_and_unrelated_files(self):
+        self.write("kernel.py", "from .helper import run\n")
+        self.write("helper.py", "from .leaf import VALUE\ndef run(): return VALUE\n")
+        self.write("leaf.py", "VALUE = 1\n")
+        before = self.key()
+        self.write("README.md", "documentation")
+        self.write("unrelated.py", "VALUE = 3\n")
+        self.assertEqual(before, self.key())
+        self.write("leaf.py", "VALUE = 2\n")
+        self.assertNotEqual(before, self.key())
+
+    def test_reexports_aliases_cycles_and_nested_imports(self):
+        self.write("kernel.py", "from .helpers import run as alias\n")
+        self.write("helpers/__init__.py", "from .implementation import run\n")
+        self.write(
+            "helpers/implementation.py",
+            "def run():\n from .. import kernel\n from ..leaf import VALUE\n return VALUE\n",
+        )
+        self.write("leaf.py", "VALUE=1\n")
+        before = self.key()
+        self.write("leaf.py", "VALUE=2\n")
+        self.assertNotEqual(before, self.key())
+
+    def test_type_checking_only_import_is_excluded(self):
+        self.write(
+            "kernel.py",
+            "from typing import TYPE_CHECKING\nif TYPE_CHECKING:\n from .absent import Thing\n",
+        )
+        self.key()
+
+    def test_runtime_branches_both_participate(self):
+        self.write(
+            "kernel.py",
+            "if CHOICE:\n from .a import value\nelse:\n from .b import value\n",
+        )
+        self.write("a.py", "value=1\n")
+        self.write("b.py", "value=2\n")
+        before = self.key()
+        self.write("b.py", "value=3\n")
+        self.assertNotEqual(before, self.key())
+
+    def test_missing_import_fails(self):
+        self.write("kernel.py", "from .missing import value\n")
+        with self.assertRaisesRegex(ValueError, "Cannot resolve"):
+            self.key()
+
+    def test_dynamic_imports_require_declared_targets(self):
+        self.write("helper.py", "value=1\n")
+        self.write(
+            "kernel.py", "import importlib\nvalue=importlib.import_module(NAME)\n"
+        )
+        with self.assertRaisesRegex(ValueError, "__b12x_source_dependencies__"):
+            self.key()
+        self.write(
+            "kernel.py",
+            "import importlib\n__b12x_source_dependencies__ = ('b12x.helper',)\nvalue=importlib.import_module(NAME)\n",
+        )
+        before = self.key()
+        self.write("helper.py", "value=2\n")
+        self.assertNotEqual(before, self.key())
+
+    def test_literal_dynamic_import(self):
+        self.write(
+            "kernel.py",
+            "import importlib\nvalue=importlib.import_module('b12x.helper')\n",
+        )
+        self.write("helper.py", "value=1\n")
+        before = self.key()
+        self.write("helper.py", "value=2\n")
+        self.assertNotEqual(before, self.key())
+
+    def test_aliased_dynamic_import(self):
+        self.write(
+            "kernel.py",
+            "def run():\n return load('b12x.helper')\nfrom importlib import import_module as load\n",
+        )
+        self.write("helper.py", "VALUE=1\n")
+        before = self.key()
+        self.write("helper.py", "VALUE=2\n")
+        self.assertNotEqual(before, self.key())
+
+    def test_package_computed_import_requires_declaration(self):
+        self.write(
+            "__init__.py", "import importlib\nvalue=importlib.import_module(NAME)\n"
+        )
+        self.write("kernel.py", "VALUE=1\n")
+        with self.assertRaisesRegex(ValueError, "__b12x_source_dependencies__"):
+            self.key()
+
+    def test_checkout_and_alias_independence(self):
+        self.write("kernel.py", "from .leaf import VALUE\n")
+        self.write("leaf.py", "VALUE=1\n")
+        before = self.key()
+        self.assertEqual(before, self.key("flashinfer.experimental.b12x.kernel"))
+        with tempfile.TemporaryDirectory() as directory:
+            other = Path(directory)
+            for path in self.root.rglob("*.py"):
+                target = other / path.relative_to(self.root)
+                target.parent.mkdir(parents=True, exist_ok=True)
+                target.write_bytes(path.read_bytes())
+            resolver = dependencies.SourceDependencies(other)
+            self.assertEqual(
+                before, resolver.fingerprint((("b12x.kernel", other / "kernel.py"),))
+            )
+
+    def test_memo_does_not_reread_files(self):
+        self.write("kernel.py", "VALUE=1\n")
+        resolver = dependencies.SourceDependencies(self.root)
+        roots = (("b12x.kernel", self.root / "kernel.py"),)
+        before = resolver.fingerprint(roots)
+        (self.root / "kernel.py").unlink()
+        self.assertEqual(before, resolver.fingerprint(roots))
+
+    def load(self, module, filename):
+        spec = importlib.util.spec_from_file_location(module, self.root / filename)
+        loaded = importlib.util.module_from_spec(spec)
+        modules = patch.dict(sys.modules, {module: loaded})
+        modules.start()
+        self.addCleanup(modules.stop)
+        spec.loader.exec_module(loaded)
+        return loaded
+
+    def test_inherited_callable_and_bound_method_sources(self):
+        self.write("base.py", "class Base:\n def __call__(self): return 1\n")
+        self.load("b12x.base", "base.py")
+        self.write("kernel.py", "from .base import Base\nclass Kernel(Base):\n pass\n")
+        target = self.load("b12x.kernel", "kernel.py").Kernel()
+        for value in (target, target.__call__):
+            roots = dependencies.callable_sources(value, self.root)
+            self.assertEqual({name for name, _ in roots}, {"b12x.kernel", "b12x.base"})
+        base = sys.modules["b12x.base"].Base()
+        roots = dependencies.callable_sources(base.__call__, self.root)
+        self.assertEqual({name for name, _ in roots}, {"b12x.base"})
+
+    def test_callable_memo_shares_instances_without_retaining_them(self):
+        self.write(
+            "kernel.py",
+            "class Kernel:\n __hash__ = None\n def __call__(self): return 1\n",
+        )
+        kernel = self.load("b12x.kernel", "kernel.py").Kernel
+        for bound in (False, True):
+            target = kernel()
+            reference = weakref.ref(target)
+            roots = dependencies.callable_sources(
+                target.__call__ if bound else target, self.root
+            )
+            del target
+            self.assertIsNone(reference())
+            with (
+                patch.object(dependencies.inspect, "getsourcefile") as inspect_source,
+                patch.object(Path, "resolve") as resolve,
+            ):
+                target = kernel()
+                self.assertEqual(
+                    roots,
+                    dependencies.callable_sources(
+                        target.__call__ if bound else target, self.root
+                    ),
+                )
+                inspect_source.assert_not_called()
+                resolve.assert_not_called()
+
+    def test_callable_memo_distinguishes_closures_with_the_same_name(self):
+        self.write("first.py", "def helper(): return 1\n")
+        self.write("second.py", "def helper(): return 2\n")
+        self.write(
+            "kernel.py",
+            "def make(callback):\n def kernel(): return callback()\n return kernel\n",
+        )
+        make = self.load("b12x.kernel", "kernel.py").make
+        for module in ("first", "second"):
+            helper = self.load(f"b12x.{module}", f"{module}.py").helper
+            target = make(helper)
+            roots = dependencies.callable_sources(target, self.root)
+            self.assertEqual(
+                {name for name, _ in roots}, {"b12x.kernel", f"b12x.{module}"}
+            )
+            with patch.object(dependencies.inspect, "getsourcefile") as inspect_source:
+                self.assertEqual(
+                    roots, dependencies.callable_sources(target, self.root)
+                )
+                inspect_source.assert_not_called()
+
+    def test_clearing_source_cache_rediscovers_callable_defaults(self):
+        self.write("helper.py", "def helper(): return 1\n")
+        helper = self.load("b12x.helper", "helper.py").helper
+        self.write("kernel.py", "def kernel(callback=None): return callback()\n")
+        kernel = self.load("b12x.kernel", "kernel.py").kernel
+        roots = dependencies.callable_sources(kernel, self.root)
+        self.assertEqual({name for name, _ in roots}, {"b12x.kernel"})
+        kernel.__defaults__ = (helper,)
+        dependencies.source_dependencies.cache_clear()
+        roots = dependencies.callable_sources(kernel, self.root)
+        self.assertEqual({name for name, _ in roots}, {"b12x.kernel", "b12x.helper"})
+
+    def test_lazy_reexport_need_not_cache_its_attribute(self):
+        self.write("helpers/leaf.py", "def run(): return 1\n")
+        self.load("b12x.helpers.leaf", "helpers/leaf.py")
+        self.write(
+            "helpers/__init__.py",
+            "from importlib import import_module\ndef __getattr__(name):\n return getattr(import_module('.leaf', __name__), name)\n",
+        )
+        self.load("b12x.helpers", "helpers/__init__.py")
+        self.write("kernel.py", "from .helpers import run as execute\n")
+        self.load("b12x.kernel", "kernel.py")
+        before = self.key()
+        self.write("helpers/leaf.py", "def run(): return 2\n")
+        self.assertNotEqual(before, self.key())
+
+    def test_decorator_and_callable_default_sources(self):
+        self.write("helper.py", "def helper(): return 1\n")
+        helper = self.load("b12x.helper", "helper.py").helper
+        self.write(
+            "decorators.py",
+            "from functools import wraps\ndef decorate(f):\n @wraps(f)\n def wrapper(*args): return f(*args)\n return wrapper\n",
+        )
+        decorate = self.load("b12x.decorators", "decorators.py").decorate
+        self.write("kernel.py", "def kernel(callback): return callback()\n")
+        kernel = self.load("b12x.kernel", "kernel.py").kernel
+        kernel.__defaults__ = (helper,)
+        roots = dependencies.callable_sources(decorate(kernel), self.root)
+        self.assertEqual(
+            {name for name, _ in roots},
+            {"b12x.kernel", "b12x.helper", "b12x.decorators"},
+        )
+
+    def test_parent_initializer_dependencies(self):
+        self.write("package/__init__.py", "from ..helper import VALUE\n")
+        path = self.write("package/kernel.py", "VALUE=1\n")
+        self.write("helper.py", "VALUE=1\n")
+        roots = (("b12x.package.kernel", path),)
+        before = dependencies.SourceDependencies(self.root).fingerprint(roots)
+        self.write("helper.py", "VALUE=2\n")
+        self.assertNotEqual(
+            before, dependencies.SourceDependencies(self.root).fingerprint(roots)
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
