-FLOAT4_E2M1_MAX = 6.0  # Maximum value representable in FP4 E2M1
-FLOAT8_E4M3_MAX = 448.0  # Maximum value representable in FP8 E4M3
-SF_VEC_SIZE = 16  # Elements per scale factor block
