+        assert launcher(*args) is planned
+        assert compile_kernel.call_count == 1
+        evict_planning_artifacts((program,))
+        ready = launcher(*args)
+        assert ready is not planned
+        assert ready.__b12x_dependencies__ == (compiled,)
