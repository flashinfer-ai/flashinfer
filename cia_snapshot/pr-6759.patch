+                         "=r"(*reinterpret_cast<uint32_t*>(&packed[(0) + 1])),
+                         "=r"(*reinterpret_cast<uint32_t*>(&packed[(0) + 2])),
+                         "=r"(*reinterpret_cast<uint32_t*>(&packed[(0) + 3]))
+                       : "r"(epi_staging_addr +
+                             (unsigned int)((expert_row_1 * BLOCK_M + hidden_chunk * 8) * 2)));
+          int route = route_map[expert_row_base + expert_row_1];
+          if (route >= 0) {
+            int source_rank = route / routes_per_rank;
+            __nv_bfloat16* output_base =
+                reinterpret_cast<__nv_bfloat16*>(remote_terms_peers.ptrs[source_rank]);
+            reinterpret_cast<int4*>(
+                output_base +
+                ((unsigned long long)route * (unsigned long long)N + (unsigned long long)off_m +
+                 (unsigned long long)(hidden_chunk * 8)))[0] = reinterpret_cast<int4*>(packed)[0];
+          }
+        }
+        asm volatile("barrier.sync 15, 128;" ::: "memory");
+        _phase_mainloop_done ^= 1;
+      }
+      unsigned int* completion_words = reinterpret_cast<unsigned int*>(fc2_completion);
+      asm volatile("barrier.sync 15, 128;" ::: "memory");
+      if (epi_warp == 0) {
+        int last_arriver = 0;
+        if (lane == 0) {
+          unsigned int _atomic_old_0;
+          asm volatile("atom.acq_rel.gpu.global.add.u32 %0, [%1], %2;"
+                       : "=r"(_atomic_old_0)
+                       : "l"(&completion_words[1]), "r"(static_cast<uint32_t>(1))
+                       : "memory");
+          unsigned int arrived = _atomic_old_0;
+          int arrived_count = (int)arrived + 1;
+          if (arrived_count == num_bids) {
+            completion_words[1] = 0;
+            last_arriver = 1;
+          }
+        }
+        int _shfl_0 = __shfl_sync(0xFFFFFFFF, last_arriver, 0);
+        int signal_now = _shfl_0;
+        __syncwarp();
+        if (signal_now == 1) {
+          int destination = lane;
+          int signal_world = remote_pg_world;
+          if (destination < signal_world) {
+            unsigned int* peer_words =
+                reinterpret_cast<unsigned int*>(fc2_completion_peers.ptrs[destination]);
+            asm volatile("red.release.sys.global.add.u32 [%0], %1;" ::"l"(
+                             (reinterpret_cast<unsigned int*>(peer_words) + (0))),
+                         "r"(static_cast<unsigned int>(1))
+                         : "memory");
+          }
+        }
+      }
+    }
+  }
+  // ---- Role: mma ----
+  if (warp == 4) {
+    {  // mma_main
+      unsigned int mma_tma_stage = 0;
+      unsigned int mma_epi_stage = 0;
+      unsigned int _phase_epilogue_done = 1;
+      unsigned int _phase_tma_full = 0;
+#pragma unroll 1
+      for (unsigned int tile_idx_1 = bid; tile_idx_1 < num_tiles; tile_idx_1 += num_bids) {
+        mbarrier_wait(epilogue_done_addr + (mma_epi_stage) * 8, _phase_epilogue_done);
+#pragma unroll 1
+        for (int iter_k = 0; iter_k < K_tiles; iter_k++) {
+          mbarrier_wait(tma_full_addr + (mma_tma_stage) * 8, _phase_tma_full);
+          asm volatile("tcgen05.fence::after_thread_sync;");
+          int init_flag = ((iter_k == 0) ? 1 : 0);
+          if (elect_sync()) {
+#if defined(__CUDA_ARCH__) && (__CUDA_ARCH__ < 1000)
+#error "Tcgen05Cp requires Blackwell tcgen05.cp support"
+#endif
+            {
+              uint64_t _tcgen05_cp_desc_0 =
+                  ((((uint64_t)(smem_sfa_cp_addr + mma_tma_stage * 21504)) & 0x3FFFFULL) >> 4ULL) |
+                  (((((uint64_t)(0)) & 0x3FFFFULL) >> 4ULL) << 16ULL) |
+                  (((((uint64_t)(128)) & 0x3FFFFULL) >> 4ULL) << 32ULL) | (1ULL << 46ULL) |
+                  (0ULL << 61ULL);
+              asm volatile("tcgen05.cp.cta_group::1.32x128b.warpx4 [%0], %1;" ::"r"(
+                               (uint32_t)(tmem_tmem_sfa)),
+                           "l"(_tcgen05_cp_desc_0)
+                           : "memory");
+            }
+#if defined(__CUDA_ARCH__) && (__CUDA_ARCH__ < 1000)
+#error "Tcgen05Cp requires Blackwell tcgen05.cp support"
+#endif
+            {
+              uint64_t _tcgen05_cp_desc_1 =
+                  ((((uint64_t)(smem_sfb_cp_addr + mma_tma_stage * 21504)) & 0x3FFFFULL) >> 4ULL) |
+                  (((((uint64_t)(0)) & 0x3FFFFULL) >> 4ULL) << 16ULL) |
+                  (((((uint64_t)(128)) & 0x3FFFFULL) >> 4ULL) << 32ULL) | (1ULL << 46ULL) |
+                  (0ULL << 61ULL);
+              asm volatile("tcgen05.cp.cta_group::1.32x128b.warpx4 [%0], %1;" ::"r"(
+                               (uint32_t)(tmem_tmem_sfb)),
+                           "l"(_tcgen05_cp_desc_1)
+                           : "memory");
+            }
+            int _mma_a_lo_0 = (((smem_a_addr) >> 4) & 0x3FFF) + (mma_tma_stage) * 1344;
+            int _mma_b_lo_0 = (((smem_b_addr) >> 4) & 0x3FFF) + (mma_tma_stage) * 1344;
+            {
+              uint64_t a_desc = ((uint64_t)(uint32_t)_mma_a_lo_0) | ((uint64_t)0x40004040 << 32);
+              uint64_t b_desc = ((uint64_t)(uint32_t)_mma_b_lo_0) | ((uint64_t)0x40004040 << 32);
+
+              tcgen05_mma_mxf8_bs(tmem_tmem_acc, a_desc + 0, b_desc + 0, 0x8880000U, tmem_tmem_sfa,
+                                  tmem_tmem_sfb, ((init_flag) ? 0 : 1));
+              tcgen05_mma_mxf8_bs(tmem_tmem_acc, a_desc + 2, b_desc + 2, 0x28880010U, tmem_tmem_sfa,
+                                  tmem_tmem_sfb, 1);
+              tcgen05_mma_mxf8_bs(tmem_tmem_acc, a_desc + 4, b_desc + 4, 0x48880020U, tmem_tmem_sfa,
+                                  tmem_tmem_sfb, 1);
+              tcgen05_mma_mxf8_bs(tmem_tmem_acc, a_desc + 6, b_desc + 6, 0x68880030U, tmem_tmem_sfa,
+                                  tmem_tmem_sfb, 1);
+            }
+          }
+          elect_commit(mma_done_addr + (mma_tma_stage) * 8);
+          mma_tma_stage += 1;
+          if (mma_tma_stage == 8) {
+            mma_tma_stage = 0;
+            _phase_tma_full ^= 1;
+          }
+        }
+        elect_commit(mainloop_done_addr + (mma_epi_stage) * 8);
+        _phase_epilogue_done ^= 1;
+      }
+    }
+  }
+  // ---- Role: load ----
+  if (warp == 5) {
+    {  // load_main
+      unsigned int load_stage = 0;
+      unsigned int pf_first_tile = bid;
+      if (elect_sync()) {
+        if (bid < num_tiles) {
+          int pf_batch_idx = tile_expert[bid];
+          int pf_off_m = tile_m_local[bid];
+#pragma unroll
+          for (int pf_k = 0; pf_k < 8; pf_k++) {
+            if (pf_k < K_tiles) {
+              mbarrier_arrive_expect_tx(tma_full_addr + (pf_k) * 8, 21504);
+              tma_4d_gmem2smem(smem_a_addr + (unsigned int)(pf_k * 21504), (&A), 0, 0, pf_k,
+                               pf_batch_idx * (N / BLOCK_M) + pf_off_m / BLOCK_M,
+                               tma_full_addr + (pf_k) * 8);
+              int pf_sfa_tile = pf_off_m / BLOCK_M * K_tiles + pf_k;
+              tma_4d_gmem2smem(smem_sfa_cp_addr + (unsigned int)(pf_k * 21504), (&SFA), 0, 0,
+                               pf_sfa_tile, pf_batch_idx, tma_full_addr + (pf_k) * 8);
+            }
+          }
+        }
+      }
+      asm volatile("griddepcontrol.wait;" ::: "memory");
+      unsigned int _phase_mma_done = 1;
+      if (elect_sync()) {
+#pragma unroll 1
+        for (unsigned int tile_idx_2 = bid; tile_idx_2 < num_tiles; tile_idx_2 += num_bids) {
+          if (num_bids + (int)tile_idx_2 >= num_tiles) {
+            asm volatile("griddepcontrol.launch_dependents;" ::: "memory");
+          }
+          int batch_idx_1 = tile_expert[tile_idx_2];
+          int off_m_1 = tile_m_local[tile_idx_2];
+#pragma unroll 1
+          for (int iter_k_1 = 0; iter_k_1 < K_tiles; iter_k_1++) {
+            mbarrier_wait(mma_done_addr + (load_stage) * 8, _phase_mma_done);
+            int pf_issued = 0;
+            if (tile_idx_2 == pf_first_tile) {
+              if (iter_k_1 < 8) {
+                pf_issued = 1;
+              }
+            }
+            if (pf_issued == 0) {
+              tma_4d_gmem2smem(smem_a_addr + load_stage * 21504, (&A), 0, 0, iter_k_1,
+                               batch_idx_1 * (N / BLOCK_M) + off_m_1 / BLOCK_M,
+                               tma_full_addr + (load_stage) * 8);
+              int pdl_sfa_tile = off_m_1 / BLOCK_M * K_tiles + iter_k_1;
+              tma_4d_gmem2smem(smem_sfa_cp_addr + load_stage * 21504, (&SFA), 0, 0, pdl_sfa_tile,
+                               batch_idx_1, tma_full_addr + (load_stage) * 8);
+            }
+            tma_4d_gmem2smem(smem_b_addr + load_stage * 21504, (&B), 0, 0, iter_k_1, batch_idx_1,
+                             tma_full_addr + (load_stage) * 8);
+            tma_4d_gmem2smem(smem_sfb_cp_addr + load_stage * 21504, (&SFB), 0, 0, iter_k_1,
+                             batch_idx_1, tma_full_addr + (load_stage) * 8);
+            if (pf_issued == 0) {
+              mbarrier_arrive_expect_tx(tma_full_addr + (load_stage) * 8, 21504);
+            }
+            load_stage += 1;
+            if (load_stage == 8) {
+              load_stage = 0;
+              _phase_mma_done ^= 1;
+            }
+          }
+        }
+      }
+    }
+  }
+
+  // Cleanup
+  __syncthreads();  // barrier before TMEM dealloc
+
+  if (warp == 0) {
+    asm volatile(
+        "tcgen05.dealloc.cta_group::1.sync.aligned.b32 %0, %1;" ::"r"(tmem_addr_storage[0]),
+        "r"(64));
+  }
+}
+
+}  // extern "C"
