-        << cudaGetErrorString(status);
-    arena.events.push_back(completion);
-    arena.slots.push_back(
-        {chunk + index * sizeof(CUtensorMap), completion, nullptr, "", false, false, false});
-  }
-  arena.reusable_slots += count;
-}
