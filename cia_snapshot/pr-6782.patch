+def test_changing_shapes_in_one_process_do_not_rebuild() -> None:
+    _check(64, 128, None)
+    loaded_before = loader.load.cache_info().misses
+    for S, C, docs in (
+        (1, 128, None),
+        (65, 256, (64, 1)),
+        (5, 136, (2, 0, 3)),
+        (1000, 512, "perf"),
+    ):
+        _check(S, C, docs)
+    assert loader.load.cache_info().misses == loaded_before, (
+        "a changed problem size rebuilt a module"
+    )
