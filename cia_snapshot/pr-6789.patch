+// Fused mHC post -> pre: stream kernel for 1800 <= num_tokens <= 2048.
+
+#include "mhc_fused_post_pre_kernels.cuh"
+
+namespace flashinfer {
+namespace mhc_fpp {
+namespace {
+
+// Operand ranges after the softmax: every entry is >= HC_SINKHORN_EPS / 4 after the first column
+// pass, and Sinkhorn iterates diag(u) A diag(v) of a positive matrix with max/min <= ~1e6 keep
+// every entry, row sum and column sum within [~1e-13, ~4 + eps].  That is deep inside div_ok()'s
+// [2^-60, 2^60) window, so the refined-reciprocal quotient equals div.rn.f32 for all 39
+// normalization steps.  Only the softmax quotient (exp underflow -> denormal/zero numerators)
+// keeps the range check and the IEEE '/' fallback.
+
+// 20-iteration Sinkhorn on a 4x4 matrix; 4 consecutive lanes hold one matrix, lane = row.
+__device__ __forceinline__ void sinkhorn_rows_bw(float (&c)[4]) {
+  {
+    const float mx = fmaxf(fmaxf(c[0], c[1]), fmaxf(c[2], c[3]));
+    float e[4];
+#pragma unroll
+    for (int kk = 0; kk < 4; ++kk) e[kk] = expf(c[kk] - mx);
+    const float sm = (e[0] + e[1]) + (e[2] + e[3]);
+    const float r = rcp_refined(sm);
+    bool bad = !div_ok(sm);
+#pragma unroll
+    for (int kk = 0; kk < 4; ++kk) {
+      bad |= !div_ok(e[kk]);
+      c[kk] = div_rn_rcp(e[kk], sm, r);
+    }
+    if (__any_sync(0xffffffffu, bad)) {
+#pragma unroll
+      for (int kk = 0; kk < 4; ++kk) c[kk] = e[kk] / sm;
+    }
+#pragma unroll
+    for (int kk = 0; kk < 4; ++kk) c[kk] = c[kk] + HC_SINKHORN_EPS;
+  }
+  auto colnorm = [&]() {
+    // Keep the two-step per-column shuffle/add tree in every row lane.  One lane then
+    // owns each column's identical refined reciprocal and broadcasts it to the subgroup.
+    float den[4];
+#pragma unroll
+    for (int kk = 0; kk < 4; ++kk) {
+      float cs = c[kk] + __shfl_xor_sync(0xffffffffu, c[kk], 1);
+      cs = cs + __shfl_xor_sync(0xffffffffu, cs, 2);
+      den[kk] = cs + HC_SINKHORN_EPS;
+    }
+    const int col = threadIdx.x & 3;
+    const float owned_den =
+        (col == 0) ? den[0] : ((col == 1) ? den[1] : ((col == 2) ? den[2] : den[3]));
+    const float owned_rcp = rcp_refined(owned_den);
+#pragma unroll
+    for (int kk = 0; kk < 4; ++kk) {
+      const float r = __shfl_sync(0xffffffffu, owned_rcp, kk, 4);
+      c[kk] = div_rn_rcp(c[kk], den[kk], r);
+    }
+  };
+  colnorm();
+#pragma unroll 1
+  for (int rep = 0; rep < SINKHORN_REPEAT - 1; ++rep) {
+    const float den = ((c[0] + c[1]) + (c[2] + c[3])) + HC_SINKHORN_EPS;
+    const float r = rcp_refined(den);
+#pragma unroll
+    for (int kk = 0; kk < 4; ++kk) c[kk] = div_rn_rcp(c[kk], den, r);
+    colnorm();
+  }
+}
+
+// Low-latency variant for the last tokens of a CTA: one element per lane, lane = 16 * token +
+// 4 * row + col (two tokens per warp).  Each reduction gathers its three partners at once and adds
+// (own + p1) + (p2 + p3), which is bit-identical to sinkhorn_rows()'s row and column trees, but a
+// step costs one quotient per lane instead of four.
+__device__ __forceinline__ float sinkhorn_element_bw(float c) {
+  constexpr unsigned FULL = 0xffffffffu;
+  auto rsum = [&](float v) {
+    const float a = __shfl_xor_sync(FULL, v, 1);
+    const float b = __shfl_xor_sync(FULL, v, 2);
+    const float d = __shfl_xor_sync(FULL, v, 3);
+    return (v + a) + (b + d);
+  };
+  auto csum = [&](float v) {
+    const float a = __shfl_xor_sync(FULL, v, 4);
+    const float b = __shfl_xor_sync(FULL, v, 8);
+    const float d = __shfl_xor_sync(FULL, v, 12);
+    return (v + a) + (b + d);
+  };
+  {
+    const float a = __shfl_xor_sync(FULL, c, 1);
+    const float b = __shfl_xor_sync(FULL, c, 2);
+    const float d = __shfl_xor_sync(FULL, c, 3);
+    const float mx = fmaxf(fmaxf(c, a), fmaxf(b, d));
+    const float e = expf(c - mx);
+    const float sm = rsum(e);
+    c = div_rn_rcp(e, sm, rcp_refined(sm));
+    if (__any_sync(FULL, !(div_ok(sm) && div_ok(e)))) c = e / sm;
+    c = c + HC_SINKHORN_EPS;
+  }
+  auto colnorm = [&]() {
+    const float den = csum(c) + HC_SINKHORN_EPS;
+    c = div_rn_rcp(c, den, rcp_refined(den));
+  };
+  colnorm();
+#pragma unroll 1
+  for (int rep = 0; rep < SINKHORN_REPEAT - 1; ++rep) {
+    const float den = rsum(c) + HC_SINKHORN_EPS;
+    c = div_rn_rcp(c, den, rcp_refined(den));
+    colnorm();
+  }
+  return c;
+}
+
+// ================================================================================================
+// Bandwidth-regime kernel (several tiles per cluster): warp-specialized.
+//   warps 0-3  (WG0): TF32 projection; each warp keeps its 256-column x 24 slice of fn in
+//                     registers (setmaxnreg 248) and runs MMA(k) while the elementwise warps work
+//                     on tile k+1.
+//   warps 4-11 (WG1-2): post-map(k), B2(k-3), B1(k-2).  B1 trails post-map by two tiles so the
+//                     MMA -> owner finalize -> pre-mix broadcast chain has two tiles of slack.
+//   x has its own 3-slot ring (only post-map reads it), which leaves room for 5 residual stages.
+//   The bf16 residual_cur sum of squares is accumulated by the MMA warps from their A fragments.
+//   warp 12: TMA producer (+ L2 tensor prefetch BG_PF tiles ahead), 13: owner/finalize,
+//   14: Sinkhorn; 15: TMA residual store plus owner-reduce/broadcast for RMS.
+// ================================================================================================
+constexpr int BG_S = 5;   // residual / residual_cur stages
+constexpr int BG_XS = 3;  // x slots
+constexpr int BG_PF = 7;
+constexpr int BG_SK_TAIL = 4;  // producer handles the final owned Sinkhorn tokens
+constexpr int BG_NTHREADS = 512;
+constexpr int BG_NMW = 4;
+constexpr int BG_EW0 = 4;
+constexpr int BG_NEW = 8;
+constexpr int BG_WARP_PROD = 12;
+constexpr int BG_WARP_F0 = 13;
+constexpr int BG_WARP_F1 = 14;
+constexpr int BG_WARP_G2 = 15;
+constexpr int BG_R_OFF = 0;
+constexpr int BG_PLM_OFF = TMAX * 4 * ROWB;
+constexpr int BG_COMB_OFF = BG_PLM_OFF + TMAX * 16;
+constexpr int BG_STAGEB = BG_COMB_OFF + TMAX * 64;
+constexpr int BG_OFF_X = BG_S * BG_STAGEB;
+constexpr int BG_OFF_G1 = BG_OFF_X + BG_XS * TMAX * ROWB;
+constexpr int BG_OFF_PM = BG_OFF_G1 + BG_S * CL * G1_REC * 4;
+constexpr int BG_OFF_G2_PART = BG_OFF_PM + BG_S * TMAX * 16;
+constexpr int BG_OFF_G2_RS = BG_OFF_G2_PART + BG_S * TMAX * CL * 4;
+constexpr int BG_OFF_RED = BG_OFF_G2_RS + BG_S * TMAX * 4;
+constexpr int BG_RED_LD = 28;  // 24 mixes + sumsq, padded
+constexpr int BG_OFF_SSQ = BG_OFF_RED + 2 * BG_NMW * TMAX * BG_RED_LD * 4;
+constexpr int BG_OFF_Q = BG_OFF_SSQ + BG_S * TMAX * 4;
+constexpr int BG_OFF_BAR = BG_OFF_Q + QN * QREC * 4;
+constexpr int BG_B_FULL = 0, BG_B_EMPTY = BG_S, BG_B_RCR = 2 * BG_S, BG_B_G1 = 3 * BG_S;
+constexpr int BG_B_PM = 4 * BG_S, BG_B_G2_PART = 5 * BG_S, BG_B_G2 = 6 * BG_S;
+constexpr int BG_B_QF = 7 * BG_S, BG_B_QE = 7 * BG_S + QN;
+constexpr int BG_B_EMPTY_X = 7 * BG_S + 2 * QN;
+constexpr int BG_NBAR = 7 * BG_S + 2 * QN + BG_XS;
+constexpr int BG_SMEM_BYTES = BG_OFF_BAR + BG_NBAR * 8;
+static_assert(BG_SMEM_BYTES <= 227 * 1024, "smem");
+static_assert(BG_OFF_RED % 16 == 0 && BG_OFF_Q % 16 == 0 && BG_OFF_BAR % 8 == 0, "align");
+static_assert(BG_STAGEB % 128 == 0 && BG_OFF_X % 128 == 0 && BG_OFF_G1 % 16 == 0, "align");
+
+__device__ __forceinline__ void tma_prefetch_2d(const CUtensorMap* tm, int c0, int c1) {
+  asm volatile("cp.async.bulk.prefetch.tensor.2d.L2.global.tile [%0, {%1, %2}];" ::"l"(
+                   reinterpret_cast<uint64_t>(tm)),
+               "r"(c0), "r"(c1)
+               : "memory");
+}
+__device__ __forceinline__ void tma_prefetch_3d(const CUtensorMap* tm, int c0, int c1, int c2) {
+  asm volatile("cp.async.bulk.prefetch.tensor.3d.L2.global.tile [%0, {%1, %2, %3}];" ::"l"(
+                   reinterpret_cast<uint64_t>(tm)),
+               "r"(c0), "r"(c1), "r"(c2)
+               : "memory");
+}
+__device__ __forceinline__ void mma_bar() {
+  asm volatile("bar.sync 2, %0;" ::"n"(BG_NMW * 32) : "memory");
+}
+
+template <bool kLongRegs>
+__global__ void __launch_bounds__(BG_NTHREADS, 1)
+    mhc_fused_post_pre_crossover_kernel(const Params p, const __grid_constant__ CUtensorMap tm_x,
+                                        const __grid_constant__ CUtensorMap tm_res,
+                                        const __grid_constant__ CUtensorMap tm_rc) {
+  extern __shared__ __align__(1024) uint8_t smem[];
+  const uint32_t sbase = smem_u32(smem);
+  const int warp = threadIdx.x >> 5;
+  const int lane = threadIdx.x & 31;
+  const uint32_t r = cluster_ctarank();
+  const int cid = blockIdx.x / CL;
+  const int ncl = gridDim.x / CL;
+  // The host only selects this kernel when ntiles(TMAX) exceeds the resident cluster count,
