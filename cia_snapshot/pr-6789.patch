+
+// Only the <true> register split is reachable in this regime (see kStreamLongRegs).
+cudaError_t prepare_long_stream(int* stream_clusters) {
+  return configure_cluster_kernel(
+      reinterpret_cast<const void*>(mhc_fused_post_pre_long_stream_kernel<true>), BG_NTHREADS,
+      BG_SMEM_BYTES, stream_clusters);
+}
+
+cudaError_t launch_long_stream(const LaunchArgs& args, int num_clusters, const TensorMaps& maps,
+                               cudaStream_t stream) {
+  return launch_cluster_kernel(mhc_fused_post_pre_long_stream_kernel<true>, BG_NTHREADS,
+                               BG_SMEM_BYTES, num_clusters, make_params(args), maps, stream);
+}
