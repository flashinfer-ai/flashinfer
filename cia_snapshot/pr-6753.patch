+      "bra LAB_WAIT_PLAIN_HINT;\n\t"
+      "DONE_PLAIN_HINT:\n\t"
+      "}\n" ::"r"(mbar_addr),
+      "r"(phase), "r"(suspend_time_hint));
+}
