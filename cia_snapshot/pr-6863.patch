+{
+  "name": "fp8_token_head_quantize_append_paged_kv_cache_with_slot_mapping_kv2_d128_sl144_ps4",
+  "description": "Quantize fp16/bf16 K/V rows into an FP8 per-(token, head) paged KV cache using a flat slot_mapping array, writing the e4m3/e5m2 data and the float32 scale into one inline slot. Negative slots are ignored.",
+  "op_type": "page_append",
+  "tags": [
