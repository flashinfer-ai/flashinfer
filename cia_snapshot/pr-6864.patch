+  int32_t v_S_local = static_cast<int32_t>(a_S_local);
+  int32_t v_H_local = static_cast<int32_t>(a_H_local);
+  int32_t v_D = static_cast<int32_t>(a_D);
+  void* kernel_args[] = {&v_inp, &v_out, &v_staging_peers, &v_signals_peers, &v_signals_self, &v_pg_rank, &v_B, &v_S_local, &v_H_local, &v_D};
+  cudaLaunchConfig_t config{};
+  config.gridDim = dim3(static_cast<unsigned>(grid_x), static_cast<unsigned>(grid_y), static_cast<unsigned>(grid_z));
+  config.blockDim = dim3(512, 1, 1);
