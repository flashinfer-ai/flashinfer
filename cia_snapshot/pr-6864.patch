+void Run(TensorView a_inp, TensorView a_out, TensorView a_staging_peers, TensorView a_signals_peers, TensorView a_signals_self, int64_t a_pg_rank, int64_t a_B, int64_t a_S_local, int64_t a_H_local, int64_t a_D, int64_t grid_x, int64_t grid_y, int64_t grid_z) {
