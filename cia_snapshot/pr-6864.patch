+      << KERNEL_NAME << ": 'H_local' = " << a_H_local
+      << " is outside the i32 range [-2147483648, 2147483647]";
+  TVM_FFI_CHECK(a_D >= -2147483648LL && a_D <= 2147483647LL, ValueError)
