+  CakePeerPointerTable<__half> v_staging_peers;
+  std::memcpy(v_staging_peers.ptrs, DataPtr(a_staging_peers), sizeof(v_staging_peers.ptrs));
+  CakePeerPointerTable<unsigned int> v_signals_peers;
+  std::memcpy(v_signals_peers.ptrs, DataPtr(a_signals_peers), sizeof(v_signals_peers.ptrs));
+  void* v_signals_self = DataPtr(a_signals_self);
+  int32_t v_pg_rank = static_cast<int32_t>(a_pg_rank);
