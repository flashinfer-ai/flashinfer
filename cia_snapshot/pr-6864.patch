+      << " is outside the i32 range [-2147483648, 2147483647]";
+  check_contiguous(a_inp, "inp");
+  check_contiguous(a_out, "out");
+  check_same_device(a_out, a_inp, "out", "inp");
+  check_contiguous(a_signals_self, "signals_self");
+  check_same_device(a_signals_self, a_inp, "signals_self", "inp");
+  TVM_FFI_CHECK(a_pg_rank >= 0 && a_pg_rank < 4, ValueError)
+      << KERNEL_NAME << ": 'pg_rank' = " << a_pg_rank << " is outside [0, the fixed world size 4)";
+  TVM_FFI_CHECK(DataPtr(a_signals_self) == PeerAddress(a_signals_peers, a_pg_rank), ValueError)
+      << KERNEL_NAME << ": 'signals_self' is at " << DataPtr(a_signals_self) << ", but 'signals_peers'[" << a_pg_rank << "] holds "
+      << PeerAddress(a_signals_peers, a_pg_rank);
