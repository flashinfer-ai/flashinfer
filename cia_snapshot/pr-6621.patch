-
-        # Optionally shuffle weights using shared utility
-        gemm1_weights = []
-        gemm2_weights = []
-        for _ in range(num_experts_local):
-            # Generate bf16 weights for this expert using shared utility
-            w1_batch, w2_batch = generate_moe_weights(
