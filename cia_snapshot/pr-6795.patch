+
+
+@pytest.mark.parametrize(
+    ("generator", "module_name", "option"),
+    [
+        ("gen_gemm_sm100_module_cutlass_fp8", "fp8_gemm_cutlass", "add_moe"),
+        ("gen_trtllm_utils_module", "trtllm_utils", "add_misc"),
