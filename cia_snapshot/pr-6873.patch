+        "nnz_per_head": int(plan["nnz_per_head"]),
+        "num_work_items": int(plan["work_count"]),
+        "topk": _TOPK,
+        "max_pages": max_pages if paged else 0,
+        "causal": 1,
+        "derive_q_offset": 1,
