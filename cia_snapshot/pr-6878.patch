+  check_dtype(a_L1, DLDataType{kDLBfloat, 16, 1}, "L1");
+  check_cuda_tensor(a_L1_tail, "L1_tail");
+  check_dtype(a_L1_tail, DLDataType{kDLBfloat, 16, 1}, "L1_tail");
+  check_contiguous(a_alpha, "alpha");
+  check_same_device(a_alpha, a_D, "alpha", "D");
+  check_contiguous(a_bias, "bias");
+  check_same_device(a_bias, a_D, "bias", "D");
