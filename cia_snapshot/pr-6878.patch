+    assert loader.raster_group(m=16384, n=12288, k=12288, rank=32) == 2
+    assert loader.raster_group(m=4096, n=3072, k=3072, rank=32) == 8
+    assert loader.raster_group(m=6912, n=3072, k=3072, rank=128) == 8
