+void Run(TensorView a_D, TensorView a_alpha, TensorView a_bias, TensorView a_out, int64_t a_M, int64_t a_N, int64_t a_K_tiles, int64_t a_tok_tiles, int64_t a_w_tiles, int64_t a_num_tiles, int64_t a_raster_group, int64_t a_has_bias, int64_t a_rank, int64_t a_num_units, int64_t a_full_units, int64_t a_tail_split, TensorView a_A, TensorView a_B, TensorView a_B_half, TensorView a_SFA, TensorView a_SFB, TensorView a_L1, TensorView a_L1_tail, int64_t grid_x, int64_t grid_y, int64_t grid_z) {
+  DLDevice dev = a_D.device();
+  tvm::ffi::CUDADeviceGuard device_guard(dev.device_id);
+  check_cuda_tensor(a_D, "D");
+  check_dtype(a_D, DLDataType{kDLBfloat, 16, 1}, "D");
+  check_cuda_tensor(a_alpha, "alpha");
+  check_dtype(a_alpha, DLDataType{kDLFloat, 32, 1}, "alpha");
+  check_cuda_tensor(a_bias, "bias");
+  check_dtype(a_bias, DLDataType{kDLBfloat, 16, 1}, "bias");
+  check_cuda_tensor(a_out, "out");
+  check_dtype(a_out, DLDataType{kDLBfloat, 16, 1}, "out");
+  TVM_FFI_CHECK(a_M >= -2147483648LL && a_M <= 2147483647LL, ValueError)
+      << KERNEL_NAME << ": 'M' = " << a_M
+      << " is outside the i32 range [-2147483648, 2147483647]";
+  TVM_FFI_CHECK(a_N >= -2147483648LL && a_N <= 2147483647LL, ValueError)
+      << KERNEL_NAME << ": 'N' = " << a_N
+      << " is outside the i32 range [-2147483648, 2147483647]";
+  TVM_FFI_CHECK(a_K_tiles >= -2147483648LL && a_K_tiles <= 2147483647LL, ValueError)
+      << KERNEL_NAME << ": 'K_tiles' = " << a_K_tiles
+      << " is outside the i32 range [-2147483648, 2147483647]";
+  TVM_FFI_CHECK(a_tok_tiles >= -2147483648LL && a_tok_tiles <= 2147483647LL, ValueError)
+      << KERNEL_NAME << ": 'tok_tiles' = " << a_tok_tiles
+      << " is outside the i32 range [-2147483648, 2147483647]";
+  TVM_FFI_CHECK(a_w_tiles >= -2147483648LL && a_w_tiles <= 2147483647LL, ValueError)
+      << KERNEL_NAME << ": 'w_tiles' = " << a_w_tiles
+      << " is outside the i32 range [-2147483648, 2147483647]";
+  TVM_FFI_CHECK(a_num_tiles >= -2147483648LL && a_num_tiles <= 2147483647LL, ValueError)
+      << KERNEL_NAME << ": 'num_tiles' = " << a_num_tiles
+      << " is outside the i32 range [-2147483648, 2147483647]";
+  TVM_FFI_CHECK(a_raster_group >= -2147483648LL && a_raster_group <= 2147483647LL, ValueError)
+      << KERNEL_NAME << ": 'raster_group' = " << a_raster_group
+      << " is outside the i32 range [-2147483648, 2147483647]";
+  TVM_FFI_CHECK(a_has_bias >= -2147483648LL && a_has_bias <= 2147483647LL, ValueError)
+      << KERNEL_NAME << ": 'has_bias' = " << a_has_bias
+      << " is outside the i32 range [-2147483648, 2147483647]";
+  TVM_FFI_CHECK(a_rank >= -2147483648LL && a_rank <= 2147483647LL, ValueError)
+      << KERNEL_NAME << ": 'rank' = " << a_rank
+      << " is outside the i32 range [-2147483648, 2147483647]";
+  TVM_FFI_CHECK(a_num_units >= -2147483648LL && a_num_units <= 2147483647LL, ValueError)
+      << KERNEL_NAME << ": 'num_units' = " << a_num_units
+      << " is outside the i32 range [-2147483648, 2147483647]";
+  TVM_FFI_CHECK(a_full_units >= -2147483648LL && a_full_units <= 2147483647LL, ValueError)
+      << KERNEL_NAME << ": 'full_units' = " << a_full_units
+      << " is outside the i32 range [-2147483648, 2147483647]";
+  TVM_FFI_CHECK(a_tail_split >= -2147483648LL && a_tail_split <= 2147483647LL, ValueError)
+      << KERNEL_NAME << ": 'tail_split' = " << a_tail_split
+      << " is outside the i32 range [-2147483648, 2147483647]";
+  check_cuda_tensor(a_A, "A");
+  check_dtype(a_A, DLDataType{kDLUInt, 8, 1}, "A");
+  check_cuda_tensor(a_B, "B");
+  check_dtype(a_B, DLDataType{kDLUInt, 8, 1}, "B");
+  check_cuda_tensor(a_B_half, "B_half");
+  check_dtype(a_B_half, DLDataType{kDLUInt, 8, 1}, "B_half");
+  check_cuda_tensor(a_SFA, "SFA");
+  check_dtype(a_SFA, DLDataType{kDLUInt, 32, 1}, "SFA");
+  check_cuda_tensor(a_SFB, "SFB");
+  check_dtype(a_SFB, DLDataType{kDLUInt, 32, 1}, "SFB");
+  check_cuda_tensor(a_L1, "L1");
+  check_dtype(a_L1, DLDataType{kDLBfloat, 16, 1}, "L1");
+  check_cuda_tensor(a_L1_tail, "L1_tail");
+  check_dtype(a_L1_tail, DLDataType{kDLBfloat, 16, 1}, "L1_tail");
+  check_contiguous(a_alpha, "alpha");
+  check_same_device(a_alpha, a_D, "alpha", "D");
+  check_contiguous(a_bias, "bias");
+  check_same_device(a_bias, a_D, "bias", "D");
+  check_same_device(a_out, a_D, "out", "D");
+  check_same_device(a_A, a_D, "A", "D");
+  check_same_device(a_B, a_D, "B", "D");
+  check_same_device(a_B_half, a_D, "B_half", "D");
+  check_same_device(a_SFA, a_D, "SFA", "D");
+  check_same_device(a_SFB, a_D, "SFB", "D");
+  check_same_device(a_L1, a_D, "L1", "D");
+  check_same_device(a_L1_tail, a_D, "L1_tail", "D");
