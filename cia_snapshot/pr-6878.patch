+      << KERNEL_NAME << ": 'has_bias' = " << a_has_bias
+      << " is outside the i32 range [-2147483648, 2147483647]";
+  check_same_device(a_B, a_A, "B", "A");
+  check_same_device(a_SFA, a_A, "SFA", "A");
+  check_same_device(a_SFB, a_A, "SFB", "A");
+  check_same_device(a_D, a_A, "D", "A");
