+  check_dtype(a_B, DLDataType{kDLUInt, 8, 1}, "B");
+  check_cuda_tensor(a_SFA, "SFA");
+  check_dtype(a_SFA, DLDataType{kDLUInt, 32, 1}, "SFA");
+  check_cuda_tensor(a_SFB, "SFB");
+  check_dtype(a_SFB, DLDataType{kDLUInt, 32, 1}, "SFB");
