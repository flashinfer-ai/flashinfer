+      << " is outside the i32 range [-2147483648, 2147483647]";
+  TVM_FFI_CHECK(a_w_tiles >= -2147483648LL && a_w_tiles <= 2147483647LL, ValueError)
+      << KERNEL_NAME << ": 'w_tiles' = " << a_w_tiles
+      << " is outside the i32 range [-2147483648, 2147483647]";
+  TVM_FFI_CHECK(a_num_tiles >= -2147483648LL && a_num_tiles <= 2147483647LL, ValueError)
