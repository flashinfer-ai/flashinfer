+        cute.autovec_copy(
+            cute.make_tensor(
+                cute.make_ptr(
+                    cutlass.BFloat16,
+                    q_tile.iterator.toint(),
+                    cute.AddressSpace.gmem,
+                    assumed_align=16,
+                ),
+                cute.make_layout((vec,)),
+            ),
+            r_q_bf16,
+        )
+        cute.autovec_copy(
+            cute.make_tensor(
+                cute.make_ptr(
+                    cutlass.BFloat16,
+                    k_tile.iterator.toint(),
+                    cute.AddressSpace.gmem,
