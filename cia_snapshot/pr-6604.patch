+        cute.make_layout((vec,), stride=(1,)), cutlass.BFloat16
+    )
+    r_k_bf16 = cute.make_rmem_tensor(
+        cute.make_layout((vec,), stride=(1,)), cutlass.BFloat16
+    )
+    r_hb0 = cute.make_rmem_tensor(
+        cute.make_layout((vec,), stride=(1,)), cutlass.BFloat16
+    )
+    r_hb1 = cute.make_rmem_tensor(
+        cute.make_layout((vec,), stride=(1,)), cutlass.BFloat16
+    )
+    r_hb2 = cute.make_rmem_tensor(
+        cute.make_layout((vec,), stride=(1,)), cutlass.BFloat16
+    )
+    r_hb3 = cute.make_rmem_tensor(
+        cute.make_layout((vec,), stride=(1,)), cutlass.BFloat16
+    )
