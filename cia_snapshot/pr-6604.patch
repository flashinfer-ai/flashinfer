 limitations under the License.
 """
 
+import math
+import weakref
 from typing import List, Tuple
+
 import torch
 
 try:
@@ -27,6 +30,7 @@
         "Please install cuda-python that matches your CUDA version."
     ) from e
 
+from .api_logging import flashinfer_api
 from .cuda_utils import checkCudaErrors
 from .utils import get_compute_capability, round_up
 
@@ -293,3 +297,237 @@ def split_device_green_ctx_by_sm_count(
                 f"Please reduce the requested SM counts or use fewer partitions."
             ) from e
         raise
+
+
+# ---------------------------------------------------------------------------
+# uGPU localization: locality domains (dies) of multi-die GPUs such as Rubin
+# ---------------------------------------------------------------------------
+
+
+def _indexed(dev) -> torch.device:
+    """``dev`` as a ``torch.device`` with an explicit index (``"cuda"`` -> current device)."""
+    dev = torch.device(dev)
+    if dev.index is None:
+        dev = torch.device(dev.type, torch.cuda.current_device())
+    return dev
+
+
+@flashinfer_api
+def get_locality_domain_count(dev: torch.device) -> int:
+    r"""Number of locality domains (uGPUs, one per die) of ``dev``.
+
+    Args:
+        dev: The CUDA device (``"cuda"`` without an index means the current device).
+
+    Returns:
+        The number of locality domains: 2 on Rubin VR200, 1 when the device or the
+        installed driver / cuda-python does not expose locality domains.
+    """
+    attr = getattr(
+        driver.CUdevice_attribute, "CU_DEVICE_ATTRIBUTE_LOCALITY_DOMAIN_COUNT", None
+    )
+    if attr is None:
+        return 1
+    dev = _indexed(dev)
+    try:
+        return max(
+            1,
+            int(checkCudaErrors(driver.cuDeviceGetAttribute(attr, get_cudevice(dev)))),
+        )
+    except RuntimeError:
+        return 1
+
+
+@flashinfer_api
+def split_device_green_ctx_by_locality_domain(
+    dev: torch.device, backfill: bool = True
+) -> Tuple[List[torch.Stream], List[CUdevResource]]:
+    r"""
+    Create one green context per locality domain (uGPU) of ``dev`` and return its stream
+    and ``CUdevResource``, in domain order. A kernel launched on stream ``i`` runs only on
+    domain ``i``'s SMs, so together with memory placed in that domain
+    (:func:`empty_per_locality_domain`) its DRAM traffic stays on the die.
+
+    Args:
+        dev: The device to split.
+        backfill: If ``True`` (default), each group gets ``num_SMs // num_domains`` SMs and
+            the driver completes a domain's group with SMs that belong to no domain (on
+            Rubin VR200: 100 native SMs + 6 of the 12 remaining ones per die, so all 212
+            SMs work). If ``False``, each group holds its domain's native SMs only.
+
+    Returns:
+        streams: One ``torch.Stream`` per locality domain.
+        resources: The matching ``CUdevResource`` objects (``.sm.smCount`` is the SM count).
+
+    Raises:
+        RuntimeError: if the device has fewer than two locality domains.
+    """
+    dev = _indexed(dev)
+    num_domains = get_locality_domain_count(dev)
+    if num_domains < 2:
+        raise RuntimeError(
+            f"{dev} exposes {num_domains} locality domain(s); uGPU localization needs at "
+            "least two (e.g. Rubin) and a driver / cuda-python with the locality-domain API"
+        )
+    cu_dev = get_cudevice(dev)
+    resource = get_device_resource(cu_dev)
+    params = []
+    for i in range(num_domains):
+        p = driver.CU_DEV_SM_RESOURCE_GROUP_PARAMS()
+        p.smCount = resource.sm.smCount // num_domains if backfill else 0
+        p.coscheduledSmCount = 2
+        flags = int(
+            driver.CUdevSmResourceGroup_flags.CU_DEV_SM_RESOURCE_GROUP_LOCALITY_DOMAIN_ID
+        )
+        if backfill:
+            flags |= int(
+                driver.CUdevSmResourceGroup_flags.CU_DEV_SM_RESOURCE_GROUP_BACKFILL
+            )
+        p.flags = flags
+        p.localityDomainId = i
+        params.append(p)
+    groups = checkCudaErrors(
+        driver.cuDevSmResourceSplit(num_domains, resource, 0, params)
+    )[0]
+    groups = list(groups)
+    # torch tags an external stream with the current device: make that dev
+    with torch.cuda.device(dev):
+        return create_green_ctx_streams(cu_dev, groups), groups
+
+
+class _LocalizedAllocation:
+    """Owner of an :func:`empty_per_locality_domain` mapping; torch keeps it alive."""
+
+    def __init__(self, ptr: int, nbytes: int, typestr: str):
+        self.__cuda_array_interface__ = {
+            "shape": (nbytes,),
+            "typestr": typestr,
+            "data": (ptr, False),
+            "version": 3,
+        }
+
+
+# Allocations whose tensors died while a CUDA graph was being captured: their release (which
+# synchronizes the device) waits for the next allocation or release outside capture.
+_deferred_releases: list = []
+
+
+def _release_localized(dev_index: int, ptr: int, va_bytes: int, chunks) -> None:
+    torch.cuda.synchronize(dev_index)
+    for offset, size, handle in chunks:
+        checkCudaErrors(driver.cuMemUnmap(ptr + offset, size))
+        checkCudaErrors(driver.cuMemRelease(handle))
+    checkCudaErrors(driver.cuMemAddressFree(ptr, va_bytes))
+
+
+def _release_deferred() -> None:
+    # A device synchronize during stream capture would invalidate the capture
+    if torch.cuda.is_current_stream_capturing():
+        return
+    while _deferred_releases:
+        _release_localized(*_deferred_releases.pop())
+
+
+def _unmap_localized(dev_index: int, ptr: int, va_bytes: int, chunks) -> None:
+    """Finalizer of an :func:`empty_per_locality_domain` tensor (runs from garbage collection)."""
+    _deferred_releases.append((dev_index, ptr, va_bytes, chunks))
+    _release_deferred()
+
+
+@flashinfer_api
+def empty_per_locality_domain(
+    part_shape: Tuple[int, ...], dtype: torch.dtype, dev: torch.device
+) -> torch.Tensor:
+    r"""
+    Allocate an uninitialized tensor of shape ``[num_domains, *part_shape]`` whose part ``i``
+    lives in locality domain ``i``'s memory (one virtual address range over per-domain
+    physical memory). Each part is contiguous; the stride of dim 0 is the part size rounded
+    up to the allocation granularity.
+
+    The memory comes from the CUDA driver (``cuMemCreate`` / ``cuMemMap``), not from PyTorch's
+    caching allocator: it does not count in ``torch.cuda.memory_allocated()`` and cannot be
+    reused by other tensors. It is released when the tensor and all its views are freed (after
+    a device synchronize; if that happens during CUDA graph capture, at the next allocation or
+    release outside capture).
+
+    Example: :func:`flashinfer.gdn_decode.ugpu_state_pool` builds a GDN state pool from two
+    parts, so that each die reads and writes only its own half of every state.
+
+    Args:
+        part_shape: Shape of one part.
+        dtype: Element type.
+        dev: CUDA device with at least two locality domains.
+
+    Returns:
+        The tensor.
+    """
+    dev = _indexed(dev)
+    num_domains = get_locality_domain_count(dev)
+    if num_domains < 2:
+        raise RuntimeError(
+            f"{dev} exposes {num_domains} locality domain(s); empty_per_locality_domain "
+            "needs at least two"
+        )
+    _release_deferred()
+    cu_dev = get_cudevice(dev)
+    elem = torch.tensor([], dtype=dtype).element_size()
+    part_elems = math.prod(part_shape)
+
+    def prop_for(domain: int):
+        prop = driver.CUmemAllocationProp()
+        prop.type = driver.CUmemAllocationType.CU_MEM_ALLOCATION_TYPE_PINNED
+        prop.location.type = (
+            driver.CUmemLocationType.CU_MEM_LOCATION_TYPE_DEVICE_LOCALITY_DOMAIN
+        )
+        prop.location.localized.deviceId = int(cu_dev)
+        prop.location.localized.localityDomainId = domain
+        return prop
+
+    gran = int(
+        checkCudaErrors(
+            driver.cuMemGetAllocationGranularity(
+                prop_for(0),
+                driver.CUmemAllocationGranularity_flags.CU_MEM_ALLOC_GRANULARITY_RECOMMENDED,
+            )
+        )
+    )
+    part_bytes = max(round_up(part_elems * elem, gran), gran)
+    va_bytes = num_domains * part_bytes
+    ptr = int(checkCudaErrors(driver.cuMemAddressReserve(va_bytes, 0, 0, 0)))
+    chunks = []
+    try:
+        for i in range(num_domains):
+            handle = checkCudaErrors(driver.cuMemCreate(part_bytes, prop_for(i), 0))
+            try:
+                checkCudaErrors(
+                    driver.cuMemMap(ptr + i * part_bytes, part_bytes, 0, handle, 0)
+                )
+            except BaseException:
+                driver.cuMemRelease(handle)
+                raise
+            chunks.append((i * part_bytes, part_bytes, handle))
+        access = driver.CUmemAccessDesc()
+        access.location.type = driver.CUmemLocationType.CU_MEM_LOCATION_TYPE_DEVICE
+        access.location.id = int(cu_dev)
+        access.flags = driver.CUmemAccess_flags.CU_MEM_ACCESS_FLAGS_PROT_READWRITE
+        checkCudaErrors(driver.cuMemSetAccess(ptr, va_bytes, [access], 1))
+    except BaseException:
+        # unwind (e.g. out of memory in the second domain): nothing has used the mapping yet
+        for offset, size, handle in chunks:
+            driver.cuMemUnmap(ptr + offset, size)
+            driver.cuMemRelease(handle)
+        driver.cuMemAddressFree(ptr, va_bytes)
+        raise
+    owner = _LocalizedAllocation(ptr, va_bytes, "|u1")
+    weakref.finalize(
+        owner, _unmap_localized, dev.index, ptr, va_bytes, chunks
+    ).atexit = False
+    flat = torch.as_tensor(owner, device=dev).view(dtype)
+    inner = []
+    stride = 1
+    for size in reversed(part_shape):
+        inner.append(stride)
+        stride *= size
+    return torch.as_strided(
+        flat, (num_domains, *part_shape), (part_bytes // elem, *reversed(inner))
+    )
diff --git a/tests/gdn/test_decode_bf16_state_rubin.py b/tests/gdn/test_decode_bf16_state_rubin.py
new file mode 100644
index 00000000000..c00d4826217
--- /dev/null
+++ b/tests/gdn/test_decode_bf16_state_rubin.py
@@ -0,0 +1,488 @@
+"""
+Copyright (c) 2026 by FlashInfer team.
+
+Licensed under the Apache License, Version 2.0 (the "License");
+you may not use this file except in compliance with the License.
+You may obtain a copy of the License at
+
+  http://www.apache.org/licenses/LICENSE-2.0
+
+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+"""
+
+"""Rubin-tuned T=1 GDN decode kernel with BF16 state (gdn_decode_bf16_state_rubin), SM107 only.
+
+Where the generic dispatcher picks its wide_vec T=1 kernel (B * HV >= 512) the math and FMA order
+are identical, so outputs and the updated state must be bitwise equal. At smaller work sizes the
+generic dispatcher runs a different kernel (mtp_ilp4) with another reduction order, so there the
+comparison uses a bf16 tolerance. The build specializes on a few input properties (16 B aligned
+q/k rows, unit-stride output rows, dense state rows); the layout test runs each one's other side.
+The fp32-reference check is test_decode_delta_rule.py::test_gdn_decode_bf16_state_t1_kernel.
+"""
+
+import math
+
+import pytest
+import torch
+
+import flashinfer.gdn_decode as gdn_decode
+from flashinfer.gdn_decode import gated_delta_rule_decode_pretranspose, ugpu_state_pool
+from flashinfer.gdn_kernels.gdn_decode_bf16_state import gated_delta_rule as generic
+from flashinfer.gdn_kernels.gdn_decode_bf16_state_rubin import gated_delta_rule_t1_rubin
+
+pytestmark = pytest.mark.arch_rubin
+
+D = 128
+
+
+def _inputs(B, HQ, HK, HV, pool, seed, dtype=torch.bfloat16):
+    g = torch.Generator(device="cuda").manual_seed(seed)
+
+    def r(*s, dt=dtype):
+        return torch.randn(*s, device="cuda", dtype=dt, generator=g)
+
+    return dict(
+        q=r(B, 1, HQ, D),
+        k=r(B, 1, HK, D),
+        v=r(B, 1, HV, D),
+        A_log=r(HV, dt=torch.float32),
+        a=r(B, 1, HV),
+        dt_bias=r(HV, dt=torch.bfloat16),  # the API takes bf16 / fp32 dt_bias
+        b=r(B, 1, HV),
+        state=r(pool, HV, D, D, dt=torch.bfloat16) * 0.1,
+    )
+
+
+def _call(fn, inp, state, idx, out_idx, l2norm, **extra):
+    out = torch.empty(
+        inp["q"].shape[0], 1, inp["v"].shape[2], D, device="cuda", dtype=torch.bfloat16
+    )
+    fn(
+        A_log=inp["A_log"],
+        a=inp["a"],
+        dt_bias=inp["dt_bias"],
+        q=inp["q"],
+        k=inp["k"],
+        v=inp["v"],
+        b=inp["b"],
+        initial_state_source=state,
+        initial_state_indices=idx,
+        output_state_indices=out_idx,
+        use_qk_l2norm_in_kernel=l2norm,
+        scale=1.0 / math.sqrt(D),
+        output=out,
+        **extra,
+    )
+    return out
+
+
+def _api(inp, state, idx, out_idx, backend, **extra):
+    return gated_delta_rule_decode_pretranspose(
+        q=inp["q"],
+        k=inp["k"],
+        v=inp["v"],
+        state=None,
+        A_log=inp["A_log"],
+        a=inp["a"],
+        dt_bias=inp["dt_bias"],
+        b=inp["b"],
+        scale=1.0 / math.sqrt(D),
+        use_qk_l2norm=True,
+        initial_state=state,
+        initial_state_indices=idx,
+        output_state_indices=out_idx,
+        backend=backend,
+        **extra,
+    )[0]
+
+
+def _pool(B, mode):
+    if mode == "split":
+        pool = 2 * B
+        idx = torch.arange(B, dtype=torch.int32, device="cuda")
+        out_idx = torch.arange(B, 2 * B, dtype=torch.int32, device="cuda")
+    elif mode == "shuffled":
+        pool = B + 7
+        idx = torch.randperm(pool, device="cuda")[:B].to(torch.int32)
+        out_idx = None
+    else:
+        pool = B
+        idx = torch.arange(B, dtype=torch.int32, device="cuda")
+        out_idx = None
+    return pool, idx, out_idx
+
+
+@pytest.mark.parametrize("B", [1, 4, 8, 16, 32, 64, 128, 512])
+@pytest.mark.parametrize("HQ,HK,HV", [(16, 16, 64), (16, 16, 32)])
+@pytest.mark.parametrize("l2norm", [True, False])
+@pytest.mark.parametrize("pool_mode", ["single", "split", "shuffled"])
+def test_rubin_t1_matches_generic(B, HQ, HK, HV, l2norm, pool_mode):
+    pool, idx, out_idx = _pool(B, pool_mode)
+    inp = _inputs(B, HQ, HK, HV, pool, seed=B * 7 + HV)
+    st_ref = inp["state"].clone()
+    st_new = inp["state"].clone()
+    o_ref = _call(generic, inp, st_ref, idx, out_idx, l2norm)
+    o_new = _call(gated_delta_rule_t1_rubin, inp, st_new, idx, out_idx, l2norm)
+    torch.cuda.synchronize()
+
+    if B * HV >= 512:  # the generic dispatcher runs the same wide_vec T=1 math
+        assert torch.equal(o_new, o_ref)
+        assert torch.equal(st_new, st_ref)
+    else:
+        torch.testing.assert_close(o_new.float(), o_ref.float(), atol=2e-2, rtol=2e-2)
+        torch.testing.assert_close(st_new.float(), st_ref.float(), atol=2e-2, rtol=2e-2)
+    # pool slots that are not written must stay untouched
+    touched = torch.zeros(pool, dtype=torch.bool, device="cuda")
+    touched[(out_idx if out_idx is not None else idx).long()] = True
+    assert torch.equal(st_new[~touched], inp["state"][~touched])
+
+
+@pytest.mark.parametrize(
+    "tile_v,pf_dist", [(32, None), (64, None), (128, None), (64, 0)]
+)
+def test_rubin_t1_variants_bitwise(tile_v, pf_dist):
+    """Every tile size, with and without the L2 prefetch, computes the same thing."""
+    B, HQ, HK, HV = 64, 16, 16, 64
+    inp = _inputs(B, HQ, HK, HV, B, seed=3)
+    idx = torch.arange(B, dtype=torch.int32, device="cuda")
+    st_ref = inp["state"].clone()
+    o_ref = _call(generic, inp, st_ref, idx, None, True)
+    st = inp["state"].clone()
+    o = _call(
+        gated_delta_rule_t1_rubin,
+        inp,
+        st,
+        idx,
+        None,
+        True,
+        tile_v=tile_v,
+        pf_dist=pf_dist,
+    )
+    torch.cuda.synchronize()
+    assert torch.equal(o, o_ref)
+    assert torch.equal(st, st_ref)
+
+
+def test_rubin_t1_negative_index_matches_generic():
+    """Padding rows (index -1) follow the generic kernel's redirect-to-slot-0 semantics."""
+    B, HQ, HK, HV = 16, 16, 16, 64
+    inp = _inputs(B, HQ, HK, HV, B, seed=11)
+    idx = torch.arange(B, dtype=torch.int32, device="cuda")
+    idx[3] = -1
+    st_ref = inp["state"].clone()
+    st_new = inp["state"].clone()
+    o_ref = _call(generic, inp, st_ref, idx, None, True)
+    o_new = _call(gated_delta_rule_t1_rubin, inp, st_new, idx, None, True)
+    torch.cuda.synchronize()
+    good = torch.ones(B, dtype=torch.bool, device="cuda")
+    good[3] = False
+    good[0] = (
+        False  # slot 0 is also written by the redirected padding row (race in both)
+    )
+    assert torch.equal(o_new[good], o_ref[good])
+    assert torch.equal(st_new[good], st_ref[good])
+
+
+@pytest.mark.parametrize("B", [64, 512])
+def test_rubin_t1_fused_qkv_views(B):
+    """q / k / v as views of one fused QKV buffer (each build compiles their strides): the
+    same bits as contiguous q / k / v."""
+    HQ, HK, HV = 16, 16, 64
+    inp = _inputs(B, HQ, HK, HV, B, seed=B + 5)
+    idx = torch.arange(B, dtype=torch.int32, device="cuda")
+    st_ref = inp["state"].clone()
+    o_ref = _call(gated_delta_rule_t1_rubin, inp, st_ref, idx, None, True)
+    qkv = torch.cat([inp["q"], inp["k"], inp["v"]], dim=2)  # [B, 1, HQ + HK + HV, D]
+    views = dict(
+        inp, q=qkv[:, :, :HQ], k=qkv[:, :, HQ : HQ + HK], v=qkv[:, :, HQ + HK :]
+    )
+    assert not views["q"].is_contiguous()
+    st = inp["state"].clone()
+    o = _call(gated_delta_rule_t1_rubin, views, st, idx, None, True)
+    torch.cuda.synchronize()
+    assert torch.equal(o, o_ref)
+    assert torch.equal(st, st_ref)
+
+
+def test_rubin_t1_strided_pool_sizes():
+    """vLLM-style padded pool (slot stride > HV * V * K) at two pool sizes in a row: each
+    size gets its own build and the same bits as the generic kernel."""
+    HQ, HK, HV = 16, 16, 32
+    for B in (16, 32):
+        pool = 2 * B
+        inp = _inputs(B, HQ, HK, HV, pool, seed=B + 9)
+        idx = (torch.arange(B, dtype=torch.int32, device="cuda") * 2 + 1) % pool
+        states = []
+        for _ in range(2):
+            big = torch.empty(pool, HV + 1, D, D, dtype=torch.bfloat16, device="cuda")
+            st = big[:, :HV]
+            st.copy_(inp["state"])
+            assert not st.is_contiguous()
+            states.append(st)
+        o_ref = _call(generic, inp, states[0], idx, None, True)
+        o = _call(gated_delta_rule_t1_rubin, inp, states[1], idx, None, True)
+        torch.cuda.synchronize()
+        assert torch.equal(o, o_ref)
+        assert torch.equal(states[1], states[0])
+
+
+@pytest.mark.parametrize("layout", ["unaligned_qk", "strided_output", "padded_rows"])
+def test_rubin_t1_layouts(layout):
+    """The other side of each input property the build specializes on: q / k rows that are
+    not 16 B aligned (no 16 B q / k loads), an output with a non-unit last stride, state rows
+    padded past K (no dense-row prefetch addressing). The same bits as the generic kernel."""
+    B, HQ, HK, HV = 64, 16, 16, 64
+    inp = _inputs(B, HQ, HK, HV, B, seed=17)
+    idx = torch.arange(B, dtype=torch.int32, device="cuda")
+    st_ref = inp["state"].clone()
+    o_ref = _call(generic, inp, st_ref, idx, None, True)
+    st = inp["state"].clone()
+    if layout == "unaligned_qk":
+        for name, H in (("q", HQ), ("k", HK)):
+            # rows 264 B apart: only every other row starts on a 16 B boundary
+            view = torch.empty(B, 1, H, D + 4, dtype=torch.bfloat16, device="cuda")
+            view = view[..., :D]
+            view.copy_(inp[name])
+            inp = dict(inp, **{name: view})
+    if layout == "padded_rows":
+        big = torch.empty(B, HV, D, D + 8, dtype=torch.bfloat16, device="cuda")
+        st = big[..., :D]
+        st.copy_(inp["state"])
+    out = torch.empty(B, 1, HV, D, device="cuda", dtype=torch.bfloat16)
+    if layout == "strided_output":
+        out = torch.empty(B, 1, HV, 2 * D, device="cuda", dtype=torch.bfloat16)[
+            ..., ::2
+        ]
+    gated_delta_rule_t1_rubin(
+        A_log=inp["A_log"],
+        a=inp["a"],
+        dt_bias=inp["dt_bias"],
+        q=inp["q"],
+        k=inp["k"],
+        v=inp["v"],
+        b=inp["b"],
+        initial_state_source=st,
+        initial_state_indices=idx,
+        use_qk_l2norm_in_kernel=True,
+        scale=1.0 / math.sqrt(D),
+        output=out,
+    )
+    torch.cuda.synchronize()
+    assert torch.equal(out, o_ref)
+    assert torch.equal(st, st_ref)
