+            cute.make_layout((1, vec // 2), stride=(vec // 2, 1)), cutlass.Uint32
+        )
+        r_w2 = cute.make_rmem_tensor(
+            cute.make_layout((1, vec // 2), stride=(vec // 2, 1)), cutlass.Uint32
+        )
