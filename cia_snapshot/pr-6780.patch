+_PROGRAM_SHIM_DEFAULT = re.compile(r"^#define CAKE_PROGRAM_SHIM (\w+)$", re.M)
+_LAUNCHER_NAMESPACE = re.compile(r"^namespace (\w+) \{$", re.M)
