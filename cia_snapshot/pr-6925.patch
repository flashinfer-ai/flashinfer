+):
+    """Tracing and execution use the same host Q bound without reading offsets."""
+    from flashinfer.attention.prims_ts import (
+        BatchDecodePagedTSWrapper,
+        BatchMLADecodePagedTSWrapper,
+    )
+    from flashinfer.fi_trace import fi_trace
+
+    wrapper = BatchMLADecodePagedTSWrapper() if mla else BatchDecodePagedTSWrapper()
+    options = dict(
+        packed_query=True,
+        q_data_type=torch.bfloat16,
+        o_data_type=torch.bfloat16,
+        page_size=32,
+        mask_type="causal",
+        window_left=-1,
+        storage_page_size=None,
+        lse_mode="none",
+        use_attention_sinks=False,
+        max_seq_len_q=4 if bound_source != "missing" else None,
+    )
+    if mla:
+        options.update(num_heads=8, kv_lora_rank=512, qk_rope_head_dim=64)
+    wrapper._runtime_plan = SimpleNamespace(options=options)
+    kwargs = dict(
+        seq_lens=torch.tensor((129, 65), dtype=torch.int32),
+        block_tables=torch.zeros((2, 5), dtype=torch.int32),
