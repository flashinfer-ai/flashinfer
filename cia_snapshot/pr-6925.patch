+def _make_case(
+    dtype,
+    dim,
+    q_lengths,
+    *,
+    fixed=False,
+    page_size=32,
+    kv_lengths=(257, 131),
+    heads=8,
+    kv_heads=2,
+    window_left=-1,
+):
+    """Create shuffled guarded pages and a bottom-right FP32 oracle."""
+    generator = torch.Generator(device="cuda").manual_seed(7213)
+    counts = [(n + page_size - 1) // page_size for n in kv_lengths]
+    page_ids = list(reversed(range(1, sum(counts) + 1)))
+    shape = (sum(counts) + 2, kv_heads, page_size, dim)
+    # Masked PV products still consume padded V: zero times NaN is NaN.
+    # A large finite sentinel detects unmasked padding without requiring a
+    # separate NaN-padding guarantee from the decode kernel.
+    k = torch.full(shape, 16.0, device="cuda")
+    v = torch.full_like(k, 16.0)
+    backing = torch.full(
+        (len(kv_lengths), max(counts) + 2), -1, device="cuda", dtype=torch.int32
+    )
+    table = backing[:, : max(counts)]
+    queries, expected = [], []
+    cursor = 0
+    scale = 1.0 / math.sqrt(dim)
+    for b, (nq, nk) in enumerate(zip(q_lengths, kv_lengths, strict=True)):
+        q = (
+            0.3 * torch.randn((nq, heads, dim), device="cuda", generator=generator)
+        ).to(dtype)
+        kb = (
+            0.3 * torch.randn((nk, kv_heads, dim), device="cuda", generator=generator)
+        ).to(dtype)
+        vb = (
+            0.3 * torch.randn((nk, kv_heads, dim), device="cuda", generator=generator)
+        ).to(dtype)
+        for local_page in range(counts[b]):
+            page = page_ids[cursor]
+            cursor += 1
+            table[b, local_page] = page
+            begin = local_page * page_size
+            valid = min(page_size, nk - begin)
+            k[page, :, :valid] = kb[begin : begin + valid].transpose(0, 1).float()
+            v[page, :, :valid] = vb[begin : begin + valid].transpose(0, 1).float()
+        kh = kb.float().repeat_interleave(heads // kv_heads, dim=1)
+        vh = vb.float().repeat_interleave(heads // kv_heads, dim=1)
+        scores = torch.einsum("qhd,khd->hqk", q.float(), kh) * scale
+        visible = torch.arange(nk, device="cuda")[None, :] <= (
+            nk - nq + torch.arange(nq, device="cuda")[:, None]
+        )
+        if window_left >= 0:
+            visible &= torch.arange(nk, device="cuda")[None, :] >= (
+                nk - nq + torch.arange(nq, device="cuda")[:, None] - window_left
+            )
+        scores.masked_fill_(~visible[None], -float("inf"))
+        expected.append(torch.einsum("hqk,khd->qhd", scores.softmax(-1), vh) * 0.75)
+        queries.append(q)
+    q = torch.stack(queries) if fixed else torch.cat(queries)
+    ref = torch.stack(expected) if fixed else torch.cat(expected)
+    if fixed and q_lengths[0] == 1:
+        q, ref = q[:, 0], ref[:, 0]
+    return dict(
+        q=q,
+        k=k.to(dtype),
+        v=v.to(dtype),
+        table=table,
+        lengths=torch.tensor(kv_lengths, dtype=torch.int32, device="cuda"),
+        offsets=torch.tensor(
+            [sum(q_lengths[:i]) for i in range(len(q_lengths) + 1)],
+            dtype=torch.int32,
+            device="cuda",
+        ),
+        reference=ref,
+        output_dtype=torch.float16 if dtype == torch.float8_e4m3fn else dtype,
+        page_size=page_size,
+        scale=scale,
+    )
