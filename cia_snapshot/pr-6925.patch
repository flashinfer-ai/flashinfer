+        (torch.float8_e4m3fn, 128, "fixed", "base2", -1),
+        (torch.float8_e4m3fn, 256, "packed", "basee", -1),
+        (torch.bfloat16, 128, "packed", "base2", 31),
+        (torch.float8_e4m3fn, 128, "paged", "basee", -1),
+        (torch.bfloat16, 256, "paged", "base2", 31),
+    ],
+)
+@pytest.mark.parametrize("with_sinks", (False, True))
+@pytest.mark.parametrize(
+    "model_plan", (False, True), ids=("capacity_plan", "model_plan")
+)
+def test_context_final_lse(dtype, dim, kind, mode, window, with_sinks, model_plan):
+    torch.manual_seed(107)
+    device = "cuda"
+    nq = (129, 129) if kind == "fixed" else (3, 2)
+    nk = (257, 257) if kind == "fixed" else (257, 131)
+    qs = [(torch.randn(n, 8, dim, device=device) * 0.3).to(dtype) for n in nq]
+    ks = [(torch.randn(n, 2, dim, device=device) * 0.3).to(dtype) for n in nk]
+    vs = [torch.randn_like(k.float()).to(dtype) for k in ks]
+    sinks = (
+        torch.tensor(
+            [-torch.inf, -100.0, 0.0, 1.0, 6.0, 12.0, 1000.0, -1000.0], device=device
+        )
+        if with_sinks
+        else None
+    )
+    refs = [
+        _reference(q, k, v, causal=True, window=window, sink=sinks)
+        for q, k, v in zip(qs, ks, vs, strict=False)
+    ]
+    packed = kind != "fixed"
+    q = torch.cat(qs) if packed else torch.stack(qs)
+    ref = (
+        torch.cat([r[0] for r in refs]) if packed else torch.stack([r[0] for r in refs])
+    )
+    expected = (
+        torch.cat([r[1] for r in refs]) if packed else torch.stack([r[1] for r in refs])
+    )
+    if mode == "base2":
+        expected = expected / math.log(2)
+    out_dtype = torch.float16 if dtype == torch.float8_e4m3fn else dtype
+    offsets = torch.tensor([0, nq[0], sum(nq)], device=device, dtype=torch.int32)
+    if kind == "paged":
+        wrapper = context.BatchPrefillPagedTSWrapper(kv_layout="NHD")
+        counts = [(n + 31) // 32 for n in nk]
+        cache = [
+            torch.zeros(sum(counts), 32, 2, dim, device=device, dtype=dtype)
+            for _ in range(2)
+        ]
+        table = torch.full((2, max(counts)), -1, device=device, dtype=torch.int32)
+        cursor = 0
+        for b in range(2):
+            for p in range(counts[b]):
+                valid = min(32, nk[b] - p * 32)
+                table[b, p] = cursor
+                for dest, src in zip(cache, (ks, vs), strict=False):
+                    dest[cursor, :valid] = src[b][p * 32 : p * 32 + valid]
+                cursor += 1
+        args = (
+            q,
+            *cache,
