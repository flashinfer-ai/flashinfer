+@_GPU
+@pytest.mark.parametrize("dtype", (torch.bfloat16, torch.float8_e4m3fn))
+def test_mla_counts_above_128(dtype):
+    sms = device_split_limit(0)
+    if sms <= 128:
+        pytest.skip("Requires more than128 SMs")
+    # Automatic policy selects all152 useful splits at this exact KV-tile count.
