+"""Shared final-LSE output contracts for task-scheduled attention."""
+
+from typing import Literal, cast
+
+import torch
+
+
+def validate_lse_mode(mode: str) -> Literal["none", "base2", "basee"]:
+    if not isinstance(mode, str):
+        raise TypeError("lse_mode must be a string")
+    if mode not in ("none", "base2", "basee"):
+        raise ValueError("lse_mode must be 'none', 'base2', or 'basee'")
+    return cast(Literal["none", "base2", "basee"], mode)
+
+
+def prepare_lse(
+    lse: torch.Tensor | None,
+    *,
+    q: torch.Tensor,
+    mode: str,
+    return_lse: bool,
+    validate: bool,
+) -> torch.Tensor | None:
+    """Bind an independent caller buffer, or allocate the enabled output."""
+    if not isinstance(return_lse, bool):
+        raise TypeError("return_lse must be a bool")
+    if mode == "none":
+        if return_lse or lse is not None:
+            raise ValueError("plan() must enable lse_mode='base2' or 'basee'")
+        return None
+    shape = tuple(q.shape[:-1])
+    if lse is None:
+        return torch.empty(shape, dtype=torch.float32, device=q.device)
+    if validate:
+        if not isinstance(lse, torch.Tensor):
+            raise TypeError("lse must be a torch.Tensor")
+        if lse.dtype != torch.float32 or lse.device != q.device:
+            raise ValueError("lse must be float32 on the query device")
+        if tuple(lse.shape) != shape:
+            raise ValueError(f"lse must have shape {shape}, got {tuple(lse.shape)}")
+        stride = 1
+        for dim in reversed(range(len(shape))):
+            if lse.stride(dim) != stride:
+                raise ValueError("lse must have compact strides")
+            stride *= shape[dim]
+        if lse.data_ptr() % 4:
+            raise ValueError("lse must be 4-byte aligned")
+    return lse
