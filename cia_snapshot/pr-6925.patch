+def test_mla_final_lse(dtype, heads, nq, nk, packed, mode, model_plan):
+    from flashinfer.attention.prims_ts import mla_decode
+    from tests.attention.test_attention_ts_mla_decode import (
+        _make_mla_case,
+        _pack_mla_case,
+    )
+
+    case = _make_mla_case(
+        batch_size=2,
+        num_qo_heads=heads,
+        seq_len_q=nq,
+        max_seq_len=nk,
+        page_size=32,
+        qkv_dtype=dtype,
+        mask_type="causal",
+    )
+    offsets = None
+    if packed:
+        case, offsets = _pack_mla_case(case, (nq, 0))
+    query = case.query
+    wrapper = mla_decode.BatchMLADecodePagedTSWrapper()
+    wrapper.plan(
+        "cuda",
+        None if model_plan else 2,
+        heads,
+        512,
+        64,
+        32,
+        nk,
+        max_seq_len_q=nq,
+        packed_query=packed,
+        q_data_type=dtype,
+        kv_data_type=dtype,
+        o_data_type=torch.bfloat16,
+        lse_mode=mode,
+    )
+    refs = []
+    for b, n in enumerate(case.seq_lens.tolist()):
+        qb = query[int(offsets[b]) : int(offsets[b + 1])] if packed else query[b]
+        pages = case.block_tables[b, : (n + 31) // 32].long()
+        kv = case.kv_cache[pages, 0].reshape(-1, 576)[:n].float()
+        scores = torch.einsum("qhd,kd->qhk", qb.float(), kv) * case.bmm1_scale
+        keys = torch.arange(n, device="cuda")
+        end = torch.arange(qb.shape[0], device="cuda") + n - qb.shape[0]
+        scores.masked_fill_(keys[None, None] > end[:, None, None], -torch.inf)
+        refs.append(torch.logsumexp(scores, -1))
+    expected = torch.cat(refs) if packed else torch.stack(refs)
+    if mode == "base2":
+        expected = expected / math.log(2)
+    # Scalar FP32 LSE stores must accept a 4-byte-aligned offset view.
+    guard = torch.full((expected.numel() + 2,), float("nan"), device="cuda")
+    lse = guard[1:-1].view(expected.shape)
+    out, stats = wrapper.run(
+        query,
+        case.kv_cache,
+        case.block_tables,
+        case.seq_lens,
+        qo_indptr=offsets,
+        bmm1_scale=case.bmm1_scale,
+        bmm2_scale=case.bmm2_scale,
+        max_seq_len_q=nq,
+        max_kv_len=nk,
+        lse=lse,
+        return_lse=True,
+    )
+    assert stats is lse
+    torch.testing.assert_close(lse, expected, atol=0.02, rtol=0.002)
+    assert torch.isnan(guard[0]) and torch.isnan(guard[-1])
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        wrapper.run(
+            query,
+            case.kv_cache,
+            case.block_tables,
+            case.seq_lens,
+            qo_indptr=offsets,
+            bmm1_scale=case.bmm1_scale,
+            bmm2_scale=case.bmm2_scale,
+            out=out,
+            max_seq_len_q=nq,
+            max_kv_len=nk,
+            lse=lse,
+            validate=False,
+        )
+    lse.fill_(float("nan"))
+    graph.replay()
+    torch.testing.assert_close(lse, expected, atol=0.02, rtol=0.002)
