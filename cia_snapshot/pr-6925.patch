+def test_mla_split_activity_long_metadata_prefix(split):
+    """A physical suffix must stay inactive even when its tile origin exceeds int32."""
+    import cutlass
+    import cutlass.cute as cute
+    from cutlass.cute.runtime import from_dlpack
+    from flashinfer.attention.prims_ts.kernels.mla_decode.helpers.tile import (
+        active_split_kv_count,
+        runtime_split_tile_is_active,
+    )
+    from flashinfer.attention.prims_ts.kernels.mla_decode.throughput_latency_1cta.config import (
+        MlaConfig,
+    )
+
+    capacity = 152
+    cfg = MlaConfig(
+        mask_type="dense", use_multi_ctas_kv=int(split), num_ctas_per_seq_kv=capacity
+    )
+    pairs = [
+        (length, count)
+        for length in (0, 1, 127, 128, 129, 4096, 8193, 2**31 - 1024)
+        for count in (1, 2, 3, 11, 16, capacity)
+    ]
+    lengths = torch.tensor([p[0] for p in pairs], device="cuda", dtype=torch.int32)
+    counts = torch.tensor([p[1] for p in pairs], device="cuda", dtype=torch.int32)
+    actual = torch.empty((len(pairs), capacity), device="cuda", dtype=torch.int32)
+
+    @cute.kernel
+    def kernel(lengths: cute.Tensor, counts: cute.Tensor, actual: cute.Tensor):
+        rank, _, _ = cute.arch.thread_idx()
+        row, _, _ = cute.arch.block_idx()
+        if rank < capacity:
+            actual[row, rank] = cutlass.Int32(
+                runtime_split_tile_is_active(
+                    cfg,
+                    lengths,
+                    None,
+                    row,
+                    cutlass.Int32(0),
+                    rank,
+                    requested_splits=counts[row],
+                )
+            )
+
+    @cute.jit
+    def probe(lengths: cute.Tensor, counts: cute.Tensor, actual: cute.Tensor):
+        kernel(lengths, counts, actual).launch(
+            grid=(len(pairs), 1, 1), block=(256, 1, 1)
+        )
+
+    args = tuple(from_dlpack(t) for t in (lengths, counts, actual))
+    compiled = cute.compile(probe, *args)
+    compiled(*args)
+    expected = torch.tensor(
+        [
+            [
+                rank < (active_split_kv_count(length, 128, 2, count) if split else 1)
+                for rank in range(capacity)
+            ]
+            for length, count in pairs
+        ],
+        device="cuda",
+        dtype=torch.int32,
+    )
+    torch.testing.assert_close(actual, expected, rtol=0, atol=0)
