+            *args,
+            out=out,
+            max_seq_len_q=max(nq),
+            max_kv_len=max(nk),
+            lse=lse,
+            validate=False,
+            attention_sinks=sinks,
+        )
+    lse.fill_(float("nan"))
+    graph.replay()
+    torch.testing.assert_close(lse, expected, atol=0.01, rtol=0.001)
+
+    if with_sinks:
+        sinks.fill_(-torch.inf)
+        graph.replay()
+        plain = [
+            _reference(qb, kb, vb, causal=True, window=window)
+            for qb, kb, vb in zip(qs, ks, vs, strict=True)
+        ]
+        plain_lse = (
+            torch.cat([r[1] for r in plain])
+            if packed
+            else torch.stack([r[1] for r in plain])
+        )
+        plain_out = (
+            torch.cat([r[0] for r in plain])
+            if packed
+            else torch.stack([r[0] for r in plain])
+        )
+        if mode == "base2":
+            plain_lse /= math.log(2)
+        torch.testing.assert_close(lse, plain_lse, atol=0.01, rtol=0.001)
+        torch.testing.assert_close(out.float(), plain_out, atol=0.02, rtol=0.05)
