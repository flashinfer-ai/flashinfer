+def _plan_with_workspace(wrapper_type, config, mode, monkeypatch, layout=None):
+    kwargs = {} if layout is None else {"kv_layout": layout}
+    if mode == "query":
+        wrapper = wrapper_type(**kwargs, **config)
+        with monkeypatch.context() as guard:
+            guard.setattr(torch, "empty", _forbid_query)
+            size = wrapper.get_workspace_size()
+        workspace = torch.empty(size, dtype=torch.uint8, device="cuda")
+        wrapper.plan(workspace_buffer=workspace)
+    else:
+        # An existing application-owned arena: no public size query involved.
+        workspace = torch.empty(64 * 1024 * 1024, dtype=torch.int8, device="cuda")
+        if mode == "constructor":
+            wrapper = wrapper_type(**kwargs, **config, workspace_buffer=workspace)
+            monkeypatch.setattr(wrapper, "get_workspace_size", _forbid_query)
+            wrapper.plan()
+        else:
+            wrapper = wrapper_type(**kwargs)
+            monkeypatch.setattr(wrapper, "get_workspace_size", _forbid_query)
+            wrapper.plan(**config, workspace_buffer=workspace)
+    assert wrapper._runtime_plan.workspace.data_ptr() == workspace.data_ptr()
+    assert not wrapper._runtime_plan.owns_workspace
+    return wrapper, workspace
