+            table,
+            torch.tensor(nk, device=device, dtype=torch.int32),
+        )
+        extra = dict(page_size=32)
+    else:
+        wrapper = context.BatchPrefillTSWrapper()
+        k = torch.cat(ks) if packed else torch.stack(ks)
+        v = torch.cat(vs) if packed else torch.stack(vs)
+        args = (
+            (
+                q,
+                k,
+                v,
+                offsets,
+                torch.tensor([0, nk[0], sum(nk)], device=device, dtype=torch.int32),
+            )
+            if packed
+            else (q, k, v)
+        )
+        extra = dict(packed=packed)
+    wrapper.plan(
+        device=device,
+        batch_size=None if model_plan else 2,
+        max_seq_len_q=max(nq),
+        max_kv_len=max(nk),
+        num_qo_heads=8,
+        num_kv_heads=2,
+        head_dim=dim,
+        q_dtype=dtype,
+        k_dtype=dtype,
+        out_dtype=out_dtype,
