+"""Cross-layer dispatch reuse, resource isolation and bounded concurrent caching."""
+
+from concurrent.futures import ThreadPoolExecutor
+from dataclasses import dataclass
+import gc
+import threading
+import weakref
+
+import pytest
+import torch
+
+pytest.importorskip("cutlass", minversion="4.7.0")
+
+from flashinfer.attention.prims_ts import (
+    BatchDecodePagedTSWrapper,
+    BatchMLADecodePagedTSWrapper,
+    BatchPrefillTSWrapper,
+    BatchPrefillPagedTSWrapper,
+)
+from flashinfer.attention.prims_ts._policy_cache import (
+    PolicyCache,
+    SharedPolicy,
+    policy_key,
+    shared_policy_cache,
+)
+from tests.attention.test_attention_ts_decode import (
+    _make_decode_case,
+    _pack_decode_case,
+    _assert_case_correct as _check_decode,
+)
+from tests.attention.test_attention_ts_mla_decode import (
+    _make_mla_case,
+    _pack_mla_case,
+    _assert_case_correct as _check_mla,
+)
+from tests.attention.test_attention_ts_context import (
+    _make_context_case,
+    _make_paged_context_case,
+    _make_native_paged_metadata,
+    _assert_context_correct,
+)
+
+_GPU = pytest.mark.skipif(
+    not torch.cuda.is_available() or torch.cuda.get_device_capability()[0] != 10,
+    reason="Requires an SM100-family device",
+)
+
+
+@dataclass(frozen=True)
+class _State:
+    value: object
+    buffer: object = None
+
+
+def _record(value):
+    return SharedPolicy.from_state(_State(value), frozenset(("buffer",)))
+
+
+def test_cpu_shared_policy_is_bounded_and_retries_failed_builds():
+    cache = PolicyCache(maxsize=2)
+    a, b, c = _record(1), _record(2), _record(3)
+    assert cache.get_or_create((1,), lambda: a) is a
+    cache.get_or_create((2,), lambda: b)
+    assert cache.get_or_create((1,), lambda: b) is a
+    cache.get_or_create((3,), lambda: c)
+    assert cache.peek((2,)) is None and cache.cache_info().currsize == 2
+    with pytest.raises(RuntimeError, match="builder failed"):
+        cache.get_or_create(
+            (4,), lambda: (_ for _ in ()).throw(RuntimeError("builder failed"))
+        )
+    assert cache.peek((4,)) is None
+    assert cache.get_or_create((4,), lambda: a) is a
+
+
+def test_cpu_shared_policy_has_one_concurrent_builder():
+    cache = PolicyCache()
+    entered, release = threading.Event(), threading.Event()
+    calls = []
+    policy = _record(7)
+
+    def create():
+        calls.append(1)
+        entered.set()
+        assert release.wait(10)
+        return policy
+
+    with ThreadPoolExecutor(max_workers=4) as pool:
+        first = pool.submit(cache.get_or_create, (1,), create)
+        assert entered.wait(10)
+        rest = [pool.submit(cache.get_or_create, (1,), create) for _ in range(3)]
+        with pytest.raises(RuntimeError, match="active builders"):
+            cache.cache_clear()
+        release.set()
+        assert all(result.result(10) is policy for result in (first, *rest))
+    assert len(calls) == 1
+    assert cache.cache_info().misses == 1 and cache.cache_info().hits == 3
+
+
+def test_cpu_shared_policy_drops_bindings_and_copies_mutable_config():
+    @dataclass
+    class Config:
+        tile: int
+
+    @dataclass(frozen=True)
+    class State:
+        config: Config
+        buffer: torch.Tensor
+
+    tensor = torch.empty(1)
+    original = State(Config(32), tensor)
+    with pytest.raises(TypeError, match="retain tensors"):
+        SharedPolicy.from_state(original, frozenset())
+    policy = SharedPolicy.from_state(original, frozenset(("buffer",)))
+    original.config.tile = 64
+    rebound = policy.bind(buffer=tensor)
+    assert rebound.config.tile == 32
+    rebound.config.tile = 128
+    assert policy.bind(buffer=tensor).config.tile == 32
+    with pytest.raises(TypeError):
+        policy.values["config"] = Config(16)
+
+
+def test_cpu_policy_key_keeps_all_dispatch_features():
+    base = dict(
+        device=torch.device("cuda:0"),
+        head_dim=128,
+        q_dtype=torch.bfloat16,
+        packed_query=True,
+        mask_type="causal",
+        lse_mode="none",
+        validate=True,
+    )
+    key = policy_key("decode", base, (2, 3, 513), "NHD")
+    for name, value in (
+        ("device", torch.device("cuda:1")),
+        ("head_dim", 256),
+        ("q_dtype", torch.float8_e4m3fn),
+        ("packed_query", False),
+        ("mask_type", "dense"),
+        ("lse_mode", "basee"),
+        ("validate", False),
+    ):
+        assert policy_key("decode", {**base, name: value}, (2, 3, 513), "NHD") != key
+    assert policy_key("decode", base, (3, 3, 513), "NHD") != key
+    assert policy_key("decode", base, (2, 3, 513), "HND") != key
+    assert policy_key("context", base, (2, 3, 513), "NHD") != key
+    assert (
+        policy_key(
+            "decode",
+            {
+                **base,
+                "sm_scale": 0.2,
+                "output_scale": 0.5,
+                "workspace_buffer": torch.empty(1),
+            },
+            (2, 3, 513),
+            "NHD",
+        )
+        == key
+    )
+    assert policy_key("decode", {**base, "head_dim": 1}, (2, 3, 513)) != policy_key(
+        "decode", {**base, "head_dim": True}, (2, 3, 513)
+    )
+    with pytest.raises(TypeError, match="keys cannot retain tensors"):
+        policy_key("decode", {**base, "head_dim": torch.tensor(128)}, (2, 3, 513))
+
+
+@dataclass
+class Layer:
+    wrapper: object
+    run: object
+    check: object
+
+
+def make_layer(family, dtype, seed, output_scale=0.75):
+    """Construct independent layer data and resources for tests and timing."""
+    output_dtype = torch.float16 if dtype == torch.float8_e4m3fn else dtype
+    if family == "decode":
+        case = _make_decode_case(
+            kv_lens=(513, 257),
+            num_qo_heads=8,
+            num_kv_heads=2,
+            head_dim=128,
+            seq_len_q=3,
+            page_size=32,
+            qkv_dtype=dtype,
+            output_dtype=output_dtype,
+            cache_form="tuple",
+            mask_type="causal",
+            device="cuda",
+            seed=seed,
+        )
+        case, offsets = _pack_decode_case(case, (3, 1))
+        cache = tuple(t.transpose(1, 2).contiguous() for t in case.paged_kv_cache)
+        lengths = torch.tensor((513, 257), dtype=torch.int32, device="cuda")
+        wrapper = BatchDecodePagedTSWrapper(
+            "NHD",
+            device="cuda",
+            num_qo_heads=8,
+            num_kv_heads=2,
+            head_dim=128,
+            page_size=32,
+            q_data_type=dtype,
+            o_data_type=output_dtype,
+            packed_query=True,
+            mask_type="causal",
+        )
+        wrapper.plan()
+
+        def run(out=None, validate=True, max_kv_len=513):
+            return wrapper.run(
+                case.q,
+                cache,
+                lengths,
+                case.block_tables,
+                qo_indptr=offsets,
+                max_seq_len_q=3,
+                max_kv_len=max_kv_len,
+                out=out,
+                validate=validate,
+                bmm1_scale=case.bmm1_scale,
+                bmm2_scale=case.bmm2_scale,
+            )
+
+        return Layer(wrapper, run, lambda out: _check_decode(out, case))
+    if family == "mla":
+        case = _make_mla_case(
+            batch_size=2,
+            num_qo_heads=129,
+            max_seq_len=513,
+            seq_len_q=3,
+            qkv_dtype=dtype,
+            seed=seed,
+        )
+        case, offsets = _pack_mla_case(case, (3, 1))
+        wrapper = BatchMLADecodePagedTSWrapper(
+            device="cuda",
+            num_heads=129,
+            kv_lora_rank=512,
+            qk_rope_head_dim=64,
+            page_size=32,
+            q_data_type=dtype,
+            kv_data_type=dtype,
+            o_data_type=torch.bfloat16,
+            packed_query=True,
+        )
+        wrapper.plan()
+
+        def run(out=None, validate=True, max_kv_len=513):
+            return wrapper.run(
+                case.query,
+                case.kv_cache,
+                case.block_tables,
+                case.seq_lens,
+                qo_indptr=offsets,
+                max_seq_len_q=3,
+                max_kv_len=max_kv_len,
+                bmm1_scale=case.bmm1_scale,
+                bmm2_scale=case.bmm2_scale,
+                out=out,
+                validate=validate,
+            )
+
+        return Layer(
+            wrapper,
+            run,
+            lambda out: _check_mla(
+                out, case, dict(wrapper._plan_state.policy), qo_indptr=offsets
+            ),
+        )
+    common = dict(
+        q_lengths=(1, 33, 1, 9),
+        k_lengths=(65, 257, 129, 513),
+        num_qo_heads=4,
+        num_kv_heads=2,
+        head_dim=128,
+        output_dtype=output_dtype,
+        mask_type="dense",
+        seed=seed,
+        output_scale=output_scale,
+    )
+    config = dict(
+        device="cuda",
+        num_qo_heads=4,
+        num_kv_heads=2,
+        head_dim=128,
+        q_dtype=dtype,
+        k_dtype=dtype,
+        out_dtype=output_dtype,
+        output_scale=output_scale,
+    )
+    if family == "context":
+        case = _make_context_case(**common, qkv_dtype=dtype, packed=True)
+        wrapper = BatchPrefillTSWrapper(**config, packed=True)
+        wrapper.plan()
+
+        def run(out=None, validate=True, max_kv_len=513):
+            return wrapper.run(
+                case.q,
+                case.k,
+                case.v,
+                case.qo_indptr,
+                case.kv_indptr,
+                max_seq_len_q=33,
+                max_kv_len=max_kv_len,
+                out=out,
+                validate=validate,
+            )
+
+        return Layer(wrapper, run, lambda out: _assert_context_correct(out, case))
+    case = _make_paged_context_case(**common, qk_dtype=dtype, page_size=32)
+    metadata = _make_native_paged_metadata(case)
+    cache = tuple(t.transpose(1, 2).contiguous() for t in (case.k_cache, case.v_cache))
+    wrapper = BatchPrefillPagedTSWrapper("NHD", **config, page_size=32)
+    wrapper.plan()
+
+    def run(out=None, validate=True, max_kv_len=513):
+        return wrapper.run(
+            case.reference.q,
+            *cache,
+            metadata.qo_indptr,
+            metadata.block_tables,
+            metadata.seq_lens_kv,
+            max_seq_len_q=33,
+            max_kv_len=max_kv_len,
+            out=out,
+            validate=validate,
+        )
+
+    return Layer(wrapper, run, lambda out: _assert_context_correct(out, case.reference))
+
+
+@_GPU
+@pytest.mark.parametrize("family", ("decode", "mla", "context", "paged_context"))
+@pytest.mark.parametrize("dtype", (torch.bfloat16, torch.float8_e4m3fn))
+def test_layers_share_policy_with_independent_bindings(family, dtype):
+    shared_policy_cache.cache_clear()
+    layers = [
+        make_layer(family, dtype, 93000 + i, output_scale=0.75 - i * 0.125)
+        for i in range(3)
+    ]
+    outputs = []
+    for layer in layers:
+        output = layer.run()
+        layer.check(output)
+        outputs.append(output)
+    info = shared_policy_cache.cache_info()
+    assert (info.misses, info.hits, info.currsize) == (1, 2, 1)
+    states = [layer.wrapper._plan_state for layer in layers]
+    if family in ("decode", "mla"):
+        assert len({state.workspace_buffer.data_ptr() for state in states}) == 3
+    else:
+        assert len({state.output_scale.data_ptr() for state in states}) == 3
+    out = torch.empty_like(outputs[-1])
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        layers[-1].run(out=out, validate=False)
+    shared_policy_cache.cache_clear()
+    graph.replay()
+    torch.cuda.synchronize()
+    layers[-1].check(out)
+    assert shared_policy_cache.cache_info().currsize == 0
+
+
+@_GPU
+@pytest.mark.parametrize("family", ("decode", "mla", "context", "paged_context"))
+def test_shared_policy_does_not_retain_layer_storage(family):
+    shared_policy_cache.cache_clear()
+    layer = make_layer(family, torch.bfloat16, 93010)
+    layer.run()
+    state = layer.wrapper._plan_state
+    tensor = (
+        state.workspace_buffer if family in ("decode", "mla") else state.output_scale
+    )
+    owner = weakref.ref(tensor)
+    del tensor, state, layer
+    torch.cuda.synchronize()
+    gc.collect()
+    assert owner() is None
+    assert shared_policy_cache.cache_info().currsize == 1
