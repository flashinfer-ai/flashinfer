+            paged_kv_cache=(torch.empty((8, 2, 32, 128), dtype=torch.bfloat16),) * 2,
+        )
+    if bound_source == "run":
+        kwargs["max_seq_len_q"] = 3
+
+    def reject_readback(*_args, **_kwargs):
+        raise AssertionError("tracing must not read packed offsets")
+
+    monkeypatch.setattr(torch.Tensor, "item", reject_readback)
