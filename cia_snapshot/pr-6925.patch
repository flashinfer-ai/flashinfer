+wrapper = BatchDecodePagedTSWrapper(
+    "NHD", device="cuda", num_qo_heads=32, num_kv_heads=4,
+    head_dim=128, page_size=32, q_data_type=torch.bfloat16,
+    packed_query=True, mask_type="causal",
+)
+workspace = torch.empty(
+    wrapper.get_workspace_size(), dtype=torch.uint8, device="cuda"
+)
+wrapper.plan(workspace_buffer=workspace)
+```
