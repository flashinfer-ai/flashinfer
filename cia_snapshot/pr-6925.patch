+        lse_mode=mode,
+        **extra,
+        use_attention_sinks=with_sinks,
+    )
+    # Guard both ends of the caller buffer against partial/paired tile writes.
+    guard = torch.full((q.numel() // dim + 2,), float("nan"), device=device)
+    lse = guard[1:-1].view(q.shape[:-1])
+    out = torch.empty_like(q, dtype=out_dtype)
+    result, stats = wrapper.run(
+        *args,
+        out=out,
+        max_seq_len_q=max(nq),
+        max_kv_len=max(nk),
+        lse=lse,
+        return_lse=True,
+        attention_sinks=sinks,
+    )
