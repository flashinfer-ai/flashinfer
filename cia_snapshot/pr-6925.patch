+def _reference(q, k, v, *, causal, window=-1, sink=None):
+    heads = q.shape[-2]
+    k = k.float().repeat_interleave(heads // k.shape[-2], -2)
+    v = v.float().repeat_interleave(heads // v.shape[-2], -2)
+    scores = torch.einsum("qhd,khd->qhk", q.float(), k) / math.sqrt(q.shape[-1])
+    if causal:
+        positions = torch.arange(q.shape[0], device=q.device) + k.shape[0] - q.shape[0]
+        keys = torch.arange(k.shape[0], device=q.device)
+        visible = keys[None] <= positions[:, None]
+        if window >= 0:
+            visible &= keys[None] >= positions[:, None] - window
+        scores.masked_fill_(~visible[:, None], -torch.inf)
+    lse = torch.logsumexp(scores, -1)
+    if sink is not None:
+        lse = torch.logaddexp(lse, sink[None])
+    weights = torch.exp(scores - lse[..., None])
+    return torch.einsum("qhk,khd->qhd", weights, v), lse
+
+
+@_GPU
+@pytest.mark.parametrize(
+    "dtype,dim,kind,mode,window",
