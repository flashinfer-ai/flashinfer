+def test_2cta_explicit_capacity_and_compile_reuse(
+    dtype, capacity, counts, kv, persistent
+):
+    """R4 small scratch and >128 reference reduction use the same runtime ABI."""
+    from flashinfer.attention.prims_ts.kernels.mla_decode.throughput_2cta.kernel import (
+        MlaDecodeTs,
+    )
+    from flashinfer.attention.prims_ts.kernels.mla_decode.throughput_2cta.config import (
+        compute_workspace_size,
+    )
+    import cutlass
+
+    sms = device_split_limit(0)
+    if capacity > sms:
+        pytest.skip("Requires at least152 SMs")
+    case = _make_mla_case(
+        batch_size=1, num_qo_heads=128, max_seq_len=kv, qkv_dtype=dtype
+    )
+    wrapper = mla_decode.BatchMLADecodePagedTSWrapper()
+    wrapper.plan(
+        "cuda",
+        1,
+        128,
+        512,
+        64,
+        32,
+        kv,
+        max_seq_len_q=1,
+        packed_query=False,
+        q_data_type=dtype,
+        kv_data_type=dtype,
+        o_data_type=torch.bfloat16,
+        lse_mode="base2",
+    )
+    original = wrapper._plan_state
+    kernel = MlaDecodeTs(
+        max_active_clusters=sms // 2,
+        page_size=32,
+        is_persistent=persistent,
+        static_split_kv=None,
+        split_kv_capacity=capacity,
+        qkv_dtype="bf16" if dtype == torch.bfloat16 else "e4m3",
+        out_dtype="bf16",
+        num_heads=128,
+        seq_len_q=1,
+        batch_size=1,
+    )
+    assert kernel.reduction_split_capacity == capacity
+    if not persistent:
+        assert kernel._parallel_reduction_shape_is_eligible
+    kernel_bytes = compute_workspace_size(
+        tile_size_q=128,
+        num_q_tiles=1,
+        latent_dim=512,
+        batch_size=1,
+        split_kv=capacity,
+        partial_o_dtype=cutlass.BFloat16,
+        lse_dtype=cutlass.Float32,
+    )
+    launch = mla_decode._MLADecodeLaunchSpec(
+        kernel=kernel,
+        policy=original.policy,
+        kernel_workspace_bytes=kernel_bytes,
+        split_kv=counts[0],
+    )
+    kwargs = dict(
+        device_index=0,
+        num_heads=128,
+        kv_lora_rank=512,
+        qk_rope_head_dim=64,
+        page_size=32,
+        q_dtype_key=mla_decode._dtype_key(dtype),
+        output_dtype_key="bfloat16",
+        max_seq_len_q=1,
+        packed_query=False,
+        lse_mode="base2",
+    )
+    compiled = mla_decode._get_compiled_mla_decode(
+        mla_decode._make_mla_decode_compile_spec(launch, **kwargs)
+    )
+    # Changing the count alone neither changes identity nor compiles a reducer.
+    again = mla_decode._get_compiled_mla_decode(
+        mla_decode._make_mla_decode_compile_spec(
+            replace(launch, split_kv=counts[1]), **kwargs
+        )
+    )
+    assert again is compiled
+    layout = mla_decode._make_mla_workspace_layout(kernel_bytes, 1, 128, 1)
+    buffer = torch.empty(layout.total_bytes, device="cuda", dtype=torch.int8)
+    views = mla_decode._bind_mla_workspace(buffer, layout)
+    state = replace(
+        original,
+        workspace_layout=layout,
+        workspace_buffer=buffer,
+        workspace_views=views,
+        compiled=compiled,
+    )
+    if capacity == 4:
+        old_bytes = compute_workspace_size(
+            tile_size_q=128,
+            num_q_tiles=1,
+            latent_dim=512,
+            batch_size=1,
+            split_kv=128,
+            partial_o_dtype=cutlass.BFloat16,
+            lse_dtype=cutlass.Float32,
+        )
+        assert kernel_bytes * 32 == old_bytes
+    for count in counts:
+        buffer.fill_(-1)
+        wrapper._plan_state = replace(state, split_kv=count)
+        out, lse = wrapper.run(
+            case.query,
+            case.kv_cache,
+            case.block_tables,
+            case.seq_lens,
+            bmm1_scale=case.bmm1_scale,
+            bmm2_scale=case.bmm2_scale,
+            return_lse=True,
+        )
+        ref = _mla_reference(case, num_insts_kv=1, tile_size_kv=128, splits_kv=count)
+        rtol, atol = _mla_tolerances(dtype)
+        torch.testing.assert_close(out.float(), ref, rtol=rtol, atol=atol)
+        assert torch.isfinite(lse).all()
+        if capacity == 4:
+            partial_o_bytes = 128 * capacity * 512 * 2
+            partial_lse = (
+                views.kernel_workspace[partial_o_bytes:kernel_bytes]
+                .view(torch.float32)
+                .view(128, capacity)
+            )
+            assert torch.isfinite(partial_lse[:, :count]).all()
+            assert torch.isnan(partial_lse[:, count:]).all()
