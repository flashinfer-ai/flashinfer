index 0000000000000000000000000000000000000000..f19879f89e277803d8271512fadeaee6669ce722
--- /dev/null
+++ b/flashinfer/attention/prims_ts/_policy_cache.py
@@ -0,0 +1,165 @@
+# Copyright (c) 2026 by FlashInfer team.
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at http://www.apache.org/licenses/LICENSE-2.0
+
+"""Shared dispatch records; all tensor storage stays with its owning wrapper."""
+
+from collections import OrderedDict, namedtuple
+from collections.abc import Callable, Mapping
+import copy
+from dataclasses import dataclass, fields, is_dataclass
+import threading
+from types import MappingProxyType
+from typing import Any
+
+import torch
+
+
+PolicyCacheInfo = namedtuple("PolicyCacheInfo", "hits misses maxsize currsize")
+_BINDING_OPTIONS = frozenset(
+    (
+        "batch_size",
+        "max_seq_len_q",
+        "max_kv_len",
+        "workspace_buffer",
+        "seq_lens",
+        "initialize_workspace",
+        "sm_scale",
+        "output_scale",
+    )
+)
+
+
+def policy_key(family: str, options: Mapping, problem: tuple, layout=None) -> tuple:
+    """Use effective problem bounds and typed, normalized model options.
+
+    Validation mode remains part of the key so a trusted plan cannot bypass
+    another wrapper's static validation. Scale values are layer-owned inputs.
+    """
+    model = []
+    for name, value in sorted(options.items()):
+        if name in _BINDING_OPTIONS:
+            continue
+        if isinstance(value, torch.Tensor):
+            raise TypeError("shared attention policy keys cannot retain tensors")
+        model.append((name, type(value), value))
+    return family, layout, problem, tuple(model)
+
+
+def _host_only(value: Any) -> None:
+    if isinstance(value, torch.Tensor):
+        raise TypeError("shared attention policies cannot retain tensors")
+    if is_dataclass(value) and not isinstance(value, type):
+        for field in fields(value):
+            _host_only(getattr(value, field.name))
+    elif isinstance(value, (tuple, list)):
+        for item in value:
+            _host_only(item)
+    elif isinstance(value, Mapping):
+        for item in value.values():
+            _host_only(item)
+
+
+def _copy_mutable_record(value: Any) -> Any:
+    params = getattr(type(value), "__dataclass_params__", None)
+    return copy.copy(value) if params is not None and not params.frozen else value
+
+
+@dataclass(frozen=True)
+class SharedPolicy:
+    state_type: type
+    values: Mapping
+
+    @classmethod
+    def from_state(cls, state: Any, excluded: frozenset[str]) -> "SharedPolicy":
+        values = {
+            field.name: _copy_mutable_record(getattr(state, field.name))
+            for field in fields(state)
+            if field.name not in excluded
+        }
+        _host_only(values)
+        return cls(type(state), MappingProxyType(values))
+
+    def bind(self, **bindings) -> Any:
+        values = {
+            name: _copy_mutable_record(value) for name, value in self.values.items()
+        }
+        return self.state_type(**values, **bindings)
+
+
+class PolicyCache:
+    """Bounded process-local LRU with one builder per key on concurrent misses."""
+
+    def __init__(self, maxsize: int = 512):
+        if maxsize <= 0:
+            raise ValueError("policy cache size must be positive")
+        self.maxsize = maxsize
+        self._entries: OrderedDict[tuple, SharedPolicy] = OrderedDict()
+        self._pending: dict[tuple, threading.Event] = {}
+        self._lock = threading.Lock()
+        self._hits = self._misses = 0
+
+    def peek(self, key: tuple) -> SharedPolicy | None:
+        with self._lock:
+            return self._entries.get(key)
+
+    def get_or_create(
+        self, key: tuple, factory: Callable[[], SharedPolicy]
+    ) -> SharedPolicy:
+        while True:
+            with self._lock:
+                if key in self._entries:
+                    self._hits += 1
+                    self._entries.move_to_end(key)
+                    return self._entries[key]
+                event = self._pending.get(key)
+                if event is None:
+                    event = threading.Event()
+                    self._pending[key] = event
+                    self._misses += 1
+                    break
+            event.wait()
+        try:
+            policy = factory()
+        except BaseException:
+            with self._lock:
+                self._pending.pop(key).set()
+            raise
+        with self._lock:
+            self._entries[key] = policy
+            while len(self._entries) > self.maxsize:
+                self._entries.popitem(last=False)
+            self._pending.pop(key).set()
+        return policy
+
+    def cache_info(self):
+        with self._lock:
+            return PolicyCacheInfo(
+                self._hits, self._misses, self.maxsize, len(self._entries)
+            )
+
+    def cache_clear(self):
+        with self._lock:
+            if self._pending:
+                raise RuntimeError("cannot clear a policy cache with active builders")
+            self._entries.clear()
+            self._hits = self._misses = 0
+
+
+shared_policy_cache = PolicyCache()
+
+
+def reuse_policy(
+    key: tuple, create: Callable, bind: Callable, excluded: frozenset[str]
+) -> Any:
+    """Prepare once, then bind each layer's own resources to the cached record."""
+    first_child = None
+
+    def resolve():
+        nonlocal first_child
+        first_child = create()
+        return SharedPolicy.from_state(first_child._plan_state, excluded)
+
+    policy = shared_policy_cache.get_or_create(key, resolve)
+    return first_child if first_child is not None else bind(policy)
