+def test_constructor_configuration_is_allocation_free(wrapper_type, monkeypatch):
+    def forbidden(*args, **kwargs):
+        raise AssertionError("constructor allocated execution resources")
+
+    monkeypatch.setattr(torch, "empty", forbidden)
+    monkeypatch.setattr(torch, "tensor", forbidden)
+    wrapper_type(device="cuda", mask_type="causal")
+    with pytest.raises(TypeError, match="unexpected keyword"):
