+"""Numerical and storage contracts for native HND/NHD PrimTS caches."""
+
+import math
+
+import pytest
+import torch
+
+pytest.importorskip("cutlass", minversion="4.7.0")
+
+from flashinfer.attention.prims_ts import context, decode
+from flashinfer.trace.templates.attention import (
+    attention_ts_decode_trace_dispatch,
+    prims_ts_decode_wrapper_trace_dispatch,
+)
+
