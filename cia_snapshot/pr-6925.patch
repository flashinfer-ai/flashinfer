+
+"""Per-head synthetic zero-value attention sink contracts."""
+
+import torch
+
+
+def prepare_attention_sinks(sinks, *, q, enabled, validate):
+    if enabled != (sinks is not None):
+        raise ValueError(
+            "attention_sinks must be supplied exactly when plan(use_attention_sinks=True)"
+        )
+    if sinks is not None and validate:
+        if not isinstance(sinks, torch.Tensor):
+            raise TypeError("attention_sinks must be a torch.Tensor")
+        if sinks.dtype != torch.float32 or sinks.device != q.device:
+            raise ValueError("attention_sinks must be float32 on the query device")
+        if tuple(sinks.shape) != (q.shape[-2],) or sinks.stride(0) != 1:
+            raise ValueError(
+                "attention_sinks must be a compact vector of num_qo_heads elements"
+            )
+        if sinks.data_ptr() % 4:
+            raise ValueError("attention_sinks must be 4-byte aligned")
+        if not bool((torch.isfinite(sinks) | torch.isneginf(sinks)).all().item()):
+            raise ValueError("attention_sinks may contain only finite values or -inf")
+    return sinks
