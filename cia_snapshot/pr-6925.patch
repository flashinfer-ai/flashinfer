+"""Private runtime fanout, shared scratch capacities and reducer reuse."""
+
+from dataclasses import replace
+import math
+import pytest
+import torch
+
+pytest.importorskip("cutlass", minversion="4.7.0")
+from flashinfer.attention.prims_ts import decode, mla_decode
+from flashinfer.attention.prims_ts._split_kv import split_capacity, device_split_limit
+from tests.attention.test_attention_ts_mla_decode import (
+    _make_mla_case,
+    _mla_reference,
+    _mla_tolerances,
+)
+from tests.attention.test_attention_ts_layouts import _make_case, _assert_result
+from tests.attention.test_attention_ts_lse import _reference
+
+_GPU = pytest.mark.skipif(
+    not torch.cuda.is_available() or torch.cuda.get_device_capability()[0] != 10,
+    reason="Requires an SM100-family device",
+)
+
+
+def test_private_capacity_respects_hardware_bound():
+    for sms in (8, 120, 152, 192):
+        for bound in range(1, sms + 1):
+            capacity = split_capacity(bound, sms)
+            assert bound <= capacity <= sms
+        assert split_capacity(sms + 100, sms) == sms
+    assert split_capacity(129, 152) > 128
+
+
+@_GPU
+@pytest.mark.parametrize("dtype", (torch.bfloat16, torch.float8_e4m3fn))
+@pytest.mark.parametrize(
+    "heads,batch,kv,family,reducer",
+    [
+        (16, 1, 4096, "throughput_latency_1cta", "none"),
+        (32, 1, 8192, "throughput_latency_1cta", "parallel"),
+        (64, 1, 19456, "throughput_latency_1cta", "parallel"),
+        (128, 2, 8192, "throughput_2cta", "reference"),
+        (128, 1, 8192, "throughput_2cta", "parallel"),
+    ],
+)
+def test_mla_runtime_count_changes(dtype, heads, batch, kv, family, reducer):
+    case = _make_mla_case(
+        batch_size=batch, num_qo_heads=heads, max_seq_len=kv, qkv_dtype=dtype
+    )
+    wrapper = mla_decode.BatchMLADecodePagedTSWrapper()
+    wrapper.plan(
+        "cuda",
+        batch,
+        heads,
+        512,
+        64,
+        32,
+        kv,
+        max_seq_len_q=1,
+        packed_query=False,
+        q_data_type=dtype,
+        kv_data_type=dtype,
+        o_data_type=torch.bfloat16,
+        lse_mode="base2",
+    )
+    state = wrapper._plan_state
+    policy = dict(state.policy)
+    assert policy["kernel"] == family and policy["separate_reducer_impl"] == reducer
+    capacity = policy["split_capacity"]
+    assert capacity <= device_split_limit(0)
+    compiled = state.compiled
+    misses = mla_decode._get_compiled_mla_decode.cache_info().misses
+    out = torch.empty(
+        (*case.query.shape[:-1], 512), device="cuda", dtype=torch.bfloat16
+    )
+    lse = torch.empty(case.query.shape[:-1], device="cuda")
+    # Reuse the same compiled callable/scratch for increasing and decreasing counts.
+    for count in (
+        *[n for n in (1, 2, 3, 4, 8, 16, 17, 32) if n <= capacity],
+        capacity,
+        2,
+    ):
+        wrapper._plan_state = replace(state, split_kv=count)
+        scratch = state.workspace_views.kernel_workspace
+        if scratch is not None:
+            scratch.fill_(-1)
+        result, stats = wrapper.run(
+            case.query,
+            case.kv_cache,
+            case.block_tables,
+            case.seq_lens,
+            bmm1_scale=case.bmm1_scale,
+            bmm2_scale=case.bmm2_scale,
+            out=out,
+            lse=lse,
+            return_lse=True,
+        )
+        expected = _mla_reference(
+            case, num_insts_kv=policy["num_insts_kv"], tile_size_kv=128, splits_kv=count
+        )
+        rtol, atol = _mla_tolerances(dtype)
+        torch.testing.assert_close(result.float(), expected, rtol=rtol, atol=atol)
+        assert torch.isfinite(stats).all()
+        assert wrapper._plan_state.compiled is compiled
+    assert mla_decode._get_compiled_mla_decode.cache_info().misses == misses
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        wrapper.run(
+            case.query,
+            case.kv_cache,
+            case.block_tables,
+            case.seq_lens,
+            bmm1_scale=case.bmm1_scale,
+            bmm2_scale=case.bmm2_scale,
+            out=out,
+            lse=lse,
+            validate=False,
+        )
+    graph.replay()
+    torch.testing.assert_close(out.float(), expected, rtol=rtol, atol=atol)
+
+    # Graph-live shorter lengths must contract the useful prefix and ignore
+    # previously published partials beyond it without host policy/JIT work.
+    case.seq_lens.clamp_(max=129)
+    graph.replay()
+    shortened = _mla_reference(
+        case, num_insts_kv=policy["num_insts_kv"], tile_size_kv=128, splits_kv=2
+    )
+    torch.testing.assert_close(out.float(), shortened, rtol=rtol, atol=atol)
+    assert mla_decode._get_compiled_mla_decode.cache_info().misses == misses
+
+
+@_GPU
+@pytest.mark.parametrize("dtype", (torch.bfloat16, torch.float8_e4m3fn))
+@pytest.mark.parametrize("heads", (32, 128))
+def test_fmha_runtime_count_changes(dtype, heads):
+    case = _make_case(
+        dtype, 128, (1,), fixed=True, heads=heads, kv_heads=1, kv_lengths=(8192,)
+    )
+    wrapper = decode.BatchDecodePagedTSWrapper()
+    wrapper.plan(
+        "cuda",
+        1,
+        heads,
+        1,
+        128,
+        32,
+        8192,
+        q_data_type=dtype,
+        o_data_type=case["output_dtype"],
+        mask_type="causal",
+        lse_mode="base2",
+    )
+    state = wrapper._plan_state
+    assert state.config.use_split_kv
+    assert state.config.runtime_split_kv
+    capacity = state.config.splits_kv
+    out = torch.empty_like(case["q"], dtype=case["output_dtype"])
+    lse = torch.empty(case["q"].shape[:-1], device="cuda")
+    before = decode._get_compiled_decode.cache_info().misses
+    for count in (
+        *[n for n in (1, 2, 3, 4, 7, 8, 9, 11, 16, 17, 32) if n <= capacity],
+        capacity,
+        2,
+    ):
+        wrapper._plan_state = replace(state, requested_splits=count)
+        state.workspace.partial_stats.fill_(torch.nan)
+        state.workspace.partial_o.fill_(torch.nan)
+        wrapper.run(
+            case["q"],
+            (case["k"], case["v"]),
+            case["lengths"],
+            case["table"],
+            out=out,
+            lse=lse,
+            bmm2_scale=0.75,
+        )
+        torch.testing.assert_close(
+            out.float(),
+            case["reference"],
+            rtol=0.05,
+            atol=0.02,
+            msg=lambda m: f"runtime count={count}, capacity={capacity}: {m}",
+        )
+        _assert_result(out, case)
+        assert torch.isfinite(lse).all()
+    assert decode._get_compiled_decode.cache_info().misses == before
+
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        wrapper.run(
+            case["q"],
+            (case["k"], case["v"]),
+            case["lengths"],
+            case["table"],
+            out=out,
+            lse=lse,
+            bmm2_scale=0.75,
+            validate=False,
+        )
+    case["lengths"].fill_(129)
+    graph.replay()
+    pages = case["table"][0, :5].long()
+    k, v = [
+        c[pages].transpose(1, 2).reshape(-1, 1, 128)[:129]
+        for c in (case["k"], case["v"])
+    ]
+    expected, expected_lse = _reference(case["q"], k, v, causal=True)
+    torch.testing.assert_close(out.float(), expected * 0.75, rtol=0.05, atol=0.02)
+    relative_l2 = (out.float() - expected * 0.75).norm() / (expected * 0.75).norm()
+    assert float(relative_l2) < (0.01 if dtype == torch.bfloat16 else 0.05)
+    torch.testing.assert_close(lse, expected_lse / math.log(2), atol=0.015, rtol=0.002)
+    assert decode._get_compiled_decode.cache_info().misses == before
+
