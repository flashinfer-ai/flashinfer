+# ``#if CAKE_BGMV_MOE_CC_MAJOR == 9`` (sm_90a) / ``>= 10`` (sm_100a and later).
+_CC_IF_RE = re.compile(r"#if CAKE_BGMV_MOE_CC_MAJOR (==|>=) (\d+)$")
