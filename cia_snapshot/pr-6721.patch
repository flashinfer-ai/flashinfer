+        "mov.b32 {$w1}, v01;\n            mov.b32 {$w2}, v23;"
+        if init
+        else "fma.rn.f16x2 {$w1}, v01, one2, {$r4};\n"
+        "            fma.rn.f16x2 {$w2}, v23, one2, {$r5};"
+    )
