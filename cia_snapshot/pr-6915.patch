diff --git a/tests/experimental/b12x/comm/formal/twoshot.qnt b/tests/experimental/b12x/comm/formal/twoshot.qnt
new file mode 100644
index 00000000000..e9a37dabf6c
--- /dev/null
+++ b/tests/experimental/b12x/comm/formal/twoshot.qnt
@@ -0,0 +1,197 @@
+// Two-shot source-buffer ownership with independently scheduled GPU, proxy and NIC.
+module twoshot {
+  const WORLD: int
+  const RAILS: int
+  const SIZES: List[int]
+  const WAIT_RELEASE: bool
+  const MAX_ADDRESSES: int
+  const OP_COUNT: int
+
+  pure val Ranks = 0.to(WORLD - 1)
+  pure val Rails = 0.to(RAILS - 1)
+  pure val Ops = 1.to(OP_COUNT)
+  pure val Addresses = 0.to(MAX_ADDRESSES - 1)
+  assume validSizes = Ops.forall(op => SIZES[op - 1] > 0 and SIZES[op - 1] <= MAX_ADDRESSES)
+  assume matchingCount = SIZES.length() == OP_COUNT
+  // (generation, phase: 0 reduce-scatter / 1 all-gather, source, destination, rail).
+  type Packet = (int, int, int, int, int)
+  pure val Packets = tuples(Ops, Set(0, 1), Ranks, Ranks, Rails)
+    .filter(p => p._3 != p._4)
+  type State = {
+    epoch: int -> int,
+    gpu: int -> int,
+    proxy: int -> int,
+    done: int -> int,
+    readyRS: int -> int,
+    readyAG: int -> int,
+    send: (int, int) -> int,
+    wire: Packet -> int,
+    corrupt: bool
+  }
+  var s: State
+
+  // One address represents one 16-byte pack. Empty stripes still carry a flag.
+  pure def first(op: int, shard: int): int = (SIZES[op - 1] * shard) / WORLD
+  pure def inShard(op: int, shard: int, address: int): bool =
+    first(op, shard) <= address and address < first(op, shard + 1)
+  pure def stripe(p: Packet): Set[int] = {
+    val shard = if (p._2 == 0) p._4 else p._3
+    val count = first(p._1, shard + 1) - first(p._1, shard)
+    val base = count / RAILS
+    val extra = count % RAILS
+    val lo = first(p._1, shard) + p._5 * base + (if (p._5 < extra) p._5 else extra)
+    val n = base + (if (p._5 < extra) 1 else 0)
+    Addresses.filter(a => lo <= a and a < lo + n)
+  }
+  pure def code(op: int, phase: int): int = 2 * op + phase
+  def incoming(rank: int, op: int, phase: int): bool =
+    Packets.filter(p => p._1 == op and p._2 == phase and p._4 == rank)
+      .forall(p => s.wire.get(p) >= 3)
+  def posted(rank: int, op: int, phase: int): bool =
+    Packets.filter(p => p._1 == op and p._2 == phase and p._3 == rank)
+      .forall(p => s.wire.get(p) >= 1)
+  def drained(rank: int, op: int): bool =
+    Packets.filter(p => p._1 == op and p._3 == rank)
+      .forall(p => s.wire.get(p) == 4)
+
+  action init = s' = {
+    epoch: Ranks.mapBy(_ => 0), gpu: Ranks.mapBy(_ => 0),
+    proxy: Ranks.mapBy(_ => 0), done: Ranks.mapBy(_ => 0),
+    readyRS: Ranks.mapBy(_ => 0), readyAG: Ranks.mapBy(_ => 0),
+    send: tuples(Ranks, Addresses).mapBy(_ => 0),
+    wire: Packets.mapBy(_ => 0), corrupt: false
+  }
+
+  def canStage(r: int): bool = s.gpu.get(r) == 0 and s.epoch.get(r) < OP_COUNT
+  action stage(r: int): bool = all {
+    canStage(r),
+    s' = {
+      gpu: s.gpu.set(r, 1),
+      readyRS: s.readyRS.set(r, s.epoch.get(r) + 1),
+      send: tuples(Ranks, Addresses).mapBy(k =>
+        if (k._1 == r and k._2 < SIZES[s.epoch.get(r)] and
+            not(inShard(s.epoch.get(r) + 1, r, k._2)))
+          code(s.epoch.get(r) + 1, 0) else s.send.get(k)),
+      ...s
+    }
+  }
+  def canReduce(r: int): bool = s.gpu.get(r) == 1 and incoming(r, s.epoch.get(r) + 1, 0)
+  action reduce(r: int): bool = all {
+    canReduce(r),
+    s' = {
+      gpu: s.gpu.set(r, 2),
+      readyAG: s.readyAG.set(r, s.epoch.get(r) + 1),
+      send: tuples(Ranks, Addresses).mapBy(k =>
+        if (k._1 == r and inShard(s.epoch.get(r) + 1, r, k._2))
+          code(s.epoch.get(r) + 1, 1) else s.send.get(k)),
+      ...s
+    }
+  }
+  def canGather(r: int): bool = s.gpu.get(r) == 2 and incoming(r, s.epoch.get(r) + 1, 1)
+  action gather(r: int): bool = all {
+    canGather(r),
+    s' = { gpu: s.gpu.set(r, 3), ...s }
+  }
+  def canFinish(r: int): bool = s.gpu.get(r) == 3 and
+    (not(WAIT_RELEASE) or s.done.get(r) == s.epoch.get(r) + 1)
+  action finish(r: int): bool = all {
+    canFinish(r),
+    s' = { epoch: s.epoch.set(r, s.epoch.get(r) + 1), gpu: s.gpu.set(r, 0), ...s }
+  }
+  // A ready word survives GPU completion until the following generation writes
+  // that word. Each proxy finishes one generation before inspecting the next.
+  def canPost(p: Packet): bool = all {
+    s.wire.get(p) == 0,
+    s.proxy.get(p._3) + 1 == p._1,
+    (if (p._2 == 0) s.readyRS.get(p._3) else s.readyAG.get(p._3)) == p._1,
+    p._2 == 0 or posted(p._3, p._1, 0)
+  }
+  action post(p: Packet): bool = all {
+    canPost(p), s' = { wire: s.wire.set(p, 1), ...s }
+  }
+  // Posting describes an address; the NIC reads its contents later.
+  action readPayload(p: Packet): bool = all {
+    s.wire.get(p) == 1,
+    s' = {
+      wire: s.wire.set(p, 2),
+      corrupt: s.corrupt or stripe(p).exists(a => s.send.get((p._3, a)) != code(p._1, p._2)),
+      ...s
+    }
+  }
+  // Reliable QP ordering publishes a stripe flag only after its payload.
+  action publishFlag(p: Packet): bool = all {
+    s.wire.get(p) == 2, s' = { wire: s.wire.set(p, 3), ...s }
+  }
+  // CQ consumption may happen after a receiver has already consumed its flag.
+  action completion(p: Packet): bool = all {
+    s.wire.get(p) == 3, s' = { wire: s.wire.set(p, 4), ...s }
+  }
+  def canRelease(r: int): bool = s.proxy.get(r) < OP_COUNT and
+    drained(r, s.proxy.get(r) + 1)
+  action release(r: int): bool = all {
+    canRelease(r),
+    s' = {
+      done: s.done.set(r, s.proxy.get(r) + 1),
+      proxy: s.proxy.set(r, s.proxy.get(r) + 1), ...s
+    }
+  }
+
+  action gpuStep = {
+    nondet r = Ranks.oneOf()
+    any { stage(r), reduce(r), gather(r), finish(r) }
+  }
+  action proxyStep = any {
+    { nondet p = Packets.oneOf(); post(p) },
+    { nondet r = Ranks.oneOf(); release(r) }
+  }
+  action nicStep = {
+    nondet p = Packets.oneOf()
+    any { readPayload(p), publishFlag(p), completion(p) }
+  }
+  action usefulStep = any { gpuStep, proxyStep, nicStep }
+  // Polling can repeat forever; it does not release storage or complete an op.
+  action poll = s' = s
+  action step = any { usefulStep, poll }
+
+  val complete = Ranks.forall(r => s.epoch.get(r) == OP_COUNT and
+    s.proxy.get(r) == OP_COUNT)
+  val usefulEnabled = Ranks.exists(r => any {
+      canStage(r), canReduce(r), canGather(r), canFinish(r), canRelease(r)
+    }) or Packets.exists(p => canPost(p) or (1 <= s.wire.get(p) and s.wire.get(p) < 4))
+  val sourceSafe = not(s.corrupt)
+  val noProtocolDeadlock = complete or usefulEnabled
+  val releaseBeforeEpoch = not(WAIT_RELEASE) or
+    Ranks.forall(r => s.epoch.get(r) <= s.done.get(r))
+  val safety = sourceSafe and noProtocolDeadlock and releaseBeforeEpoch
+  // Every useful transition advances a finite operation/packet state. Weak
+  // fairness of the aggregate non-stuttering scheduler therefore suffices.
+  temporal healthyProgress = weakFair(usefulStep, s) implies eventually(complete)
+}
+
+module twoshot_release_2r1h {
+  import twoshot(WORLD = 2, RAILS = 1, SIZES = List(4, 2), WAIT_RELEASE = true, MAX_ADDRESSES = 4, OP_COUNT = 2).*
+}
+module twoshot_release_2r2h {
+  import twoshot(WORLD = 2, RAILS = 2, SIZES = List(4, 2), WAIT_RELEASE = true, MAX_ADDRESSES = 4, OP_COUNT = 2).*
+}
+module twoshot_release_3r1h {
+  import twoshot(WORLD = 3, RAILS = 1, SIZES = List(6, 3), WAIT_RELEASE = true, MAX_ADDRESSES = 6, OP_COUNT = 2).*
+}
+module twoshot_without_release {
+  import twoshot(WORLD = 2, RAILS = 1, SIZES = List(4, 2), WAIT_RELEASE = false, MAX_ADDRESSES = 4, OP_COUNT = 2).*
+
+  // Rank zero advances after receiving rank one's all-gather. Its own
+  // all-gather still refers to packs [0,2), and the shorter op stages pack 1.
+  run geometryOverwriteTest = init
+    .then(stage(0)).then(stage(1))
+    .then(post((1, 0, 0, 1, 0))).then(readPayload((1, 0, 0, 1, 0)))
+    .then(publishFlag((1, 0, 0, 1, 0)))
+    .then(post((1, 0, 1, 0, 0))).then(readPayload((1, 0, 1, 0, 0)))
+    .then(publishFlag((1, 0, 1, 0, 0)))
+    .then(reduce(0)).then(reduce(1))
+    .then(post((1, 1, 1, 0, 0))).then(readPayload((1, 1, 1, 0, 0)))
+    .then(publishFlag((1, 1, 1, 0, 0)))
+    .then(gather(0)).then(finish(0)).then(stage(0))
+    .then(post((1, 1, 0, 1, 0))).then(readPayload((1, 1, 0, 1, 0)))
+    .then(all { assert(not(sourceSafe)), s' = s })
+}
diff --git a/tests/experimental/b12x/comm/test_roce_protocol_gpu.py b/tests/experimental/b12x/comm/test_roce_protocol_gpu.py
new file mode 100644
index 00000000000..362f21a3785
--- /dev/null
+++ b/tests/experimental/b12x/comm/test_roce_protocol_gpu.py
@@ -0,0 +1,174 @@
+"""Exercise shared-buffer lifetimes under changing RoCE collective geometry.
+
+Run under torchrun with one GPU process on each of two or four hosts. Both
+neighbor-ring and direct-mesh transports use real CuTe kernels and native
+RDMA proxies. Gloo carries setup barriers; reduction references are exact
+integer sums, so no NCCL communicator is needed.
+"""
+
+from __future__ import annotations
+
+import os
+import threading
+import time
+from datetime import timedelta
+
+import pytest
+import torch
+import torch.distributed as dist
+
+from tests.experimental.b12x.comm.test_roce_varlen_gpu import (
+    CAPACITY,
+    SENTINEL,
+    _check,
+    _contribution,
+    _counts_cases,
+    _prepare,
+)
+
+pytestmark = pytest.mark.skipif(
+    not 2 <= int(os.environ.get("WORLD_SIZE", "1")) <= 16,
+    reason="requires torchrun with 2..16 ranks",
+)
+
+
+@pytest.fixture(scope="module", params=[False, True], ids=["mesh", "ring"])
+def prepared(request):
+    if not dist.is_initialized():
+        dist.init_process_group("gloo", timeout=timedelta(seconds=120))
+    result = _prepare(ring=request.param, pipe_bytes=16 << 20)
+    yield result
+    dist.barrier()
+    result.runtime.close()
+
+
+def _check_reductions(outputs, iteration):
+    """Report corrupt payloads on every rank before a teardown barrier."""
+    world = dist.get_world_size()
+    errors = []
+    for operation, output in enumerate(outputs):
+        value = world * (world + 1) // 2 + world * (iteration + operation)
+        mismatches = int(torch.count_nonzero(output != value).item())
+        if mismatches:
+            errors.append(
+                {
+                    "rank": dist.get_rank(),
+                    "replay": iteration,
+                    "operation": operation,
+                    "nbytes": output.numel() * output.element_size(),
+                    "expected": value,
+                    "mismatched_elements": mismatches,
+                }
+            )
+    peer_errors = [None] * world
+    dist.all_gather_object(peer_errors, errors)
+    assert not any(peer_errors), f"collective payload corruption: {peer_errors}"
+
+
+def _replay(prepared, graph, iteration, *, delay_proxy):
+    """Delay one proxy's service independently of GPU and peer progress."""
+    runtime = prepared.runtime
+    rank, world = dist.get_rank(), dist.get_world_size()
+    torch.cuda.synchronize()
+    dist.barrier()
+    resume = None
+    if delay_proxy and rank == iteration % world:
+        runtime._proxy.stop()
+
+        def restart():
+            time.sleep(0.025)
+            runtime._proxy.start()
+
+        resume = threading.Thread(target=restart, daemon=True)
+        resume.start()
+    try:
+        # Submission skew changes which GPU reaches each doorbell first.
+        time.sleep(0.001 * ((rank + iteration) % world))
+        graph.replay()
+        torch.cuda.synchronize()
+    finally:
+        if resume is not None:
+            resume.join(timeout=5)
+            assert not resume.is_alive(), "delayed proxy did not restart"
+    runtime.check_health()
+
+
+def test_graph_changes_two_shot_shards_before_send_buffer_reuse(prepared):
+    """A shared pipe survives 2, 8, 4, and 16 MiB sends within one graph.
+
+    Every operation has a distinct payload. Changing shard boundaries makes
+    the next operation overwrite bytes owned by a different rank in the
+    preceding all-gather; pipe completion must precede that overwrite.
+    """
+    runtime = prepared.runtime
+    rank = dist.get_rank()
+    sizes = (2 << 20, 8 << 20, 4 << 20, 16 << 20, 8 << 20, 2 << 20)
+    sources = [
+        torch.full(
+            (size // 2,), rank + 1 + op, dtype=torch.bfloat16, device=runtime.device
+        )
+        for op, size in enumerate(sizes)
+    ]
+    outputs = [torch.empty_like(source) for source in sources]
+    stream = torch.cuda.Stream(device=runtime.device)
+    stream.wait_stream(torch.cuda.current_stream())
+    with torch.cuda.stream(stream):
+        for source, output in zip(sources, outputs, strict=True):
+            prepared.all_reduce(source, out=output)
+    torch.cuda.synchronize()
+    dist.barrier()
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph, stream=stream), runtime.capture(stream=stream):
+        for source, output in zip(sources, outputs, strict=True):
+            prepared.all_reduce(source, out=output)
+    for iteration in range(20):
+        for operation, (source, output) in enumerate(
+            zip(sources, outputs, strict=True)
+        ):
+            source.fill_(rank + 1 + iteration + operation)
+            output.fill_(float("nan"))
+        _replay(prepared, graph, iteration, delay_proxy=iteration % 3 == 0)
+        _check_reductions(outputs, iteration)
+    dist.barrier()
+
+
+def test_graph_mixes_variable_counts_and_reduction_with_proxy_delays(prepared):
+    """Mutable count vectors and distinct reductions retain their own epochs."""
+    runtime = prepared.runtime
+    world, rank = dist.get_world_size(), dist.get_rank()
+    source = torch.zeros(CAPACITY, dtype=torch.uint8, device=runtime.device)
+    counts = torch.zeros(world, dtype=torch.int64, device=runtime.device)
+    gathered = torch.empty((world, CAPACITY), dtype=torch.uint8, device=runtime.device)
+    inputs = [
+        torch.full(
+            (size // 2,), rank + 1 + op, dtype=torch.bfloat16, device=runtime.device
+        )
+        for op, size in enumerate((32768, 8 << 20, 2 << 20))
+    ]
+    outputs = [torch.empty_like(inp) for inp in inputs]
+    stream = torch.cuda.Stream(device=runtime.device)
+    stream.wait_stream(torch.cuda.current_stream())
+    with torch.cuda.stream(stream):
+        prepared.gather(source, counts, out=gathered)
+        for inp, out in zip(inputs, outputs, strict=True):
+            prepared.all_reduce(inp, out=out)
+    torch.cuda.synchronize()
+    dist.barrier()
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph, stream=stream), runtime.capture(stream=stream):
+        prepared.all_reduce(inputs[0], out=outputs[0])
+        prepared.gather(source, counts, out=gathered)
+        prepared.all_reduce(inputs[1], out=outputs[1])
+        prepared.gather(source, counts, out=gathered)
+        prepared.all_reduce(inputs[2], out=outputs[2])
+    for iteration, values in enumerate(_counts_cases(world) * 3):
+        counts.copy_(torch.tensor(values, dtype=torch.int64))
+        source.copy_(_contribution(rank, values[rank], 700 + iteration, runtime.device))
+        gathered.fill_(SENTINEL)
+        for operation, (inp, out) in enumerate(zip(inputs, outputs, strict=True)):
+            inp.fill_(rank + 1 + iteration + operation)
+            out.fill_(float("nan"))
+        _replay(prepared, graph, iteration, delay_proxy=iteration % 3 == 0)
+        _check(gathered, values, 700 + iteration)
+        _check_reductions(outputs, iteration)
+    dist.barrier()
diff --git a/tests/experimental/b12x/comm/test_roce_proxy.py b/tests/experimental/b12x/comm/test_roce_proxy.py
index 93aea4764fc..ede37678c52 100644
--- a/tests/experimental/b12x/comm/test_roce_proxy.py
+++ b/tests/experimental/b12x/comm/test_roce_proxy.py
@@ -61,3 +61,79 @@ def roce_connect(self, ctx, blobs, size, table, rails):
             proxy.connect([b"aaaa", b"bbbb", b"cccc"], [[], [(0, 1)], [(1, 0), (3, 2)]])
     finally:
         proxy._ctx = None
+
+
+def test_ring_route_table_leaves_non_neighbors_unconnected():
+    from b12x.comm.roce._proxy import Proxy
+
+    class Native:
+        def roce_blob_bytes(self):
+            return 4
+
+        def roce_connect(self, ctx, blobs, size, table, rails):
+            assert ctx == 123 and size == 16 and rails == 2
+            assert list(table) == [0, 0, 0, 0, 0, 1, 2, 3, 0, 0, 0, 0, 1, 0, 3, 2]
+            return 0
+
+    proxy = Proxy.__new__(Proxy)
+    proxy._ctx, proxy._lib = 123, Native()
+    proxy.world_size, proxy.rank, proxy.ring = 4, 0, True
+    blobs = [b"aaaa", b"bbbb", b"cccc", b"dddd"]
+    routes = [[], [(0, 1), (2, 3)], [], [(1, 0), (3, 2)]]
+    try:
+        proxy.connect(blobs, routes)
+        routes[2] = [(0, 0), (1, 1)]
+        with pytest.raises(RuntimeError, match="non-neighbors"):
+            proxy.connect(blobs, routes)
+    finally:
+        proxy._ctx = None
+
+
+def test_layout_places_two_shot_area_after_control():
+    """The two-shot area follows the control record; without one the region is unchanged."""
+    from b12x.comm.roce._proxy import Layout, load
+
+    try:
+        load()
+    except RuntimeError as exc:  # no C compiler or libibverbs headers
+        pytest.skip(str(exc))
+    plain = Layout(4, 2 << 20)
+    assert plain.pipe_bytes == 0 and plain.total_bytes == plain.pipe_send_off
+    piped = Layout(4, 2 << 20, 64 << 20)
+    assert piped.ctrl_off == plain.ctrl_off
+    assert piped.pipe_send_off >= piped.ctrl_off + 4096
+    assert piped.pipe_recv_off == piped.pipe_send_off + (64 << 20)
+    assert piped.shard_cap == 16 << 20
+    assert piped.pipe_flag_off == piped.pipe_recv_off + 4 * 2 * piped.shard_cap
+    flags = 2 * 4 * piped.max_chunks * 2 * piped.flag_stride
+    assert piped.total_bytes == piped.pipe_flag_off + flags
+    # Uneven shards round up to whole pages.
+    assert Layout(3, 2 << 20, 4096 * 5).shard_cap == 8192
+    with pytest.raises(ValueError):
+        Layout(4, 2 << 20, 1000)
+
+
+def test_layout_places_variable_length_area_after_two_shot():
+    """Two receive rows per rank and slot, then per-slot chunk flags; without one, nothing changes."""
+    from b12x.comm.roce._proxy import ABI_VERSION, Layout, load
+
+    try:
+        lib = load()
+    except RuntimeError as exc:  # no C compiler or libibverbs headers
+        pytest.skip(str(exc))
+    assert lib.roce_abi_version() == ABI_VERSION == 10
+    piped = Layout(4, 2 << 20, 64 << 20)
+    assert piped.varlen_bytes == 0
+    assert piped.varlen_recv_off == piped.varlen_flag_off == piped.total_bytes
+    varlen = Layout(4, 2 << 20, 64 << 20, 8 << 20)
+    assert varlen.pipe_flag_off == piped.pipe_flag_off
+    assert varlen.varlen_recv_off == piped.total_bytes
+    assert varlen.varlen_flag_off == varlen.varlen_recv_off + 2 * 4 * (8 << 20)
+    flags = 2 * 4 * varlen.varlen_max_chunks * 2 * varlen.flag_stride
+    assert varlen.total_bytes == varlen.varlen_flag_off + flags
+    # Without a two-shot area the variable-length one follows the control record.
+    alone = Layout(2, 4096, 0, 4096)
+    assert alone.varlen_recv_off == alone.pipe_send_off == alone.ctrl_off + 4096
+    for bad in (1000, (1 << 32) + 4096):
+        with pytest.raises(ValueError):
+            Layout(4, 2 << 20, 0, bad)
