+    (("ke", "B16", 0, (1, 7)),),
+    (("qe", "B16", 0, (1, 7)),),
+    (("akk_int", "A16", 0, (1, 6)),),
+    (("do_int", "B16", 0, (1, 6)), ("db_int", "V32", 0, (7, 8))),
+    (("v_int", "B16", 0, (1, 6)),),
+    (("dv2", "B16", 0, (1, 6)),),
+    (("vb", "B16", 0, (1, 2)), ("dAqk", "A32", 0, (4, 7))),
+    (
+        ("u", "B16", 0, (2, 2)),
+        ("aqk_int", "A16", 256, (1, 4)),
+        ("dh", "TAPE", 0, (5, 6)),
+        ("dg_int", "F32", 0, (7, 8)),
+    ),
+    (("qg", "B16", 0, (1, 5)), ("kg", "B16", 256, (1, 5)), ("dq_f", "F32", 0, (6, 7))),
+    (("w", "B16", 0, (2, 5)), ("dv1", "B16", 256, (4, 5)), ("dk_f", "F32", 0, (6, 7))),
+    (
+        ("v_new_scratch", "B16", 0, (1, 1)),
