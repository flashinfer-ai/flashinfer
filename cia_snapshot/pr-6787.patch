+
+def _rule_kinds(rule: dict) -> list[str]:
+    kinds = [rule["kind"]]
+    if rule["kind"] == "all_of":
+        for sub_rule in rule["rules"]:
+            kinds.extend(_rule_kinds(sub_rule))
+    return kinds
+
