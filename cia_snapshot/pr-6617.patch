-    shapes = {
-        "q_scale": (
-            num_qo_heads,
-            flat_scale_numel(batch_size, seq_len_q, config.q_block_size),
-        ),
-        "k_scale": (
-            num_kv_heads,
-            flat_scale_numel(batch_size, seq_len_kv, config.k_block_size),
-        ),
-        "v_scale": (batch_size, num_kv_heads, head_dim),
