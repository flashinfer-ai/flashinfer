+inline void CheckDtype(const TensorView& t, const char* name, int code, int bits, int lanes) {
+  DLDataType d = t.dtype();
+  TVM_FFI_CHECK((int)d.code == code && (int)d.bits == bits && (int)d.lanes == lanes, TypeError)
