+        _SafeE4M3Quantize(hidden, top_k),
+        tensor(Float32, (tokens, hidden), 4),
+        tensor(Float32, (tokens, 1), 4),
+        tensor(cutlass.Float8E4M3FN, (capacity, hidden), 1),
