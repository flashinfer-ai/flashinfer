+    )
+    compile_payload = inspect.unwrap(_preparation.compile_compressed_sparse_mla)
+    with pytest.raises(ValueError, match="arithmetic constraint"):
+        compile_payload(constrained.query.to_dict(), asdict(fp8), 0)
