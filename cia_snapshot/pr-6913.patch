+
+    return VarlenAttentionQuery(
+        variant="varlen",
+        dtype="bfloat16",
+        causal=False,
+        batch_size=4,
+        q_heads=16,
+        kv_heads=16,
+        q_head_dim=72,
+        v_head_dim=72,
