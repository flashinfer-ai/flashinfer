+        assert bool(guards) is (len(splits) > 1)
+    remaining = sorted(
+        path.name for path in csrc_dir.glob("flashkda_decode_d128_t*.cu")
+    )
+    assert remaining == sorted(set(_TEMPLATED_BODY_FILES.values()))
