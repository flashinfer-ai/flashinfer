+            device="cuda",
+            query_paired=True,
+        ),
+        dtype=torch.int8,
+        device="cuda",
+    )
+    out = torch.empty_like(expected)
+    prepared = prepare_prims_ts_batch_decode_with_kv_cache(
+        decode_case.q,
+        decode_case.paged_kv_cache,
