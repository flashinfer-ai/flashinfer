+            main_pitch_units,
+            main_footer_units,
+        )
+
+    values: dict[str, Any] = {
+        "Q": q_packed,
+        "SWA_cache": main_data,
+        "SWA_sf": main_sf,
+        "compressed_KV_cache": extra_data,
+        "compressed_KV_sf": extra_sf,
+        "O": out_rows,
+        "LSE": lse_out,
+        "swa_indices": main_indices,
+        "compressed_indices": extra_indices,
