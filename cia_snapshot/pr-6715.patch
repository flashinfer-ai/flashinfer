+        scratch = launch["main"]["seq_chunk_cumsum"]
+        assert scratch.numel() == prepared.grid[0] * (num_seqs + 1)
+        assert launch["main"]["metadata_from_cu_seqlens"] == (
+            module._TABLE_IN_KERNEL_I64
