+def _graph_outputs(t):
+    return tuple(
+        torch.empty(s, dtype=d, device="cuda")
+        for s, d in (
+            ((t, HC), torch.float32),
+            ((t, HC * HC), torch.float32),
+            ((t, H), torch.bfloat16),
+        )
