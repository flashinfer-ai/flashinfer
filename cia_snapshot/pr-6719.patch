-    op = tree["op"]
-    a = _eval_dim(tree["a"], tensor)
-    b = _eval_dim(tree["b"], tensor)
-    if op == "add":
-        return a + b
-    if op == "sub":
-        return a - b
-    if op == "mul":
-        return a * b
-    if op == "floordiv":
-        return a // b
-    if op == "floormod":
-        return a % b
-    if op == "eq":
-        return int(a == b)
-    raise ValueError(f"unknown TMA expression operator {op!r}")
