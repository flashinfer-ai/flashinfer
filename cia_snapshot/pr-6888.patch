+def card(arch: str, num_sms: int) -> str:
+    """The policy's card: ``h100`` (sm_90a; H200 follows it), ``b200``, ``b300`` or
+    ``gb300`` (sm_103a with ``gb300_sms`` SMs)."""
+
+    if arch.startswith("sm_90"):
+        return "h100"
+    if arch == "sm_100a":
+        return "b200"
+    if arch == "sm_103a":
+        return (
+            "gb300"
+            if int(num_sms) == STAGE_POLICY["constants"]["gb300_sms"]
+            else "b300"
