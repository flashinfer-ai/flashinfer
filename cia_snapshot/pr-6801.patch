-        raise NotImplementedError(routing_method)
-
-    moe_impl = spec.make_impl()
-    moe_impl._cache_permute_indices = cache_permute_indices
-    weights_data = moe_impl.quantize_weights(
-        gemm1_weights, gemm2_weights, hidden_states
