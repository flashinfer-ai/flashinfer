+# Explicit per-expert count fixtures: (counts, activation count the backend sees).
+_COUNT_FIXTURES = {
+    "fc1_counts": (ref.COUNTS_E2E_FC1, 64),
+    "fc1_counts_mxfp8": (ref.COUNTS_E2E_FC1_MXFP8, 64),
+    "fc2_counts": (ref.COUNTS_E2E_FC2, 256),
+}
