-char const* familyName(int family) {
-  switch (family) {
-    case generated::kFc1Nvfp4:
-      return "nvfp4";
-    case generated::kFc1Nvfp4PerToken:
-      return "nvfp4_bf16tok";
-    case generated::kFc1Bf16:
-      return "bf16";
-    case generated::kFc1Fp8PerTensor:
-      return "fp8";
-    case generated::kFc1MxFp8:
-      return "mxfp8";
-    default:
-      return "unsupported";
