-        permute_info, scores = routing_reference_no_aux(
-            expert_logits,
-            routing_bias,
-            TOP_K,
-            n_groups,
-            top_k_groups,
-            routed_scaling,
-            PADDING,
-            num_fused_shared_experts=num_fused_shared_experts,
