+                f"requantization unit; the 4over6 recipe {recipe!r} is unavailable."
+            )
+    return {
+        "full_path": True,
+        "reserved_sms": reserved_sms,
+        "global_scale_inv": CAKE_STEPFUN_GLOBAL_SCALE_INV,
+    }
 
 
