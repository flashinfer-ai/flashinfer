+void Run(TensorView arg_A, TensorView arg_B, TensorView arg_SFA, TensorView arg_SFB, TensorView arg_C, TensorView arg_tile_expert, TensorView arg_tile_mn_limit, TensorView arg_num_non_exiting_ctas, TensorView arg_scale_c, int64_t arg_M_out, int64_t arg_K, int64_t arg_grid_m, int64_t arg_grid_n, int64_t arg_K_tiles, int64_t enable_pdl, int64_t grid_x, int64_t grid_y, int64_t grid_z) {
+  DLDevice dev = arg_A.device();
+  tvm::ffi::CUDADeviceGuard device_guard(dev.device_id);
+  {
+    // Bind the primary context for the tensor-map encoders once per thread and device.
+    static thread_local int encoder_context_device = -1;
+    if (encoder_context_device != dev.device_id) {
+      TVM_FFI_CHECK_CUDA_ERROR(cudaSetDevice(dev.device_id));
+      encoder_context_device = dev.device_id;
+    }
+  }
+  check_cuda_tensor(arg_A, "A");
+  check_dtype(arg_A, DLDataType{kDLUInt, 8, 1}, "A");
+  check_contiguous(arg_A, "A");
+  check_cuda_tensor(arg_B, "B");
+  check_dtype(arg_B, DLDataType{kDLUInt, 8, 1}, "B");
+  check_cuda_tensor(arg_SFA, "SFA");
+  check_dtype(arg_SFA, DLDataType{kDLUInt, 8, 1}, "SFA");
+  check_cuda_tensor(arg_SFB, "SFB");
+  check_dtype(arg_SFB, DLDataType{kDLUInt, 8, 1}, "SFB");
+  check_cuda_tensor(arg_C, "C");
+  check_dtype(arg_C, DLDataType{kDLBfloat, 16, 1}, "C");
+  check_cuda_tensor(arg_tile_expert, "tile_expert");
+  check_dtype(arg_tile_expert, DLDataType{kDLInt, 32, 1}, "tile_expert");
+  check_contiguous(arg_tile_expert, "tile_expert");
+  check_cuda_tensor(arg_tile_mn_limit, "tile_mn_limit");
+  check_dtype(arg_tile_mn_limit, DLDataType{kDLInt, 32, 1}, "tile_mn_limit");
+  check_contiguous(arg_tile_mn_limit, "tile_mn_limit");
+  check_cuda_tensor(arg_num_non_exiting_ctas, "num_non_exiting_ctas");
+  check_dtype(arg_num_non_exiting_ctas, DLDataType{kDLInt, 32, 1}, "num_non_exiting_ctas");
+  check_contiguous(arg_num_non_exiting_ctas, "num_non_exiting_ctas");
+  check_cuda_tensor(arg_scale_c, "scale_c");
+  check_dtype(arg_scale_c, DLDataType{kDLFloat, 32, 1}, "scale_c");
+  check_contiguous(arg_scale_c, "scale_c");
+  TVM_FFI_CHECK(arg_M_out >= -2147483648LL && arg_M_out <= 2147483647LL, ValueError)
+      << "scalar 'M_out' value " << arg_M_out
+      << " is outside i32 range [-2147483648, 2147483647]";
+  TVM_FFI_CHECK(arg_K >= -2147483648LL && arg_K <= 2147483647LL, ValueError)
+      << "scalar 'K' value " << arg_K
+      << " is outside i32 range [-2147483648, 2147483647]";
+  TVM_FFI_CHECK(arg_grid_m >= -2147483648LL && arg_grid_m <= 2147483647LL, ValueError)
+      << "scalar 'grid_m' value " << arg_grid_m
+      << " is outside i32 range [-2147483648, 2147483647]";
+  TVM_FFI_CHECK(arg_grid_n >= -2147483648LL && arg_grid_n <= 2147483647LL, ValueError)
+      << "scalar 'grid_n' value " << arg_grid_n
+      << " is outside i32 range [-2147483648, 2147483647]";
+  TVM_FFI_CHECK(arg_K_tiles >= -2147483648LL && arg_K_tiles <= 2147483647LL, ValueError)
+      << "scalar 'K_tiles' value " << arg_K_tiles
+      << " is outside i32 range [-2147483648, 2147483647]";
