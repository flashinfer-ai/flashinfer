+  check_same_device(arg_SFA, arg_A, "SFA", "A");
+  check_same_device(arg_SFB, arg_A, "SFB", "A");
+  check_same_device(arg_C, arg_A, "C", "A");
+  check_same_device(arg_tile_expert, arg_A, "tile_expert", "A");
+  check_same_device(arg_tile_mn_limit, arg_A, "tile_mn_limit", "A");
+  check_same_device(arg_num_non_exiting_ctas, arg_A, "num_non_exiting_ctas", "A");
+  check_same_device(arg_scale_c, arg_A, "scale_c", "A");
