+                    unit["kernel_variant"], unit["expert_weights_dtype"]
+                )
+                == program
+            )
+    assert len(keys) == 111
+    for stage, family in (("fc1", "nvfp4"), ("fc2", "bf16")):
+        tiles = cb.exported_tiles(stage, family)
+        assert tiles == tuple(sorted(tiles)) and tiles
+        for tile in tiles:
